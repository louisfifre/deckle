#include <winver.h>

#define DECKLE_NATIVE_VERSION_NUM 0,1,0,0
#define DECKLE_NATIVE_VERSION_STR "0.1.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DECKLE_NATIVE_VERSION_NUM
 PRODUCTVERSION DECKLE_NATIVE_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Deckle"
            VALUE "FileDescription", "Deckle taskbar customization, injected half"
            VALUE "FileVersion", DECKLE_NATIVE_VERSION_STR
            VALUE "InternalName", "Deckle.Shell.Taskbar.Native"
            VALUE "OriginalFilename", "Deckle.Shell.Taskbar.Native.dll"
            VALUE "ProductName", "Deckle"
            VALUE "ProductVersion", DECKLE_NATIVE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
