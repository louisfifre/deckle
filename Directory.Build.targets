<Project>

  <!-- Libraries do not produce RID-specific outputs in Deckle. Keeping them
       RID-agnostic prevents self-contained app builds from scheduling the same
       referenced project once with SelfContained=true and once without it. -->
  <PropertyGroup Condition="'$(OutputType)' == '' or '$(OutputType)' == 'Library'">
    <IsRidAgnostic>true</IsRidAgnostic>
  </PropertyGroup>

  <!-- One ONNX Runtime in every Deckle process: the pinned NuGet build (1.23.0,
       see Directory.Packages.props), which matches ONNX Runtime GenAI 0.13.
       Since Windows App SDK 2.0, Windows ML ships as the NuGet package
       Microsoft.Windows.AI.MachineLearning (pulled in by Microsoft.WindowsAppSDK.ML),
       and in self-contained mode (Deckle.App) its natives are plain NuGet
       copy-local files: a second onnxruntime.dll (1.24), DirectML.dll and the
       Windows ML DLL. The SDK then keeps the higher onnxruntime.dll file version
       for the root output and the deps.json, so the GenAI judge would run on a
       runtime it was not built for. Deckle does not use Windows ML, so drop the
       package's native assets before the copy-local step; its managed projection
       stays.

       Same shape as the _SuppressWindowsMLNativeCopyLocal target that
       Microsoft.WindowsAppSDK.ML ships for framework-dependent apps (the test
       projects), which is skipped in self-contained mode and leaves the
       RuntimeTargets items, hence the deps.json entries, in place. The only
       Microsoft switch left that reaches it, WindowsAppSDKMLPassthroughOnnxRuntime,
       is documented as incompatible with WindowsAppSDKSelfContained, so it is
       not used. A no-op in projects that do not resolve the package.

       Replaces the Windows App SDK 1.8 exclusion of the MSIX DirectML.dll, whose
       hook (AddMicrosoftWindowsAppSDKPayloadFilesFromMsix) no longer exists. -->
  <!-- Shut the .NET build servers down five minutes after the last build.
       Directory.Build.rsp stops MSBuild worker nodes from outliving a build, but
       VBCSCompiler (the Roslyn compiler server) stays ten minutes by SDK default
       and, when it hangs, forever: one hung server kept a CPU core at 100 % for
       hours. The SDK's keepalive is not settable from a repository, so every
       project build touches a stamp and arms scripts/build-server-watchdog.ps1,
       which runs `dotnet build-server shutdown` once no stamp has moved for five
       minutes. Builds in a burst keep their servers; the delay restarts at each
       project. The watchdog is armed only when its heartbeat is missing or
       stale, so a full build pays one pwsh start, not one per project.

       The state lives in the user's temp directory because the servers belong
       to the machine, not to a checkout: every worktree feeds the same watchdog.
       Visual Studio keeps its own compiler-server lifecycle, so its builds are
       left alone. Set DeckleBuildServerWatchdog=false to opt out of one build. -->
  <PropertyGroup>
    <DeckleBuildServerWatchdog Condition="'$(DeckleBuildServerWatchdog)' == ''">true</DeckleBuildServerWatchdog>
    <DeckleBuildStateDir>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'Deckle.Build'))</DeckleBuildStateDir>
  </PropertyGroup>

  <Target Name="ArmBuildServerWatchdog"
          AfterTargets="Build"
          Condition="'$(DeckleBuildServerWatchdog)' == 'true' and '$(BuildingInsideVisualStudio)' != 'true'">
    <PropertyGroup>
      <_DeckleWatchdogHeartbeat>$([System.IO.Path]::Combine($(DeckleBuildStateDir), 'watchdog.heartbeat'))</_DeckleWatchdogHeartbeat>
      <!-- Whole seconds, so the comparison below never meets a culture-specific
           decimal separator. A missing heartbeat dates from 1601 and reads as stale. -->
      <_DeckleWatchdogHeartbeatAge>$([System.Convert]::ToInt64($([System.DateTime]::Now.Subtract($([System.IO.File]::GetLastWriteTime('$(_DeckleWatchdogHeartbeat)'))).TotalSeconds)))</_DeckleWatchdogHeartbeatAge>
    </PropertyGroup>
    <MakeDir Directories="$(DeckleBuildStateDir)" ContinueOnError="WarnAndContinue" />
    <Touch Files="$([System.IO.Path]::Combine($(DeckleBuildStateDir), '$(MSBuildProjectName).stamp'))" AlwaysCreate="true" ContinueOnError="WarnAndContinue" />
    <!-- 120 s is four watchdog ticks: the same staleness the script applies. -->
    <Exec Condition="$(_DeckleWatchdogHeartbeatAge) &gt; 120"
          Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)scripts\build-server-watchdog.ps1&quot; -Arm -StateDir &quot;$(DeckleBuildStateDir)&quot;"
          EchoOff="true"
          StandardOutputImportance="low"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="ExcludeWindowsMLNativeAssets"
          AfterTargets="ResolveLockFileCopyLocalFiles"
          BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning' and '%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning' and '%(ReferenceCopyLocalPaths.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>

</Project>