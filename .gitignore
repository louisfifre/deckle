# ─────────────────────────────────────────────────────────────────────────

**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
venv/
.venv*/
env/
ENV/

