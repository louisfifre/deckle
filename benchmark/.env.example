# benchmark/.env — local secrets for the evaluation suite.
#
# COPY this file to `.env` in the same folder and fill in your own keys.
# `.env` is gitignored; this template is the only env file ever tracked.
#
# Both keys are optional. A bench runs without them: it skips the LLM judge
# with a loud warning, and the objective metrics (WER, looping, leak) still
# compute. Supply the key for the judge a bench actually uses.

# Anthropic — per-row Claude judge (text-only), used by benches run with
# `--judge claude`. Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — multimodal judge (listens to the raw audio) and the
# ground-truth transcriber behind pregenerate_groundtruth_gemini.py. This is
# the default judge in most benches. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
