<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Deckle.Benchmark.PhiBench</RootNamespace>
    <AssemblyName>PhiBench</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- DirectML EP for AMD/NVIDIA/Intel GPUs on Windows via D3D12. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.14.0" />
    <!-- TOML parser for the regimes file (mirrors the Python voxtral_validation.toml). -->
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

</Project>
