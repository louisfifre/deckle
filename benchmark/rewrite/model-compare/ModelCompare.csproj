<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Matches the src/ libraries' target so Deckle.Llm can be referenced
         directly — the generate step goes through the production Claude
         engine (ClaudeEngine, effort low), not a copy of it. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Deckle.Benchmark.ModelCompare</RootNamespace>
    <AssemblyName>ModelCompare</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deckle.Llm already references Deckle.Security (SecretVault, read for
         the API key) and Deckle.Core (AppPaths, where the corpus and the
         settings live), and carries the Anthropic SDK the judge calls
         directly; all of them flow through this one reference. -->
    <ProjectReference Include="..\..\..\src\Deckle.Llm\Deckle.Llm.csproj" />
  </ItemGroup>

</Project>
