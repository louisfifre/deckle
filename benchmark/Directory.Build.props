<Project>

  <!-- The benchmark workspace is outside the app's release discipline. Its
       studies may use different target frameworks, RIDs, and package versions.

       This file's mere presence stops the root Directory.Build.props conventions from
       reaching the bench projects (MSBuild uses the nearest Directory.Build.props only).
       Central Package Management is cut off by the sibling Directory.Packages.props,
       so C# benchmark studies keep self-contained inline PackageReference versions
       instead of resolving them from the root Directory.Packages.props. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
