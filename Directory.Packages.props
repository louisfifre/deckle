<Project>

  <!-- ── Central Package Management (CPM) ──────────────────────────────────────
       One source of truth for every third-party package version. Project files
       carry versionless <PackageReference Include="..." />; the version is resolved
       from the <PackageVersion> entries below. A WindowsAppSDK bump (today spread
       across ~13 csproj) becomes a single edit here.

       CentralPackageTransitivePinningEnabled pins transitively-pulled packages to
       the versions listed here, closing the door on silent transitive drift.
       CentralPackageVersionOverrideEnabled=false forbids a project from quietly
       overriding a central version with VersionOverride — versions move here or
       not at all.

       The benchmark workspace opts out with its own Directory.Packages.props and
       keeps its experimental inline versions. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 runtime + build tooling. Versions must stay in lockstep: a single
         WindowsAppSDK runtime is loaded per process. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

    <!-- MVVM source generators ([ObservableProperty], [RelayCommand]) +
         SettingsCard/SettingsExpander (the Windows 11 settings-page pattern). -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />

    <!-- Direct2D-backed drawing on a CompositionDrawingSurface (HUD rewriting stroke). -->
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />

    <!-- One process-wide ONNX Runtime binary for every Deckle consumer. The
         DirectML build also exposes the CPU EP: Deckle.Inference.Onnx sessions
         keep using CPU by default, while GenAI can opt into DML. Keeping this at
         1.23.0 matches GenAI 0.13 and prevents two ABI-incompatible
         onnxruntime.dll files from competing in the App output. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" />

    <!-- ONNX Runtime GenAI for Deckle.Autocorrect.Onnx's closed-candidate sentence
         judge. The .DirectML variant runs the forced-decoding judge on the GPU (D3D12)
         — the only onnxruntime-genai GPU path on this AMD RDNA3 machine — while still
         exposing the CPU EP as a selectable fallback. Pinned to 0.13.0, NOT 0.14.x:
         genai 0.14 wants ORT API 24 but bundles ORT 1.23, a mismatch that throws
         DllNotFoundException on init (see benchmark/asr/studies/PhiBench). 0.13.0 is
         self-consistent when the whole process resolves the same ORT 1.23 binary,
         and is the version proven in-repo by PhiBench. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.13.0" />

    <!-- Managed SentencePiece/BPE tokenizers (no native lib, no Python) — used by
         the autocorrect CLI's CamemBERT MLM reranker probe to segment text. -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

    <!-- DPAPI (CurrentUser) for the autocorrect CLI's `harvest` sink — the raw
         typed-word capture is sealed at rest, unlike the inspectable personal
         dictionary. CLI-only; the app and the engine never touch it. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="6.0.0" />

    <!-- Managed DTLS-PSK for Hue Entertainment v2. Kept inside Deckle.Lighting's
         Hue driver so the transport dependency does not leak into Ambient. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />

    <!-- Official MCP C# SDK. The ASP.NET Core transport hosts the resident
         stateless Streamable HTTP endpoint; tests use the protocol package's
         client directly to pin current and down-level negotiation. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.1.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!-- Test stack (tests/Deckle.*.Tests): xUnit v3 on the Microsoft Testing Platform,
         VSTest bridge for the Test Explorer. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
