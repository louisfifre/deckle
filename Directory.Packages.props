<Project>

  <!-- ── Central Package Management (CPM) ──────────────────────────────────────
       One source of truth for every third-party package version. Project files
       carry versionless <PackageReference Include="..." />; the version is resolved
       from the <PackageVersion> entries below. A WindowsAppSDK bump (today spread
       across the ~23 csproj of src/ and tests/ that reference it) becomes a single edit here.

       CentralPackageTransitivePinningEnabled pins transitively-pulled packages to
       the versions listed here, closing the door on silent transitive drift.
       CentralPackageVersionOverrideEnabled=false forbids a project from quietly
       overriding a central version with VersionOverride — versions move here or
       not at all. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 runtime + build tooling. Versions must stay in lockstep: a single
         WindowsAppSDK runtime is loaded per process. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

    <!-- MVVM source generators ([ObservableProperty], [RelayCommand]) +
         SettingsCard/SettingsExpander (the Windows 11 settings-page pattern). -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <!-- GridSplitter for the Ambient page's preview pane. Same build as
         SettingsControls on purpose: both pull CommunityToolkit.WinUI.Extensions
         and Helpers transitively, and one Toolkit build per process keeps those
         shared assemblies at one version. Bump the two together. -->
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.250402" />

    <!-- Direct2D-backed drawing on a CompositionDrawingSurface (HUD rewriting stroke). -->
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />

    <!-- One process-wide ONNX Runtime binary for every Deckle consumer (today the
         Silero VAD, through Deckle.Inference.Onnx). The DirectML build also
         exposes the CPU EP, which the sessions use by default. Keeping a single
         version here prevents two ABI-incompatible onnxruntime.dll files from
         competing in the App output. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" />

    <!-- DPAPI (CurrentUser) seals data at rest: the secret vault (Deckle.Security),
         the dictation and take-audio recovery stores (Deckle.Transcription) and the
         autocorrect CLI's `harvest` sink (Deckle.Autocorrect.Lab), whose raw typed-word
         capture is sealed, unlike the inspectable personal dictionary. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="6.0.0" />

    <!-- WMI Win32_ProcessStartTrace subscription for Deckle.Orchestration: the
         smallest thing that pushes process start events (raw ETW would be
         hundreds of lines of interop). Works only when Deckle runs elevated. -->
    <PackageVersion Include="System.Management" Version="10.0.12" />

    <!-- Managed DTLS-PSK for Hue Entertainment v2. Kept inside Deckle.Lighting's
         Hue driver so the transport dependency does not leak into Ambient. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />

    <!-- Official Anthropic C# SDK: Deckle.Llm's Claude engine calls the
         Messages API through it. Plain .NET, no WinUI. -->
    <PackageVersion Include="Anthropic" Version="12.57.0" />

    <!-- Official MCP C# SDK. The ASP.NET Core transport hosts the resident
         stateless Streamable HTTP endpoint; tests use the protocol package's
         client directly to pin current and down-level negotiation. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.1.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!-- Capture data of photos for the Atelier (Deckle.Atelier): reads EXIF, XMP
         and maker notes from JPEG, HEIF and camera raw files without decoding the
         image and without a Windows codec. WIC would read a raw only once the
         Store's Raw Image Extension is installed. Apache-2.0; pulls XmpCore (BSD). -->
    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />

    <!-- Test stack (tests/Deckle.*.Tests): xUnit v3 on the Microsoft Testing Platform,
         VSTest bridge for the Test Explorer. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
