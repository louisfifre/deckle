<Project>

  <!-- ── Shared MSBuild properties for every Deckle project under src/ and tests/ ──
       Centralizes the properties that were duplicated, byte-for-byte, across the
       22 module csproj. A target-framework or platform bump now lives in one
       place instead of 22 files.

       Only UNCONDITIONAL, universally-true properties belong here. Directory.Build.props
       is imported very early (before the project body), so anything that depends on a
       value the project sets later (RID, target-framework-conditional logic) would
       evaluate wrong here — those stay in the project files.

       Deliberately NOT centralized (legitimately per-project):
         RootNamespace      — one per module.
         UseWinUI           — only the modules that compile XAML.
         DefaultLanguage    — only the modules that ship a .resw.
         EnableMsixTooling  — only the modules that must emit their own .pri.
         OutputType         — App is WinExe, test projects are Exe, libs are default.
         Version            — single source of truth is Deckle.App.csproj.

       The benchmark/ suite opts out entirely via benchmark/Directory.Build.props
       (different target framework, autonomous sandbox). -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <!-- Permits `unsafe` / LibraryImport in any module without re-declaring it.
         Permissive, not coercive — a module that never uses unsafe pays nothing,
         and the interop-heavy modules stop hitting SYSLIB1062 / CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Artifacts output layout (.NET 8+). Pulls every bin/ + obj/ out of the
         per-module folders into one root artifacts/ tree, so a module folder
         holds only its source. Layout: artifacts/<bin|obj|publish>/<Project>/<pivot>,
         pivot = configuration (TFM omitted — single-targeted; RID appended only
         when published for a RID). The x64 platform is NOT a pivot, so it leaves
         the path: src\Deckle.App\bin\x64\Debug\net10...\Deckle.exe collapses to
         artifacts\bin\Deckle.App\debug\Deckle.exe.

         ArtifactsPath, NOT the bare UseArtifactsOutput flag, is deliberate.
         $(MSBuildThisFileDirectory) binds to THIS file's directory (the repo
         root) regardless of who imports it — so tests/, which re-imports this
         file (tests/Directory.Build.props), consolidates into the SAME root
         artifacts/ instead of spawning its own tests/artifacts/. benchmark/ has
         its own Directory.Build.props that does not import this one, so it stays
         on the classic per-project layout — intended, it is an autonomous box.

         Cohabits with the publish-staging artifacts/Deckle-v<X.Y.Z>/ produced by
         scripts/commands/publish-app.ps1 (distinct names; the whole artifacts/ tree is
         git-ignored). publish-app.ps1 passes an explicit -o, so its output path
         is unaffected by this property. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
