# Git normalizes text to LF in the index; each type gets its native EOL on checkout.
* text=auto

# Scripts check out with Windows line endings, the platform the launcher runs on.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Shell scripts break on a carriage return, whatever the platform.
*.sh   text eol=lf

*.md   text eol=lf
*.json text eol=lf
.gitattributes text eol=lf

# TREE.md is regenerated by the pre-commit hook, so a merge keeps our side and
# the next commit rewrites it. The driver is registered by
# scripts/setup/install-hooks.ps1.
TREE.md merge=ours

# Binary files: never normalized, never diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.7z   binary
*.gz   binary
*.tar  binary
*.dll  binary
*.exe  binary
*.pdb  binary
