<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework aligné sur les modules testés (Chrono, Diagnostics
         compilent en net10.0-windows10.0.26100.0). Une asymétrie ferait
         échouer la résolution des ProjectReference. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Deckle.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>

    <!-- xUnit v3 : un projet de test est un exécutable autonome
         (Microsoft Testing Platform). Compatible aussi avec VSTest via
         xunit.runner.visualstudio pour le Test Explorer. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Win2D arrive transitivement via Deckle.Composition / Deckle.Vision
         et émet WIN2D0001 quand le projet est buildé AnyCPU. Le projet de
         tests ne consomme aucune API Win2D et le warning n'a aucune
         conséquence runtime — la dll Canvas n'est jamais chargée. Désactivé
         localement pour garder la sortie test propre. -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Orchestration VSTest — découverte par dotnet test et Test Explorer. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <!-- Framework de test xUnit v3 (versions documentées : xunit.v3 3.2.2,
         xunit.runner.visualstudio 3.1.5). Choix v3 motivé par recommandation
         officielle de l'équipe xUnit pour tout nouveau projet en 2026. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modules testés au premier sprint. D'autres ProjectReference
         s'ajouteront au fil de l'extension de la couverture. -->
    <ProjectReference Include="..\..\src\Deckle.Chrono\Deckle.Chrono.csproj" />
    <ProjectReference Include="..\..\src\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <!-- Vision pour DeckleVisionSourceTests (heartbeat capture). Tire
         WindowsAppSDK + Composition transitively. -->
    <ProjectReference Include="..\..\src\Deckle.Vision\Deckle.Vision.csproj" />
    <!-- Shell pour DispatcherQueueExtensionsTests (régression sur la
         garde anti-récursion _emittingMarshal). Tire WindowsAppSDK pour
         DispatcherQueue / DispatcherQueueController.CreateOnDedicatedThread. -->
    <ProjectReference Include="..\..\src\Deckle.Shell\Deckle.Shell.csproj" />
    <!-- Hud pour ProximityRollupAggregatorTests (unit) et
         DeckleHudSourceTests (observability — signature ProximityRollup
         post-bascule per-session). Tire WindowsAppSDK + Composition
         transitively comme Vision. -->
    <ProjectReference Include="..\..\src\Deckle.Hud\Deckle.Hud.csproj" />
    <!-- Lighting.Ambient pour la régression EventStream Hue
         faux-external-stop + observability DeckleAmbientSource. -->
    <ProjectReference Include="..\..\src\Deckle.Lighting.Ambient\Deckle.Lighting.Ambient.csproj" />
  </ItemGroup>
</Project>
