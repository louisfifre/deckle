  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Deckle.App\Assets\Sounds\speech.wav"
             Link="Assets\Sounds\speech.wav"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
