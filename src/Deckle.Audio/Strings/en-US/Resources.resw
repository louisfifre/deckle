  <!-- The check's detail line (Loc.Format from RecordingViewModel), one key per
       side of the voice level: {0} raw dBFS, {1} processed dBFS, {2} the margin
       of the loudest tenth of the 50 ms frames, in whole dB, always positive.
       Mirrored in Deckle.App's Resources.resw. -->
  <data name="RecordingPageMicResultAbove_Format" xml:space="preserve">
    <value>{0} dBFS → {1} dBFS · loudest tenth {2} dB above your voice level</value>
  </data>
  <data name="RecordingPageMicResultBelow_Format" xml:space="preserve">
    <value>{0} dBFS → {1} dBFS · loudest tenth {2} dB below your voice level</value>
  </data>

