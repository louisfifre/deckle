<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Audio.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Audio">

    <!-- Same canvas pattern as GeneralPage / DiagnosticsPage / WhisperPage:
         Grid wrapper + StackPanel MaxWidth=1000 + SettingsCardSpacing=4 +
         section headers in BodyStrong + Margin 1,30,0,6. Page extracted
         from GeneralPage in slice S3 ; auto-paste + overlay HUD were
         moved back to GeneralPage (Behaviour section) in pass2. What's
         left here is the capture pipeline itself : microphone device
         and voice level window calibration. -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock x:Uid="RecordingPageTitleLabel"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,8" />

                <TextBlock x:Uid="RecordingPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="RecordingPageSectionHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="ResetRecordingLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetRecording_Click" />
                </Grid>

                <controls:SettingsCard x:Name="AudioInputCard"
                                       x:Uid="GeneralMicrophoneCard"
                                       Tag="GeneralMicrophoneCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Microphone}}">
                    <ComboBox x:Name="AudioInputCombo"
                              MinWidth="240"
                              SelectionChanged="AudioInputCombo_SelectionChanged" />
                </controls:SettingsCard>

                <!-- Transcription pre-processing — the DSP black box. Single
                     opt-in toggle ; the fine parameters live in the Playground.
                     The description carries the deferred-activation contract
                     (enabled now, active after a few measured recordings).

                     Composed region — the lone composable card on this page.
                     RecordingPage.ComposePreprocessingSection() declares it as a
                     SettingDescriptor (RecordingViewModel.Settings.cs) and the
                     composer builds the SettingsCard into this host. It sits
                     between two bespoke cards (the microphone ComboBox above, the
                     mic-check button below), so the host holds just this one
                     toggle — composed and hand-authored cards interleave freely
                     in the same StackPanel. -->
                <StackPanel x:Name="PreprocessingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Microphone level check — the indicator. Speak a few seconds;
                     Deckle reads the level, projects where the DSP would land it,
                     and advises whether turning the toggle on is worth it. No
                     transcription, no auto-decision — the user decides. The
                     button self-disables while measuring (AsyncRelayCommand);
                     the InfoBars toggle on plain bool flags (InfoBar.IsOpen), so
                     no value converter is involved. -->
                <controls:SettingsCard x:Name="MicCheckCard"
                                       x:Uid="RecordingPageMicCheckCard"
                                       Tag="RecordingPageMicCheckCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.VoiceLevel}}">
                    <Button x:Uid="RecordingPageMicCheckButton"
                            MinWidth="120"
                            Command="{x:Bind ViewModel.MeasureMicCommand}" />
                </controls:SettingsCard>

                <InfoBar x:Uid="RecordingPageMicCheckListening"
                         IsClosable="False"
                         Severity="Informational"
                         IsOpen="{x:Bind ViewModel.IsMeasuringMic, Mode=OneWay}">
                    <InfoBar.Content>
                        <ProgressRing IsActive="True" Width="20" Height="20"
                                      HorizontalAlignment="Left" Margin="0,0,0,12" />
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar x:Uid="RecordingPageMicAdviceRecommended"
                         IsClosable="False" Severity="Success"
                         IsOpen="{x:Bind ViewModel.AdviceRecommended, Mode=OneWay}"
                         Message="{x:Bind ViewModel.MicResultDetail, Mode=OneWay}" />
                <InfoBar x:Uid="RecordingPageMicAdviceMarginal"
                         IsClosable="False" Severity="Warning"
                         IsOpen="{x:Bind ViewModel.AdviceMarginal, Mode=OneWay}"
                         Message="{x:Bind ViewModel.MicResultDetail, Mode=OneWay}" />
                <InfoBar x:Uid="RecordingPageMicAdviceNotNeeded"
                         IsClosable="False" Severity="Informational"
                         IsOpen="{x:Bind ViewModel.AdviceNotNeeded, Mode=OneWay}"
                         Message="{x:Bind ViewModel.MicResultDetail, Mode=OneWay}" />
                <InfoBar x:Uid="RecordingPageMicAdviceError"
                         IsClosable="False" Severity="Error"
                         IsOpen="{x:Bind ViewModel.AdviceError, Mode=OneWay}" />

                <!-- Voice level window — the calibration group, composed. The
                     master toggle is "set the window manually": ON reveals the
                     three sliders, OFF re-enables auto-calibration and the Group
                     hides them. RecordingPage.ComposeVoiceLevelSection() declares
                     it as a Group SettingDescriptor (RecordingViewModel.Settings.cs)
                     with master selectors projecting the inverse of
                     LevelWindowAutoCalibration; the sliders push live into
                     AudioLevelMapper via the VM setters' SettingsHost.ApplyLevelWindow. -->
                <StackPanel x:Name="VoiceLevelHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Diagnostics — the microphone-telemetry opt-in, relocated here from
                     the shared Diagnostics page because it observes this module's
                     capture pipeline. A privacy opt-in, so this section carries NO
                     section-reset link (it is never reset from here).
                     RecordingPage.ComposeTelemetrySection() declares the toggle as a
                     SettingDescriptor (RecordingViewModel.Settings.cs) and the composer
                     builds the SettingsCard into this host. -->
                <TextBlock x:Uid="RecordingPageTelemetryHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                <StackPanel x:Name="TelemetryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
