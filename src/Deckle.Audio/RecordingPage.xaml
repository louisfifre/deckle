<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Audio.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Audio">

    <!-- Same canvas pattern as GeneralPage / DiagnosticsPage / WhisperPage:
         Grid wrapper + StackPanel MaxWidth=1000 + SettingsCardSpacing=4 +
         section headers in BodyStrong + Margin 1,30,0,6. -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <!-- Listening-test strengths, passed as CommandParameter: typed doubles
             so RelayCommand<double> receives a boxed double, not a string. -->
        <x:Double x:Key="ListeningStrengthOff">0</x:Double>
        <x:Double x:Key="ListeningStrengthQuarter">0.25</x:Double>
        <x:Double x:Key="ListeningStrengthThreeQuarters">0.75</x:Double>
        <x:Double x:Key="ListeningStrengthFull">1</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock x:Uid="RecordingPageTitleLabel"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,8" />

                <TextBlock x:Uid="RecordingPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="RecordingPageSectionHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="ResetRecordingLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetRecording_Click" />
                </Grid>

                <controls:SettingsCard x:Name="AudioInputCard"
                                       x:Uid="GeneralMicrophoneCard"
                                       Tag="GeneralMicrophoneCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Microphone}}">
                    <ComboBox x:Name="AudioInputCombo"
                              MinWidth="240"
                              SelectionChanged="AudioInputCombo_SelectionChanged" />
                </controls:SettingsCard>

                <!-- Maximum recording length — composed ComboBox, declared in
                     RecordingViewModel.Settings.cs; it sits under the microphone
                     because both shape every take. -->
                <StackPanel x:Name="RecordingLimitHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Transcription pre-processing — the DSP black box, a single
                     composed opt-in toggle. Each composed region gets its own
                     host, so composed and hand-authored cards interleave freely
                     in the same StackPanel. -->
                <StackPanel x:Name="PreprocessingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Microphone level check — the indicator. Deckle reads the
                     level, projects where the DSP would land it, and advises
                     whether turning the toggle on is worth it; the user decides.
                     The InfoBars toggle on plain bool flags (InfoBar.IsOpen), so
                     no value converter is involved. -->
                <controls:SettingsCard x:Name="MicCheckCard"
                                       x:Uid="RecordingPageMicCheckCard"
                                       Tag="RecordingPageMicCheckCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.VoiceLevel}}">
                    <Button x:Uid="RecordingPageMicCheckButton"
                            MinWidth="120"
                            Command="{x:Bind ViewModel.MeasureMicCommand}" />
                </controls:SettingsCard>

                <InfoBar x:Uid="RecordingPageMicCheckListening"
                         IsClosable="False"
                         Severity="Informational"
                         IsOpen="{x:Bind ViewModel.IsMeasuringMic, Mode=OneWay}">
                    <InfoBar.Content>
                        <ProgressRing IsActive="True" Width="20" Height="20"
                                      HorizontalAlignment="Left" Margin="0,0,0,12" />
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar x:Uid="RecordingPageMicAdviceRecommended"
                         IsClosable="False" Severity="Success"
                         IsOpen="{x:Bind ViewModel.AdviceRecommended, Mode=OneWay}"
                         Message="{x:Bind ViewModel.MicResultDetail, Mode=OneWay}" />
                <InfoBar x:Uid="RecordingPageMicAdviceMarginal"
                         IsClosable="False" Severity="Warning"
                         IsOpen="{x:Bind ViewModel.AdviceMarginal, Mode=OneWay}"
                         Message="{x:Bind ViewModel.MicResultDetail, Mode=OneWay}" />
                <InfoBar x:Uid="RecordingPageMicAdviceNotNeeded"
                         IsClosable="False" Severity="Informational"
                         IsOpen="{x:Bind ViewModel.AdviceNotNeeded, Mode=OneWay}"
                         Message="{x:Bind ViewModel.MicResultDetail, Mode=OneWay}" />
                <InfoBar x:Uid="RecordingPageMicAdviceError"
                         IsClosable="False" Severity="Error"
                         IsOpen="{x:Bind ViewModel.AdviceError, Mode=OneWay}" />

                <!-- Listening test — hear the pre-processing. Record a take once
                     (ListeningTester.TakeSeconds), then play it back on the default
                     output device in four variants. Nothing saved, nothing
                     transcribed. The playback card stays collapsed until a take
                     exists (bool → Visibility, implicit in x:Bind). -->
                <controls:SettingsCard x:Name="ListeningTestCard"
                                       x:Uid="RecordingPageListeningTestCard"
                                       Tag="RecordingPageListeningTestCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Transport.Play}}">
                    <Button x:Uid="RecordingPageListeningRecordButton"
                            MinWidth="120"
                            Command="{x:Bind ViewModel.RecordListeningTakeCommand}" />
                </controls:SettingsCard>

                <InfoBar x:Uid="RecordingPageListeningRecording"
                         IsClosable="False"
                         Severity="Informational"
                         IsOpen="{x:Bind ViewModel.IsRecordingListeningTake, Mode=OneWay}">
                    <InfoBar.Content>
                        <ProgressRing IsActive="True" Width="20" Height="20"
                                      HorizontalAlignment="Left" Margin="0,0,0,12" />
                    </InfoBar.Content>
                </InfoBar>

                <controls:SettingsCard x:Name="ListeningPlaybackCard"
                                       x:Uid="RecordingPageListeningPlaybackCard"
                                       Tag="RecordingPageListeningPlaybackCard"
                                       Visibility="{x:Bind ViewModel.HasListeningTake, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="RecordingPageListeningPlayOff"
                                Command="{x:Bind ViewModel.PlayListeningVariantCommand}"
                                CommandParameter="{StaticResource ListeningStrengthOff}" />
                        <Button x:Uid="RecordingPageListeningPlay25"
                                Command="{x:Bind ViewModel.PlayListeningVariantCommand}"
                                CommandParameter="{StaticResource ListeningStrengthQuarter}" />
                        <Button x:Uid="RecordingPageListeningPlay75"
                                Command="{x:Bind ViewModel.PlayListeningVariantCommand}"
                                CommandParameter="{StaticResource ListeningStrengthThreeQuarters}" />
                        <Button x:Uid="RecordingPageListeningPlayOn"
                                Command="{x:Bind ViewModel.PlayListeningVariantCommand}"
                                CommandParameter="{StaticResource ListeningStrengthFull}" />
                    </StackPanel>
                </controls:SettingsCard>

                <InfoBar x:Uid="RecordingPageListeningError"
                         IsClosable="False"
                         Severity="Error"
                         IsOpen="{x:Bind ViewModel.ListeningTestFailed, Mode=OneWay}" />

                <!-- Voice level window — the calibration group, composed. The
                     master toggle is "set the window manually": ON reveals the
                     three sliders, OFF re-enables auto-calibration and the Group
                     hides them, so the master projects the inverse of
                     LevelWindowAutoCalibration (RecordingViewModel.Settings.cs).
                     The VM setters push the sliders live into AudioLevelMapper. -->
                <StackPanel x:Name="VoiceLevelHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Diagnostics — the microphone-telemetry opt-in, composed. A
                     privacy opt-in, so this section carries NO section-reset link
                     (it is never reset from here). -->
                <TextBlock x:Uid="RecordingPageTelemetryHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                <StackPanel x:Name="TelemetryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
