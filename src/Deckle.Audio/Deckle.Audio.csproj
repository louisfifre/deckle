<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Audio</RootNamespace>
    <!-- WinUI XAML compilation: the module owns both the audio domain and its
         settings page (RecordingPage). -->
    <UseWinUI>true</UseWinUI>
    <!-- Neutral language for the lib's PRI fallback. Mirrors Deckle.App.csproj. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in RecordingPage resolve
         against the Deckle.Audio/Resources subtree (Strings/en-US/Resources.resw). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output and must
         match the ETW manifest. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- Telemetry POCOs: the microphone-telemetry opt-in reads/writes
         TelemetrySettings via TelemetrySettingsService. No cycle — Diagnostics.Telemetry
         does not reference Audio. -->
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <!-- Shell: RecordingPage uses the instrumented DispatcherQueue.TryEnqueueObserved
         wrapper. One-way (Shell does not reference Audio), so no cycle. -->
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
  </ItemGroup>
</Project>
