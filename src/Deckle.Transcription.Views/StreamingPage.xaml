<Page
    x:Class="Deckle.Transcription.Views.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The Streaming page of the Transcription module, graph first
         (2026-11-07): the pipeline switch alone at the top, then segmentation,
         which is the cut curve (its corners drag the ramp and the waits, its
         pause strip the cut margin and the minimum speech), then, under it, the
         one fold of the guards against text from silence and noise: the Silero
         trim with its three parameters and Whisper's no-speech cut-off,
         collapsed (2026-11-07 review, changes 6 and 7). Everything shows
         whatever the switch says: it picks only the dictation pipeline, while
         files and recovered takes are always cut and trimmed with these
         settings. Every card is composed from WhisperViewModel's manifests. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb (Transcription › Streaming),
                     one line of description, Reset all (active-when-dirty, confirmed
                     by the block). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="StreamingPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The pipeline switch, first and alone. Composed:
                     WhisperViewModel.StreamingSwitch. -->
                <StackPanel x:Name="SwitchHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Segmentation ────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="StreamingPageSegmentationSection">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <!-- The cut curve, compact: the plot with its sentence
                             under it, the four hangover anchors and the control
                             points beside it (under it on a narrow page), then
                             the pause view in a frame of its own with its two
                             durations (WhisperViewModel.SegmentationSettings). -->
                        <StackPanel x:Name="SegmentationHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />

                        <!-- The guards against text from silence and noise, one
                             fold with no master, collapsed: the Silero trim (its
                             switch, then its three parameters while it is on) and
                             the no-speech cut-off, which left the Decoding page
                             (WhisperViewModel.SilenceGuardSettings). In this
                             section, under the curve, as the review's target
                             page draws it: they act on the utterances the cut
                             produces. -->
                        <StackPanel x:Name="SilenceGuardsHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                    </StackPanel>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
