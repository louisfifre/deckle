<Page
    x:Class="Deckle.Transcription.Views.LexiconPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Deckle.Transcription.Views"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The Lexicon page of the Dictation node: the person's own words
         and the switch of the boost (TranscriptionViewModel.Lexicon.cs). No Reset all:
         the words are the person's data, and the switch has its own reset. Words
         are added one at a time, like the excluded words of the Autocorrect
         page, so a list never costs a multi-line field. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="LexiconPageHeader"
                                            HasResetAll="False" />

                <StackPanel x:Name="BoostHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <controls:SettingsCard x:Uid="LexiconAddCard"
                                       Tag="LexiconAddCard">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBox x:Name="WordBox"
                                 x:Uid="LexiconWordBox"
                                 Width="200"
                                 Text="{x:Bind ViewModel.NewLexiconWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="WordBox_KeyDown" />
                        <Button x:Uid="LexiconAddButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.AddLexiconWordCommand}" />
                    </StackPanel>
                </controls:SettingsCard>

                <ItemsControl ItemsSource="{x:Bind ViewModel.LexiconWords}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>
                            </StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LexiconWordRow">
                            <controls:SettingsCard Header="{x:Bind Word}">
                                <Button x:Uid="LexiconRemoveButton"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName}"
                                        Command="{x:Bind RemoveCommand}">
                                    <FontIcon Glyph="{StaticResource Icon.Delete}"
                                              FontSize="16" />
                                </Button>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
