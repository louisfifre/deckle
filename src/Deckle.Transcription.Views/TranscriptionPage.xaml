<Page
    x:Class="Deckle.Transcription.Views.TranscriptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <Grid Background="Transparent"
          Tapped="OnBackgroundTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Padding="32,24,32,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="1000"
                            HorizontalAlignment="Stretch"
                            Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty). The header
                     asks; the page adds its ResetDetail in the constructor. -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="TranscriptionPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <InfoBar x:Name="SetupInfoBar"
                         x:Uid="TranscriptionSetupInfoBar"
                         IsClosable="False"
                         IsOpen="False"
                         Margin="0,0,0,8"
                         catalog:InfoBarLayout.CollapseWhenClosed="True">
                    <InfoBar.ActionButton>
                        <Button x:Uid="TranscriptionSetupButton"
                                Click="OnSetupClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ── While you speak ──────────────────────────────────────────
                     What happens during a take, in order: the streaming switch
                     (composed, first and outside every reset: on or off is the
                     person's choice, not a value), the overlay fold (the
                     on-screen HUD, composed from
                     TranscriptionViewModel.BehaviourSettings) and the maximum
                     recording length (composed from RecordingLimitSettings,
                     stored in the capture settings). The section's reset spans
                     the overlay and the length, gated active-when-dirty. -->
                <catalog:SettingsSection x:Name="WhileYouSpeakSection"
                                         x:Uid="TranscriptionPageWhileYouSpeakSection"
                                         HasReset="True"
                                         ResetRequested="ResetWhileYouSpeak_Click">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <StackPanel x:Name="StreamingSwitchHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                        <StackPanel x:Name="BehaviourHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                        <StackPanel x:Name="RecordingLimitHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                    </StackPanel>
                </catalog:SettingsSection>

                <!-- ── Transcription ───────────────────────────────────────── -->
                <!--
                    Order : Speech engine → Models folder → GPU acceleration.
                    The two cards with a chevron lead, since a chevron sits
                    above the plain cards: the engine fold, then the models
                    folder, a folder fold (a standalone Path renders as one).
                    The GPU switch closes the section because it requires a
                    restart. No section reset: the three hosts are separate
                    composers, so no single dirtiness could gate one.
                -->
                <catalog:SettingsSection x:Uid="TranscriptionPageModelEngineSection">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Speech engine — composed. The fold holds what the engine
                     reads: its model folder with the state of the files, and the
                     encoder precision. -->
                <StackPanel x:Name="SpeechEngineHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Models folder — composed. The folder fold (its title and
                     sentence in the header, the Location line inside with the
                     typeable path field, "Choose a folder" and "Open", and its
                     own reset) is built by ComposeSettings() into this host,
                     with FolderPickerMode.Editable and the AppPaths fallback
                     carried in PathArgs. -->
                <StackPanel x:Name="ModelsDirectoryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- GPU acceleration — composed. The lone toggle (and its per-card
                     reset) is built by ComposeUseGpuSection() into this host; the VM's
                     UseGpu property is the same one the restart footer watches, so
                     flipping the composed toggle still trips the footer. -->
                <StackPanel x:Name="UseGpuHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />
                </StackPanel>
                </catalog:SettingsSection>

                <!-- ── Segmentation ─────────────────────────────────────────────
                     Developer mode only: the page shows it when it is navigated
                     to with developer mode on, and Reset all counts its values
                     only then. The cut curve (its corners drag the ramp and the
                     waits, its pause strip the cut margin and the minimum
                     speech), then the Silero trim fold, which applies to every
                     recording, whatever the streaming switch says.
                     TranscriptionViewModel.SegmentationSettings and
                     SilenceGuardSettings. -->
                <catalog:SettingsSection x:Name="SegmentationSection"
                                         x:Uid="TranscriptionPageSegmentationSection"
                                         Visibility="Collapsed">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <StackPanel x:Name="SegmentationHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                        <StackPanel x:Name="SilenceGuardsHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                    </StackPanel>
                </catalog:SettingsSection>

                <!-- The lexicon lives on its own page, LexiconPage, and the
                     microphone on the Microphone page (RecordingPage), both nested
                     under this module in the rail. The dictation's dataset
                     consents (latency, audio corpus) live on Settings >
                     Diagnostics, the one editor of what Deckle records
                     (TranscriptionTelemetryViewModel, 2026-10-14). -->

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Restart footer: Windows Terminal Settings pattern.
             56px high, DividerStrokeColorDefaultBrush as separator,
             primary AccentButton + standard Button, 8px gap, 32px right margin. -->
        <Grid x:Name="RestartFooter"
              Grid.Row="1"
              Height="56"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Margin="0,0,32,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Uid="TranscriptionRestartDiscard"
                        Click="RestartDiscard_Click" />
                <Button x:Uid="TranscriptionRestartNow"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="RestartNow_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
