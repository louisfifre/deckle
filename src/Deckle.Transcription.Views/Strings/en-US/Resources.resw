  <!-- The cut curve: the card shows no header or description of its own; the
       sentence that reads the current values (TranscriptionViewModel.CutCurveSentence)
       sits under the plot, and Header is the editor's accessible name;
       the four anchor entries are the legend fields under the plot, their
       Header the field's caption (and, joined two by two, the accessible name
       of the curve's corner handles) and their Description its tooltip. -->
  <data name="TranscriptionCutCurveCard.Header" xml:space="preserve">
    <value>Pause before cutting</value>
  </data>
  <!-- {0} the maximum wait, {1} the ramp start, {2} the minimum wait, {3} the
