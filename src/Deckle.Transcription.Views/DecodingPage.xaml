<Page
    x:Class="Deckle.Transcription.Views.DecodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The Decoding page of the Transcription module: what applies to every
         recording whatever the pipeline. Today that is the one collapsed fold
         of the guards against text from silence and noise (the Silero trim).
         Composed from WhisperViewModel's manifest into a host; the page only
         hosts. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb (Transcription › Decoding),
                     one line of description, Reset all (active-when-dirty, confirmed
                     by the block). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="DecodingPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- ── Silence and noise filtering ─────────────────────────
                     One fold with no master, collapsed: the Silero trim (its
                     switch, then its three parameters while it is on). Here
                     because it applies to every recording, whatever the
                     pipeline (WhisperViewModel.SilenceGuardSettings). -->
                <StackPanel x:Name="SilenceGuardsHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
