<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Setup.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">

            <controls:SettingsCard x:Uid="SetupFoldersAppCard"
                                   HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Folder}}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="AppPathText"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300" />
                    <Button x:Name="BrowseAppButton"
                            Click="OnBrowseAppClick" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="SetupFoldersDataCard"
                                   HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Folder}}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="DataPathText"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300" />
                    <Button x:Name="BrowseDataButton"
                            Click="OnBrowseDataClick" />
                </StackPanel>
            </controls:SettingsCard>

            <InfoBar x:Name="SpaceBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational" />

        </StackPanel>
    </ScrollViewer>
</Page>
