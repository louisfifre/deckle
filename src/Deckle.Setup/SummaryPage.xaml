<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Setup.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The window scrolls the page, so a long list of failed items stays
         reachable, and holds the total below it. -->
    <StackPanel Spacing="20">

        <InfoBar x:Name="ResultBar"
                 IsOpen="True"
                 IsClosable="False" />

        <StackPanel x:Name="ItemsPanel"
                    Spacing="8" />

        <HyperlinkButton x:Name="OpenDiagnosticsLink"
                         Visibility="Collapsed"
                         Click="OnOpenDiagnosticsClick" />

    </StackPanel>
</Page>
