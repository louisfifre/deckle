<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Deckle.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Deckle Setup">

    <!-- Mica backdrop is set in code-behind. The root Grid stays
         transparent so DWM applies Mica through the window. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- TitleBar -->
            <RowDefinition Height="*" />     <!-- Step rail + right-hand panel -->
        </Grid.RowDefinitions>

        <!-- Same TitleBar as the Settings window, minus its commands: the wizard
             has no search and no pane toggle. ExtendsContentIntoTitleBar, SetTitleBar
             and the Tall height are set in code-behind. -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="SetupTitleBar" />

        <!-- The step rail. The pane is always open and carries no toggle, back
             button, settings entry or search: its items are filled in code from the
             steps the flow actually goes through (RefreshStepRail), and the
             window, not the user, decides which of them can be invoked. -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="220"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnStepSelectionChanged">

            <!-- The right-hand panel: step header, page Frame, footer. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Step header -->
                    <RowDefinition Height="*" />     <!-- Page Frame -->
                    <RowDefinition Height="Auto" />  <!-- Footer -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="40,16,40,16" Spacing="6">
                    <TextBlock x:Name="StepTitle"
                               Text="Setup"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="StepSubtitle"
                               Text=""
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Frame x:Name="ContentFrame"
                       Grid.Row="1"
                       Padding="40,8,40,16" />

                <Grid Grid.Row="2" Padding="40,16,40,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            x:Uid="SetupCancelButton"
                            Grid.Column="0"
                            Click="OnCancelClick" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="BackButton"
                                x:Uid="SetupBackButton"
                                Click="OnBackClick"
                                IsEnabled="False" />
                        <Button x:Name="NextButton"
                                x:Uid="SetupNextButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnNextClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
