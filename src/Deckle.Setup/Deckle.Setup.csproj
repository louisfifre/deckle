<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Setup</RootNamespace>
    <!-- WinUI XAML compilation : Deckle.Setup hosts the first-run wizard
         (SetupWindow + ChoicesPage / InstallingPage / SummaryPage). Extracted
         from Deckle.App/Shell/Setup/ to break the App-side coupling — the
         wizard now only sees Deckle.Transcription's setup primitives and
         Deckle.Catalog/Logging/Core, not the full host. -->
    <UseWinUI>true</UseWinUI>
    <!-- Neutral language for the lib's PRI fallback. Mirrors Deckle.csproj. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in the wizard pages
         resolve against the Deckle.Setup/Resources subtree. The resw under
         Strings/en-US/ is a copy of the App's resw — same pattern as
         Deckle.Settings + Deckle.Llm + Deckle.Transcription. -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions aligned on Deckle.App.csproj. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- Presence catalogue — the module selector (ModulesPage) reads the
         registry and records the choice through ModulePresence. -->
    <ProjectReference Include="..\Deckle.Modules\Deckle.Modules.csproj" />
    <!-- Windows-integration primitives shared with the download stub — the
         install-mode pages (Folders/Deploy) place the app, register it in
         Installed apps, and write DECKLE_DATA_ROOT through them. -->
    <ProjectReference Include="..\Deckle.Install\Deckle.Install.csproj" />
    <!-- Per-module provisioning primitives the install plan composes:
         the VAD model identity, the CamemBERT asset catalog, and the pinned
         anytype-cli bundle — each beside the backend it serves. -->
    <ProjectReference Include="..\Deckle.Vad\Deckle.Vad.csproj" />
    <ProjectReference Include="..\Deckle.Autocorrect.Mlm\Deckle.Autocorrect.Mlm.csproj" />
    <ProjectReference Include="..\Deckle.Anytype\Deckle.Anytype.csproj" />
    <!-- Transcription parent owns the wizard-agnostic primitives (ModelEntry,
         Downloader) and the EventSource provider. -->
    <ProjectReference Include="..\Deckle.Transcription\Deckle.Transcription.csproj" />
    <!-- Whisper-specific catalogs (SpeechModels) and the libwhisper native
         runtime descriptor migrated to the child module — Setup consumes
         both directly to drive the wizard pages. -->
    <ProjectReference Include="..\Deckle.Transcription.Whisper\Deckle.Transcription.Whisper.csproj" />
  </ItemGroup>
</Project>
