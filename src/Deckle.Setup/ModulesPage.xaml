<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Setup.ModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Applied to the cost text of the cards built in code: a ThemeResource
             inside a Style follows light/dark live, which a brush read from the
             resource dictionary in code would not. -->
        <Style x:Key="ModuleCostTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">

            <!-- One SettingsCard per catalogue module, built in code from
                 ModuleRegistry (BuildModuleCards) — the list is data, not layout. -->
            <StackPanel x:Name="ModulesList" Spacing="4" />

            <InfoBar x:Name="TotalEstimateBar"
                     x:Uid="SetupTotalEstimateBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational" />

        </StackPanel>
    </ScrollViewer>
</Page>
