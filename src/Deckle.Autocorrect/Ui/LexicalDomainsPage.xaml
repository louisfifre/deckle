<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Autocorrect.LexicalDomainsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Deckle.Autocorrect"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Child page of the Autocorrect family. While the master switch is off the
         domain section is collapsed and one line says why: the door on the
         parent page and the rail entry stay, so the page must answer for itself.
         No SettingsSection block: the page carries a single section and its tabs
         name it, so a title would add nothing. -->

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- No Reset all: the page holds only per-language switches over a
                     shipped catalogue, with no page-level default to return to. -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="LexicalDomainsPageHeader"
                                            HasResetAll="False" />

                <TextBlock x:Name="DisabledNotice"
                           x:Uid="LexicalDomainsPage_Disabled"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- ── Domains ───────────────────────────────────────────────── -->
                <!-- Tag is the search index's scroll-to handle for this bespoke
                     section; it matches the SettingSearchEntry's LabelKey. -->
                <StackPanel x:Name="DomainsSection"
                            Tag="LexicalDomainsPage_Section_Domains"
                            Spacing="{StaticResource SettingsCardSpacing}">

                    <!-- Peer views, not a filter. Selection follows keyboard focus,
                         the control's own behaviour, which is why the first domain
                         is selected on load. No header above it: a "Categories"
                         line would be a third title level. -->
                    <SelectorBar x:Name="DomainSelector"
                                 Margin="0,4,0,12"
                                 SelectionChanged="OnDomainChanged" />

                    <TextBlock Text="{x:Bind ViewModel.SelectedDomain.Description, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <!-- Bespoke rather than composed: the rows are enumerated from
                         DomainPack.Shipped and each carries its own term count,
                         which no composer kind models. -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedDomain.Languages, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DomainLanguageRow">
                                <controls:SettingsCard Header="{x:Bind Label}">
                                    <ToggleSwitch IsOn="{x:Bind Active, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What the domain ships against what fabrication turned away,
                         in plain prose on purpose: no InfoBar, no severity ladder. -->
                    <TextBlock Text="{x:Bind ViewModel.SelectedDomain.Indications, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.SelectedDomain.IndicationsVisibility, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
