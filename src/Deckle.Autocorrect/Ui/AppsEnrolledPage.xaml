<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Autocorrect.AppsEnrolledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Deckle.Autocorrect"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Child page of the Autocorrect family: where correction is allowed to
         run, app by app. While the master switch is off the section is collapsed
         and one line says why: the door on the parent page and the rail entry
         stay, so the page must answer for itself. -->

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- No Reset all: the page is a list the user authors through their
                     answers, with nothing to restore. -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="AppsEnrolledPageHeader"
                                            HasResetAll="False" />

                <TextBlock x:Name="DisabledNotice"
                           x:Uid="AppsEnrolledPage_Disabled"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- Tag is the search index's scroll-to handle; it matches the
                     SettingSearchEntry's LabelKey. It sits on the section block
                     itself so hiding it hides the title with the cards. -->
                <catalog:SettingsSection x:Name="AppsSection"
                                         x:Uid="AppsEnrolledPageAppsSection"
                                         Tag="AppsEnrolledPage_Section_Apps">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                        <!-- Trades places with the list from code-behind, off
                             Apps.CollectionChanged. -->
                        <TextBlock x:Name="EmptyState"
                                   x:Uid="AppsEnrolledPage_Empty"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <!-- Bespoke, not composed: a live, runtime-enumerated list
                             of cards, which no composer kind models. -->
                        <ItemsControl x:Name="AppsList"
                                      ItemsSource="{x:Bind ViewModel.Apps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4">
                                        <StackPanel.ChildrenTransitions>
                                            <TransitionCollection>
                                                <AddDeleteThemeTransition />
                                            </TransitionCollection>
                                        </StackPanel.ChildrenTransitions>
                                    </StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutocorrectAppRow">
                                    <controls:SettingsCard Header="{x:Bind DisplayName}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            <Button x:Uid="AppsEnrolledPage_ForgetButton"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Command="{x:Bind ForgetCommand}">
                                                <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                          FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
