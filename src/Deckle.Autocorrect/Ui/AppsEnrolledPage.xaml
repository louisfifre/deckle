<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Autocorrect.AppsEnrolledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Deckle.Autocorrect">

    <!-- Child page of the Autocorrect family: where correction is allowed to
         run, app by app. Same canonical Settings layout as its parent and its
         sibling — ScrollViewer Padding 32,24, StackPanel max 1000 inside a Grid,
         Spacing=4, section headers in BodyStrong. The section is collapsed while
         the master switch is off (mask-never-grey) and one line says why — the
         door on the parent page and the rail entry stay, so the page must answer
         for itself when nothing behind them applies. -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock x:Uid="AppsEnrolledPage_Title"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,8" />

                <TextBlock x:Uid="AppsEnrolledPage_Subtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- Shown in place of the whole section while autocorrect is off:
                     one inline channel, the wording carries the tone. -->
                <TextBlock x:Name="DisabledNotice"
                           x:Uid="AppsEnrolledPage_Disabled"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- Tag is the search index's scroll-to handle for this bespoke
                     section (composed cards get theirs from the composer); it
                     matches the SettingSearchEntry's LabelKey. -->
                <StackPanel x:Name="AppsSection"
                            Tag="AppsEnrolledPage_Section_Apps"
                            Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock x:Uid="AppsEnrolledPage_Section_Apps"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <TextBlock x:Uid="AppsEnrolledPage_Apps_Body"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <!-- Shown only when no app has been decided on yet ; the list
                         and this line trade places from code-behind off
                         Apps.CollectionChanged. -->
                    <TextBlock x:Name="EmptyState"
                               x:Uid="AppsEnrolledPage_Empty"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <!-- Bespoke, not composed: the per-app list is a live,
                         runtime-enumerated collection of cards with add/remove/
                         forget gestures — no composer kind models that. -->
                    <ItemsControl x:Name="AppsList"
                                  ItemsSource="{x:Bind ViewModel.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>
                                </StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutocorrectAppRow">
                                <controls:SettingsCard Header="{x:Bind DisplayName}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                        <Button x:Uid="AppsEnrolledPage_ForgetButton"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{x:Bind ForgetCommand}">
                                            <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                      FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
