<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Autocorrect.AutocorrectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Autocorrect">

    <!-- Canonical Settings page layout, identical to TrackpadPage /
         AmbientPage : ScrollViewer Padding 32,24, a StackPanel max 1000 inside
         a Grid, Spacing=4 between cards, section headers in BodyStrong with
         Margin 1,30,0,6. The master switch is composed (declared in
         AutocorrectViewModel.Settings.cs, built into MasterHost by the
         SettingsComposer) ; below it, the apps the user has decided on — each a
         card with an on/off switch and a "forget" button. The whole Apps
         section is collapsed while the master is off (mask-never-grey). -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock x:Uid="AutocorrectPage_Title"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,8" />

                <TextBlock x:Uid="AutocorrectPage_Subtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Master switch ─────────────────────────────────────────── -->
                <!-- Composed region — the Enable-autocorrect master toggle,
                     declared in AutocorrectViewModel.Settings.cs and built into
                     this host by ComposeSettings(). It carries its own inline
                     reset off the POCO default. -->
                <StackPanel x:Name="MasterHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Apps ──────────────────────────────────────────────────── -->
                <!-- The whole per-app section — its header, body, and the
                     empty-state/list pair — is collapsed while the master is
                     off (mask-never-grey), driven from code-behind off the
                     Enabled PropertyChanged. When the master is on, the
                     empty-state and list trade places off Apps.Count, nested
                     under this gate. -->
                <!-- Tag is the search index's scroll-to handle for this bespoke
                     section (composed cards get theirs from the composer); it
                     matches the SettingSearchEntry's LabelKey. -->
                <StackPanel x:Name="AppsSection"
                            Tag="AutocorrectPage_Section_Apps"
                            Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock x:Uid="AutocorrectPage_Section_Apps"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <TextBlock x:Uid="AutocorrectPage_Apps_Body"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <!-- Shown only when no app has been decided on yet ; the list
                         and this line trade places from code-behind off
                         Apps.CollectionChanged. -->
                    <TextBlock x:Name="EmptyState"
                               x:Uid="AutocorrectPage_Empty"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <!-- Bespoke, not composed: the per-app list is a live,
                         runtime-enumerated collection of cards with add/remove/
                         forget gestures — no composer kind models that. -->
                    <ItemsControl x:Name="AppsList"
                                  ItemsSource="{x:Bind ViewModel.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>
                                </StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutocorrectAppRow">
                                <controls:SettingsCard Header="{x:Bind DisplayName}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                        <Button x:Uid="AutocorrectPage_ForgetButton"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{x:Bind ForgetCommand}">
                                            <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                      FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- ── Vocabulary packs ──────────────────────────────────────── -->
                <!-- Gated on the master switch like the Apps section above
                     (mask-never-grey): a pack only means something while
                     correction runs. Bespoke rather than composed — the rows are
                     enumerated from DomainPack.Shipped at Load(), and each will
                     grow its own dilution figures, which no composer kind
                     models. Tag is the search index's scroll-to handle. -->
                <StackPanel x:Name="PacksSection"
                            Tag="AutocorrectPage_Section_Packs"
                            Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock x:Uid="AutocorrectPage_Section_Packs"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <TextBlock x:Uid="AutocorrectPage_Packs_Body"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Packs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutocorrectPackRow">
                                <!-- The in-page fold the settings doctrine
                                     allows: the toggle stays on the header row,
                                     and what the pack brings against what
                                     sanitization refused sits one expand away.
                                     Every string is bound from the row rather
                                     than x:Uid — a DataTemplate is not a
                                     reliable x:Uid scope, and the rows already
                                     resolve their wording through Loc. -->
                                <controls:SettingsExpander Header="{x:Bind DisplayName}"
                                                           Description="{x:Bind Description}"
                                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Language}}">
                                    <ToggleSwitch IsOn="{x:Bind Active, Mode=TwoWay}" />
                                    <controls:SettingsExpander.Items>
                                        <controls:SettingsCard ContentAlignment="Left">
                                            <StackPanel Spacing="12"
                                                        Margin="0,4,0,4"
                                                        HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind DilutionSummary}"
                                                           Visibility="{x:Bind DilutionVisibility}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <!-- Open exactly while the pack
                                                     is active: the cost is real
                                                     only once the pack is
                                                     loaded, and warning about a
                                                     state the user is not in is
                                                     noise. -->
                                                <InfoBar Title="{x:Bind WarningTitle}"
                                                         Message="{x:Bind WarningMessage}"
                                                         IsOpen="{x:Bind Active, Mode=OneWay}"
                                                         IsClosable="False"
                                                         Severity="Informational" />
                                            </StackPanel>
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.Items>
                                </controls:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- ── Excluded words ────────────────────────────────────────── -->
                <!-- The settings mirror of the exclusion register: consultable
                     and reversible, one row per word. Gated on the master
                     switch like the sections above, and bespoke for the same
                     reason — a live collection with add and undo gestures. -->
                <StackPanel x:Name="ExclusionsSection"
                            Tag="AutocorrectPage_Section_Exclusions"
                            Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock x:Uid="AutocorrectPage_Section_Exclusions"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <TextBlock x:Uid="AutocorrectPage_Exclusions_Body"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <controls:SettingsCard x:Uid="AutocorrectPage_ExcludeCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Filter}}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBox x:Name="ExclusionBox"
                                     x:Uid="AutocorrectPage_ExclusionBox"
                                     Width="200"
                                     Text="{x:Bind ViewModel.NewExclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ExclusionBox_KeyDown" />
                            <Button x:Uid="AutocorrectPage_ExcludeButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ExcludeWordCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <TextBlock x:Name="ExclusionsEmptyState"
                               x:Uid="AutocorrectPage_Exclusions_Empty"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="ExclusionsList"
                                  ItemsSource="{x:Bind ViewModel.ExcludedWords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>
                                </StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutocorrectExcludedWordRow">
                                <controls:SettingsCard Header="{x:Bind Word}">
                                    <Button x:Uid="AutocorrectPage_IncludeButton"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{x:Bind IncludeCommand}">
                                        <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                  FontSize="16" />
                                    </Button>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- ── Diagnostics ───────────────────────────────────────────── -->
                <!-- The module's observability opt-ins, relocated here from the
                     shared Diagnostics page so they sit beside the engine they
                     observe: log-activity (a runtime filter, no consent) plus the
                     decisions and text telemetry opt-ins (each consent-gated,
                     independent). All three are COMPOSED — declared in
                     AutocorrectViewModel.Settings.cs (DiagnosticsSettings) and
                     built into DiagnosticsHost by the SettingsComposer. This
                     section is NOT gated by the master switch: it is always
                     visible, unlike the Apps section above. -->
                <TextBlock x:Uid="AutocorrectPageDiagnosticsHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <StackPanel x:Name="DiagnosticsHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
