<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Autocorrect.AutocorrectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Autocorrect"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="AutocorrectPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- ── Master switch ─────────────────────────────────────────── -->
                <StackPanel x:Name="MasterHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- The two child pages (Lexical domains, Apps enrolled) are
                     reached from the rail, which expands this module's node;
                     the drill-in cards that doubled them are gone (triage of
                     2026-10-14). -->

                <!-- ── Excluded words ────────────────────────────────────────── -->
                <!-- On the family's landing page: an exclusion crosses every domain
                     and every app, so it belongs to neither child. Collapsed while
                     the master is off (mask-never-grey). Bespoke: a live collection
                     with add and undo gestures no composer kind models. The Tag,
                     the search scroll-to handle, sits on the section block so
                     hiding it hides the title with the cards. -->
                <catalog:SettingsSection x:Name="ExclusionsSection"
                                         x:Uid="AutocorrectPageExclusionsSection"
                                         Tag="AutocorrectPage_Section_Exclusions">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                        <controls:SettingsCard x:Uid="AutocorrectPage_ExcludeCard"
                                               catalog:SettingsDescriptions.Toggled="True">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox x:Name="ExclusionBox"
                                         x:Uid="AutocorrectPage_ExclusionBox"
                                         Width="200"
                                         Text="{x:Bind ViewModel.NewExclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="ExclusionBox_KeyDown" />
                                <Button x:Uid="AutocorrectPage_ExcludeButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.ExcludeWordCommand}" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <TextBlock x:Name="ExclusionsEmptyState"
                                   x:Uid="AutocorrectPage_Exclusions_Empty"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />

                        <ItemsControl x:Name="ExclusionsList"
                                      ItemsSource="{x:Bind ViewModel.ExcludedWords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4">
                                        <StackPanel.ChildrenTransitions>
                                            <TransitionCollection>
                                                <AddDeleteThemeTransition />
                                            </TransitionCollection>
                                        </StackPanel.ChildrenTransitions>
                                    </StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutocorrectExcludedWordRow">
                                    <controls:SettingsCard Header="{x:Bind Word}">
                                        <Button x:Uid="AutocorrectPage_IncludeButton"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{x:Bind IncludeCommand}">
                                            <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                      FontSize="16" />
                                        </Button>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </catalog:SettingsSection>

                <!-- The module's two dataset consents live on Settings >
                     Diagnostics, the one editor of what Deckle records
                     (AutocorrectTelemetryViewModel, 2026-10-14). -->

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
