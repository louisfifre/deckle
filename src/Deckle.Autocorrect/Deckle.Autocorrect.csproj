<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Autocorrect</RootNamespace>
    <!-- WinUI XAML compilation for the module's own Settings pages, as a
         library with its own PRI. The live engine depends on none of this. -->
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Input\Deckle.Input.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- The page's Diagnostics section reads and writes the two telemetry
         opt-ins (TelemetrySettings). Neither Diagnostics project references
         Deckle.Autocorrect, so these refs add no cycle. -->
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Autocorrect.Tests" />
    <!-- The offline miner reuses the engine's physical-layout model (QwertyAdjacency). -->
    <InternalsVisibleTo Include="Deckle.Autocorrect.Lab" />
    <!-- The offline benchmark drives the internal keyboard seam and candidate observer. -->
    <InternalsVisibleTo Include="Deckle.Autocorrect.Probe" />
  </ItemGroup>

  <ItemGroup>
    <!-- Derived lexical artifacts (build-data output) ride next to the binary.
         This Content lands flat under "Data\" in THIS project's own output, but
         a consuming app gets it prefixed with the project name. Deckle.App
         flattens it back with its FlattenAutocorrectLexicons target so the
         engine finds it beside the exe. -->
    <Content Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output and must
         match the ETW manifest. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
