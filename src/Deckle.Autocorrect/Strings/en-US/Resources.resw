  <!-- ─── AutocorrectPage ────────────────────────────────────────────
       Settings page for the Autocorrect module. Title + subtitle, the
       master switch, then the list of apps the user has decided on.
       x:Uid keys follow AutocorrectPage_<Element>(.<Property>) — plain
       TextBlocks bind .Text, SettingsCards bind .Header / .Description. -->
  <data name="AutocorrectPage_Title.Text" xml:space="preserve">
    <value>Autocorrect</value>
  </data>
  <data name="AutocorrectPage_Subtitle.Text" xml:space="preserve">
    <value>Restore French accents and fix typos as you type. Autocorrect runs only in the apps you turn it on for — Deckle offers to enable it the first time a correction could help in a new app.</value>
  </data>

  <!-- Master switch -->
  <data name="AutocorrectPage_MasterCard.Header" xml:space="preserve">
    <value>Enable autocorrect</value>
  </data>
  <data name="AutocorrectPage_MasterCard.Description" xml:space="preserve">
    <value>Master switch. When off, no text is corrected in any app, whatever you've chosen below.</value>
  </data>

  <!-- Apps -->
  <data name="AutocorrectPage_Section_Apps.Text" xml:space="preserve">
    <value>Apps</value>
  </data>
  <data name="AutocorrectPage_Apps_Body.Text" xml:space="preserve">
    <value>The apps you've answered for. Turn correction on or off for each, or forget an app to be asked again the next time a correction could help there.</value>
  </data>
  <data name="AutocorrectPage_Empty.Text" xml:space="preserve">
    <value>No apps yet. Deckle will offer to turn autocorrect on the first time a correction could help in an app — your choices show up here.</value>
  </data>
  <data name="AutocorrectPage_ForgetButton.ToolTipService.ToolTip" xml:space="preserve">
    <value>Forget this app</value>
  </data>

  <!-- Vocabulary packs — the user-facing name for the domain packs of
       CONTEXT.md § Lexicon composition. "Domain" reads as a DNS domain next to
       a computing pack, so the interface says "vocabulary" throughout while the
       code keeps the model's term.
       The rows are built in code from DomainPack.Shipped, so these are resolved
       through Loc.GetFrom rather than x:Uid; the "<key>.Header"/".Description"
       shape still matches a SettingsCard's, one pair per shipped pack. -->
  <data name="AutocorrectPage_Section_Packs.Text" xml:space="preserve">
    <value>Vocabulary packs</value>
  </data>
  <data name="AutocorrectPage_Packs_Body.Text" xml:space="preserve">
    <value>Add a field's vocabulary to what Deckle knows. Its words stop being corrected, and become corrections in their own right. Turn on only the fields you write in — each pack you add makes correction a little less sure.</value>
  </data>
  <data name="AutocorrectPage_PackFrIt.Header" xml:space="preserve">
    <value>Computing</value>
  </data>
  <data name="AutocorrectPage_PackFrIt.Description" xml:space="preserve">
    <value>French terms from computing, the internet and programming.</value>
  </data>

  <!-- The dilution indicator, one per pack: what it brings against what
       fabrication refused to keep base corrections working. The counts come
       from the pack's shipped manifest, so they are formatted at runtime, and
       the strings are resolved by AutocorrectPackRow rather than x:Uid — a
       DataTemplate is not a reliable x:Uid scope. -->
  <data name="AutocorrectPage_PackDilution_Format" xml:space="preserve">
    <value>Brings {0} words. {1} more were left out: each was one typo away from a common French word, so keeping it would have blocked that correction.</value>
  </data>
  <data name="AutocorrectPage_PackWarning_Title" xml:space="preserve">
    <value>Correction is a little less sure while this pack is on</value>
  </data>
  <data name="AutocorrectPage_PackWarning_Message" xml:space="preserve">
    <value>Every word a pack adds is another word a typo can be corrected into. Turn the pack off if ordinary French starts getting corrected wrongly.</value>
  </data>

  <!-- Diagnostics — the module's purpose-specific dataset consents.
       Decisions and text are independent disk-persistence opt-ins.
       Keys are flat SettingsCards composed by the SettingsComposer, so they bind
       .Header / .Description. -->
  <data name="AutocorrectPageDiagnosticsHeader.Text" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="AutocorrectDecisionsCard.Header" xml:space="preserve">
    <value>Autocorrect decisions</value>
  </data>
  <data name="AutocorrectDecisionsCard.Description" xml:space="preserve">
    <value>Record every corrected or left-alone word on an enrolled app to autocorrect.decisions.jsonl — its candidates, scores, margins and the rule that decided it. The deep view for tuning the corrector. Includes the words you type.</value>
  </data>
  <data name="AutocorrectTextCard.Header" xml:space="preserve">
    <value>Keep the text I type</value>
  </data>
  <data name="AutocorrectTextCard.Description" xml:space="preserve">
    <value>Also record each sentence you type in enrolled apps to autocorrect.text.jsonl, verbatim and paired with the corrected form, to build a corpus of your own writing and mistakes. Heavier: a full record of typed input. Password fields, paste and dictation are never recorded.</value>
  </data>
  <data name="SettingsModuleNavLabel" xml:space="preserve">
    <value>Autocorrect</value>
  </data>
