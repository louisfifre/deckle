  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- ─── AutocorrectPage ────────────────────────────────────────────
       Settings page for the Autocorrect module — title + subtitle, the master
       switch, the two drill-ins to the child pages, the exclusion register, then
       Diagnostics. The two child pages carry their own key prefixes
       (AppsEnrolledPage_*, LexicalDomainsPage_*) further down.
       x:Uid keys follow <Page>_<Element>(.<Property>) — plain TextBlocks bind
       .Text, SettingsCards bind .Header / .Description. -->
  <data name="AutocorrectPage_Title.Text" xml:space="preserve">
    <value>Autocorrect</value>
  </data>
  <!-- Says what the feature does, and stops there. Where correction runs belongs
       to the Apps enrolled page, whose own subtitle states it — each surface
       describes what it holds, so the sentence is written once. -->
  <data name="AutocorrectPage_Subtitle.Text" xml:space="preserve">
    <value>Restore French accents and fix typos as you type.</value>
  </data>

  <!-- Master switch -->
  <data name="AutocorrectPage_MasterCard.Header" xml:space="preserve">
    <value>Enable autocorrect</value>
  </data>
  <data name="AutocorrectPage_MasterCard.Description" xml:space="preserve">
    <value>Master switch. When off, no text is corrected in any app, whatever you've chosen.</value>
  </data>

  <!-- Navigation cards — the two drill-ins to the child pages. Icon-less
       SettingsCards, so only .Header / .Description; the chevron says the rest. -->
  <data name="AutocorrectPage_DomainsCard.Header" xml:space="preserve">
    <value>Lexical domains</value>
  </data>
  <data name="AutocorrectPage_DomainsCard.Description" xml:space="preserve">
    <value>Teach Deckle the vocabulary of the fields you write about.</value>
  </data>
  <data name="AutocorrectPage_AppsCard.Header" xml:space="preserve">
    <value>Apps enrolled</value>
  </data>
  <data name="AutocorrectPage_AppsCard.Description" xml:space="preserve">
    <value>Where correction runs, app by app.</value>
  </data>

  <!-- Excluded words — the settings mirror of the exclusion register. It sits on
       this page rather than on a child because an exclusion holds against every
       domain and every app at once. The body states both halves of what an
       exclusion does, because the second half is the surprising one: the word
       stops being a correction target AND stops being protected. Precedence is
       exclusions &gt; domains &gt; base lexicon, so the wording says "whatever it came
       from" rather than naming a source. -->
  <data name="AutocorrectPage_Section_Exclusions.Text" xml:space="preserve">
    <value>Excluded words</value>
  </data>
  <data name="AutocorrectPage_Exclusions_Body.Text" xml:space="preserve">
    <value>Stop Deckle treating something as a word. It will no longer correct anything into that word, and no longer leave the word alone when you type it. Use this when a word keeps taking corrections you wanted elsewhere.</value>
  </data>
  <data name="AutocorrectPage_ExcludeCard.Header" xml:space="preserve">
    <value>Exclude a word</value>
  </data>
  <data name="AutocorrectPage_ExcludeCard.Description" xml:space="preserve">
    <value>An exclusion applies whatever the word came from — a lexical domain or Deckle's own French.</value>
  </data>
  <data name="AutocorrectPage_ExclusionBox.PlaceholderText" xml:space="preserve">
    <value>One word</value>
  </data>
  <data name="AutocorrectPage_ExcludeButton.Content" xml:space="preserve">
    <value>Exclude</value>
  </data>
  <data name="AutocorrectPage_Exclusions_Empty.Text" xml:space="preserve">
    <value>You haven't excluded any words.</value>
  </data>
  <data name="AutocorrectPage_IncludeButton.ToolTipService.ToolTip" xml:space="preserve">
    <value>Put this word back</value>
  </data>

  <!-- ── Apps enrolled (child page) ───────────────────────────────────────── -->
  <data name="AppsEnrolledPage_Title.Text" xml:space="preserve">
    <value>Apps enrolled</value>
  </data>
  <data name="AppsEnrolledPage_Subtitle.Text" xml:space="preserve">
    <value>Autocorrect runs only where you've allowed it. Deckle offers to enable it the first time a correction could help in a new app.</value>
  </data>
  <data name="AppsEnrolledPage_Section_Apps.Text" xml:space="preserve">
    <value>Apps</value>
  </data>
  <data name="AppsEnrolledPage_Apps_Body.Text" xml:space="preserve">
    <value>The apps you've answered for. Turn correction on or off for each, or forget an app to be asked again the next time a correction could help there.</value>
  </data>
  <data name="AppsEnrolledPage_Empty.Text" xml:space="preserve">
    <value>No apps yet. Deckle will offer to turn autocorrect on the first time a correction could help in an app — your choices show up here.</value>
  </data>
  <data name="AppsEnrolledPage_ForgetButton.ToolTipService.ToolTip" xml:space="preserve">
    <value>Forget this app</value>
  </data>
  <!-- Shown instead of the whole section while the master switch is off: none of
       these rows applies then, so they are hidden rather than greyed, and this
       line says where to change that. -->
  <data name="AppsEnrolledPage_Disabled.Text" xml:space="preserve">
    <value>Autocorrect is off, so nothing is corrected anywhere. Turn it on in Autocorrect to choose where it runs.</value>
  </data>

  <!-- ── Lexical domains (child page) ─────────────────────────────────────── -->
  <!-- A domain is a field of writing whose vocabulary the corrector can be
       taught; a row inside it is one language of that domain. The word "pack"
       (the code's term for the intersection) never surfaces here. -->
  <data name="LexicalDomainsPage_Title.Text" xml:space="preserve">
    <value>Lexical domains</value>
  </data>
  <data name="LexicalDomainsPage_Subtitle.Text" xml:space="preserve">
    <value>Specialized vocabularies that extend correction to the fields you write about. Pick a domain, then enable the languages you write in.</value>
  </data>

  <!-- One pair per shipped domain, keyed by LexicalDomain.ResourceKey. Built in
       code (the tabs are enumerated from LexicalDomain.Shipped), so these resolve
       through Loc.GetFrom rather than x:Uid; the "<key>/Header" shape matches a
       SettingsCard's so the two paths read alike. -->
  <data name="AutocorrectDomain_Computing.Header" xml:space="preserve">
    <value>Computing</value>
  </data>
  <data name="AutocorrectDomain_Computing.Description" xml:space="preserve">
    <value>Terms from computing, programming and the Internet.</value>
  </data>

  <!-- A language row names itself: the language as Windows spells it, and how
       many terms turning it on would add. -->
  <data name="LexicalDomainsPage_LanguageRow_Format" xml:space="preserve">
    <value>{0} — {1:N0} terms</value>
  </data>
  <!-- The indications block, in prose under the list: what the domain ships and
       what fabrication turned away to keep base corrections working. The counts
       come from each shipped manifest, so the line is formatted at runtime. -->
  <data name="LexicalDomainsPage_Indications_Format" xml:space="preserve">
    <value>{0:N0} {1} terms shipped — {2:N0} candidates withheld to protect everyday words.</value>
  </data>

  <!-- Shown instead of the whole section while the master switch is off: no
       domain reaches the corrector then, so the rows are hidden rather than
       greyed, and this line says where to change that. -->
  <data name="LexicalDomainsPage_Disabled.Text" xml:space="preserve">
    <value>Autocorrect is off, so no vocabulary reaches the corrector. Turn it on in Autocorrect to pick your domains.</value>
  </data>

  <!-- Diagnostics — the module's purpose-specific dataset consents.
       Decisions and text are independent disk-persistence opt-ins.
       Keys are flat SettingsCards composed by the SettingsComposer, so they bind
       .Header / .Description. -->
  <data name="AutocorrectPageDiagnosticsHeader.Text" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="AutocorrectDecisionsCard.Header" xml:space="preserve">
    <value>Autocorrect decisions</value>
  </data>
  <data name="AutocorrectDecisionsCard.Description" xml:space="preserve">
    <value>Record every corrected or left-alone word on an enrolled app to autocorrect.decisions.jsonl — its candidates, scores, margins and the rule that decided it. The deep view for tuning the corrector. Includes the words you type.</value>
  </data>
  <data name="AutocorrectTextCard.Header" xml:space="preserve">
    <value>Keep the text I type</value>
  </data>
  <data name="AutocorrectTextCard.Description" xml:space="preserve">
    <value>Also record each sentence you type in enrolled apps to autocorrect.text.jsonl, verbatim and paired with the corrected form, to build a corpus of your own writing and mistakes. Heavier: a full record of typed input. Password fields, paste and dictation are never recorded.</value>
  </data>
  <!-- Rail labels: the module's own entry, then its two nested children. -->
  <data name="SettingsModuleNavLabel" xml:space="preserve">
    <value>Autocorrect</value>
  </data>
  <data name="SettingsModuleNavLabel_LexicalDomains" xml:space="preserve">
    <value>Lexical domains</value>
  </data>
  <data name="SettingsModuleNavLabel_AppsEnrolled" xml:space="preserve">
    <value>Apps enrolled</value>
  </data>
</root>
