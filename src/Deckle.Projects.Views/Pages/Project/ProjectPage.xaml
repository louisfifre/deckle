<Page
    x:Class="Deckle.Projects.Views.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A project's page (boards P1 to P4). This is the skeleton the window
         step leaves: the name and the path and nothing else. The page step owns
         this file from here and fills in the header, the readouts, the links
         and the pinned actions. -->
    <StackPanel Margin="56,12,56,40" Spacing="4">
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="PathText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</Page>
