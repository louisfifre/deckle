<UserControl
    x:Class="Deckle.Projects.Views.RunLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One state line of an action, as a pinned card's footer and the header's
         line under its buttons draw it: nothing before the words for a neutral
         line or a success (the spec draws no icon on a success), a progress ring
         while the action runs, the warning glyph in the critical colour on a
         failure. A note under the words says the action ran in the Windows
         console because Windows Terminal was missing. The words sit in a star
         column, so in a narrow card they wrap instead of running under the
         button beside them. -->
    <Grid RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ProgressRing x:Name="Ring"
                      Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      IsActive="False"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />
        <FontIcon x:Name="WarningIcon"
                  Grid.Column="1"
                  FontSize="14"
                  Margin="0,0,8,0"
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                  Visibility="Collapsed"
                  VerticalAlignment="Center" />
        <TextBlock x:Name="LineText"
                   Grid.Column="2"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="NoteText"
                   Grid.Row="1"
                   Grid.ColumnSpan="3"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
