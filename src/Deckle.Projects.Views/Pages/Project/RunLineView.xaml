<UserControl
    x:Class="Deckle.Projects.Views.RunLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One state line of an action, as a pinned card's footer and the header's
         line under its buttons draw it: nothing before the words for a neutral
         line or a success (the spec draws no icon on a success), a progress ring
         while the action runs, the warning glyph in the critical colour on a
         failure. A note under the words says the action ran in the Windows
         console because Windows Terminal was missing. The words sit in a star
         column and stay on one line: a state that wraps ("Running · 1" over
         "min 12 s") reads worse than one that is trimmed, and the card is kept
         wide enough (see PinnedActionsSection) that the usual states fit. The
         ring is centred on that one line. After a run that ended while its
         terminal window is still open, a small button after the words brings
         that window up, so the output can be read. -->
    <Grid RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ProgressRing x:Name="Ring"
                      Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      IsActive="False"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />
        <FontIcon x:Name="WarningIcon"
                  Grid.Column="1"
                  FontSize="14"
                  Margin="0,0,8,0"
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                  Visibility="Collapsed"
                  VerticalAlignment="Center" />
        <TextBlock x:Name="LineText"
                   Grid.Column="2"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <Button x:Name="TerminalButton"
                Grid.Column="3"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="6,2"
                Height="24"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnTerminalClick">
            <FontIcon x:Name="TerminalIcon" FontSize="12" />
        </Button>
        <TextBlock x:Name="NoteText"
                   Grid.Row="1"
                   Grid.ColumnSpan="4"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
