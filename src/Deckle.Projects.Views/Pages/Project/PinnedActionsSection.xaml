<UserControl
    x:Class="Deckle.Projects.Views.PinnedActionsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Projects.Views">

    <!-- "Pinned actions" (boards P1 to P3): the title line with "Pin an
         action...", the cards of the actions pinned on the project, and the
         line that says how they run. What replaces the cards when the menu is
         missing, unreadable or without a shell is one of three notices. The
         main action is not here: it is in the page's header. -->
    <StackPanel Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <Button x:Name="PinActionButton"
                    Grid.Column="1"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnPinClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PinIcon" FontSize="16" />
                    <TextBlock x:Name="PinLabel" />
                </StackPanel>
            </Button>
        </Grid>

        <local:NoScriptMenuNotice x:Name="NoMenuNotice" Visibility="Collapsed" HorizontalAlignment="Left" />

        <TextBlock x:Name="NoShellText"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <local:ScriptMenuErrorNotice x:Name="MenuErrorNotice" Visibility="Collapsed" />

        <ItemsRepeater x:Name="Cards">
            <ItemsRepeater.Layout>
                <UniformGridLayout Orientation="Horizontal"
                                   MinItemWidth="260"
                                   MinItemHeight="112"
                                   MinColumnSpacing="12"
                                   MinRowSpacing="12"
                                   ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <TextBlock x:Name="NoteText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
