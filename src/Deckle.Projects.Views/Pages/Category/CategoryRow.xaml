<UserControl
    x:Class="Deckle.Projects.Views.CategoryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Projects.Views"
    HorizontalContentAlignment="Stretch">

    <!-- One project in a category's list (board C1): a dotted handle, the name
         over the full path, the same meta line as the card, and the main
         action's button. The row paints its own card fill, stroke and corner
         (the same as a Home card's): the list's item container draws a square
         fill whatever corner radius it is given, so it is kept transparent
         (CategoryPage.xaml) and only draws the focus. The hover and pressed
         fills are the row's too, visual states (as the Home card's) that the
         code enters from the pointer, so the brushes follow the app theme. -->
    <Grid x:Name="Root"
          MinHeight="64"
          Padding="16,10,16,10"
          ColumnSpacing="12"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource OverlayCornerRadius}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The last column has a fixed width so the buttons of different rows
             line up whatever sits beside them (WinUI has no shared column
             size): the ring or the warning mark takes the room left of the
             button inside it. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="{StaticResource ProjectsRowActionColumnWidth}" />
        </Grid.ColumnDefinitions>

        <!-- The handle is the only place a drag starts (spec: "dragging a row by
             its gripper"). It is a pointer affordance: a screen reader skips it
             (the row is the unit it reads) and the tooltip stays for the mouse. -->
        <FontIcon x:Name="Grip"
                  AutomationProperties.AccessibilityView="Raw"
                  Glyph="&#xE76F;"
                  FontSize="16"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="NameText"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock x:Name="PathText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
        </StackPanel>

        <TextBlock x:Name="MetaText"
                   Grid.Column="2"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />

        <!-- Always in the column, empty or not, so the buttons of the rows that
             have one line up. -->
        <local:MainActionButton x:Name="MainAction"
                                Grid.Column="3"
                                StateBeforeButton="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
    </Grid>
</UserControl>
