<Page
    x:Class="Deckle.Projects.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A category's page (board C1). This is the skeleton the window step
         leaves: the title and nothing else. The page step owns this file from
         here and fills in the breadcrumb, the list of rows and the delete link. -->
    <Grid Margin="56,12,56,40">
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
    </Grid>
</Page>
