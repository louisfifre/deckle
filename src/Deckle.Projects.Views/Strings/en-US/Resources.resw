<?xml version="1.0" encoding="utf-8"?>
<!-- Deckle Projects' wording. One catalog for the whole library: Loc.GetFrom
     reads "<library>/Resources" and nothing else. The window step wrote every
     string the spec and the boards name, in the blocks below; the category and
     the project pages add a key only inside their own block. Product names
     ("Deckle Projects", "Deckle Folders", "Windows Terminal") stay in code or
     in the sentence the spec quotes, as Loc.cs asks. Code reads these keys
     through ProjectsText (Loc.GetFrom), so they need no copy in Deckle.App. -->
<root>
