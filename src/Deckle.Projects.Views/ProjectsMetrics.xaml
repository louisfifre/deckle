<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The sizes the Projects window shares between its pages: the card family
         (Home's cards, the More tile, the project page's pinned action cards)
         and the page margins. The host's App.xaml merges this file, because a
         Window has no Resources of its own that its pages could find.

         Home's card width and the gap between Home's cards are not here: the
         arithmetic that decides how many cards a row holds reads them from
         CardGridCapacity (MinCardWidth, Gap), and the layout must use those
         same two numbers, so they stay in that one place. ProjectsCardSpacing
         is that same gap, for the layouts XAML draws; keep the two equal. -->

    <x:Double x:Key="ProjectsCardMinHeight">120</x:Double>
    <Thickness x:Key="ProjectsCardPadding">16</Thickness>
    <x:Double x:Key="ProjectsCardSpacing">12</x:Double>
    <x:Double x:Key="ProjectsActionCardMinWidth">340</x:Double>

    <!-- The last column of a category page's rows: the main action's button
         (up to about 128 for "Build & run"), 8 of gap and the 16 of the ring or
         the warning mark, with some slack. Fixed, so the buttons line up. -->
    <GridLength x:Key="ProjectsRowActionColumnWidth">176</GridLength>

    <!-- The widest the project page header's right column may grow: the three
         buttons side by side with room for the run line under them. -->
    <x:Double x:Key="ProjectsHeaderActionsMaxWidth">480</x:Double>

    <!-- Left and right 56, bottom 40, on every page. The top is 16 under the
         title bar on a page that starts with its own heading, and Home's title
         row takes the same 16; the scrolling body under it starts 32 lower. -->
    <Thickness x:Key="ProjectsPageMargin">56,16,56,40</Thickness>
    <Thickness x:Key="ProjectsPageTopRowMargin">56,16,56,0</Thickness>
    <Thickness x:Key="ProjectsPageBodyMargin">56,32,56,40</Thickness>
    <x:Double x:Key="ProjectsSectionSpacing">32</x:Double>
</ResourceDictionary>
