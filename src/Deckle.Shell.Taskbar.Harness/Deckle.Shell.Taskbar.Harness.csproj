<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development console for the taskbar module's native engine: injects the
       DLL into the real explorer, prints what it logs, re-injects when explorer
       restarts, sends it a JSON document, and stops it cleanly on Ctrl+C. It is
       how the engine is tried live without running the Deckle app. Not part of
       the app and never published. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Deckle.Shell.Taskbar.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Shell.Taskbar\Deckle.Shell.Taskbar.csproj" />
  </ItemGroup>
</Project>
