<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Anytype.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host pulls in the whole Anytype stack (Api + Gestures + Schema)
         transitively through this one reference; Diagnostics rides along via
         Deckle.Anytype. -->
    <ProjectReference Include="..\Deckle.Anytype\Deckle.Anytype.csproj" />
    <!-- Home owns the guarded inventory domain; this project only adapts it to MCP. -->
    <ProjectReference Include="..\Deckle.Home\Deckle.Home.csproj" />
    <!-- The HTTP transport authenticates each session against the vault. -->
    <ProjectReference Include="..\Deckle.Security\Deckle.Security.csproj" />
  </ItemGroup>
</Project>
