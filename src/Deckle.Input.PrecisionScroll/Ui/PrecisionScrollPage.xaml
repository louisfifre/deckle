<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Input.PrecisionScroll.PrecisionScrollPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty, confirmed
                     by the block itself). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="PrecisionScrollPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The module switch, first and alone, in its own host so the
                     section below keeps its distance from it (the same shape as
                     Ambient and Trackpad). -->
                <StackPanel x:Name="SwitchHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Scrolling ─────────────────────────────────────────────── -->
                <!-- Hidden with its title while the module is off (mask, never
                     grey); the code-behind follows ViewModel.Enabled. -->
                <catalog:SettingsSection x:Name="ScrollingSection"
                                         x:Uid="PrecisionScrollPageScrollingSection">
                    <StackPanel x:Name="ScrollingHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
