<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Transcription.Whisper</RootNamespace>
    <!-- WhisperStructs porte des structs C interop ; le P/Invoke ne fait pas
         de fixed/unsafe directement mais on aligne sur le parent pour rester
         libre d'introduire des spans/pointers natifs si le besoin émerge. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- AppPaths.NativeDirectory pour le résolveur DllImport, AppPaths.ModelsDirectory
         pour le catalogue Setup. -->
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <!-- Pour IAsrBackend, TranscriptionResult, TranscriptionSegment, TranscriptionSettings,
         et DeckleWhispSource (provider EventSource transcription, partagé parent/enfant). -->
    <ProjectReference Include="..\Deckle.Transcription\Deckle.Transcription.csproj" />
  </ItemGroup>
</Project>
