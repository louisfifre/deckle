<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Deckle.App</RootNamespace>
    <!-- Pinned so the executable stays Deckle.exe: autostart entries, the tray
         tooltip, the taskbar label and shell filters target that name. -->
    <AssemblyName>Deckle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Neutral language for the MRT/PRI resource resolver. Without it no
         fallback language is declared, which can leave x:Uid lookups empty when
         the system display language is not en-US. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Deckle owns ONNX Runtime and DirectML through the autocorrect stack.
         Windows App SDK ML is not used, so its automatic ONNX Runtime
         initialization must not compete with the host's runtime. -->
    <DisableWindowsAppSDKMLAutoInitialize>true</DisableWindowsAppSDKMLAutoInitialize>
    <Version>0.70.0</Version>
    <!-- The release stage the running build belongs to (Alpha, then Beta),
         shown as the Settings title bar subtitle. Deliberately apart from
         <Version>: the tag, the changelog and the update check all read the
         bare number, so the stage never enters them. Maintained here and
         nowhere else; the ItemGroup below bakes it into the assembly. -->
    <DeckleStage>Alpha</DeckleStage>
    <!-- Forces the Publish pipeline to generate/copy Deckle.pri into PublishDir.
         Without this, in unpackaged + WindowsAppSDK 1.8, the .pri didn't land in
         publish\ and all compiled XAML resources (.xbf embedded in .pri since 1.8)
         became unreachable. Cf. microsoft/WindowsAppSDK#3451. Observed on 1.8;
         not re-checked on 2.5.1, so the property stays. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs owns Main: the crash dump capture is decided before XAML
         hosts anything. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Stage" Value="$(DeckleStage)" />
    <InternalsVisibleTo Include="Deckle.App.Tests" />
  </ItemGroup>

  <!-- Publish-only options, gated on _IsPublishing (set only by the Publish
       target) so a plain Release build does not pay self-contained costs.

       SelfContained with WindowsAppSDKSelfContained makes the publish output a
       self-sufficient folder that xcopy-deploys as-is.

       Folder, not single-file: unpackaged WinUI 3 single-file needs
       IncludeAllContentForSelfExtract=true, which re-extracts the payload to
       %TEMP% on each version's first launch and pollutes C:, the very thing the
       install-location choice exists to avoid.

       Native DLLs and Whisper models are not shipped: they live under the user
       data root (native\, models\), provisioned per user.

       PublishTrimmed stays off: WinUI 3, XAML compilation and x:Bind generated
       code rely on reflection paths the IL linker cannot prove safe. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <!-- The HUD Rewriting stroke needs a true angular gradient around a rounded
         rect; CompositionLinearGradientBrush only maps bbox-linear, so Win2D
         paints it on a surface brush. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Anytype\Deckle.Anytype.csproj" />
    <ProjectReference Include="..\Deckle.Anytype.Mcp\Deckle.Anytype.Mcp.csproj" />
    <ProjectReference Include="..\Deckle.Home\Deckle.Home.csproj" />
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Chrono\Deckle.Chrono.csproj" />
    <ProjectReference Include="..\Deckle.Composition\Deckle.Composition.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <ProjectReference Include="..\Deckle.Hud\Deckle.Hud.csproj" />
    <ProjectReference Include="..\Deckle.Install\Deckle.Install.csproj" />
    <ProjectReference Include="..\Deckle.Input\Deckle.Input.csproj" />
    <ProjectReference Include="..\Deckle.Autocorrect\Deckle.Autocorrect.csproj" />
    <ProjectReference Include="..\Deckle.Autocorrect.Onnx\Deckle.Autocorrect.Onnx.csproj" />
    <ProjectReference Include="..\Deckle.Input.Trackpad\Deckle.Input.Trackpad.csproj" />
    <ProjectReference Include="..\Deckle.Input.PrecisionScroll\Deckle.Input.PrecisionScroll.csproj" />
    <ProjectReference Include="..\Deckle.Lighting\Deckle.Lighting.csproj" />
    <ProjectReference Include="..\Deckle.Lighting.Ambient\Deckle.Lighting.Ambient.csproj" />
    <ProjectReference Include="..\Deckle.Llm\Deckle.Llm.csproj" />
    <ProjectReference Include="..\Deckle.Llm.Rewrite\Deckle.Llm.Rewrite.csproj" />
    <ProjectReference Include="..\Deckle.Modules\Deckle.Modules.csproj" />
    <ProjectReference Include="..\Deckle.Notifications\Deckle.Notifications.csproj" />
    <ProjectReference Include="..\Deckle.Orchestration\Deckle.Orchestration.csproj" />
    <ProjectReference Include="..\Deckle.Playground\Deckle.Playground.csproj" />
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
    <ProjectReference Include="..\Deckle.Setup\Deckle.Setup.csproj" />
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
    <ProjectReference Include="..\Deckle.Shell.Foreground\Deckle.Shell.Foreground.csproj" />
    <ProjectReference Include="..\Deckle.Shell.TaskbarCover\Deckle.Shell.TaskbarCover.csproj" />
    <ProjectReference Include="..\Deckle.Shell.TrayMenu\Deckle.Shell.TrayMenu.csproj" />
    <ProjectReference Include="..\Deckle.Shell.WindowChrome\Deckle.Shell.WindowChrome.csproj" />
    <ProjectReference Include="..\Deckle.Speech\Deckle.Speech.csproj" />
    <ProjectReference Include="..\Deckle.Transcription\Deckle.Transcription.csproj" />
    <ProjectReference Include="..\Deckle.Transcription.Whisper\Deckle.Transcription.Whisper.csproj" />
    <ProjectReference Include="..\Deckle.Vision\Deckle.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\**\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Warm-up audio: the engine's loader accepts only PCM 16-bit mono 16 kHz. -->
    <Content Include="Assets\Sounds\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- AppNotificationManager.Register() LoadLibrary's
       Microsoft.WindowsAppRuntime.Insights.Resource.dll from beside the
       executable (WindowsAppRuntimeInsights.h); without it Register() throws
       "Unable to load resource dll", toasts are unavailable and
       NotificationInvoked never fires. Windows App SDK 1.8 extracted the whole
       runtime MSIX into the output of a self-contained app, which brought the DLL
       along. 2.x only copies runtimes-framework\win-<platform>\native from its
       component packages (AddMicrosoftWindowsAppSDKPayloadFilesFromComponents)
       and never opens the MSIX, where this DLL is the one entry that lives at
       the archive root. Upstream: microsoft/WindowsAppSDK#6774. Restore exactly
       that entry; drop these targets once the SDK ships the DLL again.

       The MSIX is located from the package itself: the Runtime package's props
       expose its folder (MicrosoftWindowsAppSDKPackageDir), under which the
       framework MSIX sits in tools\MSIX\win10-<platform>, so an SDK bump needs no
       edit here. (WinAppSDKPackageName, which names it, is not set in
       self-contained mode, hence the glob.) A missing MSIX or entry fails the
       build, so a layout change can never silently drop the DLL again. The extraction is incremental on the MSIX, and the item is declared
       before AssignTargetPaths like the SDK's own payload target so both build
       and publish copy it. -->
  <Target Name="ResolveWindowsAppRuntimeInsightsResource"
          DependsOnTargets="GetWindowsAppSDKNativePlatform">
    <PropertyGroup>
      <_InsightsResourceName>Microsoft.WindowsAppRuntime.Insights.Resource.dll</_InsightsResourceName>
      <_InsightsMsixDir>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(NativePlatform)\</_InsightsMsixDir>
      <_InsightsExtractDir>$(IntermediateOutputPath)WindowsAppRuntimeInsights\</_InsightsExtractDir>
      <_InsightsResourcePath>$(_InsightsExtractDir)$(_InsightsResourceName)</_InsightsResourcePath>
    </PropertyGroup>
    <!-- Next to the framework MSIX sit the Main, Singleton and DDLM ones; only
         Microsoft.WindowsAppRuntime.<major>.msix holds the DLL. -->
    <ItemGroup>
      <_InsightsMsixCandidate Include="$(_InsightsMsixDir)Microsoft.WindowsAppRuntime.*.msix" />
      <_InsightsRuntimeMsixItem Include="@(_InsightsMsixCandidate)"
                                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^Microsoft\.WindowsAppRuntime\.\d+$'))" />
    </ItemGroup>
    <Error Condition="'@(_InsightsRuntimeMsixItem->Count())' != '1'"
           Text="Expected exactly one framework MSIX (Microsoft.WindowsAppRuntime.&lt;major&gt;.msix) in '$(_InsightsMsixDir)', found @(_InsightsRuntimeMsixItem->Count()): cannot restore $(_InsightsResourceName), toast notifications would fail to register. The Windows App SDK package layout changed." />
    <PropertyGroup>
      <_InsightsRuntimeMsix>@(_InsightsRuntimeMsixItem)</_InsightsRuntimeMsix>
    </PropertyGroup>
  </Target>

  <Target Name="ExtractWindowsAppRuntimeInsightsResource"
          DependsOnTargets="ResolveWindowsAppRuntimeInsightsResource"
          Inputs="$(_InsightsRuntimeMsix)"
          Outputs="$(_InsightsResourcePath)">
    <Unzip SourceFiles="$(_InsightsRuntimeMsix)"
           DestinationFolder="$(_InsightsExtractDir)"
           Include="$(_InsightsResourceName)"
           OverwriteReadOnlyFiles="true" />
    <Error Condition="!Exists('$(_InsightsResourcePath)')"
           Text="$(_InsightsResourceName) is not an entry of '$(_InsightsRuntimeMsix)': toast notifications would fail to register. The Windows App SDK package layout changed." />
    <!-- Unzip keeps the entry's own timestamp, older than the MSIX, which would
         make the Outputs check above fail on every build. -->
    <Touch Files="$(_InsightsResourcePath)" />
  </Target>

  <Target Name="AddWindowsAppRuntimeInsightsResource"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ExtractWindowsAppRuntimeInsightsResource">
    <ItemGroup>
      <None Include="$(_InsightsResourcePath)"
            Link="$(_InsightsResourceName)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- The autocorrect lexicons must sit flat under Data/ beside the executable,
       where App.Autocorrect loads them. Transitive Content from
       Deckle.Autocorrect lands under "Deckle.Autocorrect\Data\"
       instead (the SDK prefixes referenced-project content with the project
       name) and re-declaring it here loses to that copy on source-path dedup,
       so the engine silently finds nothing and never arms. Flatten it
       deterministically after the build instead. -->
  <Target Name="FlattenAutocorrectLexicons" AfterTargets="Build">
    <ItemGroup>
      <_AutocorrectLexicon Include="..\Deckle.Autocorrect\Data\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AutocorrectLexicon)"
          DestinationFiles="@(_AutocorrectLexicon->'$(OutDir)Data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
