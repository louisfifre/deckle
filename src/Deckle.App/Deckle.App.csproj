<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Deckle.App</RootNamespace>
    <!-- AssemblyName explicitly pinned to "Deckle" so the produced executable
         stays Deckle.exe even though the project is now Deckle.App.csproj.
         Keeps autostart entries, tray tooltip, taskbar label, and shell
         filters that target "Deckle.exe" working without migration. -->
    <AssemblyName>Deckle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Neutral language for the MRT/PRI resource resolver. Without
         this, Strings/en-US/Resources.resw is found at runtime but no
         language is declared as fallback, which can leave x:Uid
         lookups empty when the system display language doesn't match
         en-US. See the localization reference under docs/. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Deckle owns ONNX Runtime and DirectML through the autocorrect stack.
         Windows App SDK ML is not used, so its automatic ONNX Runtime
         initialization must not compete with the host's runtime. -->
    <DisableWindowsAppSDKMLAutoInitialize>true</DisableWindowsAppSDKMLAutoInitialize>
    <Version>0.27.0</Version>
    <!-- Forces the Publish pipeline to generate/copy Deckle.pri into PublishDir.
         Without this, in unpackaged + WindowsAppSDK 1.8, the .pri doesn't land in
         publish\ and all compiled XAML resources (.xbf embedded in .pri since 1.8)
         become unreachable. Cf. microsoft/WindowsAppSDK#3451. -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- Publish-only options. Gated on _IsPublishing (MSBuild-internal flag
       set exclusively by the Publish target) so a plain `dotnet build` in
       Release doesn't pay self-contained costs at every iteration.

       SelfContained bundles the .NET runtime so the distribution runs with no
       system-wide .NET install. Paired with WindowsAppSDKSelfContained above,
       the publish output is a self-sufficient folder — Deckle.exe + runtime +
       Windows App SDK + Deckle.pri + assets — that xcopy-deploys as-is.

       Folder, NOT single-file. PublishSingleFile for unpackaged WinUI 3
       requires IncludeAllContentForSelfExtract=true, which makes the exe
       re-extract its whole payload to %TEMP% (a C: path) on each version's
       first launch. Deckle installs into a permanent, user-chosen folder, so
       the self-extracting exe buys nothing and instead pollutes C: — the very
       thing the install-location choice exists to avoid. The folder runs in
       place from wherever it lands. The ZIP is produced by
       scripts/lib/publish-app.ps1.

       Native DLLs (libwhisper + ggml backends + MinGW runtime) and Whisper
       models are NOT shipped — they live under the user data root (native\,
       models\), populated by the first-run wizard on a per-user basis.

       PublishTrimmed is NOT enabled: WinUI 3 + XAML compilation + x:Bind
       generated code rely on reflection paths the IL linker can't prove
       safe. We already hit one trimming crash in the wild (Slider with a
       range excluding 0 — see project_winui3_slider_bug.md). Trimming stays
       off until there's a concrete size/perf motive AND a runtime test
       matrix proves it safe. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- MVVM Toolkit — source generators [ObservableProperty], ObservableObject, [RelayCommand].
         Eliminates INotifyPropertyChanged boilerplate in ViewModels. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- SettingsCard / SettingsExpander — canonical Windows 11 pattern for settings pages
         (spacing, section headers, animations documented on Microsoft Learn). -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <!-- Win2D — Direct2D-backed drawing on CompositionDrawingSurface. Used by the HUD
         Rewriting stroke to paint a true angular-gradient rainbow; CompositionLinearGradientBrush
         only supports bbox-linear mapping, so a rotating gradient around a rounded rect
         perimeter requires Win2D + a surface brush. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Anytype\Deckle.Anytype.csproj" />
    <ProjectReference Include="..\Deckle.Anytype.Mcp\Deckle.Anytype.Mcp.csproj" />
    <ProjectReference Include="..\Deckle.Home\Deckle.Home.csproj" />
    <ProjectReference Include="..\Deckle.Travel\Deckle.Travel.csproj" />
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Chrono\Deckle.Chrono.csproj" />
    <ProjectReference Include="..\Deckle.Composition\Deckle.Composition.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <ProjectReference Include="..\Deckle.Hud\Deckle.Hud.csproj" />
    <!-- Windows-integration primitives shared with the download stub — the
         install-mode branches (App.Install.cs) prefill folders from the
         Installed-apps entry and the DECKLE_DATA_ROOT variable. -->
    <ProjectReference Include="..\Deckle.Install\Deckle.Install.csproj" />
    <ProjectReference Include="..\Deckle.Input\Deckle.Input.csproj" />
    <ProjectReference Include="..\Deckle.Autocorrect\Deckle.Autocorrect.csproj" />
    <!-- CamemBERT masked-LM reranker for the live contextual (la/là) stage; the
         App composition root loads its ONNX model off-thread and wires it in. -->
    <ProjectReference Include="..\Deckle.Autocorrect.Mlm\Deckle.Autocorrect.Mlm.csproj" />
    <!-- ONNX Runtime GenAI sentence judge (Qwen3 on DirectML) — preferred over
         CamemBERT for the sentence stage when its model directory is present. -->
    <ProjectReference Include="..\Deckle.Autocorrect.Onnx\Deckle.Autocorrect.Onnx.csproj" />
    <ProjectReference Include="..\Deckle.Input.Trackpad\Deckle.Input.Trackpad.csproj" />
    <ProjectReference Include="..\Deckle.Input.PrecisionScroll\Deckle.Input.PrecisionScroll.csproj" />
    <ProjectReference Include="..\Deckle.Lighting\Deckle.Lighting.csproj" />
    <ProjectReference Include="..\Deckle.Lighting.Ambient\Deckle.Lighting.Ambient.csproj" />
    <ProjectReference Include="..\Deckle.Llm\Deckle.Llm.csproj" />
    <ProjectReference Include="..\Deckle.Llm.Rewrite\Deckle.Llm.Rewrite.csproj" />
    <ProjectReference Include="..\Deckle.Modules\Deckle.Modules.csproj" />
    <ProjectReference Include="..\Deckle.Notifications\Deckle.Notifications.csproj" />
    <ProjectReference Include="..\Deckle.Playground\Deckle.Playground.csproj" />
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
    <ProjectReference Include="..\Deckle.Setup\Deckle.Setup.csproj" />
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
    <ProjectReference Include="..\Deckle.Shell.TaskbarCover\Deckle.Shell.TaskbarCover.csproj" />
    <ProjectReference Include="..\Deckle.Shell.TrayMenu\Deckle.Shell.TrayMenu.csproj" />
    <ProjectReference Include="..\Deckle.Shell.WindowChrome\Deckle.Shell.WindowChrome.csproj" />
    <ProjectReference Include="..\Deckle.Speech\Deckle.Speech.csproj" />
    <ProjectReference Include="..\Deckle.Transcription\Deckle.Transcription.csproj" />
    <!-- Whisper ASR backend (IAsrBackend implementation). App composition
         root instantiates WhisperBackend and injects it into the engine. -->
    <ProjectReference Include="..\Deckle.Transcription.Whisper\Deckle.Transcription.Whisper.csproj" />
    <ProjectReference Include="..\Deckle.Vision\Deckle.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons -->
    <Content Include="Assets\Icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Fonts (Bitcount Single, etc.) -->
    <Content Include="Assets\Fonts\**\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Warm-up audio (PCM 16-bit mono 16 kHz, lu par TranscriptionEngine.Warmup) -->
    <Content Include="Assets\Sounds\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The autocorrect lexicons must sit flat under Data/ beside the executable,
       where App.Autocorrect loads them. Transitive Content from
       Deckle.Autocorrect lands under "Deckle.Autocorrect\Data\"
       instead (the SDK prefixes referenced-project content with the project
       name) and re-declaring it here loses to that copy on source-path dedup,
       so the engine silently finds nothing and never arms. Flatten it
       deterministically after the build instead. -->
  <Target Name="FlattenAutocorrectLexicons" AfterTargets="Build">
    <ItemGroup>
      <_AutocorrectLexicon Include="..\Deckle.Autocorrect\Data\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AutocorrectLexicon)"
          DestinationFiles="@(_AutocorrectLexicon->'$(OutDir)Data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Windows App SDK 1.8 self-contained deployment contributes its own
       DirectML.dll through MsixContent. Deckle already publishes the DirectML
       version required by ONNX Runtime GenAI, and the two files share the same
       output path. Use Windows App SDK's exclusion hook before its payload is
       promoted to None/ResolvedFileToPublish; removing the resolved item later
       is too late for the .NET SDK's duplicate-output check. -->
  <Target Name="ExcludeWindowsAppSDKDirectMLRuntime"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix"
          DependsOnTargets="GetExtractMicrosoftWindowsAppSDKMsixFilesInputs"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\DirectML.dll" />
    </ItemGroup>
  </Target>
</Project>
