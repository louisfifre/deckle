<Window
    x:Class="Deckle.App.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.App"
    xmlns:diag="using:Deckle.App"
    xmlns:loggingControls="using:Deckle.Diagnostics.Logging.Ui.Controls"
    xmlns:catalog="using:Deckle.Catalog"
    Title="Deckle Logs">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- Foreground comes from a ThemeResource so WinUI re-resolves it
                     on a theme switch without recreating rows. -->
                <DataTemplate x:Key="NoWrap_Verbose">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Info">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Warning">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Error">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>

                <DataTemplate x:Key="Wrap_Verbose">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Info">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Warning">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Error">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>

                <!-- Dataset rows carry measurements, not a severity: one neutral
                     secondary text, one notch above Verbose, whatever their level. -->
                <DataTemplate x:Key="NoWrap_Dataset">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Dataset">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>

                <diag:LogEntryTemplateSelector x:Key="NoWrapSelector"
                    Verbose="{StaticResource NoWrap_Verbose}"
                    Info="{StaticResource NoWrap_Info}"
                    Warning="{StaticResource NoWrap_Warning}"
                    Error="{StaticResource NoWrap_Error}"
                    Dataset="{StaticResource NoWrap_Dataset}" />
                <diag:LogEntryTemplateSelector x:Key="WrapSelector"
                    Verbose="{StaticResource Wrap_Verbose}"
                    Info="{StaticResource Wrap_Info}"
                    Warning="{StaticResource Wrap_Warning}"
                    Error="{StaticResource Wrap_Error}"
                    Dataset="{StaticResource Wrap_Dataset}" />

                <MenuFlyout x:Key="LogContextFlyout"
                            Opening="OnLogContextFlyoutOpening">
                    <MenuFlyoutItem x:Uid="LogWindowCopyMenuItem"
                                    Icon="Copy"
                                    Click="OnContextCopyClick" />
                </MenuFlyout>

                <!-- Reduced padding only: native hover and selection feedback stay. -->
                <Style x:Key="LogItemContainerStyle" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ContextFlyout" Value="{StaticResource LogContextFlyout}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="LogWindowTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- Below the narrow threshold set in code-behind, SearchBox
                     collapses and SearchIconButton takes over. -->
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="8,0">
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="LogWindowSearchBox"
                                    QueryIcon="Find"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    TextChanged="OnSearchTextChanged"
                                    LostFocus="OnSearchBoxLostFocus" />
                    <Button x:Name="SearchIconButton"
                            x:Uid="LogWindowSearchIconButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSearchIconClick">
                        <FontIcon Glyph="{StaticResource Icon.Search}" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- Lateral commands, so RightHeader; the central Content slot
                     holds the search. Settings opens on the Diagnostics page,
                     the editor of what this window may show. -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SettingsButton"
                            x:Uid="LogWindowSettingsButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSettingsButtonClick">
                        <FontIcon Glyph="{StaticResource Icon.Settings}" FontSize="16" />
                    </Button>
                    <Button x:Name="PlaygroundButton"
                            x:Uid="LogWindowPlaygroundButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnPlaygroundButtonClick">
                        <FontIcon Glyph="{StaticResource Icon.Playground}" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <CommandBar Grid.Row="1"
                    x:Name="MainCommandBar"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                    <SplitButton x:Name="CopyButton"
                                 Click="OnCopyAllClick">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Copy}" FontSize="16" />
                                <TextBlock x:Uid="LogWindowCopyAllText" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="LogWindowCopySelectionMenuItem"
                                                Icon="Copy"
                                                Click="OnCopySelectionClick" />
                                <MenuFlyoutItem x:Uid="LogWindowCopyFilteredMenuItem"
                                                Icon="Filter"
                                                Click="OnCopyFilteredClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <SplitButton x:Name="SaveButton"
                                 Click="OnSaveAllClick">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Save}" FontSize="16" />
                                <TextBlock x:Uid="LogWindowSaveAllText" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="LogWindowSaveSelectionMenuItem"
                                                Icon="Save"
                                                Click="OnSaveSelectionClick" />
                                <MenuFlyoutItem x:Uid="LogWindowSaveFilteredMenuItem"
                                                Icon="Save"
                                                Click="OnSaveFilteredClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button x:Name="ClearButton"
                            Click="OnClearClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Delete}" FontSize="16" />
                            <TextBlock x:Uid="LogWindowClearText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </CommandBar.Content>

            <AppBarToggleButton x:Name="FiltersToggle"
                                x:Uid="LogWindowFiltersToggle"
                                DynamicOverflowOrder="0"
                                Click="OnFiltersToggleClick">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE71C;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarElementContainer DynamicOverflowOrder="2"
                                    Padding="{StaticResource AppBarButtonInnerBorderOverflowMargin}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                <ToggleButton x:Name="WrapToggle"
                              x:Uid="LogWindowWrapToggle"
                              FontSize="{ThemeResource CaptionTextBlockFontSize}"
                              IsChecked="False"
                              Click="OnWrapToggleClick" />
            </AppBarElementContainer>
            <AppBarElementContainer DynamicOverflowOrder="1"
                                    Padding="{StaticResource AppBarButtonInnerBorderOverflowMargin}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                <ToggleButton x:Name="AutoScrollToggle"
                              x:Uid="LogWindowAutoScrollToggle"
                              FontSize="{ThemeResource CaptionTextBlockFontSize}"
                              IsChecked="True" />
            </AppBarElementContainer>
        </CommandBar>

        <!-- Collapsing the editor never changes the active filter: the selection
             lives outside the lazy window, for the whole process. -->
        <loggingControls:LogFilterBar x:Name="FilterBar"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      FilterChanged="OnFilterChanged" />

        <Grid Grid.Row="3" x:Name="LogSurface">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Pinned above the list rather than in ListView.Header, which
                 scrolls away under auto-scroll. Each bar collapses while closed,
                 so its margin only counts while it shows. Messages are set in
                 LogWindow.Notices.cs, where they are formatted. -->
            <StackPanel Grid.Row="0">
                <!-- No bar for verbosity controls that are off: the Settings
                     button in the title bar opens their editor, the Diagnostics
                     page, where each control carries its description. -->
                <InfoBar x:Name="DroppedEntriesInfoBar"
                         Severity="Informational"
                         IsClosable="True"
                         IsOpen="False"
                         catalog:InfoBarLayout.CollapseWhenClosed="True"
                         Margin="12,0,12,8" />
            </StackPanel>

            <ListView x:Name="LogItems"
                      Grid.Row="1"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="12,4,12,0"
                      ItemContainerStyle="{StaticResource LogItemContainerStyle}"
                      ItemTemplateSelector="{StaticResource NoWrapSelector}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ContextFlyout="{StaticResource LogContextFlyout}"
                      RightTapped="OnLogItemsRightTapped">
                <ListView.Resources>
                    <!-- Native ScrollBar templates stay; only their transparent
                         rails and separator take the log surface brush, so text
                         beneath them cannot bleed through in either theme. -->
                    <StaticResource x:Key="ScrollBarBackground" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarBackgroundPointerOver" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarBackgroundDisabled" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarTrackFill" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarTrackFillPointerOver" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarTrackFillDisabled" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollViewerScrollBarSeparatorBackground" ResourceKey="LayerFillColorDefaultBrush" />
                </ListView.Resources>
                <!-- Empty on purpose: the default item transitions flash on
                     row insertion. Do not remove. -->
                <ListView.ItemContainerTransitions />
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C"
                                         Modifiers="Control"
                                         Invoked="OnCopyKeyboardAcceleratorInvoked" />
                </ListView.KeyboardAccelerators>
                <ListView.Footer>
                    <!-- Five real row heights of tail space, outside ItemsSource
                         so they cannot be selected, copied or exported. -->
                    <StackPanel IsHitTestVisible="False"
                                AutomationProperties.AccessibilityView="Raw">
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                    </StackPanel>
                </ListView.Footer>
            </ListView>
        </Grid>
    </Grid>
</Window>
