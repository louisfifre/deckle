<Window
    x:Class="Deckle.App.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.App"
    xmlns:diag="using:Deckle.App"
    xmlns:loggingControls="using:Deckle.Diagnostics.Logging.Ui.Controls"
    Title="Deckle Logs">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- 4 semantic levels per wrap dimension, swapped through
                     DataTemplateSelector on Word-wrap toggle. Each template
                     binds its Foreground to a ThemeResource: WinUI re-resolves
                     on theme switch without needing to recreate rows. -->
                <DataTemplate x:Key="NoWrap_Verbose">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Info">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Warning">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Error">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>

                <DataTemplate x:Key="Wrap_Verbose">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Info">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Warning">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Error">
                    <local:LogEntryRow
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>

                <!-- Telemetry rows (latency / corpus / microphone): rendered
                     as secondary text, one notch above Verbose (tertiary), so
                     they read as structured diagnostic metadata without
                     drowning in the Verbose firehose. Text is precomputed by
                     LogEntry when wrapping EventEntry. -->
                <DataTemplate x:Key="NoWrap_Latency">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Corpus">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Microphone">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="NoWrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Latency">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Corpus">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Microphone">
                    <local:LogEntryRow
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MessageWrapping="Wrap" />
                </DataTemplate>

                <diag:LogEntryTemplateSelector x:Key="NoWrapSelector"
                    Verbose="{StaticResource NoWrap_Verbose}"
                    Info="{StaticResource NoWrap_Info}"
                    Warning="{StaticResource NoWrap_Warning}"
                    Error="{StaticResource NoWrap_Error}"
                    Latency="{StaticResource NoWrap_Latency}"
                    Corpus="{StaticResource NoWrap_Corpus}"
                    Microphone="{StaticResource NoWrap_Microphone}" />
                <diag:LogEntryTemplateSelector x:Key="WrapSelector"
                    Verbose="{StaticResource Wrap_Verbose}"
                    Info="{StaticResource Wrap_Info}"
                    Warning="{StaticResource Wrap_Warning}"
                    Error="{StaticResource Wrap_Error}"
                    Latency="{StaticResource Wrap_Latency}"
                    Corpus="{StaticResource Wrap_Corpus}"
                    Microphone="{StaticResource Wrap_Microphone}" />

                <MenuFlyout x:Key="LogContextFlyout"
                            Opening="OnLogContextFlyoutOpening">
                    <MenuFlyoutItem x:Uid="LogWindowCopyMenuItem"
                                    Icon="Copy"
                                    Click="OnContextCopyClick" />
                </MenuFlyout>

                <!-- Compact container for dense log rendering: reduced padding,
                     native hover and selection feedback preserved. -->
                <Style x:Key="LogItemContainerStyle" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ContextFlyout" Value="{StaticResource LogContextFlyout}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Native title bar (Windows App SDK 1.6+) ────────────────────── -->
        <!-- The TitleBar control handles drag region, themed caption buttons,
             height, and exposes a Content slot where we place the SearchBox. -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="LogWindowTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- Fixed-width search, same pattern as WinUI 3 Gallery. Below
                     the narrow threshold (see code-behind), SearchBox collapses
                     and SearchIconButton takes over; clicking the icon reveals
                     the search, focus leaving it restores the icon. -->
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="8,0">
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="LogWindowSearchBox"
                                    QueryIcon="Find"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    TextChanged="OnSearchTextChanged"
                                    LostFocus="OnSearchBoxLostFocus" />
                    <Button x:Name="SearchIconButton"
                            x:Uid="LogWindowSearchIconButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSearchIconClick">
                        <FontIcon Glyph="{StaticResource Icon.Search}" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- ── Command bar: filter editor + journal actions ──────────────── -->
        <CommandBar Grid.Row="1"
                    x:Name="MainCommandBar"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    IsOpen="False">
            <!-- Content stays anchored left while the primary view controls
                 use CommandBar's native right alignment and dynamic overflow. -->
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                    <SplitButton x:Name="CopyButton"
                                 Click="OnCopyAllClick">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Copy}" FontSize="16" />
                                <TextBlock x:Uid="LogWindowCopyAllText" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="LogWindowCopySelectionMenuItem"
                                                Icon="Copy"
                                                Click="OnCopySelectionClick" />
                                <MenuFlyoutItem x:Uid="LogWindowCopyFilteredMenuItem"
                                                Icon="Filter"
                                                Click="OnCopyFilteredClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <SplitButton x:Name="SaveButton"
                                 Click="OnSaveAllClick">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Save}" FontSize="16" />
                                <TextBlock x:Uid="LogWindowSaveAllText" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="LogWindowSaveSelectionMenuItem"
                                                Icon="Save"
                                                Click="OnSaveSelectionClick" />
                                <MenuFlyoutItem x:Uid="LogWindowSaveFilteredMenuItem"
                                                Icon="Save"
                                                Click="OnSaveFilteredClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button x:Name="ClearButton"
                            Click="OnClearClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Delete}" FontSize="16" />
                            <TextBlock x:Uid="LogWindowClearText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </CommandBar.Content>

            <!-- Filters remains the leftmost view control. Word wrap and
                 Auto-scroll migrate to the overflow first as width shrinks. -->
            <AppBarToggleButton x:Name="FiltersToggle"
                                x:Uid="LogWindowFiltersToggle"
                                DynamicOverflowOrder="0"
                                Click="OnFiltersToggleClick">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE71C;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarElementContainer DynamicOverflowOrder="2"
                                    Padding="{StaticResource AppBarButtonInnerBorderOverflowMargin}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                <ToggleButton x:Name="WrapToggle"
                              x:Uid="LogWindowWrapToggle"
                              FontSize="{ThemeResource CaptionTextBlockFontSize}"
                              IsChecked="False"
                              Click="OnWrapToggleClick" />
            </AppBarElementContainer>
            <AppBarElementContainer DynamicOverflowOrder="1"
                                    Padding="{StaticResource AppBarButtonInnerBorderOverflowMargin}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                <ToggleButton x:Name="AutoScrollToggle"
                              x:Uid="LogWindowAutoScrollToggle"
                              FontSize="{ThemeResource CaptionTextBlockFontSize}"
                              IsChecked="True" />
            </AppBarElementContainer>
        </CommandBar>

        <!-- The editor can collapse without changing the active lens. Its
             process-lifetime selection is owned outside the lazy window. -->
        <loggingControls:LogFilterBar x:Name="FilterBar"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      FilterChanged="OnFilterChanged" />

        <!-- ── Log surface ────────────────────────────────────────────────── -->
        <!-- ListView owns selection, virtualization and scrolling. Extended
             selection supplies the standard Ctrl/Shift gestures. -->
        <Grid Grid.Row="3" x:Name="LogSurface">
            <ListView x:Name="LogItems"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="12,4,12,0"
                      ItemContainerStyle="{StaticResource LogItemContainerStyle}"
                      ItemTemplateSelector="{StaticResource NoWrapSelector}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ContextFlyout="{StaticResource LogContextFlyout}"
                      RightTapped="OnLogItemsRightTapped">
                <ListView.Resources>
                    <!-- Keep native ScrollBar templates/thumbs and only replace
                         their transparent rails + separator with the exact log
                         surface brush. Text may extend beneath them but cannot
                         bleed through in either theme. -->
                    <StaticResource x:Key="ScrollBarBackground" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarBackgroundPointerOver" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarBackgroundDisabled" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarTrackFill" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarTrackFillPointerOver" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollBarTrackFillDisabled" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="ScrollViewerScrollBarSeparatorBackground" ResourceKey="LayerFillColorDefaultBrush" />
                </ListView.Resources>
                <ListView.ItemContainerTransitions />
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C"
                                         Modifiers="Control"
                                         Invoked="OnCopyKeyboardAcceleratorInvoked" />
                </ListView.KeyboardAccelerators>
                <ListView.Footer>
                    <!-- Five real, measured row heights. This structural tail
                         never enters ItemsSource, so it cannot be selected,
                         copied or exported. -->
                    <StackPanel IsHitTestVisible="False"
                                AutomationProperties.AccessibilityView="Raw">
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                        <TextBlock Text=" " FontFamily="Consolas" FontSize="12" Margin="4,1" />
                    </StackPanel>
                </ListView.Footer>
            </ListView>
        </Grid>
    </Grid>
</Window>
