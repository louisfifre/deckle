<Window
    x:Class="Deckle.App.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.App"
    xmlns:diag="using:Deckle.App"
    xmlns:loggingControls="using:Deckle.Diagnostics.Logging.Ui.Controls"
    Title="Deckle Logs">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- 4 semantic levels per wrap dimension, swapped through
                     DataTemplateSelector on Word-wrap toggle. Each template
                     binds its Foreground to a ThemeResource: WinUI re-resolves
                     on theme switch without needing to recreate rows. -->
                <DataTemplate x:Key="NoWrap_Verbose">
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Info">
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Warning">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Error">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>

                <DataTemplate x:Key="Wrap_Verbose">
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Info">
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Warning">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Error">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>

                <!-- Telemetry rows (latency / corpus / microphone): rendered
                     as secondary text, one notch above Verbose (tertiary), so
                     they read as structured diagnostic metadata without
                     drowning in the Verbose firehose. Text is precomputed by
                     LogEntry when wrapping EventEntry. -->
                <DataTemplate x:Key="NoWrap_Latency">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Corpus">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="NoWrap_Microphone">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Latency">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Corpus">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>
                <DataTemplate x:Key="Wrap_Microphone">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{Binding TimestampText}"
                             FontSize="{ThemeResource CaptionTextBlockFontSize}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SourceText}" />
                        <Run Text="{Binding MessageText}" />
                    </TextBlock>
                </DataTemplate>

                <diag:LogEntryTemplateSelector x:Key="NoWrapSelector"
                    Verbose="{StaticResource NoWrap_Verbose}"
                    Info="{StaticResource NoWrap_Info}"
                    Warning="{StaticResource NoWrap_Warning}"
                    Error="{StaticResource NoWrap_Error}"
                    Latency="{StaticResource NoWrap_Latency}"
                    Corpus="{StaticResource NoWrap_Corpus}"
                    Microphone="{StaticResource NoWrap_Microphone}" />
                <diag:LogEntryTemplateSelector x:Key="WrapSelector"
                    Verbose="{StaticResource Wrap_Verbose}"
                    Info="{StaticResource Wrap_Info}"
                    Warning="{StaticResource Wrap_Warning}"
                    Error="{StaticResource Wrap_Error}"
                    Latency="{StaticResource Wrap_Latency}"
                    Corpus="{StaticResource Wrap_Corpus}"
                    Microphone="{StaticResource Wrap_Microphone}" />

                <!-- Compact container for dense log rendering: reduced padding,
                     hover highlight preserved (signals click-to-copy). -->
                <Style x:Key="LogItemContainerStyle" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Native title bar (Windows App SDK 1.6+) ────────────────────── -->
        <!-- The TitleBar control handles drag region, themed caption buttons,
             height, and exposes a Content slot where we place the SearchBox. -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="LogWindowTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- Fixed-width search, same pattern as WinUI 3 Gallery. Below
                     the narrow threshold (see code-behind), SearchBox collapses
                     and SearchIconButton takes over; clicking the icon reveals
                     the search, focus leaving it restores the icon. -->
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="8,0">
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="LogWindowSearchBox"
                                    QueryIcon="Find"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    TextChanged="OnSearchTextChanged"
                                    LostFocus="OnSearchBoxLostFocus" />
                    <Button x:Name="SearchIconButton"
                            x:Uid="LogWindowSearchIconButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSearchIconClick">
                        <FontIcon Glyph="{StaticResource Icon.Search}" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- ── Command bar: filter editor + journal actions ──────────────── -->
        <CommandBar Grid.Row="1"
                    x:Name="MainCommandBar"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    IsOpen="False">
            <!-- Content stays anchored left while the primary view controls
                 use CommandBar's native right alignment and dynamic overflow. -->
            <CommandBar.Content>
                <CommandBar DefaultLabelPosition="Right"
                            Background="Transparent"
                            IsDynamicOverflowEnabled="False"
                            IsOpen="False">
                    <AppBarButton x:Name="CopyButton"
                                  x:Uid="LogWindowCopyButton"
                                  Click="OnCopyClick">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{StaticResource Icon.Copy}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="SaveButton"
                                  x:Uid="LogWindowSaveButton"
                                  Click="OnSaveClick">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{StaticResource Icon.Save}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="ClearButton"
                                  x:Uid="LogWindowClearButton"
                                  Click="OnClearClick">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{StaticResource Icon.Delete}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </CommandBar.Content>

            <!-- Filters remains the leftmost view control. Word wrap and
                 Auto-scroll migrate to the overflow first as width shrinks. -->
            <AppBarToggleButton x:Name="FiltersToggle"
                                x:Uid="LogWindowFiltersToggle"
                                DynamicOverflowOrder="0"
                                Click="OnFiltersToggleClick">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE71C;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarElementContainer DynamicOverflowOrder="2"
                                    Padding="{StaticResource AppBarButtonInnerBorderOverflowMargin}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                <ToggleButton x:Name="WrapToggle"
                              x:Uid="LogWindowWrapToggle"
                              FontSize="{ThemeResource CaptionTextBlockFontSize}"
                              IsChecked="False"
                              Click="OnWrapToggleClick" />
            </AppBarElementContainer>
            <AppBarElementContainer DynamicOverflowOrder="1"
                                    Padding="{StaticResource AppBarButtonInnerBorderOverflowMargin}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                <ToggleButton x:Name="AutoScrollToggle"
                              x:Uid="LogWindowAutoScrollToggle"
                              FontSize="{ThemeResource CaptionTextBlockFontSize}"
                              IsChecked="True" />
            </AppBarElementContainer>
        </CommandBar>

        <!-- The editor can collapse without changing the active lens. Its
             process-lifetime selection is owned outside the lazy window. -->
        <loggingControls:LogFilterBar x:Name="FilterBar"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      FilterChanged="OnFilterChanged" />

        <!-- ── Log surface ────────────────────────────────────────────────── -->
        <!-- ListView owns selection, virtualization and scrolling. Extended
             selection supplies the standard Ctrl/Shift gestures; every copy
             entry point uses the same selection-or-visible rule. -->
        <Grid Grid.Row="3" x:Name="LogSurface">
            <!-- Bottom padding 24 keeps the last line above the horizontal
                 scrollbar (which floats over the content in WinUI 3). Without
                 it, when scrolled to the bottom, the freshest line is masked
                 by the scrollbar — and the bottom is exactly where new entries
                 land. -->
            <ListView x:Name="LogItems"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="12,4,12,24"
                      ItemContainerStyle="{StaticResource LogItemContainerStyle}"
                      ItemTemplateSelector="{StaticResource NoWrapSelector}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerTransitions />
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C"
                                         Modifiers="Control"
                                         Invoked="OnCopyKeyboardAcceleratorInvoked" />
                </ListView.KeyboardAccelerators>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="LogWindowCopyMenuItem"
                                        Icon="Copy"
                                        Click="OnCopyClick" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
        </Grid>
    </Grid>
</Window>
