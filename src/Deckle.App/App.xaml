<Application
    x:Class="Deckle.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Deckle.Catalog ships the centralized Segoe Fluent Icons
                     ResourceDictionary. Keys are consumed everywhere via
                     {StaticResource Icon.Microphone} etc. The matching
                     constants live in Deckle.Catalog.Glyphs for code-behind. -->
                <ResourceDictionary Source="ms-appx:///Deckle.Catalog/Themes/Icons.xaml" />
                <!-- Deckle.Shell.TrayMenu ships ToggleSwitchMenuItemStyle, a
                     custom Style for MenuFlyoutItem (not ToggleMenuFlyoutItem)
                     that draws a hand-made on/off pill on the right edge in
                     place of the canonical checkmark. Applied to the Ambient
                     Light item in the tray context menu. -->
                <ResourceDictionary Source="ms-appx:///Deckle.Shell.TrayMenu/Themes/TrayMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Resources shared by all Settings pages and their UserControls.
                 Promoted to App level so UserControls (Settings/Llm/*) access
                 them without duplication. WhisperPage/GeneralPage still
                 redefine the same keys locally (shadow without effect); this
                 will be cleaned up during their refactor. -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                   TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>

            <!-- No custom "Critical / destructive" style at App level. WinUI 3
                 does not provide one, and imitating it with hardcoded reds
                 produces a button that does not follow the theme
                 (light/dark/contrast). Official Microsoft pattern for
                 destructive actions: confirmation ContentDialog, not a red
                 button. Forget / Remove stay DefaultButtonStyle; the dialog
                 they open carries the signal. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
