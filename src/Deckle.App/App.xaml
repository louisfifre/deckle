<Application
    x:Class="Deckle.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Deckle.Catalog/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- At App level so the UserControls inside Settings pages reach them. -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                   TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>

            <!-- No destructive button style: WinUI 3 provides none, and hardcoded
                 reds do not follow the theme. Destructive actions keep the default
                 button style and confirm through a ContentDialog, which carries
                 the signal. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
