<UserControl
    x:Class="Deckle.App.LogEntryRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The invisible probes size the timestamp and severity columns from the same
         font as their visible values, rather than from numeric guesses. -->
    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="00:00:00.000"
                       Opacity="0"
                       IsHitTestVisible="False"
                       FontFamily="Consolas"
                       FontSize="12" />
            <TextBlock Text="{Binding TimestampText}"
                       FontFamily="Consolas"
                       FontSize="{ThemeResource CaptionTextBlockFontSize}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <Grid Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="00000000"
                       Opacity="0"
                       IsHitTestVisible="False"
                       FontFamily="Consolas"
                       FontSize="12" />
            <TextBlock Text="{Binding SeverityText}"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="{x:Bind Root.Foreground, Mode=OneWay}" />
        </Grid>

        <!-- Fixed width, not an ActualWidth binding (it never notifies, so MaxWidth stayed 0).
             120 = 108 for 16 Consolas glyphs (longest display name "Precision Scroll",
             16, from LogLineFormatter.DisplayName) + 12 gap. -->
        <TextBlock Grid.Column="2"
                   Margin="0,0,12,0"
                   Text="{Binding SourceText}"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{x:Bind Root.Foreground, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   ToolTipService.ToolTip="{Binding SourceText}" />

        <TextBlock Grid.Column="3"
                   Text="{Binding MessageText}"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{x:Bind Root.Foreground, Mode=OneWay}"
                   TextWrapping="{x:Bind MessageWrapping, Mode=OneWay}" />
    </Grid>
</UserControl>
