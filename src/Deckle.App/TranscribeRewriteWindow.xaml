<Window
    x:Class="Deckle.App.TranscribeRewriteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.App"
    Title="Transcribe and rewrite">

    <!-- specs/transcribe-and-rewrite/deckle-transcribe-and-rewrite.md, form C: one text field at the
         centre, the way in (a file) top left, what to do with the text top
         right, the rewrite bottom left and its settings alone bottom right.
         Several files chosen at once put the list of those files where the
         field was (TranscribeRewriteWindow.Files.cs); the rows around it stay,
         and a header above it says where the texts are saved. -->
    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="TranscribeRewriteTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <!-- Its label and tooltip change with the window: it opens a
                         file into the field, or adds files to the list
                         (TranscribeRewriteWindow.Commands.cs, UpdateCommands). -->
                    <Button x:Name="TranscribeFileButton" Click="OnTranscribeFileClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock x:Name="TranscribeFileLabel" />
                        </StackPanel>
                    </Button>
                    <!-- A batch of the list in progress: the file running finishes. -->
                    <Button x:Name="StopButton" Click="OnStopClick" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="16" />
                            <TextBlock x:Name="StopLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- What to do with the field's text: nothing to do on the list,
                     where each file is already saved beside its audio. -->
                <StackPanel x:Name="TextCommands" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="UndoButton" Click="OnUndoClick" IsEnabled="False">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                    </Button>
                    <Button x:Name="RedoButton" Click="OnRedoClick" IsEnabled="False">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                    </Button>
                    <Button x:Name="CopyButton" Click="OnCopyClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                            <TextBlock x:Uid="TranscribeRewriteCopyLabel" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Click="OnSaveClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" />
                            <TextBlock x:Uid="TranscribeRewriteSaveLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="Notice" Grid.Row="1" Margin="0,8,0,0" IsOpen="False" IsClosable="True" />

            <!-- The outline host lies over the field and takes no input: the
                 HUD's processing stroke is attached to it while a run works.
                 The field takes the overlay radius, 8 dip, the one the stroke
                 is drawn with, so field, stroke and clip share their corners.
                 Its border is one even line in every state (Louis, 2026-11-14):
                 the stronger bottom line and the accent bar of focus belong
                 to a single-line box, not to a page of text. -->
            <Grid x:Name="EditorArea" Grid.Row="3" Margin="0,8,0,0">
                <RichEditBox x:Name="Editor"
                             x:Uid="TranscribeRewriteEditor"
                             CornerRadius="{ThemeResource OverlayCornerRadius}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsSpellCheckEnabled="True"
                             ClipboardCopyFormat="PlainText"
                             DisabledFormattingAccelerators="All"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="OnEditorTextChanged"
                             Paste="OnEditorPaste">
                    <!-- Per theme, so a theme switch swaps the brushes; High
                         Contrast keeps the system's own text-box border. -->
                    <RichEditBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </ResourceDictionary>
                    </RichEditBox.Resources>
                </RichEditBox>
                <Grid x:Name="OutlineHost" IsHitTestVisible="False" />
            </Grid>

            <!-- Above the list: how far the batch is, and where the texts go,
                 once for every file. -->
            <StackPanel x:Name="FilesHeader" Grid.Row="2" Margin="0,8,0,0" Spacing="2" Visibility="Collapsed">
                <TextBlock x:Name="FilesSummary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run x:Uid="TranscribeRewriteFilesDestinationRun" /> <Hyperlink Click="OnOpenFilesFolderClick"><Run x:Uid="TranscribeRewriteOpenFolderRun" /></Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Above a file of the list opened in the field: where it sits in
                 the list, and that its changes save themselves. -->
            <StackPanel x:Name="FileHeader" Grid.Row="2" Margin="0,8,0,0" Spacing="2" Visibility="Collapsed">
                <BreadcrumbBar x:Name="FileCrumbs" ItemClicked="OnFileCrumbClick" />
                <TextBlock x:Uid="TranscribeRewriteAutoSavedCaption"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- The files of the list: a status mark, the file's name, its state
                 and duration, and the opening of its text. A click opens the
                 whole text in the field; the context menu shows the file in its
                 folder. -->
            <ListView x:Name="FileList"
                      Grid.Row="3"
                      Margin="0,8,0,0"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnFileItemClick"
                      Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileTranscriptionItem">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="TranscribeRewriteShowInFolderItem"
                                                    Tag="{x:Bind}"
                                                    Click="OnShowInFolderClick" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- One status slot: a ring while it works, then one mark. -->
                            <Grid VerticalAlignment="Top" Height="24">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                <FontIcon Glyph="&#xEC61;" FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          Visibility="{x:Bind local:TranscribeRewriteWindow.SavedMark(State, RewriteFailed), Mode=OneWay}" />
                                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind local:TranscribeRewriteWindow.CautionMark(State, RewriteFailed), Mode=OneWay}" />
                                <FontIcon Glyph="&#xEB90;" FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{x:Bind local:TranscribeRewriteWindow.FailedMark(State), Mode=OneWay}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind local:TranscribeRewriteWindow.DetailOf(State, RewriteFailed, Rewritten, DurationText), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Preview, Mode=OneWay}"
                                           Visibility="{x:Bind HasText, Mode=OneWay}"
                                           Margin="0,6,0,0"
                                           MaxLines="2"
                                           TextWrapping="Wrap"
                                           TextTrimming="WordEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE76C;" FontSize="12"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind HasText, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="4" Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RewriteButton"
                        Grid.Column="0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnRewriteClick"
                        IsEnabled="False">
                    <!-- Rewrite on the field, Rewrite all on the list: set in code. -->
                    <TextBlock x:Name="RewriteLabel" />
                </Button>
                <ComboBox x:Name="ProfileBox"
                          Grid.Column="1"
                          MinWidth="180"
                          DisplayMemberPath="Name" />
                <Button x:Name="RewriteSettingsButton" Grid.Column="3" Click="OnRewriteSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
