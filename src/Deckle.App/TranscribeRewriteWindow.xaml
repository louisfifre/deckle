<Window
    x:Class="Deckle.App.TranscribeRewriteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transcribe and rewrite">

    <!-- specs/deckle-transcribe-and-rewrite.md, form C: one text field at the
         centre, the way in (a file) top left, what to do with the text top
         right, the rewrite bottom left and its settings alone bottom right. -->
    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="TranscribeRewriteTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="TranscribeFileButton" Grid.Column="0" Click="OnTranscribeFileClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock x:Uid="TranscribeRewriteTranscribeFileLabel" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="UndoButton" Click="OnUndoClick" IsEnabled="False">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                    </Button>
                    <Button x:Name="RedoButton" Click="OnRedoClick" IsEnabled="False">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                    </Button>
                    <Button x:Name="CopyButton" Click="OnCopyClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                            <TextBlock x:Uid="TranscribeRewriteCopyLabel" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Click="OnSaveClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" />
                            <TextBlock x:Uid="TranscribeRewriteSaveLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" />

            <!-- The outline host lies over the field and takes no input: the
                 HUD's processing stroke is attached to it while a run works.
                 The field takes the overlay radius, 8 dip, the one the stroke
                 is drawn with, so field, stroke and clip share their corners.
                 Its border is one even line in every state (Louis, 2026-11-14):
                 the stronger bottom line and the accent bar of focus belong
                 to a single-line box, not to a page of text. -->
            <Grid Grid.Row="2">
                <RichEditBox x:Name="Editor"
                             x:Uid="TranscribeRewriteEditor"
                             CornerRadius="{ThemeResource OverlayCornerRadius}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsSpellCheckEnabled="True"
                             ClipboardCopyFormat="PlainText"
                             DisabledFormattingAccelerators="All"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="OnEditorTextChanged"
                             Paste="OnEditorPaste">
                    <!-- Per theme, so a theme switch swaps the brushes; High
                         Contrast keeps the system's own text-box border. -->
                    <RichEditBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </ResourceDictionary>
                    </RichEditBox.Resources>
                </RichEditBox>
                <Grid x:Name="OutlineHost" IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RewriteButton"
                        Grid.Column="0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnRewriteClick"
                        IsEnabled="False">
                    <TextBlock x:Uid="TranscribeRewriteRewriteLabel" />
                </Button>
                <ComboBox x:Name="ProfileBox"
                          Grid.Column="1"
                          MinWidth="180"
                          DisplayMemberPath="Name" />
                <Button x:Name="RewriteSettingsButton" Grid.Column="3" Click="OnRewriteSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
