<Window
    x:Class="Deckle.App.FileTranscriptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.App"
    Title="Transcribe audio to text">

    <!-- specs/deckle-transcribe-and-rewrite.md, File assistant: one screen per
         step, the numbered steps listed on the side, Back and Next at the
         bottom, as in a Windows setup. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="FileTranscriptionTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16" ColumnSpacing="24" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The steps, shown, not clicked: the current one carries the
                 list's selection pill, the way a setup marks where you are. -->
            <ListView x:Name="StepList"
                      Grid.Column="0"
                      SelectionMode="Single"
                      IsHitTestVisible="False"
                      IsTabStop="False"
                      AutomationProperties.AccessibilityView="Raw" />

            <!-- ① Files -->
            <Grid x:Name="FilesPanel" Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Uid="FileTranscriptionFilesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Grid.Row="1" Click="OnAddFilesClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock x:Uid="FileTranscriptionAddFilesLabel" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FilesEmptyText"
                           x:Uid="FileTranscriptionFilesEmpty"
                           Grid.Row="2"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ListView x:Name="FileList"
                          Grid.Row="2"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileTranscriptionItem">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DurationText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        x:Uid="FileTranscriptionRemoveButton"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="OnRemoveFileClick">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ② Rewrite -->
            <StackPanel x:Name="RewritePanel" Grid.Column="1" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Uid="FileTranscriptionRewriteTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="RewriteSwitch"
                              x:Uid="FileTranscriptionRewriteSwitch"
                              Toggled="OnRewriteToggled" />
                <ComboBox x:Name="ProfileBox"
                          x:Uid="FileTranscriptionProfileBox"
                          MinWidth="200"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnProfileChanged"
                          Visibility="Collapsed" />
                <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <!-- ③ Result -->
            <Grid x:Name="ResultPanel" Grid.Column="1" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Uid="FileTranscriptionResultTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView x:Name="ResultList"
                          Grid.Row="1"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileTranscriptionItem">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind local:FileTranscriptionWindow.StatusOf(State, RewriteFailed, OutputPath), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        x:Uid="FileTranscriptionOpenFolderButton"
                                        Visibility="{x:Bind IsDone, Mode=OneWay}"
                                        Click="OnOpenFolderClick" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="BackButton" MinWidth="96" Click="OnBackClick" />
                <Button x:Name="NextButton" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
