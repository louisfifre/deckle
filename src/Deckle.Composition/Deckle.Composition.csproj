<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Composition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WindowsAppSDK : Microsoft.UI.Composition (Visual / Compositor /
         CompositionEffectFactory / animations) consumed by the conic stroke
         and digit-reveal primitives. Version pinned identical to Deckle.csproj: a
         single WinAppSDK runtime loaded per process. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- Win2D: Direct2D-backed CanvasDrawingSession on
         CompositionDrawingSurface. Used to paint the rainbow conic gradient
         and arc mask: pure primitives, no dependency
         XAML. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
  </ItemGroup>
</Project>
