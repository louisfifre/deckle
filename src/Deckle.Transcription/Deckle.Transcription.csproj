<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Transcription</RootNamespace>
    <!-- WinUI XAML compilation : Deckle.Transcription now ships WhisperPage.xaml +
         WhisperViewModel.cs (moved from Deckle.Settings in slice C1). The
         engine, native runtime setup, and capture host stay in this same
         assembly — they share the lifecycle and the Whisp module's owner
         is the natural home for both engine and UI. -->
    <UseWinUI>true</UseWinUI>
    <!-- Neutral language for the lib's PRI fallback. Mirrors Deckle.csproj. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in WhisperPage
         resolve against the Deckle.Transcription/Resources subtree. The resw
         under Strings/en-US/ is a copy of the App's resw — same pattern
         as Deckle.Settings (cf. Microsoft Learn "Localize a class
         library", PowerToys, WindowsAppSDK#3451). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions aligned on Deckle.csproj. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- MVVM Toolkit — [ObservableProperty] in WhisperViewModel. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- SettingsCard / SettingsExpander — WhisperPage canonical layout. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes internal algorithm helpers (EnergySegmenter) to the test project,
         so they can be unit-tested in isolation without being made public. Same
         MSBuild→Roslyn [InternalsVisibleTo] pattern as Deckle.Hud / Deckle.Lighting.Ambient. -->
    <InternalsVisibleTo Include="Deckle.Transcription.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <!-- VAD module. One-way dependency: the orchestrator calls the VAD, never the
         reverse. -->
    <ProjectReference Include="..\Deckle.Vad\Deckle.Vad.csproj" />
    <ProjectReference Include="..\Deckle.Llm\Deckle.Llm.csproj" />
    <ProjectReference Include="..\Deckle.Llm.Rewrite\Deckle.Llm.Rewrite.csproj" />
    <!-- For SettingsHost.RestartApp — cross-assembly App-side hook called
         from WhisperPage's "Restart now" footer. WhisperPage participates
         in the Settings shell UI; the back-reference is intentional. -->
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
  </ItemGroup>
</Project>
