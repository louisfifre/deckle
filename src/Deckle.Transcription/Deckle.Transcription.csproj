<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Transcription</RootNamespace>
  </PropertyGroup>

  <!-- The transcription logic: the engine and its pipelines (monolithic,
       streaming, file), the energy segmenter, the transcription settings and
       their file, the dictation and take-audio recovery, the corpus writer and
       the DeckleWhisp event source. No XAML, no UseWinUI and no project that
       holds XAML, so the projects that transcribe through it (the Whisper
       backend, Setup) never run the XAML compiler on its account,
       and every rule here is tested without a window.
       Deckle.Transcription.Views presents it: the Transcription settings page
       and its Decoding and Streaming subpages. -->
  <ItemGroup>
    <!-- DPAPI seal of the dictation recovery file (DictationRecoveryStore). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes internal algorithm helpers (EnergySegmenter) to the test project,
         so they can be unit-tested in isolation without being made public. Same
         MSBuild→Roslyn [InternalsVisibleTo] pattern as Deckle.Hud / Deckle.Lighting.Ambient. -->
    <InternalsVisibleTo Include="Deckle.Transcription.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <!-- Loc: the engine's feedback strings, read from the App's root map, and
         the page label a failed model load names, read from the Views
         assembly's PRI subtree (see TranscriptionEngine.PageStrings). -->
    <ProjectReference Include="..\Deckle.Localization\Deckle.Localization.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <!-- TranscriptionActivityScope: a take's or a file's worker holds the
         transcription activity open for the operational log while it runs. -->
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <!-- VAD module. One-way dependency: the orchestrator calls the VAD, never the
         reverse. -->
    <ProjectReference Include="..\Deckle.Vad\Deckle.Vad.csproj" />
    <ProjectReference Include="..\Deckle.Llm\Deckle.Llm.csproj" />
    <ProjectReference Include="..\Deckle.Llm.Rewrite\Deckle.Llm.Rewrite.csproj" />
  </ItemGroup>
</Project>
