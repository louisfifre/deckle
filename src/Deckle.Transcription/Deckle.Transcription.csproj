<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Transcription</RootNamespace>
    <!-- The module's settings UI (WhisperPage) ships in the engine's assembly:
         both belong to the Whisp module and share its lifecycle. -->
    <UseWinUI>true</UseWinUI>
    <!-- Neutral language for the lib's PRI fallback. Mirrors Deckle.App.csproj. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in WhisperPage
         resolve against the Deckle.Transcription/Resources subtree
         (cf. Microsoft Learn "Localize a class library", PowerToys,
         WindowsAppSDK#3451). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- MVVM Toolkit — [ObservableProperty] in WhisperViewModel. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- SettingsCard / SettingsExpander — WhisperPage canonical layout. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <!-- Win2D: Direct2D-backed CanvasControl for HangoverCurveCanvas — the
         segmenter's hangover plot is drawn in immediate mode (a single Draw per
         Invalidate) instead of recreating a XAML Shapes tree on every resize. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Transcription.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <!-- VAD module. One-way dependency: the orchestrator calls the VAD, never the
         reverse. -->
    <ProjectReference Include="..\Deckle.Vad\Deckle.Vad.csproj" />
    <!-- Shared preset family (the cut presets). One-way dependency. -->
    <ProjectReference Include="..\Deckle.Presets\Deckle.Presets.csproj" />
    <ProjectReference Include="..\Deckle.Llm\Deckle.Llm.csproj" />
    <ProjectReference Include="..\Deckle.Llm.Rewrite\Deckle.Llm.Rewrite.csproj" />
    <!-- For SettingsHost (restart, setup wizard, provisioning probe) and the
         shell's overlay and paste settings. WhisperPage participates in the
         Settings shell UI; the back-reference is intentional. -->
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
  </ItemGroup>
</Project>
