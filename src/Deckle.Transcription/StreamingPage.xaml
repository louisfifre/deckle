<Page
    x:Class="Deckle.Transcription.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The Streaming page of the Transcription module: the pipeline switch
         alone at the top, then speech filtering (the Silero detector and its four
         parameters), then segmentation (the silence threshold, then the cut curve
         with its anchors in its legend). Everything under the switch hides while
         streaming is off (mask, never grey): the cards through their own
         VisibleWhen, the section titles through the binds below. Every card is
         composed from WhisperViewModel's manifests. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb (Transcription › Streaming),
                     one line of description, Reset all (active-when-dirty, confirmed
                     by the block). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="StreamingPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The pipeline switch, first and alone. Composed:
                     WhisperViewModel.StreamingSwitch. -->
                <StackPanel x:Name="SwitchHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Speech filtering ────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="WhisperPageSpeechFilteringSection"
                                         Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                    <!-- The VAD group: its switch, then the four detection
                         parameters while it is on (WhisperViewModel.VadSettings). -->
                    <StackPanel x:Name="VadHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Segmentation ────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="StreamingPageSegmentationSection"
                                         Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                    <!-- The silence threshold, then the cut curve at full width
                         with the four hangover anchors in its legend
                         (WhisperViewModel.SegmentationSettings). -->
                    <StackPanel x:Name="SegmentationHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
