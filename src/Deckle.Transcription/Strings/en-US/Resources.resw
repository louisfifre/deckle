  <!-- The three output filters forbid tokens to the decoder; none removes text
       after the fact (whisper.cpp documentation; not checked in the shipped
       v1.9.1 source). suppress_nst forbids the non-speech symbols, suppress_blank
       a blank or end-of-text as a segment's first token, suppress_regex every
       token whose text matches. The headers still say "Remove"/"Drop": their
       renaming waits on the Decoding rework (2026-11-07 review, change 5). -->
  <data name="WhisperSuppressNstCard.Header" xml:space="preserve">
    <value>Remove sound tags</value>
  </data>
  <data name="WhisperSuppressNstCard.Description" xml:space="preserve">
    <value>Whisper may not write the symbols sound tags are made of, such as brackets and music notes, anywhere in the text.</value>
  </data>
  <data name="WhisperSuppressBlankCard.Header" xml:space="preserve">
    <value>Drop empty segments</value>
  </data>
  <data name="WhisperSuppressBlankCard.Description" xml:space="preserve">
    <value>Whisper may not start a segment with a blank or end it before its first word.</value>
  </data>
  <data name="WhisperSuppressRegexCard.Header" xml:space="preserve">
    <value>Remove a pattern</value>
  </data>
  <data name="WhisperSuppressRegexCard.Description" xml:space="preserve">
    <value>Whisper may not write a token that matches this regular expression.</value>
  </data>
  <data name="WhisperUseContextCard.Header" xml:space="preserve">
    <value>Carry context between segments</value>
  </data>
  <data name="WhisperUseContextCard.Description" xml:space="preserve">
    <value>Each segment primes the next for consistent wording; turn it off if the text starts repeating itself.</value>
  </data>
  <data name="WhisperMaxTokensCard.Header" xml:space="preserve">
    <value>Maximum tokens per segment</value>
  </data>
  <data name="WhisperMaxTokensCard.Description" xml:space="preserve">
    <value>How many tokens of the previous text prime each segment.</value>
  </data>
  <data name="WhisperUseBeamSearchCard.Header" xml:space="preserve">
    <value>Explore several hypotheses at once</value>
  </data>
  <data name="WhisperUseBeamSearchCard.Description" xml:space="preserve">
    <value>More accurate, a little slower.</value>
  </data>
  <data name="WhisperBeamSizeCard.Header" xml:space="preserve">
    <value>Number of hypotheses</value>
  </data>
  <data name="WhisperBeamSizeCard.Description" xml:space="preserve">
    <value>Higher is more accurate and slower.</value>
  </data>
  <data name="WhisperTemperatureCard.Header" xml:space="preserve">
    <value>Temperature</value>
  </data>
  <data name="WhisperTemperatureCard.Description" xml:space="preserve">
    <value>The randomness of the decoding; raise it only if the model keeps repeating a phrase.</value>
  </data>
  <data name="WhisperTemperatureIncrementCard.Header" xml:space="preserve">
    <value>Retry temperature step</value>
  </data>
  <data name="WhisperTemperatureIncrementCard.Description" xml:space="preserve">
    <value>An uncertain segment is retried with this much more randomness each time.</value>
  </data>
  <data name="WhisperEntropyCard.Header" xml:space="preserve">
    <value>Minimum entropy</value>
  </data>
  <data name="WhisperEntropyCard.Description" xml:space="preserve">
    <value>A segment with less word diversity than this is retried; higher catches subtler repetitions.</value>
  </data>
  <data name="WhisperLogprobCard.Header" xml:space="preserve">
    <value>Minimum confidence</value>
  </data>
  <data name="WhisperLogprobCard.Description" xml:space="preserve">
    <value>A segment decoded below this average confidence is retried; closer to 0 is stricter.</value>
  </data>
  <data name="WhisperNoSpeechCard.Header" xml:space="preserve">
    <value>No-speech cut-off</value>
  </data>
  <data name="WhisperNoSpeechCard.Description" xml:space="preserve">
    <value>Drops a segment the model hears as silence when it is also under Minimum confidence, on the Decoding page; lower drops more.</value>
  </data>
  <data name="WhisperModelsDirCard.Header" xml:space="preserve">
