  <data name="WhisperPageSubtitleLabel.Text" xml:space="preserve">
    <value>Control how Deckle turns your voice into text. Start with the model and language — then use Speech filtering to fight hallucinations on silences and background noise.</value>
  </data>
  <data name="WhisperPageModelEngineHeaderLabel.Text" xml:space="preserve">
    <value>Model &amp; engine</value>
  </data>
  <data name="WhisperPageSpeechFilteringHeaderLabel.Text" xml:space="preserve">
    <value>Speech filtering</value>
  </data>
  <data name="WhisperPageSpeechFilteringBodyLabel.Text" xml:space="preserve">
    <value>Pre-filter your audio to strip silence and background noise before transcription — the main defense against phantom text on quiet stretches.</value>
  </data>
  <data name="WhisperPageOutputFiltersHeaderLabel.Text" xml:space="preserve">
    <value>Output filters</value>
  </data>
  <data name="WhisperPageContextSegmentationHeaderLabel.Text" xml:space="preserve">
    <value>Context and segmentation</value>
  </data>
  <data name="WhisperDecodingExpander.Header" xml:space="preserve">
    <value>Decoding</value>
  </data>
  <data name="WhisperDecodingExpander.Description" xml:space="preserve">
    <value>Randomness of the decoder and fallback retry behavior.</value>
  </data>
  <data name="WhisperConfidenceExpander.Header" xml:space="preserve">
    <value>Confidence thresholds</value>
  </data>
  <data name="WhisperConfidenceExpander.Description" xml:space="preserve">
    <value>When Whisper retries a segment or treats it as silence.</value>
  </data>
