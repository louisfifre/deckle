  <!-- ─── WhisperPage — Streaming pipeline (experimental) ─────────────
       Strategy selector + energy-segmenter parameters. -->
  <data name="WhisperPageStreamingHeaderLabel.Text" xml:space="preserve">
    <value>Streaming pipeline (experimental)</value>
  </data>
  <data name="WhisperPageStreamingBodyLabel.Text" xml:space="preserve">
    <value>Instead of transcribing the whole take in one pass at Stop, cut the live recording into utterances on silence and transcribe each as you speak. Most of your dictation is already done by the time you Stop, and a runaway loop is confined to a single utterance. Transcription pre-processing (the DSP) is not applied in streaming yet. Default: off.</value>
  </data>
  <data name="WhisperStreamingEnabledCard.Header" xml:space="preserve">
    <value>Use the streaming pipeline</value>
  </data>
  <data name="WhisperStreamingEnabledCard.Description" xml:space="preserve">
    <value>Off keeps the delivered monolithic pipeline (one pass at Stop). Applies on your next recording.</value>
  </data>
  <data name="WhisperSegThresholdCard.Header" xml:space="preserve">
    <value>Silence threshold</value>
  </data>
  <data name="WhisperSegThresholdCard.Description" xml:space="preserve">
    <value>Audio at or above this raw level (in dBFS) counts as speech. Lower is more sensitive; raise it if quiet background noise keeps a segment open. Default: -45 dBFS.</value>
  </data>
  <data name="WhisperSegHangoverMaxCard.Header" xml:space="preserve">
    <value>Hangover (max)</value>
  </data>
  <data name="WhisperSegHangoverMaxCard.Description" xml:space="preserve">
    <value>How much trailing silence (in milliseconds) to wait after the last word at the start of an utterance, before deciding it has ended. Long by default so only a paragraph-break silence cuts. Default: 5000 ms.</value>
  </data>
  <data name="WhisperSegHangoverMinCard.Header" xml:space="preserve">
    <value>Hangover (min)</value>
  </data>
  <data name="WhisperSegHangoverMinCard.Description" xml:space="preserve">
    <value>Floor the hangover decays to once the utterance has grown past the ramp end. Never below this — a shorter micro-pause is treated as intra-word. Default: 500 ms.</value>
  </data>
  <data name="WhisperSegHangoverRampStartCard.Header" xml:space="preserve">
    <value>Hangover ramp start</value>
  </data>
  <data name="WhisperSegHangoverRampStartCard.Description" xml:space="preserve">
    <value>Utterance length (in milliseconds) at which the hangover starts shrinking from the max toward the min. Below this, the hangover stays at the max. Default: 15000 ms (15 s).</value>
  </data>
  <data name="WhisperSegHangoverRampEndCard.Header" xml:space="preserve">
    <value>Hangover ramp end</value>
  </data>
  <data name="WhisperSegHangoverRampEndCard.Description" xml:space="preserve">
    <value>Utterance length at and above which the hangover equals the min. Between the ramp start and end, the hangover follows a shaped curve that declines from the start and steepens toward the end. Default: 120000 ms (2 min).</value>
  </data>
  <data name="WhisperSegMarginCard.Header" xml:space="preserve">
    <value>Cut margin</value>
  </data>
  <data name="WhisperSegMarginCard.Description" xml:space="preserve">
    <value>How much silence (in milliseconds) to keep after the last word when cutting. Distinct from the hangover — the silence beyond this is dropped. Default: 150 ms.</value>
  </data>
  <data name="WhisperSegMinUtteranceCard.Header" xml:space="preserve">
    <value>Minimum utterance</value>
  </data>
  <data name="WhisperSegMinUtteranceCard.Description" xml:space="preserve">
    <value>Spans of speech shorter than this (in milliseconds) are dropped as noise blips rather than transcribed. Default: 250 ms.</value>
  </data>

