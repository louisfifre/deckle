<Page
    x:Class="Deckle.Transcription.WhisperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <!-- Compact slider for bounded continuous values: Windows 11 Settings
             pattern (mouse sensitivity, volume, etc.). No spinner, no layout
             shift, value shown on the right through ValueTextBlock. -->
        <Style x:Key="SettingSliderStyle"
               TargetType="Slider">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsThumbToolTipEnabled" Value="True" />
        </Style>

        <Style x:Key="SliderValueTextStyle"
               BasedOn="{StaticResource BodyTextBlockStyle}"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Per-setting reset button. Opacity 0 by default, switched to 1 on
             PointerEntered of the parent SettingsCard (code-behind). -->
        <Style x:Key="ResetButtonStyle"
               BasedOn="{StaticResource SubtleButtonStyle}"
               TargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ToolTip" Value="Reset to default" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          Tapped="OnBackgroundTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Padding="32,24,32,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="1000"
                            HorizontalAlignment="Stretch"
                            Spacing="{StaticResource SettingsCardSpacing}">

                <InfoBar x:Name="SetupInfoBar"
                         x:Uid="WhisperSetupInfoBar"
                         IsClosable="False"
                         IsOpen="False"
                         Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button x:Uid="WhisperSetupButton"
                                Click="OnSetupClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="WhisperPageTitleLabel"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <Button x:Uid="WhisperPage_ResetAll"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="ResetAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock x:Uid="WhisperPageResetAllLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Uid="WhisperPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Overlay and pasting ──────────────────────────────────────
                     The dictation experience — the on-screen HUD and auto-paste,
                     relocated from General. Composed from WhisperViewModel.BehaviourSettings
                     into the host below; its own section "Reset" gates active-when-dirty. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="WhisperPageBehaviourHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="BehaviourResetLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetBehaviour_Click" />
                </Grid>

                <StackPanel x:Name="BehaviourHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Transcription ───────────────────────────────────────── -->
                <!--
                    Order : Language → Initial prompt → GPU acceleration →
                    Whisper model. Model goes last because (a) it requires
                    a restart and (b) it owns the storage location for
                    downloaded weights, surfaced as an inline child of the
                    SettingsExpander rather than a separate "Storage" section.
                -->
                <TextBlock x:Uid="WhisperPageModelEngineHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Name="LanguageCard"
                                       x:Uid="WhisperLanguageCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Language}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:Name="LanguageCombo"
                                  MinWidth="160"
                                  IsEditable="True"
                                  SelectionChanged="LanguageCombo_SelectionChanged"
                                  LostFocus="LanguageCombo_LostFocus">
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="fr" />
                            <ComboBoxItem Content="en" />
                            <ComboBoxItem Content="es" />
                            <ComboBoxItem Content="de" />
                            <ComboBoxItem Content="it" />
                            <ComboBoxItem Content="pt" />
                            <ComboBoxItem Content="nl" />
                            <ComboBoxItem Content="ja" />
                            <ComboBoxItem Content="zh" />
                        </ComboBox>
                        <Button x:Name="LanguageReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="LanguageReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander x:Name="InitialPromptCard"
                                           x:Uid="WhisperInitialPromptCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Prompt}}">
                    <Button x:Name="InitialPromptReset"
                            Style="{StaticResource ResetButtonStyle}"
                            Click="InitialPromptReset_Click">
                        <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                    </Button>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="InitialPromptBox"
                                         x:Uid="WhisperInitialPromptBox"
                                         MinHeight="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{x:Bind ViewModel.InitialPrompt, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- GPU acceleration — composed. The lone toggle (and its per-card
                     reset) is built by ComposeUseGpuSection() into this host; the VM's
                     UseGpu property is the same one the restart footer watches, so
                     flipping the composed toggle still trips the footer. -->
                <StackPanel x:Name="UseGpuHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Whisper model — bespoke. The AutoSuggestBox is a runtime-
                     enumerated, restart-coupled selector (its items are scanned from
                     disk, and picking a model trips the restart footer), so it stays
                     hand-authored rather than composed as a flat descriptor. Its
                     per-card reset is bespoke too, syncing the un-bound AutoSuggestBox
                     alongside the VM. The models directory that used to nest inside
                     this expander is now its own composed card below. -->
                <controls:SettingsCard x:Name="ModelCard"
                                       x:Uid="WhisperModelCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Model}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <AutoSuggestBox x:Name="ModelSuggest"
                                        x:Uid="WhisperModelSuggest"
                                        MinWidth="240"
                                        GotFocus="ModelSuggest_GotFocus"
                                        TextChanged="ModelSuggest_TextChanged"
                                        SuggestionChosen="ModelSuggest_SuggestionChosen"
                                        LostFocus="ModelSuggest_LostFocus" />
                        <Button x:Name="ModelReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="ModelReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Models directory — composed. The editable folder path (with its
                     own reset) is built by ComposeModelsDirectorySection() into this
                     host, with FolderPickerMode.Editable and the AppPaths fallback
                     carried in PathArgs. It reads as its own card under the model
                     selector, where it used to nest as an inline expander child. -->
                <StackPanel x:Name="ModelsDirectoryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Speech filtering ────────────────────────────────────── -->
                <TextBlock x:Uid="WhisperPageSpeechFilteringHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}" />

                <TextBlock x:Uid="WhisperPageSpeechFilteringBodyLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="1,0,0,8"
                           Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}" />

                <!-- VAD fold — composed. The on/off toggle is the group master,
                     the four Silero detection parameters its children; the whole
                     expander collapses when streaming is off (the group's
                     visibleWhen gates on StreamingEnabled, matching the former
                     VisibleWhenStreaming bind). ComposeVadSection() builds it into
                     this host; the section header + body above stay hand-authored
                     (the composer governs cards, not section chrome). -->
                <StackPanel x:Name="VadHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Output filters ──────────────────────────────────────── -->
                <TextBlock x:Uid="WhisperPageOutputFiltersHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!-- Output filters — composed. The three cards (two toggles + the
                     one-line regex field) are a FLAT run with no master toggle, so
                     ComposeOutputFiltersSection() builds them as top-level composed
                     cards into this host; the section header above stays
                     hand-authored. Same host-only pattern as the VAD/Streaming folds,
                     minus the group wrapper — the composer governs cards, not the
                     section TextBlock. -->
                <StackPanel x:Name="OutputFiltersHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Context and segmentation ────────────────────────────── -->
                <TextBlock x:Uid="WhisperPageContextSegmentationHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!-- Context — composed. The UseContext toggle and the MaxTokens
                     NumberBox are a flat pair (no master toggle), composed into this
                     host by ComposeContextSection(); the section header stays
                     hand-authored, as with the output filters above. -->
                <StackPanel x:Name="ContextHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Decoding ────────────────────────────────────────────── -->
                <!-- Decoding fold — composed. The hand-authored master-less
                     SettingsExpander (and the standalone fallback-disabled InfoBar
                     beside it) are gone: ComposeDecodingSection() builds the fold as
                     a Section (header + chevron, no master toggle) into this host,
                     with UseBeamSearch / BeamSize / Temperature / TemperatureIncrement
                     as composed cards. The fallback warning rides along as the
                     TemperatureIncrement card's Advisory — a flat note row inside the
                     fold, not a separate InfoBar. -->
                <StackPanel x:Name="DecodingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Confidence thresholds ───────────────────────────────── -->
                <!-- Confidence fold — composed. ComposeConfidenceSection() builds the
                     three thresholds as a Section into this host; the slider bounds
                     that the code-behind set imperatively (to dodge the XAML-trimming
                     parser crash) now live in the manifest's SliderArgs, so that
                     workaround is gone. -->
                <StackPanel x:Name="ConfidenceHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Streaming pipeline (experimental) ───────────────────── -->
                <TextBlock x:Uid="WhisperPageStreamingHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <TextBlock x:Uid="WhisperPageStreamingBodyLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="1,0,0,8" />

                <!-- Streaming fold — composed. The on/off toggle is the group
                     master, the seven energy-segmenter parameters its Number-box
                     children; the composer hides them while streaming is off.
                     ComposeStreamingSection() builds it into this host; the section
                     header + body above stay hand-authored. -->
                <StackPanel x:Name="StreamingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Diagnostics ─────────────────────────────────────────────
                     The dictation-scoped observability opt-ins relocated from the
                     shared Diagnostics page: the streaming-transcription log filter,
                     the latency telemetry toggle, and the audio-corpus consent fold.
                     Composed from WhisperViewModel.DiagnosticsSettings into the host
                     below. No section "Reset" link — the corpus fold's consents are
                     privacy state, cleared from the Diagnostics page's own reset. -->
                <TextBlock x:Uid="WhisperPageDiagnosticsHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <StackPanel x:Name="DiagnosticsHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Restart footer: Windows Terminal Settings pattern.
             56px high, DividerStrokeColorDefaultBrush as separator,
             primary AccentButton + standard Button, 8px gap, 32px right margin. -->
        <Grid x:Name="RestartFooter"
              Grid.Row="1"
              Height="56"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Margin="0,0,32,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Uid="WhisperRestartDiscard"
                        Click="RestartDiscard_Click" />
                <Button x:Uid="WhisperRestartNow"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="RestartNow_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
