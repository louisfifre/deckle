<Page
    x:Class="Deckle.Transcription.WhisperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:settings="using:Deckle.Settings">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <!-- Compact slider for bounded continuous values: Windows 11 Settings
             pattern (mouse sensitivity, volume, etc.). No spinner, no layout
             shift, value shown on the right through ValueTextBlock. -->
        <Style x:Key="SettingSliderStyle"
               TargetType="Slider">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsThumbToolTipEnabled" Value="True" />
        </Style>

        <Style x:Key="SliderValueTextStyle"
               BasedOn="{StaticResource BodyTextBlockStyle}"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Per-setting reset button. Opacity 0 by default, switched to 1 on
             PointerEntered of the parent SettingsCard (code-behind). -->
        <Style x:Key="ResetButtonStyle"
               BasedOn="{StaticResource SubtleButtonStyle}"
               TargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ToolTip" Value="Reset to default" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          Tapped="OnBackgroundTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Padding="32,24,32,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="1000"
                            HorizontalAlignment="Stretch"
                            Spacing="{StaticResource SettingsCardSpacing}">

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="WhisperPageTitleLabel"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <Button x:Uid="WhisperPage_ResetAll"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="ResetAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock x:Uid="WhisperPageResetAllLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Uid="WhisperPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Transcription ───────────────────────────────────────── -->
                <!--
                    Order : Language → Initial prompt → GPU acceleration →
                    Whisper model. Model goes last because (a) it requires
                    a restart and (b) it owns the storage location for
                    downloaded weights, surfaced as an inline child of the
                    SettingsExpander rather than a separate "Storage" section.
                -->
                <TextBlock x:Uid="WhisperPageModelEngineHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Name="LanguageCard"
                                       x:Uid="WhisperLanguageCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Language}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:Name="LanguageCombo"
                                  MinWidth="160"
                                  IsEditable="True"
                                  SelectionChanged="LanguageCombo_SelectionChanged"
                                  LostFocus="LanguageCombo_LostFocus">
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="fr" />
                            <ComboBoxItem Content="en" />
                            <ComboBoxItem Content="es" />
                            <ComboBoxItem Content="de" />
                            <ComboBoxItem Content="it" />
                            <ComboBoxItem Content="pt" />
                            <ComboBoxItem Content="nl" />
                            <ComboBoxItem Content="ja" />
                            <ComboBoxItem Content="zh" />
                        </ComboBox>
                        <Button x:Name="LanguageReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="LanguageReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander x:Name="InitialPromptCard"
                                           x:Uid="WhisperInitialPromptCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Prompt}}">
                    <Button x:Name="InitialPromptReset"
                            Style="{StaticResource ResetButtonStyle}"
                            Click="InitialPromptReset_Click">
                        <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                    </Button>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="InitialPromptBox"
                                         x:Uid="WhisperInitialPromptBox"
                                         MinHeight="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{x:Bind ViewModel.InitialPrompt, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard x:Name="UseGpuCard"
                                       x:Uid="WhisperUseGpuCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Gpu}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSwitch x:Name="UseGpuToggle"
                                      IsOn="{x:Bind ViewModel.UseGpu, Mode=TwoWay}" />
                        <Button x:Name="UseGpuReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="UseGpuReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Whisper model is a SettingsExpander : the AutoSuggestBox
                     model selector lives in the header (so picking a model
                     stays a one-click affair), and the storage location for
                     downloaded weights is revealed as an inline child. The
                     standalone "Storage" section is gone — there's only one
                     path that ever mattered, and it belongs with the model
                     it points to. -->
                <controls:SettingsExpander x:Name="ModelCard"
                                           x:Uid="WhisperModelCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Model}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <AutoSuggestBox x:Name="ModelSuggest"
                                        x:Uid="WhisperModelSuggest"
                                        MinWidth="240"
                                        GotFocus="ModelSuggest_GotFocus"
                                        TextChanged="ModelSuggest_TextChanged"
                                        SuggestionChosen="ModelSuggest_SuggestionChosen"
                                        LostFocus="ModelSuggest_LostFocus" />
                        <Button x:Name="ModelReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="ModelReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="WhisperModelsDirCard"
                                               ContentAlignment="Vertical">
                            <settings:FolderPickerEditableCard x:Name="ModelsDirectoryPicker"
                                                               Path="{x:Bind ViewModel.ModelsDirectory, Mode=TwoWay}">
                                <settings:FolderPickerEditableCard.RightContent>
                                    <Button x:Name="ModelsDirectoryReset"
                                            Style="{StaticResource ResetButtonStyle}"
                                            Click="ModelsDirectoryReset_Click">
                                        <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                    </Button>
                                </settings:FolderPickerEditableCard.RightContent>
                            </settings:FolderPickerEditableCard>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- ── Speech filtering ────────────────────────────────────── -->
                <TextBlock x:Uid="WhisperPageSpeechFilteringHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}" />

                <TextBlock x:Uid="WhisperPageSpeechFilteringBodyLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="1,0,0,8"
                           Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}" />

                <!-- VAD is a SettingsExpander : the on/off toggle lives in the
                     header, the four Silero detection parameters are revealed as
                     inline children (gated on the toggle, same as the streaming
                     segmenter cards below). -->
                <controls:SettingsExpander x:Name="VadEnabledCard"
                                           x:Uid="WhisperVadEnabledCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Microphone}}"
                                           Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSwitch x:Name="VadEnabledToggle"
                                      IsOn="{x:Bind ViewModel.VadEnabled, Mode=TwoWay}" />
                        <Button x:Name="VadEnabledReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="VadEnabledReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <controls:SettingsExpander.Items>

                        <controls:SettingsCard x:Name="VadThresholdCard"
                                               x:Uid="WhisperVadThresholdCard"
                                               ContentAlignment="Vertical"
                                               Visibility="{x:Bind VisibleWhenVad(ViewModel.VadEnabled), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="VadThresholdSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Maximum="0.9"
                                        StepFrequency="0.05"
                                        TickFrequency="0.1"
                                        Value="{x:Bind ViewModel.VadThreshold, Mode=TwoWay}"
                                        ValueChanged="VadThresholdSlider_ValueChanged" />
                                <TextBlock x:Name="VadThresholdValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="VadThresholdReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="VadThresholdReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="VadMinSpeechCard"
                                               x:Uid="WhisperVadMinSpeechCard"
                                               ContentAlignment="Vertical"
                                               Visibility="{x:Bind VisibleWhenVad(ViewModel.VadEnabled), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="VadMinSpeechSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Minimum="0"
                                        Maximum="1000"
                                        StepFrequency="50"
                                        TickFrequency="100"
                                        Value="{x:Bind ViewModel.VadMinSpeechDurationMs, Mode=TwoWay}"
                                        ValueChanged="VadMinSpeechSlider_ValueChanged" />
                                <TextBlock x:Name="VadMinSpeechValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="VadMinSpeechReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="VadMinSpeechReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="VadMinSilenceCard"
                                               x:Uid="WhisperVadMinSilenceCard"
                                               ContentAlignment="Vertical"
                                               Visibility="{x:Bind VisibleWhenVad(ViewModel.VadEnabled), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="VadMinSilenceSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Minimum="0"
                                        Maximum="1000"
                                        StepFrequency="50"
                                        TickFrequency="100"
                                        Value="{x:Bind ViewModel.VadMinSilenceDurationMs, Mode=TwoWay}"
                                        ValueChanged="VadMinSilenceSlider_ValueChanged" />
                                <TextBlock x:Name="VadMinSilenceValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="VadMinSilenceReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="VadMinSilenceReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="VadSpeechPadCard"
                                               x:Uid="WhisperVadSpeechPadCard"
                                               ContentAlignment="Vertical"
                                               Visibility="{x:Bind VisibleWhenVad(ViewModel.VadEnabled), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="VadSpeechPadSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Minimum="0"
                                        Maximum="200"
                                        StepFrequency="10"
                                        TickFrequency="20"
                                        Value="{x:Bind ViewModel.VadSpeechPadMs, Mode=TwoWay}"
                                        ValueChanged="VadSpeechPadSlider_ValueChanged" />
                                <TextBlock x:Name="VadSpeechPadValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="VadSpeechPadReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="VadSpeechPadReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- ── Output filters ──────────────────────────────────────── -->
                <TextBlock x:Uid="WhisperPageOutputFiltersHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Name="SuppressNstCard"
                                       x:Uid="WhisperSuppressNstCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Filter}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSwitch x:Name="SuppressNstToggle"
                                      IsOn="{x:Bind ViewModel.SuppressNonSpeechTokens, Mode=TwoWay}" />
                        <Button x:Name="SuppressNstReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="SuppressNstReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="SuppressBlankCard"
                                       x:Uid="WhisperSuppressBlankCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Filter}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSwitch x:Name="SuppressBlankToggle"
                                      IsOn="{x:Bind ViewModel.SuppressBlank, Mode=TwoWay}" />
                        <Button x:Name="SuppressBlankReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="SuppressBlankReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander x:Name="SuppressRegexCard"
                                           x:Uid="WhisperSuppressRegexCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Pattern}}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="SuppressRegexBox"
                                         x:Uid="WhisperSuppressRegexBox"
                                         MinWidth="400"
                                         Text="{x:Bind ViewModel.SuppressRegex, Mode=TwoWay}" />
                                <Button x:Name="SuppressRegexReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="SuppressRegexReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- ── Context and segmentation ────────────────────────────── -->
                <TextBlock x:Uid="WhisperPageContextSegmentationHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Name="UseContextCard"
                                       x:Uid="WhisperUseContextCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Context}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSwitch x:Name="UseContextToggle"
                                      IsOn="{x:Bind ViewModel.UseContext, Mode=TwoWay}" />
                        <Button x:Name="UseContextReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="UseContextReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="MaxTokensCard"
                                       x:Uid="WhisperMaxTokensCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Tokens}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- SpinButtonPlacementMode=Hidden: no flyout pushing
                             the layout; keyboard input + mouse wheel. -->
                        <NumberBox x:Name="MaxTokensBox"
                                   Minimum="-1"
                                   Maximum="448"
                                   SmallChange="1"
                                   LargeChange="10"
                                   SpinButtonPlacementMode="Hidden"
                                   MinWidth="100"
                                   Value="{x:Bind ViewModel.MaxTokens, Mode=TwoWay}" />
                        <Button x:Name="MaxTokensReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="MaxTokensReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- ── Decoding ────────────────────────────────────────────── -->
                <!--
                    PowerToys / Win11 Settings pattern: group related sliders
                    under a parent SettingsExpander, with content in
                    ContentAlignment="Vertical" so the long description and
                    full-width slider breathe. Header + icon fixed on the
                    parent, children without icons (the parent glyph carries
                    the group's visual identity).
                -->
                <controls:SettingsExpander x:Name="DecodingExpander"
                                           x:Uid="WhisperDecodingExpander"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Tuning}}">
                    <controls:SettingsExpander.Items>

                        <controls:SettingsCard x:Name="TemperatureCard"
                                               x:Uid="WhisperTemperatureCard"
                                               ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="TemperatureSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Minimum="0"
                                        Maximum="1"
                                        StepFrequency="0.1"
                                        TickFrequency="0.1"
                                        Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}"
                                        ValueChanged="TemperatureSlider_ValueChanged" />
                                <TextBlock x:Name="TemperatureValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="TemperatureReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="TemperatureReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="TemperatureIncrementCard"
                                               x:Uid="WhisperTemperatureIncrementCard"
                                               ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="TemperatureIncrementSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Minimum="0"
                                        Maximum="1"
                                        StepFrequency="0.1"
                                        TickFrequency="0.1"
                                        Value="{x:Bind ViewModel.TemperatureIncrement, Mode=TwoWay}"
                                        ValueChanged="TemperatureIncrementSlider_ValueChanged" />
                                <TextBlock x:Name="TemperatureIncrementValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="TemperatureIncrementReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="TemperatureIncrementReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- InfoBar stays outside the expander: a warning about
                     disabled fallback must remain visible even when the
                     Decoding group is collapsed. -->
                <InfoBar x:Name="TemperatureIncrementWarning"
                         x:Uid="WhisperTemperatureIncrementWarning"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Warning" />

                <!-- ── Confidence thresholds ───────────────────────────────── -->
                <controls:SettingsExpander x:Name="ConfidenceExpander"
                                           x:Uid="WhisperConfidenceExpander"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Diagnostics}}">
                    <controls:SettingsExpander.Items>

                        <controls:SettingsCard x:Name="EntropyCard"
                                               x:Uid="WhisperEntropyCard"
                                               ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="EntropySlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Maximum="3.5"
                                        StepFrequency="0.1"
                                        TickFrequency="0.5"
                                        Value="{x:Bind ViewModel.EntropyThreshold, Mode=TwoWay}"
                                        ValueChanged="EntropySlider_ValueChanged" />
                                <TextBlock x:Name="EntropyValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="EntropyReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="EntropyReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="LogprobCard"
                                               x:Uid="WhisperLogprobCard"
                                               ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="LogprobSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        StepFrequency="0.05"
                                        TickFrequency="0.1"
                                        Value="{x:Bind ViewModel.LogprobThreshold, Mode=TwoWay}"
                                        ValueChanged="LogprobSlider_ValueChanged" />
                                <TextBlock x:Name="LogprobValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="LogprobReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="LogprobReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="NoSpeechCard"
                                               x:Uid="WhisperNoSpeechCard"
                                               ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="NoSpeechSlider"
                                        Style="{StaticResource SettingSliderStyle}"
                                        Maximum="0.80"
                                        StepFrequency="0.05"
                                        TickFrequency="0.1"
                                        Value="{x:Bind ViewModel.NoSpeechThreshold, Mode=TwoWay}"
                                        ValueChanged="NoSpeechSlider_ValueChanged" />
                                <TextBlock x:Name="NoSpeechValue"
                                           Style="{StaticResource SliderValueTextStyle}" />
                                <Button x:Name="NoSpeechReset"
                                        Style="{StaticResource ResetButtonStyle}"
                                        Click="NoSpeechReset_Click">
                                    <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- ── Streaming pipeline (experimental) ───────────────────── -->
                <TextBlock x:Uid="WhisperPageStreamingHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <TextBlock x:Uid="WhisperPageStreamingBodyLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="1,0,0,8" />

                <controls:SettingsExpander x:Name="StreamingEnabledCard"
                                           x:Uid="WhisperStreamingEnabledCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Tuning}}">
                    <ToggleSwitch x:Name="StreamingEnabledToggle"
                                  IsOn="{x:Bind ViewModel.StreamingEnabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>

                        <controls:SettingsCard x:Name="SegThresholdCard"
                                               x:Uid="WhisperSegThresholdCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegThresholdBox"
                                       Minimum="-90"
                                       Maximum="0"
                                       SmallChange="1"
                                       LargeChange="5"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegThresholdDbfs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="SegHangoverMaxCard"
                                               x:Uid="WhisperSegHangoverMaxCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegHangoverMaxBox"
                                       Minimum="500"
                                       Maximum="15000"
                                       SmallChange="100"
                                       LargeChange="500"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegHangoverMaxMs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="SegHangoverMinCard"
                                               x:Uid="WhisperSegHangoverMinCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegHangoverMinBox"
                                       Minimum="100"
                                       Maximum="2000"
                                       SmallChange="50"
                                       LargeChange="100"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegHangoverMinMs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="SegHangoverRampStartCard"
                                               x:Uid="WhisperSegHangoverRampStartCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegHangoverRampStartBox"
                                       Minimum="0"
                                       Maximum="600000"
                                       SmallChange="5000"
                                       LargeChange="30000"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegHangoverRampStartMs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="SegHangoverRampEndCard"
                                               x:Uid="WhisperSegHangoverRampEndCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegHangoverRampEndBox"
                                       Minimum="30000"
                                       Maximum="900000"
                                       SmallChange="5000"
                                       LargeChange="30000"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegHangoverRampEndMs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="SegMarginCard"
                                               x:Uid="WhisperSegMarginCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegMarginBox"
                                       Minimum="0"
                                       Maximum="1000"
                                       SmallChange="50"
                                       LargeChange="100"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegMarginMs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="SegMinUtteranceCard"
                                               x:Uid="WhisperSegMinUtteranceCard"
                                               Visibility="{x:Bind VisibleWhenStreaming(ViewModel.StreamingEnabled), Mode=OneWay}">
                            <NumberBox x:Name="SegMinUtteranceBox"
                                       Minimum="0"
                                       Maximum="2000"
                                       SmallChange="50"
                                       LargeChange="100"
                                       SpinButtonPlacementMode="Hidden"
                                       MinWidth="100"
                                       Value="{x:Bind ViewModel.SegMinUtteranceMs, Mode=TwoWay}" />
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Restart footer: Windows Terminal Settings pattern.
             56px high, DividerStrokeColorDefaultBrush as separator,
             primary AccentButton + standard Button, 8px gap, 32px right margin. -->
        <Grid x:Name="RestartFooter"
              Grid.Row="1"
              Height="56"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Margin="0,0,32,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Uid="WhisperRestartDiscard"
                        Click="RestartDiscard_Click" />
                <Button x:Uid="WhisperRestartNow"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="RestartNow_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
