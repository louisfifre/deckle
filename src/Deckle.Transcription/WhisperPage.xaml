<Page
    x:Class="Deckle.Transcription.WhisperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:catalog="using:Deckle.Catalog">

    <Page.Resources>
        <!-- Compact slider for bounded continuous values: Windows 11 Settings
             pattern (mouse sensitivity, volume, etc.). No spinner, no layout
             shift, value shown on the right through ValueTextBlock. -->
        <Style x:Key="SettingSliderStyle"
               TargetType="Slider">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsThumbToolTipEnabled" Value="True" />
        </Style>

        <Style x:Key="SliderValueTextStyle"
               BasedOn="{StaticResource BodyTextBlockStyle}"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Per-setting reset button. Opacity 0 by default, switched to 1 on
             PointerEntered of the parent SettingsCard (code-behind). -->
        <Style x:Key="ResetButtonStyle"
               BasedOn="{StaticResource SubtleButtonStyle}"
               TargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ToolTip" Value="Reset to default" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          Tapped="OnBackgroundTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Padding="32,24,32,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="1000"
                            HorizontalAlignment="Stretch"
                            Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty). This page
                     asks with its own dialog, so the header's generic one is off
                     (ConfirmsReset, set in the constructor). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="WhisperPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <InfoBar x:Name="SetupInfoBar"
                         x:Uid="WhisperSetupInfoBar"
                         IsClosable="False"
                         IsOpen="False"
                         Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button x:Uid="WhisperSetupButton"
                                Click="OnSetupClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ── Overlay and pasting ──────────────────────────────────────
                     The dictation experience — the on-screen HUD and auto-paste,
                     relocated from General. Composed from WhisperViewModel.BehaviourSettings
                     into the host below; its own section reset gates active-when-dirty. -->
                <catalog:SettingsSection x:Name="BehaviourSection"
                                         x:Uid="WhisperPageBehaviourSection"
                                         HasReset="True"
                                         ResetRequested="ResetBehaviour_Click">
                    <StackPanel x:Name="BehaviourHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Transcription ───────────────────────────────────────── -->
                <!--
                    Order : Language → Initial prompt → GPU acceleration →
                    Whisper model. Model goes last because (a) it requires
                    a restart and (b) it owns the storage location for
                    downloaded weights, surfaced as an inline child of the
                    SettingsExpander rather than a separate "Storage" section.
                    No section reset: Model / Language / InitialPrompt are
                    bespoke cards with per-card resets, and GPU / models
                    directory sit in two separate composers, so no single
                    dirtiness could gate one.
                -->
                <catalog:SettingsSection x:Uid="WhisperPageModelEngineSection">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                <controls:SettingsCard x:Name="LanguageCard"
                                       x:Uid="WhisperLanguageCard"
                                       Tag="WhisperLanguageCard">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:Name="LanguageCombo"
                                  MinWidth="160"
                                  IsEditable="True"
                                  SelectionChanged="LanguageCombo_SelectionChanged"
                                  LostFocus="LanguageCombo_LostFocus">
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="fr" />
                            <ComboBoxItem Content="en" />
                            <ComboBoxItem Content="es" />
                            <ComboBoxItem Content="de" />
                            <ComboBoxItem Content="it" />
                            <ComboBoxItem Content="pt" />
                            <ComboBoxItem Content="nl" />
                            <ComboBoxItem Content="ja" />
                            <ComboBoxItem Content="zh" />
                        </ComboBox>
                        <Button x:Name="LanguageReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="LanguageReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander x:Name="InitialPromptCard"
                                           x:Uid="WhisperInitialPromptCard"
                                           Tag="WhisperInitialPromptCard">
                    <Button x:Name="InitialPromptReset"
                            Style="{StaticResource ResetButtonStyle}"
                            Click="InitialPromptReset_Click">
                        <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                    </Button>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="InitialPromptBox"
                                         x:Uid="WhisperInitialPromptBox"
                                         MinHeight="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{x:Bind ViewModel.InitialPrompt, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- GPU acceleration — composed. The lone toggle (and its per-card
                     reset) is built by ComposeUseGpuSection() into this host; the VM's
                     UseGpu property is the same one the restart footer watches, so
                     flipping the composed toggle still trips the footer. -->
                <StackPanel x:Name="UseGpuHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Whisper model — bespoke. The AutoSuggestBox is a runtime-
                     enumerated, restart-coupled selector (its items are scanned from
                     disk, and picking a model trips the restart footer), so it stays
                     hand-authored rather than composed as a flat descriptor. Its
                     per-card reset is bespoke too, syncing the un-bound AutoSuggestBox
                     alongside the VM. The models directory that used to nest inside
                     this expander is now its own composed card below. -->
                <controls:SettingsCard x:Name="ModelCard"
                                       x:Uid="WhisperModelCard"
                                       Tag="WhisperModelCard">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <AutoSuggestBox x:Name="ModelSuggest"
                                        x:Uid="WhisperModelSuggest"
                                        MinWidth="240"
                                        GotFocus="ModelSuggest_GotFocus"
                                        TextChanged="ModelSuggest_TextChanged"
                                        SuggestionChosen="ModelSuggest_SuggestionChosen"
                                        LostFocus="ModelSuggest_LostFocus" />
                        <Button x:Name="ModelReset"
                                Style="{StaticResource ResetButtonStyle}"
                                Click="ModelReset_Click">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Models directory — composed. The editable folder path (with its
                     own reset) is built by ComposeModelsDirectorySection() into this
                     host, with FolderPickerMode.Editable and the AppPaths fallback
                     carried in PathArgs. It reads as its own card under the model
                     selector, where it used to nest as an inline expander child. -->
                <StackPanel x:Name="ModelsDirectoryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                </StackPanel>
                </catalog:SettingsSection>

                <!-- The decoding parameters and the streaming pipeline live on their
                     own pages, DecodingPage and StreamingPage, nested under this
                     module in the rail (settings design system, decision 16). -->

                <!-- ── Diagnostics ─────────────────────────────────────────────
                     The dictation-scoped observability opt-ins relocated from the
                     shared Diagnostics page: the streaming-transcription log filter,
                     the latency telemetry toggle, and the audio-corpus consent fold.
                     Composed from WhisperViewModel.DiagnosticsSettings into the host
                     below. No section reset — these observability opt-ins carry
                     no resettable default (a privacy opt-in has no per-row reset). -->
                <catalog:SettingsSection x:Uid="WhisperPageDiagnosticsSection">
                    <StackPanel x:Name="DiagnosticsHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Restart footer: Windows Terminal Settings pattern.
             56px high, DividerStrokeColorDefaultBrush as separator,
             primary AccentButton + standard Button, 8px gap, 32px right margin. -->
        <Grid x:Name="RestartFooter"
              Grid.Row="1"
              Height="56"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Margin="0,0,32,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Uid="WhisperRestartDiscard"
                        Click="RestartDiscard_Click" />
                <Button x:Uid="WhisperRestartNow"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="RestartNow_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
