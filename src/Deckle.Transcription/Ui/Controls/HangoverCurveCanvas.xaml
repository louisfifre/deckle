<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Deckle.Transcription.HangoverCurveCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <UserControl.Resources>
        <!-- The Thumb box (24) is larger than the visible dot (14) to give a
             comfortable pointer target; HandleSize in the code-behind must match
             it. -->
        <Style x:Key="CurveHandleStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Width="14" Height="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                     Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                     StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- HandleLayer has no Background, so only the Thumbs hit-test and the
         empty plot passes pointer events through. -->
    <Border x:Name="PlotBorder"
            Padding="12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid>
            <canvas:CanvasControl x:Name="Plot" Draw="OnDraw" SizeChanged="OnPlotSizeChanged" />
            <Canvas x:Name="HandleLayer">
                <primitives:Thumb x:Name="Handle1" Style="{StaticResource CurveHandleStyle}" />
                <primitives:Thumb x:Name="Handle2" Style="{StaticResource CurveHandleStyle}" />
            </Canvas>
        </Grid>
    </Border>
</UserControl>
