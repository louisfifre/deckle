<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Deckle.Transcription.HangoverCurveCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stretchy plot, unlike the fixed-160 BrightnessCurveCanvas : the
         hangover curve is the hero of the Segmentation page, so the
         consuming page allocates a large layout slot and we fill it.
         RebuildCurve sizes the inner Canvas from the Border (a Canvas does
         not stretch on its own), so the plot fills whatever slot the page
         gives the Border. -->
    <Border x:Name="PlotBorder"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
        <Canvas x:Name="PlotCanvas" />
    </Border>
</UserControl>
