<Page
    x:Class="Deckle.Transcription.DecodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The Decoding page of the Transcription module (settings design system,
         decision 16): the Whisper parameters that apply in both pipelines, in
         four flat sections — Decoding and Confidence first, the two that
         matter most, then Output filters and Context. No fold anywhere: every
         card is always shown, so a fold would only hide what the page is for
         (2026-10-14). Every card is composed from WhisperViewModel's
         manifests into a host; the page only hosts. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb (Transcription › Decoding),
                     one line of description, Reset all (active-when-dirty, confirmed
                     by the block). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="DecodingPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- ── Decoding ────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="DecodingPageDecodingSection">
                    <StackPanel x:Name="DecodingHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Confidence ──────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="DecodingPageConfidenceSection">
                    <StackPanel x:Name="ConfidenceHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Output filters ──────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="WhisperPageOutputFiltersSection">
                    <StackPanel x:Name="OutputFiltersHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Context ─────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="WhisperPageContextSegmentationSection">
                    <StackPanel x:Name="ContextHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
