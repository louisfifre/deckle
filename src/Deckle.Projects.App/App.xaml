<Application
    x:Class="Deckle.Projects.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Deckle.Catalog.Themes/Icons.xaml" />
                <!-- The window's sizes and gaps, at App level as in the
                     published Deckle the window came from. -->
                <ResourceDictionary Source="ms-appx:///Deckle.Projects.Views/ProjectsMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
