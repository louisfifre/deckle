  <data name="TaskbarPageHeader.Title" xml:space="preserve">
    <value>Taskbar</value>
  </data>
  <data name="TaskbarPageHeader.Description" xml:space="preserve">
    <value>Restyle the taskbar, tighten its buttons, tray and clock, and size the Start menu.</value>
  </data>
  <data name="TaskbarPageBarSection.Title" xml:space="preserve">
    <value>Taskbar</value>
  </data>
  <data name="TaskbarPage_BackgroundCard.Header" xml:space="preserve">
    <value>Taskbar background</value>
  </data>
  <data name="TaskbarPage_BackgroundCard.Description" xml:space="preserve">
    <value>Transparent lets the wallpaper show through the taskbar. Black fills it solid.</value>
  </data>
  <data name="TaskbarPage_BackgroundDefault.Content" xml:space="preserve">
    <value>Default</value>
  </data>
  <data name="TaskbarPage_BackgroundTransparent.Content" xml:space="preserve">
    <value>Transparent</value>
  </data>
  <data name="TaskbarPage_BackgroundBlack.Content" xml:space="preserve">
    <value>Black</value>
  </data>
  <data name="TaskbarPage_CompactTaskButtonsCard.Header" xml:space="preserve">
    <value>Compact app buttons</value>
  </data>
  <data name="TaskbarPage_CompactTaskButtonsCard.Description" xml:space="preserve">
    <value>Brings the app buttons, Start and Task view closer together. Applies to a vertical taskbar only.</value>
  </data>
  <data name="TaskbarPage_TaskButtonPitchCard.Header" xml:space="preserve">
    <value>Button height</value>
  </data>
  <data name="TaskbarPage_TaskButtonPitchCard.Description" xml:space="preserve">
    <value>The room each app button, Start and Task view take on the taskbar.</value>
  </data>
  <data name="TaskbarPage_CompactClockCard.Header" xml:space="preserve">
    <value>Compact clock</value>
  </data>
  <data name="TaskbarPage_CompactClockCard.Description" xml:space="preserve">
    <value>Stacks the month, day, weekday, hours and minutes on separate lines. Always in English.</value>
  </data>
  <data name="TaskbarPage_CompactTrayCard.Header" xml:space="preserve">
    <value>Compact tray</value>
  </data>
  <data name="TaskbarPage_CompactTrayCard.Description" xml:space="preserve">
    <value>Brings the tray icons and the quick settings icons closer together. Applies to a vertical taskbar only.</value>
  </data>
  <data name="TaskbarPage_TrayIconPitchCard.Header" xml:space="preserve">
    <value>Icon spacing</value>
  </data>
  <data name="TaskbarPage_TrayIconPitchCard.Description" xml:space="preserve">
    <value>The room each tray icon and quick settings icon takes on the taskbar.</value>
  </data>
  <data name="TaskbarPage_HorizontalBarNoEffect" xml:space="preserve">
    <value>Your taskbar is horizontal, so this has no effect.</value>
  </data>
  <data name="TaskbarPage_StartMenuFullHeightCard.Header" xml:space="preserve">
    <value>Full-height Start menu</value>
  </data>
  <data name="TaskbarPage_StartMenuFullHeightCard.Description" xml:space="preserve">
    <value>Makes the Start menu as tall as the screen, with the same space above and below it.</value>
  </data>
  <data name="TaskbarPage_StartMenuWidthCard.Header" xml:space="preserve">
    <value>Start menu width</value>
  </data>
  <data name="TaskbarPage_StartMenuWidthCard.Description" xml:space="preserve">
    <value>Fill the screen stretches Start across the screen it opens on. A custom width never goes past the screen's edge.</value>
  </data>
  <data name="TaskbarPage_StartMenuWidthDefault.Content" xml:space="preserve">
    <value>Default</value>
  </data>
  <data name="TaskbarPage_StartMenuWidthFill.Content" xml:space="preserve">
    <value>Fill the screen</value>
  </data>
  <data name="TaskbarPage_StartMenuWidthCustom.Content" xml:space="preserve">
    <value>Custom</value>
  </data>
  <data name="TaskbarPage_StartMenuCustomWidthCard.Header" xml:space="preserve">
    <value>Width</value>
  </data>
  <data name="TaskbarPage_StartMenuCustomWidthCard.Description" xml:space="preserve">
    <value>On a narrower screen, such as one turned upright, Start stops at its edge.</value>
  </data>
  <data name="TaskbarPage_WindowsKeyShowsTaskbarCard.Header" xml:space="preserve">
    <value>Windows key shows the taskbar</value>
  </data>
  <data name="TaskbarPage_WindowsKeyShowsTaskbarCard.Description" xml:space="preserve">
    <value>Pressing the Windows key on its own brings the taskbar forward instead of opening Start. Shortcuts such as Windows + E keep working.</value>
  </data>
  <data name="TaskbarPageStartSection.Title" xml:space="preserve">
    <value>Start menu</value>
  </data>
  <data name="TaskbarPage_ProblemNotApplied" xml:space="preserve">
    <value>Deckle could not find this part of the taskbar on this version of Windows, so it is not applied.</value>
  </data>
  <data name="TaskbarPage_ProblemContested" xml:space="preserve">
    <value>Windows keeps changing this back, so it may not hold.</value>
  </data>
  <data name="TaskbarPage_ProblemError" xml:space="preserve">
    <value>Deckle could not apply this.</value>
  </data>
  <data name="TaskbarPageTraySection.Title" xml:space="preserve">
    <value>System tray</value>
  </data>
  <data name="TaskbarPage_ShowAllTrayIconsCard.Header" xml:space="preserve">
    <value>Show all tray icons</value>
  </data>
  <data name="TaskbarPage_ShowAllTrayIconsCard.Description" xml:space="preserve">
    <value>Keep every tray icon on the taskbar instead of the overflow flyout. While this is on, hiding an icon in Windows Settings has no effect.</value>
  </data>
  <data name="TaskbarPage_TrayFailedOn" xml:space="preserve">
    <value>Deckle could not keep every tray icon on the taskbar. New icons may still land in the overflow flyout.</value>
  </data>
  <data name="TaskbarPage_TrayFailedOff" xml:space="preserve">
    <value>Deckle could not give every tray icon back to Windows.</value>
  </data>
  <data name="SettingsModuleNavLabel" xml:space="preserve">
    <value>Taskbar</value>
  </data>
