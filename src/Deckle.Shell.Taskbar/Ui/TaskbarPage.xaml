<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Shell.Taskbar.TaskbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty, confirmed
                     by the block itself). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="TaskbarPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- No module switch: each card below is its own setting and
                     all of them always show. -->

                <!-- ── Taskbar ──────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="TaskbarPageBarSection">
                    <StackPanel x:Name="BarHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── System tray ───────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="TaskbarPageTraySection">
                    <StackPanel x:Name="TrayHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Start menu ────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="TaskbarPageStartSection">
                    <StackPanel x:Name="StartHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>