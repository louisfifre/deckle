<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Anytype</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The backend task XML document (BackendTaskDocument) is an internal
         composition detail, but its shape is the load-bearing contract of the
         lifecycle design — kept unit-testable without widening the public API. -->
    <InternalsVisibleTo Include="Deckle.Anytype.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW payload keys
         land directly in the JSONL output. Convention documented in
         ../Deckle.Diagnostics/CLAUDE.md. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
