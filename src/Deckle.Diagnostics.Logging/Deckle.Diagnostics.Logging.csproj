<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Diagnostics.Logging</RootNamespace>
  </PropertyGroup>

  <!-- The logging logic: the verbosity gates and their persisted settings, the
       application log sink, log transfer, and the LogWindow's filter and
       auto-scroll rules. No XAML, no UseWinUI and no project that holds XAML,
       so the engines that log through it (Transcription, Autocorrect,
       Lighting.Ambient) never run the XAML compiler on its account, and every
       rule here is tested without a window. Deckle.Diagnostics.Logging.Views
       presents it: the Diagnostics settings page and the log filter bar. -->
  <ItemGroup>
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
  </ItemGroup>
</Project>
