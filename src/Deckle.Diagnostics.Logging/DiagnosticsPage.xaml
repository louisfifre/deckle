<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <!-- Same layout pattern as GeneralPage / WhisperPage: Grid wrapper +
         StackPanel MaxWidth=1000 + SettingsCardSpacing=4 + section
         headers in BodyStrong + Margin 1,30,0,6. Page extracted from
         GeneralPage in slice S2 ; J4 polish added the Logging section
         to host runtime emission filters (Verbose toggle today, more
         per-source filters / minimum-level overrides to come), so the
         page now reads as two parallel groups : Logging on top
         (controls what's emitted) and Telemetry below (controls what's
         persisted to disk). -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Page title + whole-page "Reset all" (active-when-dirty; confirms
                     because it clears recorded consents), mirroring WhisperPage. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageTitleLabel"
                               Grid.Column="0"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetAllButton"
                            x:Uid="DiagnosticsPage_ResetAll"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="ResetAllDiagnostics_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock x:Uid="DiagnosticsPageResetAllLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Uid="DiagnosticsPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Logging ─────────────────────────────────────────────────
                     Runtime emission gates. They stop selected noisy streams
                     before every sink, independently from the LogWindow display
                     lens and the future app.jsonl persistence lens. Module-owned
                     gates stay on their module pages; only the transverse
                     Windowing gate belongs on Diagnostics. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageLoggingHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetLogging_Click" />
                </Grid>

                <!-- Composed admission controls for operational detail. -->
                <StackPanel x:Name="LoggingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Telemetry ───────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageApplicationLogHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetApplicationLog_Click" />
                </Grid>

                <!-- Composed region — the application-log opt-in. It carries
                     an off→on consent dialog, declared in DiagnosticsViewModel.ApplicationLogSettings
                     via a confirmOnEnable gate the composer runs before persisting the
                     enable. ComposeApplicationLogSection() hands it to the composer, which
                     builds the SettingsCard into this host. Dataset-specific opt-ins
                     remain on the pages of the modules they observe. -->
                <StackPanel x:Name="ApplicationLogHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageTelemetryHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetTelemetry_Click" />
                </Grid>

                <!-- Composed region — the telemetry storage-folder path. A Path
                     descriptor in DiagnosticsViewModel.StorageFolderSettings, built
                     by ComposeStorageFolderSection() into this host through the
                     shared FolderPickerCard the composer's PathControlFactory resolves. -->
                <StackPanel x:Name="StorageFolderHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Diagnostic files ──────────────────────────────────────
                     Always-on local logs (setup, errors), distinct from the
                     optional application log above: recorded unconditionally and kept
                     on this device, never transmitted. No toggle — they exist
                     so a first-run or crash always leaves a trace; the only
                     affordance is opening the folder. -->
                <TextBlock x:Uid="DiagnosticsPageFilesHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="DiagnosticsFilesCard"
                                       Tag="DiagnosticsFilesCard">
                    <Button x:Uid="FolderPickerCard_OpenButton"
                            Click="OpenDiagnosticsFolder_Click" />
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
