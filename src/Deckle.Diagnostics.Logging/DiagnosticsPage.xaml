<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Same layout pattern as GeneralPage / WhisperPage: Grid wrapper +
         StackPanel MaxWidth=1000 + SettingsCardSpacing=4 (from App.xaml) +
         the shared SettingsSection block for each section. Page extracted from
         GeneralPage in slice S2 ; J4 polish added the Logging section
         to host runtime emission filters (Verbose toggle today, more
         per-source filters / minimum-level overrides to come), so the
         page now reads as two parallel groups : Logging on top
         (controls what's emitted) and Telemetry below (controls what's
         persisted to disk). -->

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty). The page
                     asks with its own dialog (it clears recorded consents), so the
                     header's generic one is off (ConfirmsReset, set in the
                     constructor). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="DiagnosticsPageHeader"
                                            ResetAllRequested="ResetAllDiagnostics_Click" />

                <!-- No module switch card on this page: Diagnostics is not a module
                     that can be turned off; its opt-ins are the settings themselves. -->

                <!-- ── Logging ─────────────────────────────────────────────────
                     Runtime emission gates. They stop selected noisy streams
                     before every sink, independently from the LogWindow display
                     lens and the future app.jsonl persistence lens. Module-owned
                     gates stay on their module pages; only the transverse
                     Windowing gate belongs on Diagnostics. -->
                <catalog:SettingsSection x:Name="LoggingSection"
                                         x:Uid="DiagnosticsPageLoggingSection"
                                         HasReset="True"
                                         ResetRequested="ResetLogging_Click">
                    <!-- Composed admission controls for operational detail. -->
                    <StackPanel x:Name="LoggingHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Application log ─────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="ApplicationLogSection"
                                         x:Uid="DiagnosticsPageApplicationLogSection"
                                         HasReset="True"
                                         ResetRequested="ResetApplicationLog_Click">
                    <!-- Composed region — the application-log opt-in. It carries
                         an off→on consent dialog, declared in DiagnosticsViewModel.ApplicationLogSettings
                         via a confirmOnEnable gate the composer runs before persisting the
                         enable. ComposeApplicationLogSection() hands it to the composer, which
                         builds the SettingsCard into this host. Dataset-specific opt-ins
                         remain on the pages of the modules they observe. -->
                    <StackPanel x:Name="ApplicationLogHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Telemetry ───────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="TelemetrySection"
                                         x:Uid="DiagnosticsPageTelemetrySection"
                                         HasReset="True"
                                         ResetRequested="ResetTelemetry_Click">
                    <!-- Composed region — the wheel-capture opt-in and telemetry
                         storage-folder path declared by DiagnosticsViewModel.TelemetrySettings.
                         The shared composer resolves the toggle and FolderPickerCard. -->
                    <StackPanel x:Name="TelemetryHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Diagnostic files ──────────────────────────────────────
                     Always-on local logs (setup, errors), distinct from the
                     optional application log above: recorded unconditionally and kept
                     on this device, never transmitted. No toggle — they exist
                     so a first-run or crash always leaves a trace; the only
                     affordance is opening the folder. A section of commands, so no
                     section reset. -->
                <catalog:SettingsSection x:Uid="DiagnosticsPageFilesSection">
                    <controls:SettingsCard x:Uid="DiagnosticsFilesCard"
                                           Tag="DiagnosticsFilesCard">
                        <Button x:Uid="FolderPickerCard_OpenButton"
                                Click="OpenDiagnosticsFolder_Click" />
                    </controls:SettingsCard>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
