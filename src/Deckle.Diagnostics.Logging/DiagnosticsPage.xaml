<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <!-- Same layout pattern as GeneralPage / WhisperPage: Grid wrapper +
         StackPanel MaxWidth=1000 + SettingsCardSpacing=4 + section
         headers in BodyStrong + Margin 1,30,0,6. Page extracted from
         GeneralPage in slice S2 ; J4 polish added the Logging section
         to host runtime emission filters (Verbose toggle today, more
         per-source filters / minimum-level overrides to come), so the
         page now reads as two parallel groups : Logging on top
         (controls what's emitted) and Telemetry below (controls what's
         persisted to disk). -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Page title + whole-page "Reset all" (active-when-dirty; confirms
                     because it clears recorded consents), mirroring WhisperPage. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageTitleLabel"
                               Grid.Column="0"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetAllButton"
                            x:Uid="DiagnosticsPage_ResetAll"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="ResetAllDiagnostics_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock x:Uid="DiagnosticsPageResetAllLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Uid="DiagnosticsPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Logging ─────────────────────────────────────────────────
                     Runtime emission filters. Distinct from Telemetry below :
                     this section controls what the in-app log surface (and
                     the JSONL pipeline downstream) actually emit, while
                     Telemetry controls which of those streams are persisted
                     to disk. The two sections are structured identically so
                     the page reads as two parallel groups of opt-ins. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageLoggingHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetLogging_Click" />
                </Grid>

                <!-- Composed region — proof of the declarative SettingsComposer.
                     The four runtime-emission toggles are no longer hand-authored
                     here: DiagnosticsPage.ComposeLoggingSection() declares them as
                     SettingDescriptors and the composer builds the SettingsCards
                     into this host. Everything below (Telemetry, Diagnostic files)
                     stays hand-authored — composed and bespoke sections interleave
                     freely in the same StackPanel. -->
                <StackPanel x:Name="LoggingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Telemetry ───────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageTelemetryHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetTelemetry_Click" />
                </Grid>

                <!-- Composed region — the Application log telemetry opt-in. It carries
                     an off→on consent dialog, declared in DiagnosticsViewModel.TelemetrySettings
                     via a confirmOnEnable gate the composer runs before persisting the
                     enable. ComposeTelemetrySection() hands it to the composer, which
                     builds the SettingsCard into this host. The Latency toggle and the
                     Corpus fold moved to the Dictation page (they observe the dictation
                     pipeline); the storage-folder card below stays hand-authored — a
                     folder path the composer can't express. -->
                <StackPanel x:Name="TelemetryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- The Autocorrect decisions/text opt-ins moved to the Autocorrect
                     module's own page (Deckle.Autocorrect), beside the engine they
                     observe; they consume their consent dialogs through the Catalog
                     TelemetryConsent registry the shell still wires below. -->

                <!-- Composed region — the telemetry storage-folder path. A Path
                     descriptor in DiagnosticsViewModel.StorageFolderSettings, built
                     by ComposeStorageFolderSection() into this host through the
                     shared FolderPickerCard the composer's PathControlFactory
                     resolves. Its own host (not TelemetryHost above) so it keeps
                     this slot below the Corpus/Autocorrect expanders. -->
                <StackPanel x:Name="StorageFolderHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Diagnostic files ──────────────────────────────────────
                     Always-on local logs (setup, errors), distinct from the
                     opt-in telemetry above: recorded unconditionally and kept
                     on this device, never transmitted. No toggle — they exist
                     so a first-run or crash always leaves a trace; the only
                     affordance is opening the folder. -->
                <TextBlock x:Uid="DiagnosticsPageFilesHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="DiagnosticsFilesCard">
                    <Button x:Uid="FolderPickerCard_OpenButton"
                            Click="OpenDiagnosticsFolder_Click" />
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
