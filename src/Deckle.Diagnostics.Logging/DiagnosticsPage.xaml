<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- "Reset all" confirms because it clears recorded consents. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageTitleLabel"
                               Grid.Column="0"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetAllButton"
                            x:Uid="DiagnosticsPage_ResetAll"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="ResetAllDiagnostics_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock x:Uid="DiagnosticsPageResetAllLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Uid="DiagnosticsPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Logging ─────────────────────────────────────────────────
                     Admission gates, one per activity: they stop selected noisy
                     streams at the producer, before every sink, independently
                     from the LogWindow view filter. This page is the only editor
                     of these gates, the application log and the telemetry storage
                     below; module pages and the LogWindow never duplicate them. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageLoggingHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetLogging_Click" />
                </Grid>

                <StackPanel x:Name="LoggingHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Application log ─────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageApplicationLogHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetApplicationLog_Click" />
                </Grid>

                <StackPanel x:Name="ApplicationLogHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DiagnosticsPageTelemetryHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetTelemetry_Click" />
                </Grid>

                <StackPanel x:Name="TelemetryHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Diagnostic files ──────────────────────────────────────
                     Always-on local logs (setup, errors), kept on this device and
                     never transmitted. No toggle, so a first run or a crash always
                     leaves a trace. -->
                <TextBlock x:Uid="DiagnosticsPageFilesHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="DiagnosticsFilesCard"
                                       Tag="DiagnosticsFilesCard">
                    <Button x:Uid="FolderPickerCard_OpenButton"
                            Click="OpenDiagnosticsFolder_Click" />
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
