<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="DiagnosticsPageHeader"
                                            ResetAllRequested="ResetAllDiagnostics_Click" />

                <!-- No module switch card on this page: Diagnostics is not a module
                     that can be turned off; its opt-ins are the settings themselves. -->

                <!-- ── Logging ─────────────────────────────────────────────────
                     Runtime emission gates. They stop selected noisy streams
                     before every sink, independently from the LogWindow view
                     filter. This page is their only editor: module pages and the
                     LogWindow never duplicate them. -->
                <catalog:SettingsSection x:Name="LoggingSection"
                                         x:Uid="DiagnosticsPageLoggingSection"
                                         HasReset="True"
                                         ResetRequested="ResetLogging_Click">
                    <StackPanel x:Name="LoggingHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Application log ─────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="ApplicationLogSection"
                                         x:Uid="DiagnosticsPageApplicationLogSection"
                                         HasReset="True"
                                         ResetRequested="ResetApplicationLog_Click">
                    <StackPanel x:Name="ApplicationLogHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Telemetry ─────────────────────────────────────────────
                     Every dataset Deckle records, in one place: the mouse-wheel
                     capture and the datasets each module contributes through
                     DiagnosticsRegistry (microphone level, dictation latency and
                     corpus, autocorrect decisions and text, trackpad frames).
                     The cards with a chevron (Group, Section and Mode folds) sit
                     at the top of the section, the flat cards under them, so
                     FoldsHost takes every fold and LeavesHost every leaf, each in
                     source order (the page's own list, then the registry). -->
                <catalog:SettingsSection x:Name="TelemetrySection"
                                         x:Uid="DiagnosticsPageTelemetrySection"
                                         HasReset="True"
                                         ResetRequested="ResetTelemetry_Click">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <StackPanel x:Name="FoldsHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                        <StackPanel x:Name="LeavesHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                    </StackPanel>
                </catalog:SettingsSection>

                <!-- ── Folders ───────────────────────────────────────────────
                     Where what the page records lands, last on the page: the
                     telemetry storage folder (composed, configurable, so the
                     section carries a reset), then the diagnostics folder. The
                     latter holds the always-on local logs (setup, errors) and the
                     opt-in application log, kept on this device and never
                     transmitted. No toggle on it, so a first run or a crash
                     always leaves a trace. -->
                <catalog:SettingsSection x:Name="FoldersSection"
                                         x:Uid="DiagnosticsPageFoldersSection"
                                         HasReset="True"
                                         ResetRequested="ResetFolders_Click">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <StackPanel x:Name="TelemetryStorageHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />
                        <controls:SettingsCard x:Uid="DiagnosticsFilesCard"
                                               Tag="DiagnosticsFilesCard"
                                               catalog:SettingsDescriptions.Toggled="True">
                            <Button x:Uid="FolderPickerCard_OpenButton"
                                    Click="OpenDiagnosticsFolder_Click" />
                        </controls:SettingsCard>
                    </StackPanel>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
