<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="DiagnosticsPageHeader"
                                            ResetAllRequested="ResetAllDiagnostics_Click" />

                <!-- No module switch card on this page: Diagnostics is not a module
                     that can be turned off; its opt-ins are the settings themselves. -->

                <!-- ── Logging ─────────────────────────────────────────────────
                     Runtime emission gates. They stop selected noisy streams
                     before every sink, independently from the LogWindow view
                     filter. This page is their only editor: module pages and the
                     LogWindow never duplicate them. -->
                <catalog:SettingsSection x:Name="LoggingSection"
                                         x:Uid="DiagnosticsPageLoggingSection"
                                         HasReset="True"
                                         ResetRequested="ResetLogging_Click">
                    <StackPanel x:Name="LoggingHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Application log ─────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="ApplicationLogSection"
                                         x:Uid="DiagnosticsPageApplicationLogSection"
                                         HasReset="True"
                                         ResetRequested="ResetApplicationLog_Click">
                    <StackPanel x:Name="ApplicationLogHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Telemetry ───────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="TelemetrySection"
                                         x:Uid="DiagnosticsPageTelemetrySection"
                                         HasReset="True"
                                         ResetRequested="ResetTelemetry_Click">
                    <StackPanel x:Name="TelemetryHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Diagnostic files ──────────────────────────────────────
                     Always-on local logs (setup, errors), kept on this device and
                     never transmitted. No toggle, so a first run or a crash always
                     leaves a trace. A section of commands, so no section reset. -->
                <catalog:SettingsSection x:Uid="DiagnosticsPageFilesSection">
                    <controls:SettingsCard x:Uid="DiagnosticsFilesCard"
                                           Tag="DiagnosticsFilesCard">
                        <Button x:Uid="FolderPickerCard_OpenButton"
                                Click="OpenDiagnosticsFolder_Click" />
                    </controls:SettingsCard>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
