  <!-- Nav label — module-owned. The Settings shell reads this bare key straight
       into the module's NavigationViewItem.Content (SettingsModuleDescriptor.LabelKey). -->

  <!-- DiagnosticsPage — page chrome (x:Uid) -->
  <data name="DiagnosticsPageHeader.Title" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="DiagnosticsPageHeader.Description" xml:space="preserve">
    <value>What Deckle logs and records about itself, and where it keeps it.</value>
  </data>

  <!-- Logging section (x:Uid header + composed card label key) -->
  <data name="DiagnosticsPageLoggingSection.Title" xml:space="preserve">
    <value>Logging details</value>
  </data>
  <data name="LoggingAmbientCard.Header" xml:space="preserve">
    <value>Ambient details</value>
  </data>
  <data name="LoggingAmbientCard.Description" xml:space="preserve">
    <value>Frame analysis, colours, light pushes and heartbeats.</value>
  </data>
  <data name="LoggingTranscriptionCard.Header" xml:space="preserve">
    <value>Transcription details</value>
  </data>
  <data name="LoggingTranscriptionCard.Description" xml:space="preserve">
    <value>Technical detail of dictation and file transcription. Transcript text stays in the corpus only.</value>
  </data>
  <data name="LoggingAutocorrectCard.Header" xml:space="preserve">
    <value>Autocorrect details</value>
  </data>
  <data name="LoggingAutocorrectCard.Description" xml:space="preserve">
    <value>Focus probes, decisions, reranking and learning. Typed text stays in its own datasets.</value>
  </data>
  <data name="LoggingWindowingCard.Header" xml:space="preserve">
    <value>Windowing details</value>
  </data>
  <data name="LoggingInputCard.Header" xml:space="preserve">
    <value>Input activity</value>
  </data>
  <data name="LoggingInputCard.Description" xml:space="preserve">
    <value>Raw Input summaries and Trackpad gesture details.</value>
  </data>
  <data name="LoggingWindowingCard.Description" xml:space="preserve">
    <value>Window placement, DPI, overlay stacking, popups and resize frames.</value>
  </data>

  <!-- Telemetry section (x:Uid header + composed card label keys). The General*
       prefix on the card keys is a historical naming artifact carried over from
       the shell, not a page binding. -->
  <data name="DiagnosticsPageTelemetrySection.Title" xml:space="preserve">
    <value>Telemetry</value>
  </data>
  <data name="DiagnosticsPageTelemetrySection.Caption" xml:space="preserve">
    <value>What Deckle records on this device for tuning and bug reports; nothing is sent anywhere.</value>
  </data>
  <data name="DiagnosticsPageApplicationLogSection.Title" xml:space="preserve">
    <value>Application log</value>
  </data>
  <data name="GeneralAppLogCard.Header" xml:space="preserve">
    <value>Application log</value>
  </data>
  <data name="GeneralAppLogCard.Description" xml:space="preserve">
    <value>Every log line goes to diagnostics\app.jsonl, rotated every 8,000 lines into diagnostics\archive.</value>
  </data>
  <data name="TelemetryMouseWheelCard.Header" xml:space="preserve">
    <value>Record wheel events</value>
  </data>
  <data name="TelemetryMouseWheelCard.Description" xml:space="preserve">
    <value>Wheel timing and deltas go to telemetry\mouse-wheel.</value>
  </data>

  <!-- Folders section, last on the page (x:Uid header + the two composed
       folder folds' label keys, DiagnosticsViewModel.FoldersSettings; each
       heads its fold, the Location line inside uses the Settings shell's
       FolderPickerCard_* words). The storage card's General* prefix is the
       same historical artifact as above. A custom storage folder only
       receives what reads CorpusPaths (the dictation audio); the other
       datasets keep writing under the default telemetry folder, and the
       wording says so. -->
  <data name="DiagnosticsPageFoldersSection.Title" xml:space="preserve">
    <value>Folders</value>
  </data>
  <data name="DiagnosticsPageFoldersSection.Caption" xml:space="preserve">
    <value>Where Deckle keeps what it records.</value>
  </data>
  <data name="GeneralStorageFolderCard.Header" xml:space="preserve">
    <value>Telemetry folder</value>
  </data>
  <data name="GeneralStorageFolderCard.Description" xml:space="preserve">
    <value>The datasets you turn on under Telemetry. A folder you choose here receives only the dictation audio for now.</value>
  </data>
  <data name="DiagnosticsFilesCard.Header" xml:space="preserve">
    <value>Diagnostics folder</value>
  </data>
  <data name="DiagnosticsFilesCard.Description" xml:space="preserve">
    <value>The setup log, the error log and the application log. Open it when you report a problem.</value>
  </data>

