  <!-- Reset dialogs (Loc.Get from code-behind). Source of truth for the wording;
       Loc.Get resolves the runtime copy from Deckle.App's root map. -->
  <data name="Settings_ResetDiagnosticsDialog_Title" xml:space="preserve">
    <value>Reset all settings?</value>
  </data>
  <data name="Settings_ResetDiagnosticsDialog_Content" xml:space="preserve">
    <value>Every logging and telemetry opt-in on this page will be turned off and the storage-folder override cleared. Nothing is recorded again until you opt back in.</value>
  </data>
  <data name="SettingsModuleNavLabel" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="DiagnosticsPageLoggingSection.Caption" xml:space="preserve">
    <value>Verbose lines per module. Incidents, warnings and errors are always logged.</value>
