<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Nav label — module-owned. The Settings shell reads this bare key straight
       into the module's NavigationViewItem.Content (SettingsModuleDescriptor.LabelKey). -->

  <!-- Shared section-reset link. Copied here (each WinUI assembly resolves x:Uid
       against its own PRI subtree); the same key also lives in the Settings shell
       for the pages that stayed there. -->
  <data name="Settings_SectionResetLink.Content" xml:space="preserve">
    <value>Reset</value>
  </data>
  <data name="Settings_SectionResetLink.ToolTipService.ToolTip" xml:space="preserve">
    <value>Reset this section to defaults</value>
  </data>

  <!-- Shared folder-picker Open button. Copied here for the same reason; the key
       also lives in the Settings shell for the two FolderPicker UserControls. -->
  <data name="FolderPickerCard_OpenButton.Content" xml:space="preserve">
    <value>Open</value>
  </data>

  <!-- DiagnosticsPage — page chrome (x:Uid) -->
  <data name="DiagnosticsPageTitleLabel.Text" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="DiagnosticsPageSubtitleLabel.Text" xml:space="preserve">
    <value>Choose which operational details Deckle admits, whether to keep an application log, and where purpose-specific telemetry datasets are stored.</value>
  </data>
  <data name="DiagnosticsPage_ResetAll.ToolTipService.ToolTip" xml:space="preserve">
    <value>Reset this page to defaults</value>
  </data>
  <data name="DiagnosticsPageResetAllLabel.Text" xml:space="preserve">
    <value>Reset all</value>
  </data>

  <!-- Logging section (x:Uid header + composed card label key) -->
  <data name="DiagnosticsPageLoggingHeaderLabel.Text" xml:space="preserve">
    <value>Logging details</value>
  </data>
  <data name="LoggingAmbientCard.Header" xml:space="preserve">
    <value>Ambient details</value>
  </data>
  <data name="LoggingAmbientCard.Description" xml:space="preserve">
    <value>Admit frame analysis, calculated colours, individual light pushes, heartbeats, and related technical probes. Lifecycle events, incidents, and recoveries remain available.</value>
  </data>
  <data name="LoggingTranscriptionCard.Header" xml:space="preserve">
    <value>Transcription details</value>
  </data>
  <data name="LoggingTranscriptionCard.Description" xml:space="preserve">
    <value>Admit technical detail across dictation and file transcription. Raw transcript text remains exclusive to the separately consented corpus dataset.</value>
  </data>
  <data name="LoggingAutocorrectCard.Header" xml:space="preserve">
    <value>Autocorrect details</value>
  </data>
  <data name="LoggingAutocorrectCard.Description" xml:space="preserve">
    <value>Admit focus probes, decisions, reranking, learning, and activity summaries. Typed text remains exclusive to separately consented datasets.</value>
  </data>
  <data name="LoggingWindowingCard.Header" xml:space="preserve">
    <value>Windowing details</value>
  </data>
  <data name="LoggingInputCard.Header" xml:space="preserve">
    <value>Input activity</value>
  </data>
  <data name="LoggingInputCard.Description" xml:space="preserve">
    <value>Admit Raw Input summaries and Trackpad gesture details. Device presence, lifecycle events, incidents, warnings, errors, and recoveries remain available.</value>
  </data>
  <data name="LoggingWindowingCard.Description" xml:space="preserve">
    <value>Verbose lines from window placement across every Deckle window — positioning and DPI, overlay stacking, popup anchoring, z-order checks, resize frames, and first-open construction timings. Off by default; this provider emits nothing else, so leaving it off keeps these windows silent in the log.</value>
  </data>

  <!-- Telemetry section (x:Uid header + composed card label keys). The General*
       prefix on the card keys is a historical naming artifact carried over from
       the shell, not a page binding. -->
  <data name="DiagnosticsPageTelemetryHeaderLabel.Text" xml:space="preserve">
    <value>Telemetry</value>
  </data>
  <data name="DiagnosticsPageApplicationLogHeaderLabel.Text" xml:space="preserve">
    <value>Application log</value>
  </data>
  <data name="GeneralAppLogCard.Header" xml:space="preserve">
    <value>Application log</value>
  </data>
  <data name="GeneralAppLogCard.Description" xml:space="preserve">
    <value>Mirror admitted operational observations to diagnostics\app.jsonl. The file rotates every 8,000 lines into numbered generations under diagnostics\archive\.</value>
  </data>
  <data name="GeneralStorageFolderCard.Header" xml:space="preserve">
    <value>Storage folder</value>
  </data>
  <data name="GeneralStorageFolderCard.Description" xml:space="preserve">
    <value>Root for telemetry datasets that support a custom folder. Leave empty to use %LOCALAPPDATA%\Deckle\telemetry\. This does not move the application log or mouse wheel captures.</value>
  </data>
  <data name="TelemetryMouseWheelCard.Header" xml:space="preserve">
    <value>Record wheel events</value>
  </data>
  <data name="TelemetryMouseWheelCard.Description" xml:space="preserve">
    <value>Record wheel timing and delta data to JSONL files under telemetry\mouse-wheel. This capture is independent of Input activity.</value>
  </data>

  <!-- Diagnostic files section (x:Uid) -->
  <data name="DiagnosticsPageFilesHeaderLabel.Text" xml:space="preserve">
    <value>Diagnostic files</value>
  </data>
  <data name="DiagnosticsFilesCard.Header" xml:space="preserve">
    <value>Setup and error logs</value>
  </data>
  <data name="DiagnosticsFilesCard.Description" xml:space="preserve">
    <value>Recorded automatically and kept on this device — never sent anywhere. Open the folder to find them when reporting a first-run or crash problem.</value>
  </data>

  <!-- Shared log filter bar. The live Log Window and the app.jsonl settings
       instantiate the same control with independent filter selections. -->
  <data name="LogFilterBarSeverityButton.Content" xml:space="preserve">
    <value>Severity</value>
  </data>
  <data name="LogFilterBarModuleButton.Content" xml:space="preserve">
    <value>Module</value>
  </data>
  <data name="LogFilterBarCategoryButton.Content" xml:space="preserve">
    <value>Category</value>
  </data>
  <data name="LogFilterBarResetButton.Content" xml:space="preserve">
    <value>Reset filters</value>
  </data>
  <data name="LogFilter_Chip_Format" xml:space="preserve">
    <value>{0}: {1}</value>
  </data>
  <data name="LogFilter_Remove_Format" xml:space="preserve">
    <value>Remove {0} filter</value>
  </data>
  <data name="LogFilter_Module_Dictation" xml:space="preserve">
    <value>Dictation</value>
  </data>

  <!-- Reset dialogs (Loc.Get from code-behind). Source of truth for the wording;
       Loc.Get resolves the runtime copy from Deckle.App's root map. -->
  <data name="Settings_ResetDiagnosticsDialog_Title" xml:space="preserve">
    <value>Reset all settings?</value>
  </data>
  <data name="Settings_ResetDiagnosticsDialog_Content" xml:space="preserve">
    <value>Every logging and telemetry opt-in on this page will be turned off and the storage-folder override cleared. Nothing is recorded again until you opt back in.</value>
  </data>
  <data name="SettingsModuleNavLabel" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
</root>
