<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Diagnostics.Logging.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="DiagnosticsPageHeader"
                                            ResetAllRequested="ResetAllDiagnostics_Click" />

                <!-- No module switch card on this page: Diagnostics is not a module
                     that can be turned off; its opt-ins are the settings themselves.
                     Three sections and no caption under their titles: the cards
                     say what they do, and every caption was one more level of
                     text to read before reaching them. -->

                <!-- ── Logs ────────────────────────────────────────────────────
                     What Deckle writes about itself: the detail a developer
                     turns on to chase a bug, and the copy kept on disk with its
                     retention. This page is their only editor: module pages and
                     the LogWindow never duplicate them. -->
                <catalog:SettingsSection x:Name="LogsSection"
                                         x:Uid="DiagnosticsPageLogsSection"
                                         HasReset="True"
                                         ResetRequested="ResetLogs_Click">
                    <StackPanel x:Name="LogsHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Corpus ──────────────────────────────────────────────────
                     What the person says or types, kept on purpose: each module
                     that owns such a corpus contributes its fold through
                     DiagnosticsRegistry (dictations, typed text). -->
                <catalog:SettingsSection x:Name="CorpusSection"
                                         x:Uid="DiagnosticsPageCorpusSection"
                                         HasReset="True"
                                         ResetRequested="ResetCorpus_Click">
                    <StackPanel x:Name="CorpusHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Folders ─────────────────────────────────────────────────
                     Where what the page records lands, last on the page: the
                     dictation audio folder (configurable, so the section carries
                     a reset), then the diagnostics folder (Open only), which
                     holds the always-on log, the trace and crash dumps. -->
                <catalog:SettingsSection x:Name="FoldersSection"
                                         x:Uid="DiagnosticsPageFoldersSection"
                                         HasReset="True"
                                         ResetRequested="ResetFolders_Click">
                    <StackPanel x:Name="FoldersHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
