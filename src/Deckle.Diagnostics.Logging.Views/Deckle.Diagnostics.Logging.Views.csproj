<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Diagnostics.Logging.Views</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Neutral language for the lib's PRI fallback. Mirrors Deckle.App.csproj. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in DiagnosticsPage and
         LogFilterBar, the composed cards (SettingsComposer reads the view
         model's assembly) and Loc.GetFrom resolve against the
         Deckle.Diagnostics.Logging.Views/Resources subtree
         (Strings/en-US/Resources.resw). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- The Diagnostics settings page and the log window's filter bar.
       Dependencies point one way: this project reads Deckle.Diagnostics.Logging,
       which holds no XAML and knows nothing of it, so the engines that log
       through it never run the XAML compiler on its account. -->
  <ItemGroup>
    <!-- One WinAppSDK runtime per process: never override the central version. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Localization\Deckle.Localization.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <!-- No cycle: Diagnostics.Telemetry does not reference this module. -->
    <ProjectReference Include="..\Deckle.Diagnostics.Telemetry\Deckle.Diagnostics.Telemetry.csproj" />
  </ItemGroup>
</Project>
