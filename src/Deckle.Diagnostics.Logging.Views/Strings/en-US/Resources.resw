  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Nav label — module-owned. The Settings shell reads this bare key straight
       into the module's NavigationViewItem.Content (SettingsModuleDescriptor.LabelKey). -->

  <!-- DiagnosticsPage — page chrome (x:Uid). Three sections, no caption under
       a section title but the Corpus one, whose title is a technical word. -->
  <data name="DiagnosticsPageHeader.Title" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="DiagnosticsPageHeader.Description" xml:space="preserve">
    <value>What Deckle keeps about itself and about what you say or type, on this device only.</value>
  </data>

  <!-- Logs section (x:Uid header + composed card label keys,
       DiagnosticsViewModel.LogsSettings). Detailed logs is one fold: its
       children are each source's detail and the developer captures, with no
       description where the name says it all. -->
  <data name="DiagnosticsPageLogsSection.Title" xml:space="preserve">
    <value>Logs</value>
  </data>
  <data name="LoggingDetailedCard.Header" xml:space="preserve">
    <value>Detailed logs</value>
  </data>
  <data name="LoggingDetailedCard.Description" xml:space="preserve">
    <value>Step-by-step detail to investigate a problem. Turn it on before the problem comes back.</value>
  </data>
  <data name="LoggingAmbientCard.Header" xml:space="preserve">
    <value>Ambient lighting</value>
  </data>
  <data name="LoggingAmbientCard.Description" xml:space="preserve">
    <value>Each light push, its colours and the frame analysis.</value>
  </data>
  <data name="LoggingTranscriptionCard.Header" xml:space="preserve">
    <value>Dictation</value>
  </data>
  <data name="LoggingTranscriptionCard.Description" xml:space="preserve">
    <value>Each utterance and segment. Never what you said.</value>
  </data>
  <data name="LoggingMicrophoneLevelCard.Header" xml:space="preserve">
    <value>Microphone level</value>
  </data>
  <data name="LoggingMicrophoneLevelCard.Description" xml:space="preserve">
    <value>The level of each recording. Levels only, never the sound.</value>
  </data>
  <data name="LoggingLlmCard.Header" xml:space="preserve">
    <value>Language model calls</value>
  </data>
  <data name="LoggingLlmCard.Description" xml:space="preserve">
    <value>Tokens and time of each call, local or online.</value>
  </data>
  <data name="LoggingAutocorrectCard.Header" xml:space="preserve">
    <value>Autocorrect</value>
  </data>
  <data name="LoggingAutocorrectCard.Description" xml:space="preserve">
    <value>Never the words you type.</value>
  </data>
  <data name="LoggingInputCard.Header" xml:space="preserve">
    <value>Touchpad gestures</value>
  </data>
  <data name="LoggingInputCard.Description" xml:space="preserve">
    <value>Each gesture recognised on the touchpad.</value>
  </data>
  <data name="LoggingWindowingCard.Header" xml:space="preserve">
    <value>Windows</value>
  </data>
  <data name="LoggingWindowingCard.Description" xml:space="preserve">
    <value>Placement, scaling and stacking of Deckle's windows.</value>
  </data>

  <!-- The trace (diagnostics\trace.jsonl, GLOSSARY.md). Its retention is
       fixed, not set (TraceRetentionPolicy). The person reads "logs on
       disk"; the keys keep their AppLog name. -->
  <data name="GeneralAppLogCard.Header" xml:space="preserve">
    <value>Keep logs on disk</value>
  </data>
  <data name="GeneralAppLogCard.Description" xml:space="preserve">
    <value>A copy of the log that survives restarts, to follow a problem over time.</value>
  </data>

  <!-- Corpus section (x:Uid header). Its folds come from the modules that own
       each corpus, with their words in their own .resw. -->
  <data name="DiagnosticsPageCorpusSection.Title" xml:space="preserve">
    <value>Corpus</value>
  </data>
  <data name="DiagnosticsPageCorpusSection.Caption" xml:space="preserve">
    <value>What you say or type, kept to tune Deckle to your own words.</value>
  </data>

  <!-- Folders section, last on the page (x:Uid header + the two composed
       folder folds' label keys, DiagnosticsViewModel.FoldersSettings; each
       heads its fold, the Location line inside uses the Settings shell's
       FolderLocationLine_* words). The storage card keeps its General* key;
       a custom storage folder only receives what reads CorpusPaths (the
       dictation audio), so the card is named for that. -->
  <data name="DiagnosticsPageFoldersSection.Title" xml:space="preserve">
    <value>Folders</value>
  </data>
  <data name="GeneralStorageFolderCard.Header" xml:space="preserve">
    <value>Dictation audio folder</value>
  </data>
  <data name="GeneralStorageFolderCard.Description" xml:space="preserve">
    <value>Where the saved audio of your dictations goes.</value>
  </data>
  <data name="DiagnosticsFilesCard.Header" xml:space="preserve">
    <value>Diagnostics folder</value>
  </data>
  <data name="DiagnosticsFilesCard.Description" xml:space="preserve">
    <value>Logs and crash reports. Open it when you report a problem.</value>
  </data>
  <!-- Shared log filter bar. The live Log Window and the trace.jsonl settings
       instantiate the same control with independent filter selections. -->
  <data name="LogFilterBarSeverityButton.Content" xml:space="preserve">
    <value>Severity</value>
  </data>
  <data name="LogFilterBarModuleButton.Content" xml:space="preserve">
    <value>Module</value>
  </data>
  <data name="LogFilterBarCategoryButton.Content" xml:space="preserve">
