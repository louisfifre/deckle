  </data>
  <data name="LogFilter_Category_Windowing" xml:space="preserve">
    <value>Windowing</value>
  </data>
  <data name="LogFilter_Category_Threading" xml:space="preserve">
    <value>Threading</value>
  </data>
  <data name="LogFilter_Category_Theme" xml:space="preserve">
