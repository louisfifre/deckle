  <data name="LogFilter_Module_Dictation" xml:space="preserve">
    <value>Dictation</value>
  </data>

  <!-- Reset dialogs (Loc.Get from code-behind). Source of truth for the wording;
       Loc.Get resolves the runtime copy from Deckle.App's root map. -->
  <data name="Settings_ResetDiagnosticsDialog_Detail" xml:space="preserve">
    <value>Detailed logs, logs on disk and every corpus are turned off, and the dictation audio folder returns to its default location.</value>
  </data>
  <data name="SettingsModuleNavLabel" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
</root>