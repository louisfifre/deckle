  </data>
  <data name="LogFilter_Severity_Warning" xml:space="preserve">
    <value>Warning</value>
  </data>
  <data name="LogFilter_Severity_Error" xml:space="preserve">
    <value>Error</value>
  </data>
  <data name="LogFilter_Severity_Critical" xml:space="preserve">
    <value>Critical</value>
  </data>
  <data name="LogFilter_Category_Lifecycle" xml:space="preserve">
    <value>Lifecycle</value>
  </data>
  <data name="LogFilter_Category_Capture" xml:space="preserve">
    <value>Capture</value>
  </data>
  <data name="LogFilter_Category_Pipeline" xml:space="preserve">
    <value>Pipeline</value>
  </data>
  <data name="LogFilter_Category_Push" xml:space="preserve">
    <value>Push</value>
  </data>
  <data name="LogFilter_Category_Heartbeat" xml:space="preserve">
