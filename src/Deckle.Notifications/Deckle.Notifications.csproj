<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Notifications</RootNamespace>
    <!-- EventSource [Event] parameters intentionally use snake_case
         so the ETW payload keys land directly in the JSONL output. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Notifications.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppNotificationManager / AppNotificationBuilder for the toast channel.
         No UseWinUI: this module ships no XAML, only the notification API
         surface. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <!-- Notification catalogue, dispatcher and channels. Owning modules declare
       their NotificationDescriptors; the catalogue indexes them at boot and the
       dispatcher routes a prompt to the channel matching descriptor.Channel. -->
</Project>
