<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Input.Trackpad.TrackpadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Input.Trackpad"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="TrackpadPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The module switch comes first on the page, alone and outside
                     any section. -->
                <StackPanel x:Name="EnabledHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Three-finger drag ────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="TrackpadPageDragSection">
                    <StackPanel x:Name="DragHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- The raw-frame recording lives on Settings > Diagnostics, the
                     one editor of what Deckle records (TrackpadTelemetryViewModel,
                     2026-10-14). -->

                <!-- ── Windows integration ──────────────────────────────────── -->
                <!-- Hand-authored: imperative commands with their own success
                     reporting, not settable values the composer can drive. -->
                <catalog:SettingsSection x:Uid="TrackpadPageWindowsSection">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                        <controls:SettingsCard x:Uid="TrackpadPage_GesturesCard"
                                               Tag="TrackpadPage_GesturesCard">
                            <Button x:Name="GesturesButton"
                                    Click="GesturesButton_Click">
                                <TextBlock x:Name="GesturesButtonLabel" />
                            </Button>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="TrackpadPage_RepairCard"
                                               Tag="TrackpadPage_RepairCard">
                            <Button x:Name="RepairButton"
                                    x:Uid="TrackpadPage_RepairButton"
                                    Click="RepairButton_Click" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="TrackpadPage_ElevatedCard"
                                               Tag="TrackpadPage_ElevatedCard">
                            <ToggleSwitch x:Name="ElevatedToggle"
                                          Toggled="ElevatedToggle_Toggled" />
                        </controls:SettingsCard>
                    </StackPanel>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
