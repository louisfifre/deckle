  <!-- ─── TrackpadPage ───────────────────────────────────────────────
       Settings page for the Trackpad module. Title + subtitle, then
       three sections in order: Three-finger drag, Windows integration,
       Diagnostics. x:Uid keys follow TrackpadPage_<Element>; code-behind
       flip-labels use the Surface_Purpose form resolved via Loc.Get. -->
  <data name="TrackpadPage_Title" xml:space="preserve">
    <value>Trackpad</value>
  </data>
  <data name="TrackpadPage_Subtitle" xml:space="preserve">
    <value>Drag with three fingers on a Magic Trackpad 2 — press nothing, just move three fingers to pick up a window or selection and drop it where they lift.</value>
  </data>

  <!-- Three-finger drag -->
  <data name="TrackpadPage_Section_Drag" xml:space="preserve">
    <value>Three-finger drag</value>
  </data>
  <data name="TrackpadPage_DragExpander.Header" xml:space="preserve">
    <value>Three-finger drag</value>
  </data>
  <data name="TrackpadPage_DragExpander.Description" xml:space="preserve">
    <value>Move three fingers to drag what's under the pointer. Turn on to reveal the speed control.</value>
  </data>
  <data name="TrackpadPage_SpeedCard.Header" xml:space="preserve">
    <value>Drag speed</value>
  </data>
  <data name="TrackpadPage_SpeedCard.Description" xml:space="preserve">
    <value>How far the drag travels for the same finger movement. Higher is faster.</value>
  </data>

  <!-- Windows integration -->
  <data name="TrackpadPage_Section_Windows" xml:space="preserve">
    <value>Windows integration</value>
  </data>
  <data name="TrackpadPage_GesturesCard.Header" xml:space="preserve">
    <value>Windows three-finger gestures</value>
  </data>
  <data name="TrackpadPage_GesturesCard.Description" xml:space="preserve">
    <value>Sets Windows' built-in three-finger gestures to nothing so the drag has room to work. Your original gestures are backed up and can be restored at any time. Applying the change may require the trackpad to reconnect.</value>
  </data>
  <data name="TrackpadPage_GesturesButton_Neutralize" xml:space="preserve">
    <value>Neutralize</value>
  </data>
  <data name="TrackpadPage_GesturesButton_Restore" xml:space="preserve">
    <value>Restore</value>
  </data>
  <data name="TrackpadPage_RepairCard.Header" xml:space="preserve">
    <value>Repair Bluetooth connection</value>
  </data>
  <data name="TrackpadPage_RepairCard.Description" xml:space="preserve">
    <value>Fixes the Apple driver pairing bug — removes the driver from the store, re-pairs the trackpad, and reinstalls. Asks for administrator approval and runs in an interactive console.</value>
  </data>
  <data name="TrackpadPage_RepairButton.Content" xml:space="preserve">
    <value>Repair…</value>
  </data>
  <data name="TrackpadPage_ElevatedCard.Header" xml:space="preserve">
    <value>Start elevated</value>
  </data>
  <data name="TrackpadPage_ElevatedCard.Description" xml:space="preserve">
    <value>Lets the drag work over windows that run as administrator. Converts Deckle's startup into a highest-privileges scheduled task. Asks for administrator approval once.</value>
  </data>

  <!-- Diagnostics -->
  <data name="TrackpadPage_Section_Diagnostics" xml:space="preserve">
    <value>Diagnostics</value>
  </data>
  <data name="TrackpadPage_RecordFramesCard.Header" xml:space="preserve">
    <value>Record raw contact frames</value>
  </data>
  <data name="TrackpadPage_RecordFramesCard.Description" xml:space="preserve">
    <value>Writes every contact frame to a JSONL file in the telemetry folder. Works whether or not three-finger drag is on.</value>
  </data>
  <data name="TrackpadPage_TuningExpander.Header" xml:space="preserve">
    <value>Tuning (temporary)</value>
  </data>
  <data name="TrackpadPage_TuningExpander.Description" xml:space="preserve">
    <value>These defaults are still being calibrated on real sessions. This section will disappear once they're frozen.</value>
  </data>
  <data name="TrackpadPage_GraceDelayCard.Header" xml:space="preserve">
    <value>Grace delay (ms)</value>
  </data>
  <data name="TrackpadPage_GraceDelayCard.Description" xml:space="preserve">
    <value>How long the drag holds on after your fingers lift, so a brief slip doesn't drop it.</value>
  </data>
  <data name="TrackpadPage_StartThresholdCard.Header" xml:space="preserve">
    <value>Start threshold (% of pad width)</value>
  </data>
  <data name="TrackpadPage_StartThresholdCard.Description" xml:space="preserve">
    <value>How far three fingers must travel before a drag begins instead of a tap.</value>
  </data>
  <data name="TrackpadPage_BaseScaleCard.Header" xml:space="preserve">
    <value>Base scale</value>
  </data>
  <data name="TrackpadPage_BaseScaleCard.Description" xml:space="preserve">
    <value>Baseline movement factor that the drag speed above multiplies.</value>
  </data>
