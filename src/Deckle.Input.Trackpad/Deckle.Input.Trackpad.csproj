<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Input.Trackpad</RootNamespace>
    <!-- WinUI XAML compilation : the module ships its own Settings page
         (TrackpadPage.xaml), following the "each module carries its own
         settings page" doctrine. Same lib-with-PRI pattern as
         Deckle.Transcription / Deckle.Lighting.Ambient. -->
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- MVVM Toolkit — [ObservableProperty] in TrackpadViewModel. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- SettingsCard / SettingsExpander — TrackpadPage canonical layout. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes the recognizer internals to the test project. Same
         MSBuild→Roslyn [InternalsVisibleTo] pattern as Deckle.Transcription. -->
    <InternalsVisibleTo Include="Deckle.Input.Trackpad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Support layer: Raw Input host, contact frames, SendInput primitive. -->
    <ProjectReference Include="..\Deckle.Input\Deckle.Input.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- AutostartService / ElevatedStartupService — the page's "Start
         elevated" toggle swaps the autostart vehicle between the HKCU Run
         key and the elevated scheduled task. -->
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Proven Magic Trackpad 2 Bluetooth repair procedure, extracted and
         launched elevated by ConnectionRepair. Shipped embedded so a Deckle
         update always carries the current script. -->
    <EmbeddedResource Include="Acts\repair-trackpad-connection.ps1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output. Convention
         documented in ../Deckle.Diagnostics/CLAUDE.md. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
