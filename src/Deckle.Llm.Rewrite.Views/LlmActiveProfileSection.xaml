<UserControl
    x:Class="Deckle.Llm.Rewrite.Views.LlmActiveProfileSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The reset is a command (it puts the choice back to "None"), not a
         dirty-tracked value, so the wheel stays enabled. -->
    <catalog:SettingsSection x:Uid="LlmActiveProfileBlock"
                             HasReset="True"
                             IsResetEnabled="True"
                             ResetRequested="ResetSection_Click">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <controls:SettingsCard x:Uid="LlmActiveProfileCard"
                                   Tag="LlmActiveProfileCard">
                <ComboBox x:Name="ActiveProfileCombo"
                          MinWidth="200"
                          SelectionChanged="ActiveProfileCombo_SelectionChanged" />
            </controls:SettingsCard>

            <!-- The length ladder: a switch, then its steps, one card each. -->
            <controls:SettingsCard x:Uid="LlmLengthSwitchCard"
                                   Tag="LlmLengthSwitchCard">
                <ToggleSwitch x:Name="LengthSwitchToggle"
                              Toggled="LengthSwitchToggle_Toggled" />
            </controls:SettingsCard>

            <StackPanel x:Name="StepsPanel"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Visibility="Collapsed">
                <StackPanel x:Name="StepsHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />
                <Button x:Name="AddStepButton"
                        x:Uid="LlmLengthAddStepButton"
                        Click="AddStep_Click"
                        Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </catalog:SettingsSection>
</UserControl>
