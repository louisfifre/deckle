<Page
    x:Class="Deckle.Llm.Rewrite.Views.LlmProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Deckle.Llm.Rewrite.Views"
    xmlns:catalog="using:Deckle.Catalog">

    <Page.Resources>
        <vm:CtxTooltipConverter x:Key="CtxTooltipConverter" />
        <vm:TempTooltipConverter x:Key="TempTooltipConverter" />
        <vm:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- One rewrite profile, opened from its card on the Rewriting page, as
         Windows 11 Settings opens one device under Bluetooth & devices: one
         card per field, the control on the trailing edge, the long prompt
         under its own header. Everything auto-saves through the view model. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Cards"
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

            <!-- Title is the profile's name, set in code and kept current; the
                 trail reads "Rewriting › name" (ParentPageTag). Nothing to reset
                 on one profile: the Profiles section of the parent page resets
                 the list. -->
            <catalog:SettingsPageHeader x:Name="Header"
                                        HasResetAll="False" />

            <controls:SettingsCard x:Uid="LlmProfilePage_NameCard">
                <TextBox x:Name="NameBox"
                         x:Uid="LlmProfilePage_NameBox"
                         Text="{x:Bind Profile.Name, Mode=OneWay}"
                         TextChanged="NameBox_TextChanged"
                         MinWidth="280" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="LlmProfilePage_ProviderCard">
                <ComboBox x:Name="ProviderBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          MinWidth="280"
                          SelectionChanged="ProviderBox_SelectionChanged" />
            </controls:SettingsCard>

            <!-- Not an editable ComboBox: its dropdown-arrow mouse interaction
                 is unreliable in WinUI 3. Text is OneWay (VM → UI) so the stored
                 model name shows even when it is not in the suggestion list
                 (provider offline, model renamed); the handlers carry UI → VM. -->
            <controls:SettingsCard x:Uid="LlmProfilePage_ModelCard">
                <AutoSuggestBox x:Uid="LlmProfilePage_ModelBox"
                                Text="{x:Bind Profile.Model, Mode=OneWay}"
                                MinWidth="280"
                                GotFocus="ModelBox_GotFocus"
                                TextChanged="ModelBox_TextChanged"
                                SuggestionChosen="ModelBox_SuggestionChosen"
                                QuerySubmitted="ModelBox_QuerySubmitted" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="LlmProfilePage_PromptCard"
                                   ContentAlignment="Vertical"
                                   HorizontalContentAlignment="Stretch">
                <TextBox x:Uid="LlmProfilePage_PromptBox"
                         Text="{x:Bind Profile.SystemPrompt, Mode=OneWay}"
                         TextChanged="PromptBox_TextChanged"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="100"
                         MaxHeight="300"
                         HorizontalAlignment="Stretch" />
            </controls:SettingsCard>

            <!-- Hidden, not greyed, for a hosted provider that takes no
                 sampling hints. Top P and the repeat penalty are not exposed
                 (triage of 2026-10-14): a profile keeps the model's defaults. -->
            <controls:SettingsCard x:Uid="LlmProfilePage_TemperatureCard"
                                   Visibility="{x:Bind Profile.ShowsGenerationHints, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Profile.TempDisplay, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Uid="LlmProfilePage_TemperatureSlider"
                            Minimum="0" Maximum="2"
                            StepFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            Value="{x:Bind Profile.Temperature, Mode=TwoWay}"
                            ThumbToolTipValueConverter="{StaticResource TempTooltipConverter}" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="LlmProfilePage_ContextCard"
                                   Visibility="{x:Bind Profile.ShowsGenerationHints, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Profile.CtxDisplay, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Uid="LlmProfilePage_ContextSlider"
                            Minimum="0" Maximum="8"
                            StepFrequency="1"
                            SnapsTo="StepValues"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            Value="{x:Bind Profile.CtxIndex, Mode=TwoWay}"
                            ThumbToolTipValueConverter="{StaticResource CtxTooltipConverter}" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- The reasoning level and the shortcut are composed in code after
                 this point (ComposeCards), so the shortcut gets the same chord
                 editor as the Shortcuts page. The removal card stays last. -->
            <controls:SettingsCard x:Name="RemoveCard"
                                   x:Uid="LlmProfilePage_RemoveCard">
                <Button x:Uid="LlmProfilePage_RemoveButton"
                        Click="RemoveButton_Click" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
