<UserControl
    x:Class="Deckle.Llm.Rewrite.Views.LlmDictationSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:llm="using:Deckle.Llm.Rewrite.Views"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The dictation steps (specs/deckle-dictation-rewriting.md, Page): the
         switch alone, then, while it is on, "Rewrite while I speak" (on
         streaming transcription only), the timeline, one card per step and
         "Add a step". No caption and no step card description: the section
         carries as few words as it can. The reset is a command (the steps
         back to one), not a dirty-tracked value, so the wheel stays enabled. -->
    <catalog:SettingsSection x:Uid="LlmDictationBlock"
                             Tag="LlmDictationSection"
                             HasReset="True"
                             IsResetEnabled="True"
                             ResetRequested="ResetSection_Click">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <controls:SettingsCard x:Uid="LlmDictationEnableCard"
                                   Tag="LlmDictationEnableCard">
                <ToggleSwitch x:Name="EnableToggle"
                              Toggled="EnableToggle_Toggled" />
            </controls:SettingsCard>

            <StackPanel x:Name="StepsPanel"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Visibility="Collapsed">
                <controls:SettingsCard x:Name="WhileSpeakingCard"
                                       x:Uid="LlmDictationWhileSpeakingCard"
                                       Tag="LlmDictationWhileSpeakingCard">
                    <ToggleSwitch x:Name="WhileSpeakingToggle"
                                  Toggled="WhileSpeakingToggle_Toggled" />
                </controls:SettingsCard>
                <catalog:PreviewBlock IsLive="True">
                    <llm:RewriteStepTimeline x:Name="Timeline"
                                             VerticalAlignment="Center" />
                </catalog:PreviewBlock>
                <StackPanel x:Name="StepsHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />
                <Button x:Name="AddStepButton"
                        x:Uid="LlmAddStepButton"
                        Click="AddStep_Click"
                        Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </catalog:SettingsSection>
</UserControl>
