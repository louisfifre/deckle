<UserControl
    x:Class="Deckle.Llm.Rewrite.Views.LlmProfilesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Deckle.Llm.Rewrite.Views"
    xmlns:catalog="using:Deckle.Catalog"
    x:Name="Root">

    <!-- Tag is the search index's scroll-to handle (LabelKey "LlmProfilesSection").
         The reset is a command with its own confirmation, not a dirty-tracked
         value, so the wheel stays enabled. -->
    <catalog:SettingsSection x:Uid="LlmProfilesBlock"
                             Tag="LlmProfilesSection"
                             HasReset="True"
                             IsResetEnabled="True"
                             ResetRequested="ResetSection_Click">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

        <ItemsRepeater ItemsSource="{x:Bind Profiles}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileViewModel">
                    <!-- One card per profile, its chevron leading to the
                         profile's own page (LlmProfilePage), as Windows 11
                         Settings lists devices. Tag carries the profile: the
                         repeater leaves DataContext unset under x:Bind. -->
                    <controls:SettingsCard
                        Header="{x:Bind Name, Mode=OneWay}"
                        Description="{x:Bind Summary, Mode=OneWay}"
                        IsClickEnabled="True"
                        Tag="{x:Bind}"
                        Click="ProfileCard_Click" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Button x:Uid="LlmAddProfileButton"
                Click="AddProfile_Click"
                Margin="0,4,0,0" />
    </StackPanel>
    </catalog:SettingsSection>
</UserControl>
