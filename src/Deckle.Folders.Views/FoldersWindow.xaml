<Window
    x:Class="Deckle.Folders.Views.FoldersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Folders.Views"
    Title="Deckle Folders">

    <!-- Hidden: an element that carries accelerators gets a tooltip naming the
         first one, opened when keyboard focus lands anywhere inside it. On the
         root that is a stray "F5" under the window whenever focus arrives by
         keyboard; the buttons' own tooltips say what the keys do. -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden" SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <!-- The three numbered lines of the empty state (12.11). -->
            <Style x:Key="EmptyStepCard" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="EmptyStepNumber" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Key="D" Modifiers="Menu" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Menu,Shift" Invoked="OnDetailsAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The top row is the title bar itself (spec, Window: one row, no
             band above it, no tabs). The TitleBar control lays out, left to
             right, its pane toggle, the icon, the title, then Content, then
             Windows' caption buttons; its own back button is hidden because
             Back sits after the name here, with Forward, Up and Refresh, in
             Content. The window asks for the tall caption buttons, which take
             the row's full height. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="Deckle Folders"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Resources>
                <!-- Content takes the width left between the title and the
                     caption buttons, so the address bar can stretch. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid Margin="4,0,0,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- The address field's floor is its icon, the search
                             button inside it and a few letters. The title bar
                             keeps a drag margin before the caption buttons, so at
                             the window's minimum width (the narrow layout, with Back
                             and Up, the tools as glyphs and the details toggle) a
                             floor of 96 clipped the toggle's pressed fill. -->
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The row, left to right: back, forward, up, refresh, the
                         address field with search inside it, the tools, the
                         divider, the details toggle. -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BackButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnBackClick">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <Button x:Name="ForwardButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnForwardClick">
                            <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        </Button>
                        <Button x:Name="UpButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnUpClick">
                            <FontIcon Glyph="&#xE74A;" FontSize="16" />
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnRefreshClick">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <local:AddressBar x:Name="Address" Grid.Column="1" Margin="2,0">
                        <local:AddressBar.TrailingContent>
                            <!-- Search goes through PowerToys Command Palette (spec,
                                 Search). It sits inside the address field, at its
                                 right end. A click asks whether it is installed, then
                                 opens the small panel under the button (12.13, Open
                                 9): absent, it says so and offers PowerToys' page;
                                 present, it gives the palette's shortcut. -->
                            <Button x:Name="SearchButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="24" Padding="0" Click="OnSearchClick">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="SearchFlyout" Placement="BottomEdgeAlignedRight">
                                        <Grid MaxWidth="320">
                                            <StackPanel x:Name="SearchAbsentPanel" Spacing="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Uid="SearchAbsentTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                    <TextBlock x:Uid="SearchAbsentBody" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button x:Uid="SearchInstallPowerToys" Style="{StaticResource AccentButtonStyle}" Click="OnInstallPowerToysClick" />
                                                    <Button x:Uid="SearchLater" Click="OnSearchLaterClick" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock x:Name="SearchPresentText" x:Uid="SearchInCommandPalette" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </Grid>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </Button>
                        </local:AddressBar.TrailingContent>
                    </local:AddressBar>

                    <!-- One toggle per tool but Files, each with its glyph
                         and its name; the pressed one is the active tool
                         (spec, Window). Files has none: it is what shows
                         when none is pressed. Built from the tool catalog in
                         code. The divider and the details-pane toggle sit
                         after them. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="2,0">
                        <StackPanel x:Name="ToolButtons" Orientation="Horizontal" Spacing="2">
                            <StackPanel.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                            </StackPanel.Resources>
                        </StackPanel>

                        <Rectangle Width="1" Height="20" Margin="4,0" VerticalAlignment="Center"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Whether the details panel shows: the person's
                             choice, on at first and kept for this window's
                             life only. -->
                        <ToggleButton x:Name="DetailsToggle" Width="36" Height="32" Padding="0" IsChecked="True" Click="OnDetailsToggleClick">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                            </ToggleButton.Resources>
                            <FontIcon Glyph="&#xE90D;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- The pane of added folders (12.1, 12.2): reduced to their icons in
             a rail, opened beside the content by the first button of the top
             row. Its display mode is set in code (NavigationPane,
             specs/deckle-navigation-pane.md); its own toggle is hidden because
             the title bar's opens it. Its content area brings the layer fill
             and the stroke the boards draw; the three resources below make
             it a card, rounded on its four corners and inset from the
             window's right and bottom edges. The Left display mode sets none
             of them itself, so these apply (generic.xaml, NavigationView). -->
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        OpenPaneLength="280"
                        SelectionFollowsFocus="Disabled"
                        ItemInvoked="OnNavItemInvoked">
            <!-- Written out in four parts: a keyed Thickness of "1" ends the
                 app in XAML parsing here. -->
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0,0,8,8</Thickness>
                <StaticResource x:Key="NavigationViewContentGridCornerRadius" ResourceKey="OverlayCornerRadius" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,1,1</Thickness>
            </NavigationView.Resources>

            <!-- Home first, then its separator, then the added folders, which
                 the window puts after them (PaneLeadingItems). -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AddItem" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="CentreHost" />

                <!-- Before any folder is added (12.11). -->
                <ScrollViewer x:Name="EmptyState" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Spacing="24" MaxWidth="584">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="EmptyTitle"
                                       Style="{StaticResource BodyLargeTextBlockStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="EmptyBody"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="DropZone"
                              Height="120"
                              AllowDrop="True"
                              Background="Transparent"
                              DragOver="OnDropZoneDragOver"
                              Drop="OnDropZoneDrop">
                            <Rectangle Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       StrokeThickness="1"
                                       StrokeDashArray="4,3"
                                       RadiusX="8"
                                       RadiusY="8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Button x:Name="EmptyAddButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Click="OnAddFolderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                                        <TextBlock x:Name="EmptyAddLabel" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Uid="EmptyDrop"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid Style="{StaticResource EmptyStepCard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EmptyStepNumber}"><TextBlock Text="1" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="EmptyStep1Title" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="EmptyStep1Body" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource EmptyStepCard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EmptyStepNumber}"><TextBlock Text="2" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="EmptyStep2Title" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="EmptyStep2Body" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource EmptyStepCard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EmptyStepNumber}"><TextBlock Text="3" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="EmptyStep3Title" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="EmptyStep3Body" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The details panel, on the right of the centre (12.1). The
                     window owns its frame; the active tool fills it. -->
                <Border x:Name="DetailsPanel"
                        Grid.Column="1"
                        Width="320"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <ScrollViewer>
                        <ContentPresenter x:Name="DetailsHost" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
