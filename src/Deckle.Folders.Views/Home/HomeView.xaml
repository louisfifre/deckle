<UserControl
    x:Class="Deckle.Folders.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Folders.Views"
    xmlns:folders="using:Deckle.Folders"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Home (boards 24/11, A2): the title, then a tile per added folder in
         the pane's order: the folders in no group with no header, then each
         group that has folders under its name. The title's left edge lines up
         with the tiles'. A tile is invoked by a click, Enter or Space, as a
         pane item is. One ItemsView per section, a few at most, in one
         vertical stack under one scroll. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="HomeTitle"
                   Margin="32,24,32,16"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <ScrollViewer Grid.Row="1" Padding="32,0,32,24">
            <ItemsControl x:Name="Sections">
                <!-- No theme resource holds a spacing; 24 between sections and
                     8 under a header are the values board A2 draws. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:HomeSection">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Header}"
                                       Visibility="{x:Bind HeaderVisibility}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsView ItemsSource="{x:Bind Folders}"
                                       SelectionMode="None"
                                       IsItemInvokedEnabled="True"
                                       ItemInvoked="OnTileInvoked">
                                <ItemsView.Layout>
                                    <UniformGridLayout MinItemWidth="280"
                                                       MinItemHeight="64"
                                                       ItemsStretch="Fill"
                                                       MinRowSpacing="8"
                                                       MinColumnSpacing="8" />
                                </ItemsView.Layout>
                                <ItemsView.ItemTemplate>
                                    <DataTemplate x:DataType="folders:AddedFolder">
                                        <ItemContainer AutomationProperties.Name="{x:Bind Name}"
                                                       ToolTipService.ToolTip="{x:Bind Path}">
                                            <Grid Padding="16,12"
                                                  ColumnSpacing="16"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                  BorderThickness="1"
                                                  CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <catalog:IconChoiceView BoxSize="24"
                                                                        Choice="{x:Bind Icon}"
                                                                        VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Path}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </ItemContainer>
                                    </DataTemplate>
                                </ItemsView.ItemTemplate>
                            </ItemsView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
