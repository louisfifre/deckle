<UserControl
    x:Class="Deckle.Folders.Views.AddressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Folders.Views"
    xmlns:catalog="using:Deckle.Catalog"
    UseSystemFocusVisuals="False"
    LostFocus="OnFieldLostFocus">

    <!-- File Explorer's address bar (spec, Window): the path as segments, a
         chevron after a segment that lists the folders inside it, a click on
         a segment goes there, a click on the empty part turns the bar into a
         text field with suggestions.

         What BreadcrumbBar gives is kept: the segments, ItemClicked, and the
         ellipsis that folds the leftmost segments when the path is too long.
         What it lacks is built here: its separator is a TextBlock of its
         template (PART_ChevronTextBlock), not a control, so it cannot open a
         list. The template's separator glyph is emptied through its
         lightweight-styling key, and each segment carries a real chevron
         Button with a MenuFlyout instead.

         The field has three modes (boards 24/11, C1, F1): short at rest
         (drive, an ellipsis, the current name), full after a click (the
         drive then the segments), and the text field after a click on the
         empty part of the full one. At Home it holds the Home glyph and
         "Home". The search button sits at the field's right end, in every
         mode. -->
    <UserControl.Resources>
        <!-- The separator between the plain parts of the short and full
             forms: the crumbs' chevron glyph, as text, since nothing in it
             is clickable. -->
        <Style x:Key="AddressSeparatorStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="Text" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Frame"
          Height="32"
          Background="{ThemeResource ControlFillColorDefaultBrush}"
          BorderBrush="{ThemeResource ControlElevationBorderBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="SegmentsMode"
              Background="Transparent"
              Padding="2,0,4,0"
              ColumnSpacing="2"
              Tapped="OnSegmentsModeTapped"
              SizeChanged="OnSegmentsModeSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The added folder's icon. A click opens the icon picker under
                 it (12.3); never a right-click (spec, Window). -->
            <Button x:Name="IconButton"
                    Width="28"
                    Height="24"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnIconClick">
                <catalog:IconChoiceView x:Name="RootIcon" />
            </Button>

            <!-- At Home the same slot holds the Home glyph, which opens
                 nothing. -->
            <FontIcon x:Name="HomeIcon"
                      Glyph="&#xE80F;"
                      FontSize="16"
                      Margin="6,0"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />

            <!-- The drive, shared by the short and the full forms; plain
                 text, nothing to click. -->
            <StackPanel x:Name="DrivePrefix"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="4,0,6,0"
                        VerticalAlignment="Center"
                        SizeChanged="OnDrivePrefixSizeChanged">
                <TextBlock x:Name="DriveLabel" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource AddressSeparatorStyle}" />
            </StackPanel>

            <BreadcrumbBar x:Name="Crumbs"
                           Grid.Column="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           ItemClicked="OnCrumbClicked">
                <BreadcrumbBar.Resources>
                    <x:String x:Key="BreadcrumbBarChevronLeftToRight">&#x200B;</x:String>
                    <x:String x:Key="BreadcrumbBarChevronRightToLeft">&#x200B;</x:String>
                    <Thickness x:Key="BreadcrumbBarChevronPadding">0</Thickness>
                    <x:Double x:Key="BreadcrumbBarItemThemeFontSize">14</x:Double>
                </BreadcrumbBar.Resources>
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="local:AddressCrumb">
                        <!-- A name too long for the bar is cut with an
                             ellipsis and says itself whole in a tooltip, as
                             File Explorer's segments do. Its ceiling follows
                             the bar's width (AddressBar.xaml.cs). -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="{x:Bind Name}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Loaded="OnCrumbNameLoaded"
                                       Unloaded="OnCrumbNameUnloaded"
                                       IsTextTrimmedChanged="OnCrumbNameTrimmedChanged" />
                            <Button Width="24"
                                    Height="24"
                                    Padding="0"
                                    Margin="2,0,0,0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Visibility="{x:Bind ChevronVisibility}"
                                    AutomationProperties.Name="{x:Bind ChevronLabel}"
                                    ToolTipService.ToolTip="{x:Bind ChevronLabel}"
                                    Tag="{x:Bind}"
                                    Click="OnChevronClick">
                                <FontIcon Glyph="&#xE76C;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <!-- The short form's end: what the segments hide, then the current
                 folder's name, cut with an ellipsis when too long. -->
            <Grid x:Name="ShortTail"
                  Grid.Column="2"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HiddenSegments" Text="&#x2026;" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="HiddenSeparator" Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource AddressSeparatorStyle}" />
                <TextBlock x:Name="CurrentName"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           IsTextTrimmedChanged="OnCurrentNameTrimmedChanged" />
            </Grid>

            <!-- Home's only segment: not clickable, no chevron. -->
            <TextBlock x:Name="HomeLabel"
                       Grid.Column="2"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>

        <!-- The text mode (12.12b). -->
        <AutoSuggestBox x:Name="PathBox"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        UpdateTextOnSelect="True"
                        TextChanged="OnPathTextChanged"
                        QuerySubmitted="OnPathSubmitted"
                        KeyDown="OnPathKeyDown"
                        LostFocus="OnPathLostFocus" />

        <!-- What the window puts at the field's right end (the search
             button), outside the modes so it stays in each of them. -->
        <ContentPresenter x:Name="TrailingHost"
                          Grid.Column="1"
                          Margin="0,0,2,0"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>
