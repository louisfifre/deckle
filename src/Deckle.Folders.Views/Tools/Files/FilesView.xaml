<UserControl
    x:Class="Deckle.Folders.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Folders.Views">

    <!-- One folder in three displays, chosen at the bottom right (12.18, 12.16,
         12.17). The list is the details list of board 12.1: a header row, then
         one row per item, name, date modified and size; the header and the
         rows share their column widths, and both sit 12 px in from the item's
         rounded fill, so each label stands over its column. The large rows
         put the type, size and date under the name, as File Explorer's Content
         view does, and need no header. The gallery shows each item as a tile
         with a picture of its content. One control per display, and only the
         shown one holds the items, so only it realizes containers. Every row
         ends on the place of its two actions (FileRowActions), a column of
         fixed width in the list, whose header keeps it empty, and in the large
         rows; in the gallery they sit on the picture's corner. -->
    <UserControl.Resources>
        <GridLength x:Key="ModifiedColumnWidth">104</GridLength>
        <GridLength x:Key="SizeColumnWidth">88</GridLength>
        <!-- Explorer's compact rows, not ListView's touch-sized default. -->
        <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
        <!-- The gallery's picture cell, 4:3 like File Explorer's large icons,
             wide enough for a page of a PDF to be told from another. -->
        <x:Double x:Key="FileTileWidth">160</x:Double>
        <x:Double x:Key="FileTilePreviewHeight">120</x:Double>
        <!-- The row actions' place, the same on every row (FileRowActions). -->
        <GridLength x:Key="RowActionsColumnWidth">68</GridLength>
    </UserControl.Resources>

    <Grid Padding="12,8,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What Windows did not do when it was asked to: open an item, show
             it in File Explorer, take it to the Recycle Bin. -->
        <InfoBar x:Name="Notice"
                 Margin="4,0,4,8"
                 IsOpen="False" />

        <Grid x:Name="Header"
              Grid.Row="1"
              Height="32"
              Margin="4,0"
              Padding="12,0"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ModifiedColumnWidth}" />
                <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                <ColumnDefinition Width="{StaticResource RowActionsColumnWidth}" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="FilesHeaderName"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Uid="FilesHeaderModified"
                       Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Uid="FilesHeaderSize"
                       Grid.Column="2"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <ListView x:Name="Rows"
                  Grid.Row="2"
                  Margin="0,4,0,0"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnItemsDoubleTapped"
                  KeyDown="OnItemsKeyDown"
                  ContainerContentChanging="OnContainerContentChanging">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileRow">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ModifiedColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource RowActionsColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <!-- A grid, not a horizontal StackPanel: a StackPanel
                             gives the name all the width it asks, so a long
                             name was clipped by the column without its
                             ellipsis. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       local:TrimmedNameToolTip.IsEnabled="True" />
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Modified}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Size}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                        <local:FileRowActions Grid.Column="3"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              ShowInFolderClick="OnRowShowInFolderClick"
                                              RecycleClick="OnRowRecycleClick" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Large rows (12.16): a 32 px icon, the name, and under it the type,
             size and date in the caption style the list's columns use. -->
        <ListView x:Name="LargeRows"
                  Grid.Row="2"
                  Margin="0,4,0,0"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  Visibility="Collapsed"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnItemsDoubleTapped"
                  KeyDown="OnItemsKeyDown"
                  ContainerContentChanging="OnContainerContentChanging">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileRow">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource RowActionsColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind Glyph}"
                                      FontSize="24"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind LargeGlyphVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind LargeIcon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" local:TrimmedNameToolTip.IsEnabled="True" />
                            <TextBlock Text="{x:Bind Summary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <local:FileRowActions Grid.Column="2"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              ShowInFolderClick="OnRowShowInFolderClick"
                                              RecycleClick="OnRowRecycleClick" />

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- The gallery (12.17): a tile per item, the picture of its content
             where Windows draws one (a photo, a PDF's first page), the
             beginning of its text for a Markdown or plain-text file, its
             type's icon otherwise, the name under
             it as File Explorer centres it, on two lines at most. -->
        <GridView x:Name="Gallery"
                  Grid.Row="2"
                  Margin="0,4,0,0"
                  Padding="4,0,0,12"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  Visibility="Collapsed"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnItemsDoubleTapped"
                  KeyDown="OnItemsKeyDown"
                  ContainerContentChanging="OnContainerContentChanging">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:FileRow">
                    <StackPanel Width="{StaticResource FileTileWidth}"
                                Padding="0,0,0,8"
                                Spacing="6"
                                ToolTipService.ToolTip="{x:Bind Name}"
                                AutomationProperties.Name="{x:Bind Name}">
                        <Grid Height="{StaticResource FileTilePreviewHeight}"
                              CornerRadius="{ThemeResource ControlCornerRadius}"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                            <FontIcon Glyph="{x:Bind Glyph}"
                                      FontSize="32"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{x:Bind TileGlyphVisibility, Mode=OneWay}" />
                            <Image Width="64"
                                   Height="64"
                                   Source="{x:Bind TileIcon, Mode=OneWay}"
                                   Stretch="Uniform"
                                   Visibility="{x:Bind TileIconVisibility, Mode=OneWay}" />
                            <Image Margin="8"
                                   Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Stretch="Uniform" />
                            <!-- A text file's beginning, as plain text in the
                                 type ramp's smallest style; the cell cuts what
                                 does not fit. -->
                            <TextBlock Margin="10,8"
                                       Text="{x:Bind PreviewText, Mode=OneWay}"
                                       Visibility="{x:Bind PreviewTextVisibility, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="False"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <!-- On the picture's corner, where they cover
                                 nothing else and move nothing. -->
                            <local:FileRowActions Margin="4"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  OverContent="True"
                                                  ShowInFolderClick="OnRowShowInFolderClick"
                                                  RecycleClick="OnRowRecycleClick" />
                        </Grid>
                        <TextBlock Margin="4,0"
                                   Text="{x:Bind Name}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   MinHeight="40" />
                        <!-- Two lines reserved on every tile: the grid sizes
                             every tile on the first one, so a one-line first
                             name cut the second line of the others. 40 is two
                             lines of the body text's 20 px line height. -->
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- An empty folder, or one that is gone or unreadable (spec, Open 33:
             Windows' conventions; Explorer says the folder is empty in the
             middle of the list), over whichever display is shown. -->
        <TextBlock x:Name="Message"
                   Grid.Row="2"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />

        <!-- Where the display is chosen (12.18, bottom right). The pressed
             button is the display shown. -->
        <StackPanel x:Name="DisplayChoice"
                    Grid.Row="3"
                    Height="40"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="2">
            <StackPanel.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
            </StackPanel.Resources>
            <ToggleButton x:Name="DisplayListButton" Width="36" Height="32" Padding="0" IsChecked="True" Click="OnDisplayClick">
                <FontIcon Glyph="&#xE8FD;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="DisplayLargeRowsButton" Width="36" Height="32" Padding="0" Click="OnDisplayClick">
                <FontIcon Glyph="&#xE8BF;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="DisplayGalleryButton" Width="36" Height="32" Padding="0" Click="OnDisplayClick">
                <FontIcon Glyph="&#xF0E2;" FontSize="16" />
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
