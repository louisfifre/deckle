<Window
    x:Class="Deckle.Browser.Views.BrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Deckle Browser">

    <Grid x:Name="RootGrid">
        <!-- No title bar of its own: the panel's button row stands in for it
             (SetTitleBar) and the caption buttons sit at the top right, above
             the page. The pane is Zen's panel: our own controls in the pane's
             slots, not navigation items. -->
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="300"
                        CompactPaneLength="48">

            <!-- One ground for the whole window: the panel and the page card
                 sit on the window's Mica, without the content layer
                 NavigationView paints by default (as Mail's window draws it).
                 The HighContrast dictionary repeats the control's own
                 values, so a contrast theme keeps its window colour. -->
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <!-- The button row: pane toggle, back, forward, reload. It is the
                 window's drag region (SetTitleBar); in the rail it stands in a
                 column. -->
            <NavigationView.PaneCustomContent>
<StackPanel>
                <Grid x:Name="ButtonRow" Background="Transparent" MinHeight="40">
                    <StackPanel x:Name="ButtonStack" Orientation="Horizontal" Spacing="2" Margin="4,4,0,4"
                                HorizontalAlignment="Left">
                        <Button x:Name="PaneToggleButton"
                                x:Uid="BrowserPaneToggleButton"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="40" Height="32" Padding="0"
                                Click="OnPaneToggleClick">
                            <FontIcon Glyph="{StaticResource Icon.Browser.Pane}" FontSize="16" />
                        </Button>
                        <Button x:Name="BackButton"
                                x:Uid="BrowserBackButton"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="40" Height="32" Padding="0"
                                IsEnabled="False"
                                Click="OnBackClick">
                            <FontIcon Glyph="{StaticResource Icon.Browser.Back}" FontSize="16" />
                        </Button>
                        <Button x:Name="ForwardButton"
                                x:Uid="BrowserForwardButton"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="40" Height="32" Padding="0"
                                IsEnabled="False"
                                Click="OnForwardClick">
                            <FontIcon Glyph="{StaticResource Icon.Browser.Forward}" FontSize="16" />
                        </Button>
                        <Button x:Name="ReloadButton"
                                x:Uid="BrowserReloadButton"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="40" Height="32" Padding="0"
                                Click="OnReloadClick">
                            <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            

            <!-- The address field: the site alone while a page shows, the
                 whole address once it has the focus. Collapsed in the rail. -->
            <TextBox x:Name="AddressBox"
                         x:Uid="BrowserAddressBox"
                         Margin="8,4,8,8"
                         GotFocus="OnAddressGotFocus"
                         LostFocus="OnAddressLostFocus"
                         KeyDown="OnAddressKeyDown" />
</StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.PaneFooter>
                <StackPanel Margin="4,4,4,8">
                    <Button x:Name="SettingsButton"
                            x:Uid="BrowserSettingsButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="40" Height="32" Padding="0"
                            HorizontalAlignment="Left"
                            IsEnabled="False">
                        <FontIcon Glyph="{StaticResource Icon.Settings}" FontSize="16" />
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- The page: a card on the Mica, below the caption buttons. -->
            <Grid x:Name="PageArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- A narrow window hides the panel: this button, drawn where
                     the panel's would be, opens it over the page. -->
                <Button x:Name="NarrowToggleButton"
                        x:Uid="BrowserPaneToggleButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="40" Height="32" Padding="0"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Click="OnPaneToggleClick">
                    <FontIcon Glyph="{StaticResource Icon.Browser.Pane}" FontSize="16" />
                </Button>
                <Border x:Name="PageCard"
                        Grid.Row="1"
                        Margin="0,0,8,8"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <WebView2 x:Name="Web" />
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
