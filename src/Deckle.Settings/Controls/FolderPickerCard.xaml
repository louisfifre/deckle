<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Deckle.Settings.FolderPickerCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The actions of a folder card, at the card's trailing edge: the picker
         behind an icon (its words live in the tooltip and the narrator name,
         the PowerToys form) and Open in a word. The path itself reads under
         the card's description, drawn by the composer (FolderCardDescription). -->
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
        <Button x:Name="PickButton"
                x:Uid="FolderPickerCard_PickButton"
                Click="PickButton_Click">
            <FontIcon Glyph="{StaticResource Icon.FolderBrowse}" FontSize="16" />
        </Button>
        <Button x:Uid="FolderPickerCard_OpenButton"
                Click="OpenButton_Click" />
    </StackPanel>
</UserControl>
