<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Deckle.Settings.FolderPickerEditableCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The typeable folder card's row, at the card's trailing edge: the path
         in a field (the Windows Terminal form, Starting directory), the picker
         behind the same icon as the read-only card, then Open. The field is
         wider than the composer's text field (200): a path is long. -->
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
        <TextBox x:Name="PathBox"
                 MinWidth="240"
                 PlaceholderText="{x:Bind DefaultPath, Mode=OneWay}"
                 Text="{x:Bind Path, Mode=TwoWay}" />
        <Button x:Uid="FolderPickerCard_PickButton"
                Click="PickButton_Click">
            <FontIcon Glyph="{StaticResource Icon.FolderBrowse}" FontSize="16" />
        </Button>
        <Button x:Uid="FolderPickerCard_OpenButton"
                Click="OpenButton_Click" />
    </StackPanel>
</UserControl>
