<Page
    x:Class="Deckle.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Settings">

    <!-- Card spacing, header margin and the 1000 max width follow the Microsoft
         Learn SettingsExpander sample "Settings page example". -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The H1 lives in the Page, not the window chrome (Windows 11
                     Settings), with the page-level reset on its trailing edge. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageTitleLabel"
                               Grid.Column="0"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetAllButton"
                            x:Uid="GeneralPage_ResetAll"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="ResetAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock x:Uid="GeneralPageResetAllLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Uid="GeneralPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Hotkeys ─────────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageShortcutsHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="HotkeysResetLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetHotkeys_Click" />
                </Grid>

                <StackPanel x:Name="HotkeysHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Appearance ──────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageAppearanceHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="AppearanceResetLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetAppearance_Click" />
                </Grid>

                <StackPanel x:Name="AppearanceHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Startup ─────────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageStartupHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="StartupResetLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetStartup_Click" />
                </Grid>

                <StackPanel x:Name="StartupHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Updates ─────────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageUpdatesHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Name="UpdatesResetLink"
                                     x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetUpdates_Click" />
                </Grid>

                <StackPanel x:Name="UpdatesHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- Bespoke: the version readout is a live status projection,
                     and "Install now" is an action — neither composes. -->
                <controls:SettingsCard x:Name="VersionCard"
                                       x:Uid="GeneralVersionCard"
                                       Tag="GeneralVersionCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Download}}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateAvailableText"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <Button x:Name="InstallUpdateButton"
                                x:Uid="GeneralInstallUpdateButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed"
                                Click="InstallUpdateButton_Click" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- ── Application data ────────────────────────────────────── -->
                <TextBlock x:Uid="GeneralPageApplicationDataHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="GeneralRerunSetupCard"
                                       Tag="GeneralRerunSetupCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Setup}}">
                    <Button x:Name="ReRunSetupButton"
                            x:Uid="GeneralRerunSetupButton"
                            Click="ReRunSetupButton_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="GeneralDataFolderCard"
                                       Tag="GeneralDataFolderCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Folder}}"
                                       ContentAlignment="Vertical">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DataFolderPathText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Button Grid.Column="1"
                                x:Name="MoveDataFolderButton"
                                x:Uid="GeneralDataFolderMoveButton"
                                Visibility="Collapsed"
                                Click="MoveDataFolderButton_Click" />
                        <Button Grid.Column="2"
                                x:Name="OpenDataFolderButton"
                                x:Uid="GeneralDataFolderOpenButton"
                                Click="OpenDataFolderButton_Click" />
                    </Grid>
                </controls:SettingsCard>

                <InfoBar x:Name="DataMoveInfoBar"
                         IsOpen="False"
                         IsClosable="True" />

                <controls:SettingsExpander x:Uid="GeneralBackupExpander"
                                           Tag="GeneralBackupExpander"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Reset}}">
                    <!-- Bespoke: Create/Restore are ACTIONS, not settings — the
                         composer drives values, not command buttons. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CreateBackupButton"
                                x:Uid="GeneralBackupCreateButton"
                                Click="CreateBackupButton_Click" />
                        <Button x:Name="RestoreBackupButton"
                                x:Uid="GeneralBackupRestoreButton"
                                Click="RestoreBackupButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasBackup, Mode=OneWay}" />
                    </StackPanel>
                    <controls:SettingsExpander.Items>
                        <!-- A StackPanel host, not a bare SettingsCard, because the
                             composer needs a Panel. -->
                        <StackPanel x:Name="BackupLocationHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />

                        <!-- Bespoke: a live status readout, not a settable value. -->
                        <controls:SettingsCard x:Uid="GeneralBackupInfoCard"
                                               Tag="GeneralBackupInfoCard"
                                               ContentAlignment="Vertical">
                            <Grid ColumnSpacing="16" RowSpacing="4" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="GeneralBackupFileNameLabel"
                                           Grid.Row="0" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupFileName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Uid="GeneralBackupCreatedAtLabel"
                                           Grid.Row="1" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupCreatedAt, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
