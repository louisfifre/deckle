<Page
    x:Class="Deckle.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Deckle.Settings"
    xmlns:catalog="using:Deckle.Catalog">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="GeneralPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The theme and the start-with-Windows switch stand first,
                     grouped under no title: a section of one card earns no
                     heading, the cards simply open the page (Louis,
                     2026-10-14). Composed: GeneralViewModel.AppearanceSettings
                     then StartupSettings, into the same host. Each card keeps
                     its own reset; there is no section to reset. -->
                <StackPanel x:Name="TopHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Updates ─────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="UpdatesSection"
                                         x:Uid="GeneralPageUpdatesSection"
                                         HasReset="True"
                                         ResetRequested="ResetUpdates_Click">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <StackPanel x:Name="UpdatesHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />

                        <!-- Bespoke: the version readout is a live status projection,
                             and "Install now" is an action; neither composes. -->
                        <controls:SettingsCard x:Name="VersionCard"
                                               x:Uid="GeneralVersionCard"
                                               Tag="GeneralVersionCard">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateAvailableText"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                                <Button x:Name="InstallUpdateButton"
                                        x:Uid="GeneralInstallUpdateButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="InstallUpdateButton_Click" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </StackPanel>
                </catalog:SettingsSection>

                <!-- ── Application data ────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="GeneralPageApplicationDataSection">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                <controls:SettingsExpander x:Name="BackupExpander"
                                           x:Uid="GeneralBackupExpander"
                                           Tag="GeneralBackupExpander">
                    <!-- Bespoke: Create/Restore are ACTIONS, not settings — the
                         composer drives values, not command buttons. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CreateBackupButton"
                                x:Uid="GeneralBackupCreateButton"
                                Click="CreateBackupButton_Click" />
                        <Button x:Name="RestoreBackupButton"
                                x:Uid="GeneralBackupRestoreButton"
                                Click="RestoreBackupButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasBackup, Mode=OneWay}" />
                    </StackPanel>
                    <!-- Items holds SettingsCards only: the expander styles every
                         item with its SettingsCard item style, so any other
                         element here throws when the fold opens (the crash of
                         2026-10-14 19:09, a StackPanel host in this slot). The
                         composed location card is moved in from code, first
                         (ComposeApplicationDataSection). -->
                    <controls:SettingsExpander.Items>
                        <!-- Bespoke: a live status projection, not a settable
                             value. -->
                        <controls:SettingsCard x:Uid="GeneralBackupInfoCard"
                                               Tag="GeneralBackupInfoCard"
                                               ContentAlignment="Vertical">
                            <Grid ColumnSpacing="16" RowSpacing="4" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="GeneralBackupFileNameLabel"
                                           Grid.Row="0" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupFileName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Uid="GeneralBackupCreatedAtLabel"
                                           Grid.Row="1" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupCreatedAt, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard x:Uid="GeneralRerunSetupCard"
                                       Tag="GeneralRerunSetupCard">
                    <Button x:Name="ReRunSetupButton"
                            x:Uid="GeneralRerunSetupButton"
                            Click="ReRunSetupButton_Click" />
                </controls:SettingsCard>

                <!-- The data folder, in the composed folder cards' form: the
                     path on a line under the description (FolderCardDescription,
                     attached in code-behind) and the actions at the trailing
                     edge. Move keeps its word where the composed cards' Change
                     is an icon: it copies the data and restarts the app, an
                     act the button has to name. -->
                <controls:SettingsCard x:Name="DataFolderCard"
                                       x:Uid="GeneralDataFolderCard"
                                       Tag="GeneralDataFolderCard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MoveDataFolderButton"
                                x:Uid="GeneralDataFolderMoveButton"
                                Visibility="Collapsed"
                                Click="MoveDataFolderButton_Click" />
                        <Button x:Name="OpenDataFolderButton"
                                x:Uid="GeneralDataFolderOpenButton"
                                Click="OpenDataFolderButton_Click" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Pre-flight outcomes of a data move that never left this
                     page; the move itself runs in the dedicated relocate
                     process. -->
                <InfoBar x:Name="DataMoveInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         catalog:InfoBarLayout.CollapseWhenClosed="True" />

                </StackPanel>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
