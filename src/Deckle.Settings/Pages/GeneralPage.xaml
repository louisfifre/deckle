<Page
    x:Class="Deckle.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:settings="using:Deckle.Settings"
    xmlns:vm="using:Deckle.Settings">

    <!-- Canonical Microsoft Learn pattern (SettingsExpander sample "Settings page
         example"): StackPanel max 1000 in a Grid, Spacing=4 between cards,
         Margin="1,30,0,6" on section headers. -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Page title: Win11 Settings pattern where the H1 lives in
                     the Page, not in the window chrome. -->
                <TextBlock x:Uid="GeneralPageTitleLabel"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,8" />

                <TextBlock x:Uid="GeneralPageSubtitleLabel"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- ── Shortcuts ───────────────────────────────────────────── -->
                <TextBlock x:Uid="GeneralPageShortcutsHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="GeneralTranscribeCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Shortcut}}">
                    <TextBlock x:Uid="GeneralShortcutTranscribeKey"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="GeneralPrimaryRewriteCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Shortcut}}">
                    <TextBlock x:Uid="GeneralShortcutPrimaryRewriteKey"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="GeneralSecondaryRewriteCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Shortcut}}">
                    <TextBlock x:Uid="GeneralShortcutSecondaryRewriteKey"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard>

                <!-- ── Appearance ──────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageAppearanceHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetAppearance_Click" />
                </Grid>

                <!-- Composed: the theme picker — the Appearance section's lone
                     value-backed card. GeneralViewModel.AppearanceSettings declares
                     it as a Choice descriptor (3 options) and the composer builds the
                     ComboBox into this host, where the card stood. The section header
                     and Reset link above stay hand-authored. -->
                <StackPanel x:Name="AppearanceHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Behaviour ───────────────────────────────────────────── -->
                <!--
                    Auto-paste + overlay HUD : the app's user-facing behaviours
                    around transcription. Used to live on the Recording page in
                    slice S3 ; moved here in pass2 because they describe what
                    Deckle does for the user, not how the capture pipeline works.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageBehaviourHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetBehaviour_Click" />
                </Grid>

                <!-- Composed: the overlay group (a Group descriptor — master
                     toggle + fade/animations/position children) followed by the
                     flat auto-paste toggle, both built from
                     GeneralViewModel.BehaviourSettings into this host. The overlay
                     SettingsExpander that stood here is now produced by the
                     composer; the position ComboBox's value-matching replaces the
                     old Tag-based combo sync in the code-behind. -->
                <StackPanel x:Name="BehaviourHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Startup ─────────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GeneralPageStartupHeaderLabel"
                               Grid.Column="0"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <HyperlinkButton x:Uid="Settings_SectionResetLink"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"
                                     Click="ResetStartup_Click" />
                </Grid>

                <!-- Composed: the "start with Windows" toggle — the Startup
                     section's lone card. Its registry write and revert-on-refusal
                     live in the VM setter (OnAutostartEnabledChanged), so the
                     composer hosts it like any toggle: GeneralViewModel.StartupSettings
                     declares it and the composer builds the card into this host. -->
                <StackPanel x:Name="StartupHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Application data ────────────────────────────────────── -->
                <TextBlock x:Uid="GeneralPageApplicationDataHeaderLabel"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="GeneralRerunSetupCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Setup}}">
                    <Button x:Name="ReRunSetupButton"
                            x:Uid="GeneralRerunSetupButton"
                            Click="ReRunSetupButton_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="GeneralDataFolderCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Folder}}"
                                       ContentAlignment="Vertical">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DataFolderPathText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Button Grid.Column="1"
                                x:Name="OpenDataFolderButton"
                                x:Uid="GeneralDataFolderOpenButton"
                                Click="OpenDataFolderButton_Click" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsExpander x:Uid="GeneralBackupExpander"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Reset}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CreateBackupButton"
                                x:Uid="GeneralBackupCreateButton"
                                Click="CreateBackupButton_Click" />
                        <Button x:Name="RestoreBackupButton"
                                x:Uid="GeneralBackupRestoreButton"
                                Click="RestoreBackupButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasBackup, Mode=OneWay}" />
                    </StackPanel>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="GeneralBackupLocationCard"
                                               ContentAlignment="Vertical">
                            <settings:FolderPickerCard x:Name="BackupFolderPicker"
                                                       Path="{x:Bind ViewModel.BackupDirectory, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="GeneralBackupInfoCard"
                                               ContentAlignment="Vertical">
                            <Grid ColumnSpacing="16" RowSpacing="4" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="GeneralBackupFileNameLabel"
                                           Grid.Row="0" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupFileName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Uid="GeneralBackupCreatedAtLabel"
                                           Grid.Row="1" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupCreatedAt, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
