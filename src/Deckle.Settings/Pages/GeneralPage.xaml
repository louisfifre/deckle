<Page
    x:Class="Deckle.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Deckle.Settings"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Canonical Microsoft Learn pattern (SettingsExpander sample "Settings page
         example"): StackPanel max 1000 in a Grid, Spacing=4 between cards. The
         section form lives in the shared SettingsSection block; the card
         spacing resource comes from App.xaml. -->

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty, confirmed
                     by the block itself). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="GeneralPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- Each section is the shared block: title, optional caption, cards,
                     and the section-level reset revealed on hover, enabled while a
                     composed value differs from its default (the code-behind gates
                     IsResetEnabled off the section's composer). -->

                <!-- ── Hotkeys ─────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="HotkeysSection"
                                         x:Uid="GeneralPageHotkeysSection"
                                         HasReset="True"
                                         ResetRequested="ResetHotkeys_Click">
                    <!-- Composed: one hotkey card per action the App built
                         (GeneralViewModel.HotkeySettings); an absent module's card
                         is hidden. -->
                    <StackPanel x:Name="HotkeysHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Appearance ──────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="AppearanceSection"
                                         x:Uid="GeneralPageAppearanceSection"
                                         HasReset="True"
                                         ResetRequested="ResetAppearance_Click">
                    <!-- Composed: the theme picker — the Appearance section's lone
                         value-backed card. GeneralViewModel.AppearanceSettings declares
                         it as a Choice descriptor (3 options) and the composer builds the
                         ComboBox into this host, where the card stood. -->
                    <StackPanel x:Name="AppearanceHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Startup ─────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="StartupSection"
                                         x:Uid="GeneralPageStartupSection"
                                         HasReset="True"
                                         ResetRequested="ResetStartup_Click">
                    <!-- Composed: the "start with Windows" toggle — the Startup
                         section's lone card. Its registry write and revert-on-refusal
                         live in the VM setter (OnAutostartEnabledChanged), so the
                         composer hosts it like any toggle: GeneralViewModel.StartupSettings
                         declares it and the composer builds the card into this host. -->
                    <StackPanel x:Name="StartupHost"
                                Spacing="{StaticResource SettingsCardSpacing}" />
                </catalog:SettingsSection>

                <!-- ── Updates ─────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Name="UpdatesSection"
                                         x:Uid="GeneralPageUpdatesSection"
                                         HasReset="True"
                                         ResetRequested="ResetUpdates_Click">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <!-- Composed: the silent-check opt-out — the section's lone
                             settable value (GeneralViewModel.UpdatesSettings). -->
                        <StackPanel x:Name="UpdatesHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />

                        <!-- Bespoke: the version readout is a live status projection,
                             and "Install now" is an action — neither composes. The
                             description carries the running version (code-behind);
                             the content pair appears only while the silent check has
                             a newer release parked. -->
                        <controls:SettingsCard x:Name="VersionCard"
                                               x:Uid="GeneralVersionCard"
                                               Tag="GeneralVersionCard"
                                               HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Download}}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateAvailableText"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                                <Button x:Name="InstallUpdateButton"
                                        x:Uid="GeneralInstallUpdateButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="InstallUpdateButton_Click" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </StackPanel>
                </catalog:SettingsSection>

                <!-- ── Application data ────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="GeneralPageApplicationDataSection">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                <controls:SettingsCard x:Uid="GeneralRerunSetupCard"
                                       Tag="GeneralRerunSetupCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Setup}}">
                    <Button x:Name="ReRunSetupButton"
                            x:Uid="GeneralRerunSetupButton"
                            Click="ReRunSetupButton_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="GeneralDataFolderCard"
                                       Tag="GeneralDataFolderCard"
                                       HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Folder}}"
                                       ContentAlignment="Vertical">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DataFolderPathText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Button Grid.Column="1"
                                x:Name="MoveDataFolderButton"
                                x:Uid="GeneralDataFolderMoveButton"
                                Visibility="Collapsed"
                                Click="MoveDataFolderButton_Click" />
                        <Button Grid.Column="2"
                                x:Name="OpenDataFolderButton"
                                x:Uid="GeneralDataFolderOpenButton"
                                Click="OpenDataFolderButton_Click" />
                    </Grid>
                </controls:SettingsCard>

                <!-- Pre-flight outcomes of a data move that never left this
                     page: same target, invalid target, not enough space. The
                     move itself runs in the dedicated relocate process. -->
                <InfoBar x:Name="DataMoveInfoBar"
                         IsOpen="False"
                         IsClosable="True" />

                <controls:SettingsExpander x:Uid="GeneralBackupExpander"
                                           Tag="GeneralBackupExpander"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Reset}}">
                    <!-- Bespoke: Create/Restore are ACTIONS, not settings — the
                         composer drives values, not command buttons. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CreateBackupButton"
                                x:Uid="GeneralBackupCreateButton"
                                Click="CreateBackupButton_Click" />
                        <Button x:Name="RestoreBackupButton"
                                x:Uid="GeneralBackupRestoreButton"
                                Click="RestoreBackupButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasBackup, Mode=OneWay}" />
                    </StackPanel>
                    <controls:SettingsExpander.Items>
                        <!-- Composed: the backup-location folder picker — a Path
                             descriptor (GeneralViewModel.ApplicationDataSettings). The
                             composer builds the FolderPickerCard into this host, where
                             the hand-authored GeneralBackupLocationCard stood; its
                             DefaultPath and per-card reset now ride the descriptor's
                             PathArgs/Default instead of the code-behind. A StackPanel
                             host (not a bare SettingsCard) because the composer needs a
                             Panel; it holds the single composed card, rendering the same
                             row inside the expander's Items. -->
                        <StackPanel x:Name="BackupLocationHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />

                        <!-- Bespoke: the "latest backup" readout is a live status
                             projection (file name + created at), not a settable value. -->
                        <controls:SettingsCard x:Uid="GeneralBackupInfoCard"
                                               Tag="GeneralBackupInfoCard"
                                               ContentAlignment="Vertical">
                            <Grid ColumnSpacing="16" RowSpacing="4" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="GeneralBackupFileNameLabel"
                                           Grid.Row="0" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupFileName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Uid="GeneralBackupCreatedAtLabel"
                                           Grid.Row="1" Grid.Column="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind ViewModel.LatestBackupCreatedAt, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                </StackPanel>
                </catalog:SettingsSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
