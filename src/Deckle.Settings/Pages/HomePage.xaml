<Page
    x:Class="Deckle.Settings.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Home is the first node of the rail and, for now, only its header: the
         page earns content later (settings design system, decision 15). The
         frame is the one every page shares: a scroll area, a 1000-wide column,
         the header block first. -->
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="4">
                <catalog:SettingsPageHeader x:Uid="HomePageHeader" HasResetAll="False" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
