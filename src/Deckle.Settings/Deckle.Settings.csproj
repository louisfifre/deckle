<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Settings</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Neutral language for the lib's PRI. Without this, the lib's
         Strings/en-US/Resources.resw is found at runtime but no language is
         declared as fallback, which can leave x:Uid lookups empty when the
         system display language doesn't match en-US. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in this assembly's pages
         resolve against its Resources subtree, which the build merges into the
         main resource map. Each WinUI assembly with x:Uid needs its own resw
         (Microsoft Learn "Localize a class library"; WindowsAppSDK#3451 for
         EnableMsixTooling). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- Shell: StartupService + SettingsWindow's IconAssets + native methods. -->
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
    <!-- WindowChrome: shared TitleBar caption-inset correction. -->
    <ProjectReference Include="..\Deckle.Shell.WindowChrome\Deckle.Shell.WindowChrome.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output and must
         match the ETW manifest. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
