<Window
    x:Class="Deckle.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Deckle Settings">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native TitleBar: icon + title only. Navigation and content remain
             below the title bar. -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="SettingsTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- NavigationView. PaneDisplayMode=Auto (default) lets WinUI choose
             Left / LeftCompact / LeftMinimal. Tag = full Page type name,
             resolved through Type.GetType in the handler. -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged"
                        ItemInvoked="OnNavItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="SettingsNavGeneral"
                                    Tag="Deckle.Settings.GeneralPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Home}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavRecording"
                                    Tag="Deckle.Settings.RecordingPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Microphone}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavTranscription"
                                    Tag="Deckle.Transcription.WhisperPage, Deckle.Transcription">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Speech}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavRewriting"
                                    Tag="Deckle.Llm.Rewrite.LlmPage, Deckle.Llm.Rewrite">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Sparkle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavAmbient"
                                    Tag="Deckle.Lighting.Ambient.AmbientPage, Deckle.Lighting.Ambient">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Lightbulb}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavTrackpad"
                                    Tag="Deckle.Input.Trackpad.TrackpadPage, Deckle.Input.Trackpad">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Trackpad}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavDiagnostics"
                                    Tag="Deckle.Settings.DiagnosticsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Diagnostics}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- Logs: opens the shared LogWindow through the App callback.
                     SelectsOnInvoked=False → no persistent selection, no Frame
                     navigation; the click is recovered through ItemInvoked. -->
                <NavigationViewItem x:Uid="SettingsNavLogs"
                                    Tag="logs"
                                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Logs}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content area: NavigationView already places its Layer surface
                 with a rounded DWM top-left corner. No Border wrapper, no
                 custom CornerRadius, no sticky header/footer. Each Page
                 manages its own H1 title and ScrollViewer (Win11 Settings
                 pattern). Auto-save everywhere → no global Cancel/Save. -->
            <Frame x:Name="PageFrame" />
        </NavigationView>
    </Grid>
</Window>
