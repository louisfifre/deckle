<Window
    x:Class="Deckle.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Settings"
    Title="Deckle Settings">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <x:Double x:Key="SettingsSearchBoxMaxWidth">360</x:Double>

            <DataTemplate x:Key="SearchHitTemplate" x:DataType="local:SettingSuggestionHit">
                <Grid ColumnSpacing="12" Padding="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="{x:Bind Glyph}"
                              FontSize="16"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Inlines built in code (SuggestionText): the only way to
                             bold matched runs — TextHighlighters recolours, not weights. -->
                        <TextBlock local:SuggestionText.Segments="{x:Bind LabelSegments}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Secondary}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SearchNoticeTemplate" x:DataType="local:SettingSuggestionNotice">
                <!-- Inert: no glyph, disabled-tone text — reads as a hint, not a target. -->
                <TextBlock Text="{x:Bind Text}"
                           Padding="4,2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorDisabledBrush}" />
            </DataTemplate>
            <local:SettingSuggestionTemplateSelector x:Key="SearchSuggestionSelector"
                HitTemplate="{StaticResource SearchHitTemplate}"
                NoticeTemplate="{StaticResource SearchNoticeTemplate}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The NavigationView's own pane toggle is off; the TitleBar carries it
             and relays through PaneToggleRequested — the WinUI 3 Gallery pattern,
             pure code-behind, no automatic link between the two controls.
             No back button: every destination has a rail entry, even a child page
             registered under a ParentId. Frame.Navigate pushes the back stack on
             every nav change, siblings included, so a CanGoBack-bound button would
             offer to retrace ordinary page switches. Wire it once a destination
             exists that the rail does not list. -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="SettingsTitleBar"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.Resources>
                <!-- The Content slot centers at its DesiredSize by default; Stretch
                     hands it the zone's full width, and the box caps itself at its
                     MaxWidth — the WinUI 3 Gallery shipped pattern. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid x:Name="SearchZone"
                      VerticalAlignment="Center"
                      Margin="8,0"
                      SizeChanged="OnSearchZoneSizeChanged">
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="SettingsSearchBox"
                                    QueryIcon="Find"
                                    MaxWidth="{StaticResource SettingsSearchBoxMaxWidth}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    ItemTemplateSelector="{StaticResource SearchSuggestionSelector}"
                                    TextChanged="OnSearchTextChanged"
                                    SuggestionChosen="OnSearchSuggestionChosen"
                                    QuerySubmitted="OnSearchQuerySubmitted"
                                    LostFocus="OnSearchBoxLostFocus"
                                    KeyDown="OnSearchBoxKeyDown" />
                    <!-- Left-packed, not centered: grouped against the title, the
                         narrow bar's idle space consolidates into one drag area
                         instead of scattering around a floating icon. -->
                    <Button x:Name="SearchIconButton"
                            x:Uid="SettingsSearchIconButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSearchIconClick">
                        <FontIcon Glyph="{StaticResource Icon.Search}" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- A lateral command, so RightHeader; the central Content slot
                     holds the search. -->
                <Button x:Name="LogsButton"
                        x:Uid="SettingsLogsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center"
                        MinWidth="36"
                        Padding="8,4"
                        Click="OnLogsButtonClick">
                    <FontIcon Glyph="{StaticResource Icon.Logs}" FontSize="16" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged"
                        Collapsed="OnNavCollapsed"
                        Expanding="OnNavExpanding">

            <!-- Home, General and Shortcuts are the shell's static anchors; every
                 module page is materialised from SettingsModuleRegistry in the
                 code-behind, so a module can appear or disappear without editing
                 this file. Shortcuts is a shell page because a key combination is
                 global: it spans every module and belongs to none. -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="SettingsNavHome"
                                    Tag="Deckle.Settings.HomePage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Home}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavGeneral"
                                    Tag="Deckle.Settings.GeneralPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Settings}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SettingsNavHotkeys"
                                    Tag="Deckle.Settings.HotkeysPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Shortcut}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
            </NavigationView.MenuItems>

            <!-- NavigationView already draws its content surface with the rounded
                 top-left corner: no Border wrapper, no custom CornerRadius. Each
                 Page owns its H1 title and ScrollViewer (Windows 11 Settings). -->
            <Frame x:Name="PageFrame" />
        </NavigationView>

        <!-- Narrow-window search overlay: the code-behind reparents the same
             AutoSuggestBox in here. Transient surface, so flyout acrylic and
             flyout stroke; declared after the NavigationView to render above the
             page. -->
        <Border x:Name="SearchOverlay"
                Grid.Row="1"
                MaxWidth="376"
                Margin="12,4"
                Padding="8,6"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="Collapsed" />
    </Grid>
</Window>
