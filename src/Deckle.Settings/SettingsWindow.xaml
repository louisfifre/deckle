<Window
    x:Class="Deckle.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Settings"
    Title="Deckle Settings">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Search box width. A fixed inline width would be a magic number; a
                 named resource keeps it self-documenting and single-sourced. -->
            <x:Double x:Key="SettingsSearchBoxWidth">360</x:Double>

            <!-- Suggestion rows: a rich hit (page glyph + card label with matched
                 terms bold + breadcrumb line) and a terminal notice ("+N more",
                 "No results"). Two templates, chosen by row type — same shape as
                 LogWindow's LogEntryTemplateSelector. -->
            <DataTemplate x:Key="SearchHitTemplate" x:DataType="local:SettingSuggestionHit">
                <Grid ColumnSpacing="12" Padding="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="{x:Bind Glyph}"
                              FontSize="16"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Inlines built in code (SuggestionText): the only way to
                             bold matched runs — TextHighlighters recolours, not weights. -->
                        <TextBlock local:SuggestionText.Segments="{x:Bind LabelSegments}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Secondary}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SearchNoticeTemplate" x:DataType="local:SettingSuggestionNotice">
                <!-- Inert: no glyph, disabled-tone text — reads as a hint, not a target. -->
                <TextBlock Text="{x:Bind Text}"
                           Padding="4,2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorDisabledBrush}" />
            </DataTemplate>
            <local:SettingSuggestionTemplateSelector x:Key="SearchSuggestionSelector"
                HitTemplate="{StaticResource SearchHitTemplate}"
                NoticeTemplate="{StaticResource SearchNoticeTemplate}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native TitleBar: icon + title, plus the pane-toggle (hamburger) and
             the Logs command. The NavigationView's own pane toggle is turned off
             (IsPaneToggleButtonVisible=False below); the TitleBar carries it and
             relays through PaneToggleRequested — the WinUI 3 Gallery pattern, pure
             code-behind, no automatic link between the two controls.
             No back button: IsBackButtonVisible stays at its default (false).
             Frame.Navigate pushes the back stack on every nav change, so binding
             the button to CanGoBack would surface it for first-level navigation,
             against the flat-nav intent. Wire it once a genuine navigated
             sub-page (returnable from the title bar) exists. -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="SettingsTitleBar"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- Cross-page search, central slot. Below the collapse threshold
                     (code-behind) the box folds into a search icon that reveals it
                     on click, and focus leaving an empty box restores the icon —
                     the LogWindow / Task Manager pattern. Fixed width, centered:
                     stretching to fill needs a TitleBar content-alignment theme
                     override that could not be verified to compile, so the proven
                     fixed-width box is used, matching LogWindow. -->
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="8,0">
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="SettingsSearchBox"
                                    QueryIcon="Find"
                                    Width="{StaticResource SettingsSearchBoxWidth}"
                                    VerticalAlignment="Center"
                                    ItemTemplateSelector="{StaticResource SearchSuggestionSelector}"
                                    TextChanged="OnSearchTextChanged"
                                    SuggestionChosen="OnSearchSuggestionChosen"
                                    QuerySubmitted="OnSearchQuerySubmitted"
                                    LostFocus="OnSearchBoxLostFocus" />
                    <Button x:Name="SearchIconButton"
                            x:Uid="SettingsSearchIconButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSearchIconClick">
                        <FontIcon Glyph="{StaticResource Icon.Search}" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- Logs: opens the shared LogWindow through the App callback. A
                     lateral command, so RightHeader — the central Content slot is
                     reserved for the interactive search added later. -->
                <Button x:Name="LogsButton"
                        x:Uid="SettingsLogsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center"
                        MinWidth="36"
                        Padding="8,4"
                        Click="OnLogsButtonClick">
                    <FontIcon Glyph="{StaticResource Icon.Logs}" FontSize="16" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- NavigationView. PaneDisplayMode=Auto (default) lets WinUI choose
             Left / LeftCompact / LeftMinimal. Its own pane toggle is off — the
             TitleBar carries it. Tag = full Page type name, resolved through
             Type.GetType in the handler. -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged">

            <!-- General is the shell's one static anchor; every module page (from
                 Recording through Diagnostics) lives in its own assembly and is
                 materialised from SettingsModuleRegistry in the code-behind, appended
                 after General in (tier, order) order — so a module can appear /
                 disappear without editing this file (the seam the module installer
                 needs). -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="SettingsNavGeneral"
                                    Tag="Deckle.Settings.GeneralPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Home}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Module pages inserted here from SettingsModuleRegistry, in
                     (tier, order) order — Recording first through Diagnostics last. -->
            </NavigationView.MenuItems>

            <!-- Footer menu holds only Footer-tier module items, inserted from
                 SettingsModuleRegistry in the code-behind. Logs moved to the
                 TitleBar. -->

            <!-- Content area: NavigationView already places its Layer surface
                 with a rounded DWM top-left corner. No Border wrapper, no
                 custom CornerRadius, no sticky header/footer. Each Page
                 manages its own H1 title and ScrollViewer (Win11 Settings
                 pattern). Auto-save everywhere → no global Cancel/Save. -->
            <Frame x:Name="PageFrame" />
        </NavigationView>
    </Grid>
</Window>
