<Window
    x:Class="Deckle.Paste.Views.PasteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Paste.Views">

    <!-- Two parts and no header: the inset, which receives the paste and
         lists what was pasted since the window opened, and the folder line.
         The whole surface moves the window (PasteWindow.Drag.cs); the strings
         are set in code (PasteText). -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
          Padding="12"
          RowSpacing="8"
          PreviewKeyDown="OnRootPreviewKeyDown"
          KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The inset. A text field that receives a paste and is never
             edited: the TextBox gives the field's own border, fill, corner
             radius, placeholder and focus line in every theme, read-only
             keeps typing out. Ctrl+V reaches the window before it
             (OnRootPreviewKeyDown). -->
        <TextBox x:Name="PasteZone"
                 Grid.Row="0"
                 IsReadOnly="True"
                 IsSpellCheckEnabled="False"
                 TextWrapping="Wrap"
                 VerticalAlignment="Stretch" />

        <!-- Over the field, its whole size, transparent: the list, the
             saving sign and the close cross. It takes the pointer, so the
             field keeps its resting fill under the rows instead of flickering
             between hover and rest; a press still focuses the field
             (PasteWindow.Drag.cs), and the field's border and focus line show
             through. The cross has a column of its own so no row and no
             scrollbar ever runs under it. -->
        <Grid x:Name="InsetOverlay" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="PasteMenuItem" Click="OnPasteMenuClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE77F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <ScrollViewer x:Name="ListScroller"
                          Grid.Column="0"
                          Margin="1"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto">
                <!-- Left 10: the rows start where the placeholder does.
                     Right 12: room for the scrollbar when it widens. -->
                <StackPanel Padding="10,6,12,6" Spacing="6">
                    <Grid x:Name="SavingRow" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="SavingRing"
                                      Width="16" Height="16" MinWidth="16" MinHeight="16"
                                      IsActive="False"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="SavingText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ItemsControl x:Name="PasteList" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PasteRow">
                                <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- One 28 dip square per row, so the
                                         thumbnails and the icons stand on
                                         one column. -->
                                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                                        <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Visibility="{x:Bind ThumbnailVisibility}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind GlyphVisibility}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <FontIcon Glyph="&#xEB90;" FontSize="16"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind ProblemVisibility}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind DetailVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- The only chrome: a small subtle cross in the inset's corner,
                 4 dip from its top and right edges. -->
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Width="20"
                    Height="20"
                    MinWidth="20"
                    MinHeight="20"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnCloseClick">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
            </Button>
        </Grid>

        <!-- Where pastes go: the path trimmed, whole in its tooltip, and the
             picker's button, as on the settings' folder lines. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      Glyph="&#xE8B7;" FontSize="16"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="FolderPath"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="ChooseFolderButton"
                    Grid.Column="2"
                    Click="OnChooseFolderClick" />
        </Grid>
    </Grid>
</Window>
