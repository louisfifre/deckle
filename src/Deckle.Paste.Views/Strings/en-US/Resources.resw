<?xml version="1.0" encoding="utf-8"?>
<!-- The Paste to folder window's wording. Code reads these keys through
     PasteText (Loc.GetFrom), so they need no copy in Deckle.App. -->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- The window -->
  <data name="Paste_WindowTitle" xml:space="preserve"><value>Paste to folder</value></data>
  <data name="Paste_Close" xml:space="preserve"><value>Close (Esc)</value></data>

  <!-- The paste zone -->
  <data name="Paste_Zone_Placeholder" xml:space="preserve"><value>Paste here (Ctrl+V)</value></data>
  <data name="Paste_Zone_Name" xml:space="preserve"><value>Paste zone</value></data>
  <data name="Paste_Zone_HelpText" xml:space="preserve"><value>Press Ctrl+V to save the clipboard as a file in the chosen folder.</value></data>
  <data name="Paste_Zone_PasteItem" xml:space="preserve"><value>Paste</value></data>
  <data name="Paste_Zone_PasteShortcut" xml:space="preserve"><value>Ctrl+V</value></data>

  <!-- The status line -->
  <data name="Paste_Status_Saving" xml:space="preserve"><value>Saving…</value></data>
  <data name="Paste_Status_Done" xml:space="preserve"><value>Done</value></data>
  <data name="Paste_Status_Failed" xml:space="preserve"><value>Failed</value></data>
  <data name="Paste_Status_Announce_Format" xml:space="preserve"><value>{0}. {1}</value></data>
  <data name="Paste_Saved_Files_Format" xml:space="preserve"><value>{0} items saved</value></data>

  <!-- Why a paste failed -->
  <data name="Paste_Error_NoFolder" xml:space="preserve"><value>Choose a folder first.</value></data>
  <data name="Paste_Error_FolderMissing" xml:space="preserve"><value>The folder no longer exists. Choose another one.</value></data>
  <data name="Paste_Error_NothingToSave" xml:space="preserve"><value>The clipboard holds nothing to save.</value></data>
  <data name="Paste_Error_SourceMissing" xml:space="preserve"><value>A copied file no longer exists.</value></data>
  <data name="Paste_Error_WriteFailed" xml:space="preserve"><value>The file could not be written in the folder.</value></data>
  <data name="Paste_Error_ClipboardUnreadable" xml:space="preserve"><value>The clipboard could not be read. Try again.</value></data>
  <data name="Paste_Error_FolderNotSaved" xml:space="preserve"><value>The folder is used until Deckle quits, but could not be remembered.</value></data>

  <!-- The folder line -->
  <data name="Paste_Folder_None" xml:space="preserve"><value>No folder chosen</value></data>
  <data name="Paste_Folder_Choose" xml:space="preserve"><value>Choose folder</value></data>
  <data name="Paste_Folder_Name" xml:space="preserve"><value>Folder</value></data>
</root>
