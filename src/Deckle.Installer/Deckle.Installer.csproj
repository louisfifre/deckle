<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the stub is a transparent web-installer (VS Code / Discord
         pattern) with no console. It shows only a native progress window and, on
         failure, a message box; any Console.* call would be inert anyway with no
         console allocated. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Deckle.Installer</RootNamespace>
    <!-- The distributed file the end user double-clicks (and that the wizard copies
         into the install folder as the uninstaller). Dashed file name is fine for an
         exe; it never appears as a C# identifier. -->
    <AssemblyName>Deckle-Installer</AssemblyName>

    <!-- Declares PerMonitorV2 DPI awareness and the comctl32 v6 dependency the
         progress bar needs for its themed (non pre-XP) style. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- TargetFramework is inherited from Directory.Build.props
         (net10.0-windows10.0.26100.0). A bare net10.0-windows would default
         TargetPlatformVersion to 7.0 and clash with the repo's
         TargetPlatformMinVersion (NETSDK1135). The SDK-versioned TFM brings the
         WinRT projections we don't use, but the AOT linker trims unreferenced
         code, so the image stays lean without the deviation. We only consume
         Win32 + registry + COM (IShellLink), all available here. -->

    <!-- NativeAOT: a self-contained native exe, no .NET runtime to unpack, instant
         cold start. `dotnet build` stays IL-only (compile validation); the native
         link happens at `dotnet publish -r win-x64` — the maintainer's act. The AOT
         analyzers DO run on build, so non-AOT-safe code surfaces as warnings here. -->
    <PublishAot>true</PublishAot>

    <!-- Drops ICU from the AOT image: the installer has no culture-sensitive text. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- No third-party packages. Registry, COM source-generated interop
         (System.Runtime.InteropServices.Marshalling) and XML/HTTP all ship in the
         net10.0-windows framework — conforms to the zero-dependency doctrine. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows-integration primitives shared with the install-mode wizard
         (Deckle.Setup). AOT-safe by that module's own contract. -->
    <ProjectReference Include="..\Deckle.Install\Deckle.Install.csproj" />
  </ItemGroup>

</Project>
