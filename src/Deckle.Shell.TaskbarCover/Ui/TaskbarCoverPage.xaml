<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Shell.TaskbarCover.TaskbarCoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty, confirmed
                     by the block itself). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="TaskbarCoverPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <StackPanel x:Name="SettingsHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
