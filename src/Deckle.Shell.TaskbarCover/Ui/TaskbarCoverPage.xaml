<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Shell.TaskbarCover.TaskbarCoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog"
    xmlns:local="using:Deckle.Shell.TaskbarCover">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge (active-when-dirty, confirmed
                     by the block itself). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="TaskbarCoverPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The module switch, first and alone, in its own host so the
                     section below keeps its distance from it (the same shape as
                     Precision scroll). -->
                <StackPanel x:Name="SwitchHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── Reveal ────────────────────────────────────────────────── -->
                <!-- Hidden with its title while the cover is off (mask, never
                     grey); the code-behind follows ViewModel.Enabled. -->
                <catalog:SettingsSection x:Name="RevealSection"
                                         x:Uid="TaskbarCoverPageRevealSection">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <StackPanel x:Name="RevealHost"
                                    Spacing="{StaticResource SettingsCardSpacing}" />

                        <!-- The approach distance on the screen, right under its
                             card so the slider and the drawing it moves are in
                             one glance. In the flow rather than in the side pane
                             the Ambient page opens: that pane exists because the
                             Ambient tuning scrolls the preview out of view, and
                             this page is two cards long. A fixed height gives
                             the block's stage a room to fit the screen's ratio
                             in; the width follows the page. -->
                        <local:ApproachPreview x:Name="Preview"
                                               Height="300"
                                               Margin="0,8,0,0" />
                    </StackPanel>
                </catalog:SettingsSection>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
