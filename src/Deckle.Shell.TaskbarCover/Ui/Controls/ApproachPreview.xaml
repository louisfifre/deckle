<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Deckle.Shell.TaskbarCover.ApproachPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The approach distance drawn on the screen, in the shared preview block,
         the form of the Ambient live preview: a stage on its layer, readouts
         under it. No capture: the display's size and the taskbar's rect are
         enough to draw the scene to scale. Live while the primary taskbar is
         found; off, the block says so. -->
    <catalog:PreviewBlock x:Name="Block"
                          x:Uid="TaskbarCoverApproachPreviewBlock">

        <!-- The stage: the primary taskbar's display, the taskbar on it and
             the approach zone past it, all in that display's physical pixels
             scaled by one factor (Layout), so the frame keeps the screen's
             ratio and the zone keeps its true share of the screen. Drawn on a
             Canvas sized in code rather than in a Viewbox: a Viewbox scales
             the strokes with the scene, and a 3840 px screen drawn 360 px wide
             would thin a 1 px border to a tenth of a pixel. Every colour is a
             theme resource: the screen a solid base fill with a strong stroke,
             the taskbar the strong control fill, the zone the accent, light
             over the reach and solid on its outer limit, where the band is
             fully opaque again. -->
        <Grid x:Name="StageRoot"
              SizeChanged="StageRoot_SizeChanged">
            <Canvas x:Name="Stage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <Rectangle x:Name="ScreenShape"
                           Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                           Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                           StrokeThickness="1" />
                <Rectangle x:Name="ZoneShape"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                           Opacity="0.3" />
                <Rectangle x:Name="ZoneLimitShape"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <Rectangle x:Name="TaskbarShape"
                           Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Canvas>
        </Grid>

        <!-- Read from the display, never typed: its size and scale, and the
             distance in this display's own pixels, the figure the scale turns
             the setting's DIP into. Two star columns that share the width. -->
        <catalog:PreviewBlock.Readouts>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <catalog:Readout x:Name="DisplayReadout"
                                 x:Uid="TaskbarCoverApproachPreviewDisplayReadout"
                                 Grid.Column="0" />
                <catalog:Readout x:Name="ReachReadout"
                                 x:Uid="TaskbarCoverApproachPreviewReachReadout"
                                 Grid.Column="1" />
            </Grid>
        </catalog:PreviewBlock.Readouts>
    </catalog:PreviewBlock>
</UserControl>
