<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Deckle.Orchestration.OrchestrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Deckle.Orchestration"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The registry of apps and games. Canonical Settings layout (ScrollViewer
         Padding 32,24, StackPanel max 1000, Spacing 4, BodyStrong section
         headers). The list is bespoke, not composed: a live collection of
         expanders with add, change and remove gestures. -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <!-- The cards inside an entry's expander. They go through ItemsSource
             because the monitor cards come and go with the monitors; the
             expander takes static Items or an ItemsSource, not both. -->
        <local:EntryItemTemplateSelector x:Key="EntryItemTemplateSelector">
            <local:EntryItemTemplateSelector.KindTemplate>
                <DataTemplate x:DataType="local:EntryKindItem">
                    <controls:SettingsCard x:Uid="OrchestrationPage_KindCard">
                        <ComboBox MinWidth="120"
                                  SelectedIndex="{x:Bind Row.KindIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="OrchestrationPage_KindApp" />
                            <ComboBoxItem x:Uid="OrchestrationPage_KindGame" />
                        </ComboBox>
                    </controls:SettingsCard>
                </DataTemplate>
            </local:EntryItemTemplateSelector.KindTemplate>
            <local:EntryItemTemplateSelector.ExecutableTemplate>
                <DataTemplate x:DataType="local:EntryExecutableItem">
                    <controls:SettingsCard x:Uid="OrchestrationPage_ExecutableCard"
                                           Description="{x:Bind Row.ExecutablePath, Mode=OneWay}">
                        <Button x:Uid="OrchestrationPage_ChangeButton"
                                Click="OnChangeExecutableClick" />
                    </controls:SettingsCard>
                </DataTemplate>
            </local:EntryItemTemplateSelector.ExecutableTemplate>
            <!-- One per HDR-capable monitor: the monitor's name, and what to
                 do with its HDR while the app runs. -->
            <local:EntryItemTemplateSelector.MonitorHdrTemplate>
                <DataTemplate x:DataType="local:MonitorHdrRow">
                    <controls:SettingsCard x:Uid="OrchestrationPage_MonitorHdrCard"
                                           Header="{x:Bind FriendlyName}">
                        <ComboBox MinWidth="120"
                                  AutomationProperties.Name="{x:Bind FriendlyName}"
                                  SelectedIndex="{x:Bind RuleIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="OrchestrationPage_HdrLeave" />
                            <ComboBoxItem x:Uid="OrchestrationPage_HdrOn" />
                            <ComboBoxItem x:Uid="OrchestrationPage_HdrOff" />
                        </ComboBox>
                    </controls:SettingsCard>
                </DataTemplate>
            </local:EntryItemTemplateSelector.MonitorHdrTemplate>
        </local:EntryItemTemplateSelector>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block. No Reset all: the page is a registry
                     the user authors, with nothing to restore. -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="OrchestrationPageHeader"
                                            HasResetAll="False" />

                <!-- Tag is the search index's scroll-to handle for this bespoke
                     section; it matches the SettingSearchEntry's LabelKey. -->
                <StackPanel x:Name="AppsSection"
                            Tag="OrchestrationPage_Section_Apps"
                            Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock x:Uid="OrchestrationPage_Section_Apps"
                               Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <!-- Unelevated, and until a foreground service is plugged
                         in, a listed app is noticed only when the list changes,
                         not when it starts. Shown from code-behind while entries
                         exist and neither source runs; not closable, because it
                         describes a state, not an event. -->
                    <InfoBar x:Name="ElevationAdvisory"
                             x:Uid="OrchestrationPage_ElevationAdvisory"
                             Severity="Warning"
                             IsClosable="False"
                             IsOpen="False"
                             Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,0,8">
                        <Button x:Uid="OrchestrationPage_AddAppButton"
                                Click="OnAddAppClick" />
                        <Button x:Uid="OrchestrationPage_AddRunningButton"
                                Click="OnAddRunningClick" />
                        <!-- Disabled while the scan runs: the one transient
                             "busy" grey the settings doctrine allows. -->
                        <Button x:Name="ScanButton"
                                x:Uid="OrchestrationPage_ScanButton"
                                Click="OnScanClick" />
                    </StackPanel>

                    <!-- One inline channel for "already in your list"; closed on
                         the next successful gesture or navigation. -->
                    <InfoBar x:Name="DuplicateInfo"
                             x:Uid="OrchestrationPage_DuplicateInfo"
                             Severity="Informational"
                             IsOpen="False" />

                    <!-- The scan is silent; this line is its only outcome when
                         nothing was added. Hidden again when the next scan starts. -->
                    <TextBlock x:Name="NothingNew"
                               x:Uid="OrchestrationPage_NothingNew"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="Collapsed" />

                    <!-- Folders the scan walks besides Steam. "Add folder…" sits
                         on the header, as in Windows Settings' excluded-folders
                         list, so it is reachable without expanding. Tag is the
                         search index's scroll-to handle. -->
                    <controls:SettingsExpander x:Name="FoldersExpander"
                                               x:Uid="OrchestrationPage_FoldersExpander"
                                               Tag="OrchestrationPage_FoldersExpander"
                                               ItemsSource="{x:Bind ViewModel.ScanFolders}"
                                               Margin="0,0,0,8">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{StaticResource Icon.Folder}" />
                        </controls:SettingsExpander.HeaderIcon>

                        <Button x:Uid="OrchestrationPage_AddFolderButton"
                                Click="OnAddFolderClick" />

                        <controls:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="local:ScanFolderRow">
                                <controls:SettingsCard Header="{x:Bind Path}">
                                    <Button x:Uid="OrchestrationPage_RemoveFolderButton"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{x:Bind RemoveCommand}">
                                        <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                  FontSize="16" />
                                    </Button>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </controls:SettingsExpander.ItemTemplate>
                    </controls:SettingsExpander>

                    <!-- Trades places with the list from code-behind, off
                         Entries.CollectionChanged. -->
                    <TextBlock x:Name="EmptyState"
                               x:Uid="OrchestrationPage_Empty"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="EntriesList"
                                  ItemsSource="{x:Bind ViewModel.Entries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>
                                </StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AppEntryRow">
                                <controls:SettingsExpander Header="{x:Bind DisplayName}"
                                                           Description="{x:Bind Description, Mode=OneWay}"
                                                           ItemsSource="{x:Bind Items}"
                                                           ItemTemplate="{StaticResource EntryItemTemplateSelector}">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    </controls:SettingsExpander.HeaderIcon>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="{x:Bind DisplayName}" />
                                        <Button x:Uid="OrchestrationPage_RemoveButton"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{x:Bind RemoveCommand}">
                                            <FontIcon Glyph="{StaticResource Icon.Delete}"
                                                      FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
