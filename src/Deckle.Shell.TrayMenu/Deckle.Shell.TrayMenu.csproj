<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Shell.TrayMenu</RootNamespace>
    <!-- WinUI 3 XAML compilation in a class library: required so MenuFlyout
         theme resources resolve at runtime and the MainResourceMap merges
         this assembly's PRI into the host process map. Mirror of the flag
         set on Deckle.Hud.csproj and Deckle.App.csproj (cf. WindowsAppSDK#3451). -->
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Strict alignment with Deckle.App.csproj: one WinAppSDK runtime per
         process, synchronous bump obligatory across the whole solution. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
  </ItemGroup>
</Project>
