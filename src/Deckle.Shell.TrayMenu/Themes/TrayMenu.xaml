<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Single custom Style: ToggleSwitchMenuItemStyle, applied only to the Ambient
    Light item, which remains a native MenuFlyoutItem (not a ToggleMenuFlyoutItem;
    the latter would reserve a checkmark column in MenuFlyoutPresenter, shifting
    all other flyout items to the right).

    Retemplate justification: MenuFlyoutItem has no native slot to graft a widget
    to the right of the label. This is the only retemplated tray menu item; Logs,
    Settings, Playground, Restart, and Quit are pure native MenuFlyoutItems.

    The template sticks to the native DefaultMenuFlyoutItemStyle pattern
    (WindowsAppSDK generic.xaml): a single LayoutRoot Grid owns Padding,
    Background, BorderBrush, BorderThickness, Margin, and CornerRadius; no
    intermediate Border wrapper. VisualStates write directly to
    LayoutRoot.Background. This structure guarantees that the Ambient item
    DesiredSize is identical to a native MenuFlyoutItem, so the presenter
    allocates the same cell height for Ambient and the other items.

    Hand-drawn pill, not a native ToggleSwitch. ToggleSwitch is designed to live
    in a SettingsCard, in its own cell (32 DIP). Grafted into a MenuFlyoutItem,
    its internal template (3-row Grid, SwitchAreaGrid Margin=0,5, Rectangle
    OuterBorder anchored to the top of Row 1) cannot be vertically centered; the
    pill stays top-aligned regardless of wrapper attempts. We drop that and draw
    the pill ourselves: rounded Border (40×20 rail) + Ellipse (12×12 knob) driven
    by a ToggleStates VisualStateGroup. Bonus: no more fragile
    FindDescendantByName to resolve ToggleSwitch after the prime cycle; state is
    applied directly to the item through VisualStateManager.GoToState.

    All brushes come from Win11 ToggleSwitch ThemeResources
    (ToggleSwitchFillOn/Off, ToggleSwitchStrokeOn/Off, ToggleSwitchKnobFillOn/Off)
    to follow light/dark/contrast/accent automatically.
    -->

    <Style x:Key="ToggleSwitchMenuItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="Background" Value="{ThemeResource MenuFlyoutItemBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutItemBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource MenuFlyoutItemBorderThickness}"/>
        <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}"/>
        <Setter Property="Padding" Value="{ThemeResource MenuFlyoutItemThemePadding}"/>
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutItem">
                    <Grid x:Name="LayoutRoot"
                          Padding="{TemplateBinding Padding}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Margin="{ThemeResource MenuFlyoutItemMargin}"
                          CornerRadius="{TemplateBinding CornerRadius}">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}"/>
                                        <Setter Target="TextLabel.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}"/>
                                        <Setter Target="TextLabel.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundDisabled}"/>
                                        <Setter Target="TextLabel.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- WinUI 3 automatic density switch: NarrowPadding
                                 (compact, 32 DIP) applied as soon as a
                                 mouse/pen/keyboard pointer interacts with the
                                 menu; DefaultPadding (airy, 40 DIP) on touch
                                 invocation or initial state. Reproduces the
                                 native DefaultMenuFlyoutItemStyle
                                 PaddingSizeStates VisualStateGroup verbatim
                                 (WindowsAppSDK generic.xaml, line 24058
                                 v1.8.260224000). Without this group, the
                                 custom template stayed frozen on its initial
                                 Padding while neighboring native items
                                 switched, creating a visual imbalance between
                                 Ambient and the other items (40 vs 32 DIP).
                                 The framework drives this state automatically. -->
                            <VisualStateGroup x:Name="PaddingSizeStates">
                                <VisualState x:Name="DefaultPadding"/>
                                <VisualState x:Name="NarrowPadding">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Padding">
                                            <!-- ThemeResource (not StaticResource like native)
                                                 because this ResourceDictionary is merged into
                                                 App.xaml at runtime. StaticResource does not resolve
                                                 the Win11 theme resource at parse scope,
                                                 KeyFrame.Value stays null, and the Storyboard
                                                 applies no change. ThemeResource resolves at runtime
                                                 through all parent scopes and finds the WindowsAppSDK
                                                 Thickness value 11,4,11,7. -->
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuFlyoutItemThemePaddingNarrow}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- On/Off states driven from code through
                                 VisualStateManager.GoToState(item, "On"/"Off")
                                 in TrayContextMenuHost.Show() on every open.
                                 No transition (useTransitions=false) to stay
                                 consistent with AreOpenCloseAnimationsEnabled=false
                                 on the MenuFlyout. -->
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualState x:Name="Off">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchRail.Background" Value="{ThemeResource ToggleSwitchFillOff}"/>
                                        <Setter Target="SwitchRail.BorderBrush" Value="{ThemeResource ToggleSwitchStrokeOff}"/>
                                        <Setter Target="SwitchKnob.Fill" Value="{ThemeResource ToggleSwitchKnobFillOff}"/>
                                        <Setter Target="SwitchKnob.HorizontalAlignment" Value="Left"/>
                                        <Setter Target="SwitchKnob.Margin" Value="3,0,0,0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchRail.Background" Value="{ThemeResource ToggleSwitchFillOn}"/>
                                        <Setter Target="SwitchRail.BorderBrush" Value="{ThemeResource ToggleSwitchStrokeOn}"/>
                                        <Setter Target="SwitchKnob.Fill" Value="{ThemeResource ToggleSwitchKnobFillOn}"/>
                                        <Setter Target="SwitchKnob.HorizontalAlignment" Value="Right"/>
                                        <Setter Target="SwitchKnob.Margin" Value="0,0,3,0"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="TextLabel"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <!-- Custom pill sized to fit in the narrow cell
                             (32 DIP) without making it overflow. Narrow cell =
                             margin 4 + padding 4+7 + useful area 17 DIP.
                             Wrapper Height=16 <= 17 keeps the cell at 32 and
                             aligns Ambient with neighboring native items.
                             Dimensions reduced from native WinUI 3 ToggleSwitch
                             (40×20 / knob 12×12) for consistency with menu
                             narrow density; the pill remains recognizable as a
                             switch. Left margin 24 reproduces the native
                             MenuFlyoutItemChevronMargin minimum label-widget
                             spacing. VerticalAlignment=Center centers the pill
                             on the text baseline. -->
                        <Grid Grid.Column="1"
                              Margin="24,0,0,0"
                              Width="36"
                              Height="16"
                              VerticalAlignment="Center">
                            <Border x:Name="SwitchRail"
                                    CornerRadius="8"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="SwitchKnob"
                                     Width="10"
                                     Height="10"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
