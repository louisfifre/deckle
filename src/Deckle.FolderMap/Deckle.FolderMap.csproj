<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.FolderMap</RootNamespace>
    <!-- EventSource [Event] parameters use snake_case so the ETW payload
         keys land as-is in the JSONL output; IDE1006 would flag them. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <!-- The map of a folder: the inventory of what an agent reads in it (its
       context files, skills, scripts and MCP servers), the links between
       those items and the lists and graphs drawn from them. Support code with
       no XAML and no WindowsAppSDK, so Deckle Folders and Deckle Projects each
       reuse it and neither depends on the other. -->
  <ItemGroup>
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- FolderNameOrder: the one order of names. Core holds no XAML. -->
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.FolderMap.Tests" />
  </ItemGroup>
</Project>
