<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Hud</RootNamespace>
    <!-- WinUI 3 XAML compilation in a class library: required so the compiler
         generates HudChrono.g.cs / HudWindow.g.cs / etc.
         (InitializeComponent + x:Name fields) from the .xaml files. -->
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Ensures the lib .pri is generated. The host (Deckle.exe) loads the
         main .pri; the keys consumed here are standard Win11 ThemeResources,
         resolved against the MainResourceMap at runtime.
         Mirrors the flag set on Deckle.App.csproj (cf. WindowsAppSDK#3451). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions strictly aligned with Deckle.App.csproj: a single WinAppSDK
         runtime loaded per process. Synchronous bump required. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes internal types to the test project: ProximityRollupAggregator
         is internal sealed (strictly module-local concern) but unit-tested in
         isolation from Deckle.Hud.Tests. .NET 5+ pattern via MSBuild attribute,
         which generates an [InternalsVisibleTo] on the Roslyn side at build. -->
    <InternalsVisibleTo Include="Deckle.Hud.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Chrono\Deckle.Chrono.csproj" />
    <ProjectReference Include="..\Deckle.Composition\Deckle.Composition.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
  </ItemGroup>
</Project>
