<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Deckle.Hud</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <!-- WinUI 3 XAML compilation in a class library : nécessaire pour que
         le compilateur génère HudChrono.g.cs / HudWindow.g.cs / etc.
         (InitializeComponent + champs x:Name) à partir des .xaml. -->
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Assure la génération du .pri de la lib. Le host (Deckle.exe) charge
         le .pri principal ; les keys consommées ici sont des ThemeResource
         Win11 standard, résolues contre le MainResourceMap au runtime.
         Mirror du flag mis sur Deckle.App.csproj (cf. WindowsAppSDK#3451). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions strictement alignées sur Deckle.App.csproj : un seul
         runtime WinAppSDK chargé par process. Bump synchrone obligatoire. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose les types internal au projet de tests — ProximityRollupAggregator
         est internal sealed (concern strictement local au module) mais testé
         unit isolément depuis Deckle.Tests. Pattern .NET 5+ via attribut MSBuild,
         qui génère un [InternalsVisibleTo] côté Roslyn au build. -->
    <InternalsVisibleTo Include="Deckle.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Audio\Deckle.Audio.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Chrono\Deckle.Chrono.csproj" />
    <ProjectReference Include="..\Deckle.Composition\Deckle.Composition.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
  </ItemGroup>
</Project>
