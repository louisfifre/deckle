<UserControl
    x:Class="Deckle.Hud.HudChrono"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="ChronoRoot">
        <Grid.Resources>
            <!-- The user's EXACT Windows accent colour (raw SystemAccentColor),
                 not the contrast-adjusted AccentText*/AccentFill* tints — those
                 lighten the accent on a dark surface (gold reads as pale yellow),
                 which is not what the flash should look like. This brush keeps the
                 literal accent the user picked in Windows. -->
            <SolidColorBrush x:Key="ChronoAccentBrush" Color="{ThemeResource SystemAccentColor}" />

            <!-- Shared style for the 8 clock TextBlocks. Each character is its
                 own TextBlock because each digit cell carries its own
                 Composition reveal visual. Code-behind overrides Foreground
                 with the phase's rest tone. -->
            <Style x:Key="ChronoDigitStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/BitcountSingle.ttf#Bitcount Single" />
                <Setter Property="FontWeight" Value="ExtraLight" />
                <Setter Property="FontSize" Value="48" />
                <Setter Property="TextLineBounds" Value="Tight" />
                <!-- No-op on a single-glyph TextBlock: CharacterSpacing applies
                     between characters, and the tightening between digits
                     comes from the negative Margin below. -->
                <Setter Property="CharacterSpacing" Value="-600" />
                <!-- Negative horizontal Margin clips into the font's
                     side-bearings to close the optical gap between digits
                     without cropping the glyph body. -->
                <Setter Property="Margin" Value="-1,0,-1,0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </Grid.Resources>

        <!-- Opaque card fill only, no XAML stroke. The system frame stroke is
             drawn by DWM at the HWND level (DWMWA_BORDER_COLOR =
             DWMWA_COLOR_DEFAULT in HudWindow.xaml.cs) and is always on for
             every state; the Composition processing stroke composites on top
             of it. -->
        <Border x:Name="ChronoCard"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}" />

        <!-- Attach point for the Composition processing stroke. Covers the
             whole card so the visual's coordinate space matches
             ActualWidth/Height. -->
        <Border x:Name="ProcessingSurfaceHost"
                IsHitTestVisible="False" />

        <!-- Independent live silence gauge; never participates in hit testing. -->
        <Border x:Name="CountdownSurfaceHost" IsHitTestVisible="False" />

        <!-- Each digit Grid stacks a primary TextBlock and an accent twin with
             identical text; the flash swaps their Opacity instead of the
             Foreground brush. Dots never flash, so they carry no twin. -->
        <StackPanel x:Name="ClockText"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Grid x:Name="Min1Cell">
                <TextBlock x:Name="Min1"       Text="0" Style="{StaticResource ChronoDigitStyle}" />
                <TextBlock x:Name="Min1Accent" Text="0" Style="{StaticResource ChronoDigitStyle}"
                           Foreground="{StaticResource ChronoAccentBrush}" Opacity="0" />
            </Grid>
            <Grid x:Name="Min2Cell">
                <TextBlock x:Name="Min2"       Text="0" Style="{StaticResource ChronoDigitStyle}" />
                <TextBlock x:Name="Min2Accent" Text="0" Style="{StaticResource ChronoDigitStyle}"
                           Foreground="{StaticResource ChronoAccentBrush}" Opacity="0" />
            </Grid>
            <TextBlock x:Name="DotA" Text="." Style="{StaticResource ChronoDigitStyle}" />
            <Grid x:Name="Sec1Cell">
                <TextBlock x:Name="Sec1"       Text="0" Style="{StaticResource ChronoDigitStyle}" />
                <TextBlock x:Name="Sec1Accent" Text="0" Style="{StaticResource ChronoDigitStyle}"
                           Foreground="{StaticResource ChronoAccentBrush}" Opacity="0" />
            </Grid>
            <Grid x:Name="Sec2Cell">
                <TextBlock x:Name="Sec2"       Text="0" Style="{StaticResource ChronoDigitStyle}" />
                <TextBlock x:Name="Sec2Accent" Text="0" Style="{StaticResource ChronoDigitStyle}"
                           Foreground="{StaticResource ChronoAccentBrush}" Opacity="0" />
            </Grid>
            <TextBlock x:Name="DotB" Text="." Style="{StaticResource ChronoDigitStyle}" />
            <Grid x:Name="Cs1Cell">
                <TextBlock x:Name="Cs1"       Text="0" Style="{StaticResource ChronoDigitStyle}" />
                <TextBlock x:Name="Cs1Accent" Text="0" Style="{StaticResource ChronoDigitStyle}"
                           Foreground="{StaticResource ChronoAccentBrush}" Opacity="0" />
            </Grid>
            <Grid x:Name="Cs2Cell">
                <TextBlock x:Name="Cs2"       Text="0" Style="{StaticResource ChronoDigitStyle}" />
                <TextBlock x:Name="Cs2Accent" Text="0" Style="{StaticResource ChronoDigitStyle}"
                           Foreground="{StaticResource ChronoAccentBrush}" Opacity="0" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
