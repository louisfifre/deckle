<Window
    x:Class="Deckle.Hud.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deckle.Hud"
    xmlns:chrono="using:Deckle.Hud">
    <!-- The RootGrid paints the same card fill as each hosted control's
         Border, so nothing visible bleeds through between the card's XAML
         CornerRadius and the HWND rectangle. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        <chrono:HudChrono    x:Name="Chrono"  Visibility="Visible" />
        <controls:HudMessage x:Name="Message" Visibility="Collapsed" />
    </Grid>
</Window>
