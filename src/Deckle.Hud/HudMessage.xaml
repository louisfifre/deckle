<UserControl
    x:Class="Deckle.Hud.HudMessage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-tracking badge brushes. Declared here, not in App.xaml, because
         SystemFillColor* tokens only resolve through a {ThemeResource}
         binding: a flat Application.Current.Resources[key] lookup in code
         returns null for themed resources. Keyed by the names
         HudPalette.Entry.BrushKey returns. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="BadgeSuccessBrush"
                         Color="{ThemeResource SystemFillColorSuccess}" />
        <SolidColorBrush x:Key="BadgeCriticalBrush"
                         Color="{ThemeResource SystemFillColorCritical}" />
        <SolidColorBrush x:Key="BadgeWarningBrush"
                         Color="{ThemeResource SystemFillColorCaution}" />
        <SolidColorBrush x:Key="BadgeInfoBrush"
                         Color="{ThemeResource SystemFillColorAttention}" />
    </UserControl.Resources>

    <!-- No Composition stroke: the semantic hue lives only on the badge
         disc. -->
    <Grid x:Name="MessageRoot">
        <Border x:Name="MessageCard"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}" />

        <Grid Padding="16,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock x:Name="MessageTitle"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="MessageSubtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Badge disc. 17x17 (odd) + CornerRadius=9 ≥ half-side so the
                 Border clips to a full circle. An odd side gives the disc a
                 true center pixel at (8, 8), so the inner glyph rasterizes on
                 axis instead of subpixel-blurring. -->
            <Border x:Name="BadgeBackground"
                    Grid.Column="1"
                    Width="17" Height="17"
                    CornerRadius="9"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right">
                <!-- The explicit centring overrides the font's baseline-driven
                     default, which otherwise drifts a glyph like E946
                     downward off-center. -->
                <FontIcon x:Name="BadgeGlyph"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="11"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
