<Window
    x:Class="Deckle.Hud.TranscriptPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Live transcript panel: the dictated text as it arrives, beside the HUD.
         Reuses the HUD's visual grammar as is: the RootGrid and card Border
         painted with LayerFillColorDefaultBrush, OverlayCornerRadius, body text
         in TextFillColorPrimaryBrush, HudMessage's 16/12 padding, the 1-dip DWM
         frame stroke, no shadow. The HWND shell in the code-behind (DWM round
         corners, layered click-through no-activate ex-styles, WM_NCCALCSIZE
         subclass) is a deliberate copy of HudOverlayWindow's, pending a shared
         extraction once the three surfaces can be run side by side.

         The ScrollViewer is never scrolled by the user: the HWND is
         WS_EX_TRANSPARENT so no input reaches it, and IsHitTestVisible="False"
         says the same in XAML. The code-behind keeps the view at its end so
         the newest line sits at the bottom and older lines leave through the
         top. The bars are Hidden, not Disabled: Disabled would constrain the
         TextBlock to the viewport height and leave nothing to scroll. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}" />

        <Grid Padding="16,12,16,12">
            <ScrollViewer x:Name="TranscriptScroller"
                          IsHitTestVisible="False"
                          IsTabStop="False"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled">
                <TextBlock x:Name="TranscriptText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="False" />
            </ScrollViewer>

            <!-- "There is more above": one line tall (height set in code from
                 the measured line height), the card's own fill fading to
                 transparent over the oldest visible line. Shown only while
                 the text overflows the viewport. -->
            <Rectangle x:Name="MoreAboveHint"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{ThemeResource LayerFillColorDefault}" />
                        <GradientStop Offset="1" Color="{ThemeResource SubtleFillColorTransparent}" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
