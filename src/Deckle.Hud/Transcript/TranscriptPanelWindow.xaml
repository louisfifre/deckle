<Window
    x:Class="Deckle.Hud.TranscriptPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Live transcript panel: the dictated text as it arrives, beside the HUD.
         Reuses the HUD's visual grammar as is.

         The ScrollViewer is never scrolled by the user: the HWND is
         WS_EX_TRANSPARENT so no input reaches it, and IsHitTestVisible="False"
         says the same in XAML. The code-behind keeps the view at its end so
         the newest line sits at the bottom and older lines leave through the
         top. The bars are Hidden, not Disabled: Disabled would constrain the
         TextBlock to the viewport height and leave nothing to scroll. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        <!-- Start of the "more above" fade: the primary text colour with zero
             alpha, so the gradient only ramps alpha and never shifts hue
             mid-way. High Contrast keeps the text solid: no fade there. -->
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <Color x:Key="TranscriptFadeStartColor">#00000000</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <Color x:Key="TranscriptFadeStartColor">#00FFFFFF</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="TranscriptFadeStartColor" ResourceKey="SystemColorWindowTextColor" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}" />

        <Grid Padding="16,12,16,12">
            <ScrollViewer x:Name="TranscriptScroller"
                          IsHitTestVisible="False"
                          IsTabStop="False"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled">
                <!-- "There is more above": the oldest visible line fades out
                     through the text's own alpha, not under a veil painted in
                     the card's colour. The card is a translucent layer, so no
                     single colour matches what it renders in both themes; a
                     fade of the text itself reads the same on any background.
                     Absolute mapping, in TextBlock coordinates: the code moves
                     the ramp onto the first visible line (ScrollToEnd), and
                     past either end the brush pads with its end colours. -->
                <TextBlock x:Name="TranscriptText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="False">
                    <TextBlock.Foreground>
                        <LinearGradientBrush x:Name="MoreAboveFade"
                                             MappingMode="Absolute"
                                             StartPoint="0,-1"
                                             EndPoint="0,0">
                            <GradientStop Offset="0" Color="{ThemeResource TranscriptFadeStartColor}" />
                            <GradientStop Offset="1" Color="{ThemeResource TextFillColorPrimary}" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
