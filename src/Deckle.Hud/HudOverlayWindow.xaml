<Window
    x:Class="Deckle.Hud.HudOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deckle.Hud">
    <!-- Overlay card hosted by HudOverlayManager. Same technical shell as
         HudWindow (fixed 272x78, opaque card painted by LayerFillColorDefaultBrush,
         DWM round + default stroke in code-behind) and the same proximity fade,
         sourced from the shared CursorMovementSignal (Deckle.Shell). Differs
         only in being transient (2-8 s) with no Closing intercept. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        <controls:HudMessage x:Name="Message" />
    </Grid>
</Window>
