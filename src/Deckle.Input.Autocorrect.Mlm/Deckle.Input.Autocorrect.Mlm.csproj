  <PropertyGroup>
    <RootNamespace>Deckle.Input.Autocorrect.Mlm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The autocorrect engine: AccentVariant / ISentenceReranker the probe and
         the reranker build against. -->
