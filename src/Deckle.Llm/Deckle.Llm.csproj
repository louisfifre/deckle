<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Llm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- No WinUI / Settings dependencies — this module is the bare-bones
         Ollama HTTP wrapper (model administration + health-check). The
         rewrite-specific layer and its Settings UI live in
         Deckle.Llm.Rewrite, so another Ollama consumer can depend on this
         module without dragging the rewrite UI in. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output and must
         match the ETW manifest. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
