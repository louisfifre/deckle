<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Deckle.Llm</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- No WinUI / Settings dependencies — this module is the bare-bones
         Ollama HTTP wrapper (model administration + health-check). The
         rewrite-specific layer (LlmService, LlmSettings, prompt
         templates, ProfileViewModel, the LlmPage Settings UI) lives in
         Deckle.Llm.Rewrite. Future Ollama consumers (AskOllama, …)
         depend on this module without dragging the rewrite UI in. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Logging\Deckle.Logging.csproj" />
  </ItemGroup>
</Project>
