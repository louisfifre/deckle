<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Llm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- No WinUI / Settings dependencies — this module is the inference
         brain: the generation seam (IGenerationEngine), the engines behind it
         (Ollama raw, chat-completions, Claude), the provider list that names
         them, and the Ollama administration calls. The rewrite-specific layer
         lives in Deckle.Llm.Rewrite and its Settings UI in
         Deckle.Llm.Rewrite.Views, so another consumer
         can depend on this module without dragging the rewrite UI in. -->
    <!-- Official Anthropic C# SDK: the Claude engine's transport. -->
    <PackageReference Include="Anthropic" />
    <InternalsVisibleTo Include="Deckle.Llm.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- ISecretVault: a provider's API key is read from the vault per request. -->
    <ProjectReference Include="..\Deckle.Security\Deckle.Security.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output and must
         match the ETW manifest. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
