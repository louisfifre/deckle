<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Autocorrect.Onnx</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure scoring geometry is internal; tests reach it through this seam. -->
    <InternalsVisibleTo Include="Deckle.Autocorrect.Tests" />
    <!-- The isolated probe profiles the exact scorer without widening its public API. -->
    <InternalsVisibleTo Include="Deckle.Autocorrect.Probe" />
  </ItemGroup>

  <ItemGroup>
    <!-- The autocorrect sentence scorer contract and closed-candidate outcome. -->
    <ProjectReference Include="..\Deckle.Autocorrect\Deckle.Autocorrect.csproj" />
    <!-- ONNX Runtime GenAI (DirectML variant) — runs the forced-decoding sentence
         judge on the GPU, with the CPU EP as a selectable fallback. Version and the
         0.13-vs-0.14 rationale are pinned in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" />
  </ItemGroup>
</Project>
