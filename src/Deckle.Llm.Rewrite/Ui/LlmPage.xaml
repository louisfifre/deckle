<Page
    x:Class="Deckle.Llm.Rewrite.LlmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:llm="using:Deckle.Llm.Rewrite"
    xmlns:catalog="using:Deckle.Catalog">

    <Page.Resources>
        <llm:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Background="Transparent"
          Tapped="OnBackgroundTapped">
    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Background="Transparent">
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- The shared header block: breadcrumb, one line of description,
                     Reset all on the trailing edge. The page asks with its own
                     dialog (it says what the reset wipes), so the header's generic
                     confirmation is off (see the constructor). -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="LlmPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <InfoBar x:Name="OllamaStatusBar"
                         x:Uid="LlmPage_OllamaStatusBar"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False"
                         Margin="0,0,0,8" />

                <llm:LlmGeneralSection x:Name="GeneralSection" />

                <!-- Mask-not-grey: the three dependent sections collapse out of
                     layout when rewriting is off, driven by the General master
                     toggle. The Enabled toggle itself (in GeneralSection) stays
                     always visible. -->
                <llm:LlmActiveProfileSection x:Name="ActiveProfileSection"
                                            Visibility="{x:Bind GeneralSection.IsRewritingEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <llm:LlmProfilesSection x:Name="ProfilesSection"
                                        Visibility="{x:Bind GeneralSection.IsRewritingEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <llm:LlmModelsSection x:Name="ModelsSection"
                                      Visibility="{x:Bind GeneralSection.IsRewritingEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
