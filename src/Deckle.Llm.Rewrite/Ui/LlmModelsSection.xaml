<UserControl
    x:Class="Deckle.Llm.Rewrite.LlmModelsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Tag="LlmModelsSection"
                Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock x:Uid="LlmModelsHeader"
                   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

        <TextBlock x:Uid="LlmModelsBody"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="1,0,0,8" />

        <InfoBar x:Name="ErrorBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,0,0,4" />

        <!-- Dynamic model cards are inserted here by code-behind -->
        <StackPanel x:Name="ModelsContainer"
                    Spacing="{StaticResource SettingsCardSpacing}" />

        <Button x:Name="RefreshModelsButton"
                Click="RefreshModels_Click"
                HorizontalAlignment="Left"
                Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="14" />
                <TextBlock x:Uid="LlmRefreshLabel" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
