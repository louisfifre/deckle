<UserControl
    x:Class="Deckle.Llm.Rewrite.LlmModelsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- Tag is the search index's scroll-to handle (LabelKey "LlmModelsSection"). -->
    <catalog:SettingsSection x:Uid="LlmModelsBlock"
                             Tag="LlmModelsSection">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,0,0,4"
                     catalog:InfoBarLayout.CollapseWhenClosed="True" />

            <!-- Dynamic model cards are inserted here by code-behind -->
            <StackPanel x:Name="ModelsContainer"
                        Spacing="{StaticResource SettingsCardSpacing}" />

            <Button x:Name="RefreshModelsButton"
                    Click="RefreshModels_Click"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="14" />
                    <TextBlock x:Uid="LlmRefreshLabel" />
                </StackPanel>
            </Button>
        </StackPanel>
    </catalog:SettingsSection>
</UserControl>
