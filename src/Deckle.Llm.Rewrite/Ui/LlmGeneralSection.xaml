<UserControl
    x:Class="Deckle.Llm.Rewrite.LlmGeneralSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="LlmGeneralHeader"
                       Grid.Column="0"
                       Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <HyperlinkButton x:Uid="Settings_SectionResetLink"
                             Grid.Column="1"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,2"
                             Click="ResetSection_Click" />
        </Grid>

        <!-- Composed region — the "Enable rewriting" master toggle and the
             "Ollama endpoint" URL, declared in LlmGeneralViewModel.Settings.cs
             and built into this host by ComposeSettings(). The endpoint carries
             VisibleWhen(() => Enabled), so it collapses with the rest of the page
             when rewriting is off (mask-not-grey). Each card carries its own
             inline reset off the POCO default. -->
        <StackPanel x:Name="ComposedHost"
                    Spacing="{StaticResource SettingsCardSpacing}" />
    </StackPanel>
</UserControl>
