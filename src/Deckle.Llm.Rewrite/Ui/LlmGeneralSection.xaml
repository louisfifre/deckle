<UserControl
    x:Class="Deckle.Llm.Rewrite.LlmGeneralSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The module switch, first on the page and alone, outside any section.
         It stays visible when rewriting is off. The providers' addresses live
         in the Providers section, so nothing else composes here. -->
    <StackPanel x:Name="MasterHost"
                Spacing="{StaticResource SettingsCardSpacing}" />
</UserControl>
