<UserControl
    x:Class="Deckle.Llm.Rewrite.LlmGeneralSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <!-- The module switch, first on the page and alone, outside any section.
             It stays visible when rewriting is off. -->
        <StackPanel x:Name="MasterHost"
                    Spacing="{StaticResource SettingsCardSpacing}" />

        <!-- Collapsed from code-behind while rewriting is off (mask-not-grey), so
             its title does not stand over an empty body. Its reset covers the
             endpoint only. -->
        <catalog:SettingsSection x:Name="GeneralBlock"
                                 x:Uid="LlmGeneralBlock"
                                 HasReset="True"
                                 ResetRequested="ResetSection_Click">
            <StackPanel x:Name="ComposedHost"
                        Spacing="{StaticResource SettingsCardSpacing}" />
        </catalog:SettingsSection>
    </StackPanel>
</UserControl>
