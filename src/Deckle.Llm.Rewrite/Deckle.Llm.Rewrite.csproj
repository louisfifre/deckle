<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Llm.Rewrite</RootNamespace>
  </PropertyGroup>

  <!-- The rewrite logic: the LLM settings and their file, the rewrite service
       and its deadline, the dictation batching, the diff gate and the
       paragraph offer coordinator. No XAML, no UseWinUI and no project that
       holds XAML, so the projects that rewrite through it (Transcription)
       never run the XAML compiler on its account, and every rule here is
       tested without a window. Deckle.Llm.Rewrite.Views presents it: the
       Rewriting settings page and the paragraph offer window. -->
  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <ProjectReference Include="..\Deckle.Llm\Deckle.Llm.csproj" />
    <!-- Loc: RewriteService's timeout notice, read from the Views assembly's
         PRI subtree (see RewriteService.Module). -->
    <ProjectReference Include="..\Deckle.Localization\Deckle.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Llm.Rewrite.Tests" />
  </ItemGroup>
</Project>
