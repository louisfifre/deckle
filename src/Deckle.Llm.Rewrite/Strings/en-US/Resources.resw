  <!-- ─── Common ─────────────────────────────────────────────────────
       Reusable buttons and short labels shared across multiple surfaces.
       Always check Common_* before introducing a surface-specific key. -->
  <data name="Common_Reset" xml:space="preserve">
    <value>Reset</value>
  </data>
  <data name="Common_Remove" xml:space="preserve">
    <value>Remove</value>
  </data>

  <!-- ─── Consent dialogs ────────────────────────────────────────────
       Opt-in prompts for local data capture. Each dialog follows the
       same structure: Title, Body_Intro paragraph, then three
       sub-sections (What/Where/Remind) sharing Common_Consent_*Header
       headers, and Enable/Cancel buttons reusing Common_Enable /
       Common_Cancel. The "Where" body line is the actual filesystem
       path and stays hardcoded in the C# (not copy). -->

  <!-- Section headers shared across the four consent dialogs. -->

  <!-- Corpus consent — text+rewrite JSONL appended per profile. -->

  <!-- Application log consent — full app.jsonl mirror of every log line. -->

  <!-- Audio corpus consent — raw WAV next to the text JSONL, per profile. -->

  <!-- Microphone telemetry consent — per-recording dBFS distribution row. -->

  <!-- ─── Engine status ──────────────────────────────────────────────
       One-shot status strings raised by TranscriptionEngine.RaiseStatus(...).
       Surfaced in the tray tooltip (capped to 127 chars by Shell) and
       echoed to LogWindow under [STATUS]. Status_Rewriting takes the
       active rewrite profile name as {0}. -->

  <!-- ─── Engine feedback ────────────────────────────────────────────
       UserFeedback Title/Body pairs raised by TranscriptionEngine when an
       error or warning is worth surfacing in the HUD. Each pair maps
       to one (Severity, Role) combination decided in code, not here.
       Naming: Engine_<Reason>_Title and Engine_<Reason>_Body. -->

  <!-- ─── Microphone errors ──────────────────────────────────────────
       UserFeedback pairs raised by TranscriptionEngine.LocalizeMicError when
       MicrophoneCapture.Probe / Record returns a MicErrorKind. The
       Unavailable body interpolates the raw MMSYSERR code as {0}
       for diagnostic clarity. -->

  <!-- ─── HUD ────────────────────────────────────────────────────────
       Short post-paste / post-copy confirmations rendered in the HUD
       message slot. Hud_Copied_Hint sits under the title to remind the
       user how to paste manually when the auto-paste path didn't run. -->

  <!-- ─── Tray ───────────────────────────────────────────────────────
       Tray icon tooltip. Capped at 127 chars by Shell_NotifyIcon. The
       {0} placeholder receives a Status_* string from TranscriptionEngine. -->

  <!-- ─── Setup wizard — shell ───────────────────────────────────────
       SetupWindow shell strings: window title, footer buttons. The
       footer buttons reuse Common_* via x:Uid in XAML. -->

  <!-- ─── Setup wizard — choices page ────────────────────────────────
       Step header text is set programmatically by ChoicesPage via
       SetStepHeader. Cards in XAML use x:Uid for header/description. -->

  <!-- ─── Setup wizard — installing page ─────────────────────────────
       Inline Cancel install button in XAML uses x:Uid. All progress
       and status strings are emitted from C# during the run. -->

  <!-- ─── Setup wizard — summary page ────────────────────────────────
       Renders per-item Results captured by InstallingPage. The Next
       button label flips between "Get started" (success path) and
       "Retry" (any failure path). -->

  <!-- ─── Settings — common section actions ──────────────────────────
       Per-section "Reset" hyperlink and its tooltip. Reused on every
       Settings section header (Appearance, Startup, Recording, etc.). -->
  <data name="Settings_SectionResetLink.Content" xml:space="preserve">
    <value>Reset</value>
  </data>
  <data name="Settings_SectionResetLink.ToolTipService.ToolTip" xml:space="preserve">
    <value>Reset this section to defaults</value>
  </data>

  <!-- ─── GeneralPage ────────────────────────────────────────────────
