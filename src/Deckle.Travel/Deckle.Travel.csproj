<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Travel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Anytype\Deckle.Anytype.csproj" />
    <ProjectReference Include="..\Deckle.Anytype.Mcp\Deckle.Anytype.Mcp.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One terms file per language; adding a language is a file addition.
         WithCulture=false: the ".fr" in the filename is a terms-file language
         tag, not an assembly culture — without it MSBuild routes the file into
         a fr satellite assembly and the main assembly carries no resource. -->
    <EmbeddedResource Include="Terms\*.json"
                      WithCulture="false"
                      LogicalName="Deckle.Travel.Terms.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Travel.Tests" />
  </ItemGroup>
</Project>
