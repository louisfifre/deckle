<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Catalog</RootNamespace>
    <!-- UseWinUI surfaces the Microsoft.WinUI reference: the composer builds
         its controls in code. The module holds no .xaml, so the XAML compiler
         never runs here, nor on Catalog's account in the modules that
         reference it. Its two compiled dictionaries (the icon catalog and the
         page header's brushes) live in Deckle.Catalog.Themes, which the host
         references; Catalog names them by URI and does not reference that
         project. No .xaml and no .resw, so no PRI emission
         (EnableMsixTooling) either. -->
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <!-- ResourceLoader (Microsoft.Windows.ApplicationModel.Resources). One
         WindowsAppSDK runtime is loaded per process. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- SettingsCard / SettingsExpander: the settings composer builds these
         controls, so every module that composes against Catalog gets the
         control set transitively. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deckle.Localization\Deckle.Localization.csproj" />
    <!-- HotkeyChord and HotkeyModifiers: the hotkey card edits a chord that
         engines persist, so the type lives in Core, which holds no XAML. -->
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
  </ItemGroup>
</Project>
