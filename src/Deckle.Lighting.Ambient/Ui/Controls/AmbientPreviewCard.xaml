<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Deckle.Lighting.Ambient.AmbientPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:Deckle.Catalog">

    <!-- The Ambient preview in the shared preview block, floating in the page's
         pane: the sampled grid as the stage, the commands and the colours sent
         on the row above it, the engine's readouts under it. Live while the
         engine runs; off, the block says what to turn on. -->
    <catalog:PreviewBlock x:Name="Block"
                          x:Uid="AmbientPreviewBlock">

        <!-- The readouts' two layouts, switched by the code-behind on the
             control's own width (OnSizeChanged): AdaptiveTrigger watches the
             window, not the pane, and the Toolkit's ControlSizeTrigger is in a
             package this module does not reference. Wide, the four readouts
             sit in two columns that share the width; narrow, they stack in
             one column and the second column closes. The states move the
             readouts between cells and give the one that changes row its top
             gap: the grid carries no RowSpacing, because a Grid pays the
             spacing for an empty row too, and the wide layout leaves two. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ReadoutLayouts">
                <VisualState x:Name="WideReadouts" />
                <VisualState x:Name="NarrowReadouts">
                    <VisualState.Setters>
                        <Setter Target="ReadoutsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="ReadoutsSecondColumn.Width" Value="0" />
                        <Setter Target="GridReadout.(Grid.Row)" Value="1" />
                        <Setter Target="GridReadout.(Grid.Column)" Value="0" />
                        <Setter Target="GridReadout.Margin" Value="0,12,0,0" />
                        <Setter Target="RateReadout.(Grid.Row)" Value="2" />
                        <Setter Target="OutputReadout.(Grid.Row)" Value="3" />
                        <Setter Target="OutputReadout.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Commands act on the preview itself, never on a setting: show the
             zone bands over the grid, freeze the refresh to look at a frame.
             The swatches share the row, one per light (or one for the group),
             the colour the engine sends on the latest tick: beside the
             commands, where the Playground puts them and the eye finds them
             (Louis, 2026-10-14, did not find them under the stage). -->
        <catalog:PreviewBlock.Commands>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="ZonesToggle"
                              x:Uid="AmbientPreviewZonesToggle"
                              IsChecked="True"
                              IsEnabled="False"
                              Click="ZonesToggle_Click" />
                <ToggleButton x:Name="PauseToggle"
                              IsEnabled="False"
                              Click="PauseToggle_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{StaticResource Icon.Transport.Pause}" FontSize="14" />
                        <TextBlock x:Uid="AmbientPreviewPauseLabel" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel x:Name="EmittedSwatches"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
            </StackPanel>
        </catalog:PreviewBlock.Commands>

        <!-- Close belongs to the pane the page opens around this control; the
             control only asks (CloseRequested). Subtle and icon-only, the way
             a pane's dismiss looks; its .resw entry names it for narrators. -->
        <catalog:PreviewBlock.TrailingCommands>
            <Button x:Name="CloseButton"
                    x:Uid="AmbientPreviewCloseButton"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="CloseButton_Click">
                <FontIcon Glyph="{StaticResource Icon.Cancel}" FontSize="14" />
            </Button>
        </catalog:PreviewBlock.TrailingCommands>

        <!-- The stage keeps the screen's ratio exactly: each cell is
             sourceWidth / cols wide and sourceHeight / rows high in source
             pixels, and the Viewbox scales the whole stage uniformly into the
             room the layer gives it. The zone overlay shares those
             coordinates. -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Stage">
                <Grid x:Name="CellsGrid" />
                <Canvas x:Name="ZoneOverlay"
                        IsHitTestVisible="False">
                    <Rectangle x:Name="ZoneTopRect"    Visibility="Collapsed" />
                    <Rectangle x:Name="ZoneBottomRect" Visibility="Collapsed" />
                    <Rectangle x:Name="ZoneLeftRect"   Visibility="Collapsed" />
                    <Rectangle x:Name="ZoneRightRect"  Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- Readouts come from the engine, never typed: the captured format,
             the sampling grid, the cadence the capture really holds and the
             output transport. Two star columns that share the pane's width,
             one column once the pane is narrow (the ReadoutLayouts states
             above): a fixed row ran past the stage's edge at 240 px, and
             fixed cells left the pane's width unused (Louis, 2026-10-15).
             Four Auto rows so the narrow layout has its cells; the two the
             wide layout leaves empty take no height. The 12 px top margin
             is the row gap; see the states for why it is not RowSpacing. -->
        <catalog:PreviewBlock.Readouts>
            <Grid x:Name="ReadoutsGrid" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ReadoutsSecondColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <catalog:Readout x:Name="CaptureReadout" x:Uid="AmbientPreviewCaptureReadout"
                                 Grid.Row="0" Grid.Column="0" />
                <catalog:Readout x:Name="GridReadout"    x:Uid="AmbientPreviewGridReadout"
                                 Grid.Row="0" Grid.Column="1" />
                <catalog:Readout x:Name="RateReadout"    x:Uid="AmbientPreviewRateReadout"
                                 Grid.Row="1" Grid.Column="0"
                                 Margin="0,12,0,0" />
                <catalog:Readout x:Name="OutputReadout"  x:Uid="AmbientPreviewOutputReadout"
                                 Grid.Row="1" Grid.Column="1"
                                 Margin="0,12,0,0" />
            </Grid>
        </catalog:PreviewBlock.Readouts>
    </catalog:PreviewBlock>
</UserControl>
