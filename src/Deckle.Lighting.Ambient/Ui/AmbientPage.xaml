    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Reset all is gated on ViewModel.CanReset in code-behind; the
                     page confirms with its own dialog, which says what the reset
                     keeps. -->
                <catalog:SettingsPageHeader x:Name="Header"
                                            x:Uid="AmbientPageHeader"
                                            ResetAllRequested="ResetAll_Click" />

                <!-- The module switch comes first on the page, alone and outside
                     any section. -->
                <StackPanel x:Name="StateHost"
                            Spacing="{StaticResource SettingsCardSpacing}" />

                <!-- ── State ──────────────────────────────────────────────── -->
                <catalog:SettingsSection x:Uid="AmbientPageStateSection">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                        <!-- bespoke: a state banner, not a setting. -->
                        <InfoBar x:Name="NotPairedInfoBar"
                                 x:Uid="AmbientNotPairedInfoBar"
                                 IsClosable="False"
                                 IsOpen="False"
                                 Severity="Warning"
                                 Margin="0,0,0,8">
                            <InfoBar.ActionButton>
                                <Button x:Name="ConfigureBridgeButton"
                                        x:Uid="AmbientNotPairedActionButton"
                                        Click="ConfigureBridgeButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!-- bespoke: a live instrument, not a setting, refreshed only
                             while open. -->
                        <ambientControls:AmbientPreviewCard />
                    </StackPanel>
                </catalog:SettingsSection>

