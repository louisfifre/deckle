<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Lighting.Ambient</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Generates the lib's own .pri so x:Uid lookups in AmbientPage
         resolve against the Deckle.Lighting.Ambient/Resources subtree. -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Lighting.Ambient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- GridSplitter between the Ambient page and its preview pane. Referenced
         here, not from Catalog: Ambient is the only page with a pane today. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Composition\Deckle.Composition.csproj" />
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
    <!-- Diagnostics.Logging carries AmbientCaptureGate, which AmbientEngine
         sets while its capture loop runs, for log admission. -->
    <ProjectReference Include="..\Deckle.Diagnostics.Logging\Deckle.Diagnostics.Logging.csproj" />
    <ProjectReference Include="..\Deckle.Lighting\Deckle.Lighting.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Presets\Deckle.Presets.csproj" />
    <ProjectReference Include="..\Deckle.Settings\Deckle.Settings.csproj" />
    <ProjectReference Include="..\Deckle.Vision\Deckle.Vision.csproj" />
    <!-- Shell carries the DispatcherQueue.TryEnqueueObserved extensions the
         UI uses; referenced directly rather than through Settings. -->
    <ProjectReference Include="..\Deckle.Shell\Deckle.Shell.csproj" />
  </ItemGroup>
</Project>
