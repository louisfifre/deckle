<Window
    x:Class="Deckle.Mail.Hub.MailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Mail.Hub"
    Title="Deckle Mail">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- A line of the search menu: the sentence, where its subject
                 stands, its date (spec Open 26; frame 5.4). The notice line
                 (no mail matches) has neither place nor date. -->
            <DataTemplate x:Key="SearchLineTemplate" x:DataType="local:SearchLine">
                <Grid ColumnSpacing="12" Padding="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Sentence}"
                               Language="{x:Bind Language}"

                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Where}"
                               Visibility="{x:Bind WhereAsWords}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <local:FramedLabel Grid.Column="1"
                                       Text="{x:Bind Where}"
                                       Visibility="{x:Bind WhereAsLabel}" />
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind Date}"
                               MinWidth="56"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The same bar on every page: back, pane toggle, icon and title,
             the search field, and the problems button while something does
             not work. Nothing in it moves from one page to the next; the back
             button is disabled, never hidden, where there is nowhere to go
             back to (spec, The window). -->
        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="MailTitleBar"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="False"
                  IsPaneToggleButtonVisible="True"
                  BackRequested="OnTitleBarBackRequested"
                  PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.Resources>
                <!-- The Content slot centers at its DesiredSize by default;
                     Stretch hands it the zone's width and the box caps itself
                     at its MaxWidth, as SettingsWindow does. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- The field while the bar has room for it; under that, a
                     button that opens the same field under the bar (spec, A
                     narrow window; MailWindow.Search.cs). SettingsWindow's
                     pattern, so both windows fold their search the same way. -->
                <Grid x:Name="SearchZone"
                      VerticalAlignment="Center"
                      Margin="8,0"
                      SizeChanged="OnSearchZoneSizeChanged">
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="MailSearchBox"
                                    QueryIcon="Find"
                                    MaxWidth="480"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    ItemTemplate="{StaticResource SearchLineTemplate}"
                                    TextChanged="OnSearchTextChanged"
                                    UpdateTextOnSelect="False"
                                    QuerySubmitted="OnSearchQuerySubmitted"
                                    LostFocus="OnSearchBoxLostFocus"
                                    KeyDown="OnSearchBoxKeyDown" />
                    <Button x:Name="SearchIconButton"
                            x:Uid="MailSearchIconButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSearchIconClick">
                        <FontIcon Glyph="{StaticResource Icon.Search}" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- Present only while something does not work, its slot kept
                     either way so the search field never moves (Problems.cs). The count
                     badge is the only colour; the glyph keeps the ink of the
                     other commands of the bar (spec Open 50). -->
                <Button x:Name="ProblemsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center"
                        MinWidth="36"
                        Padding="8,4"
                        Opacity="0"
                        IsHitTestVisible="False"
                        IsTabStop="False">
                    <Grid>
                        <FontIcon Glyph="{StaticResource Icon.Mail.Problems}" FontSize="16" />
                        <InfoBadge x:Name="ProblemsBadge"
                                   Style="{StaticResource CautionValueInfoBadgeStyle}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,-6,-10,0" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="ProblemsFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MaxWidth" Value="400" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel x:Name="ProblemsList" Width="380" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        ItemInvoked="OnNavItemInvoked"
                        Expanding="OnNavExpanding"
                        Collapsed="OnNavCollapsed">

            <!-- One ground for the whole window, as SettingsWindow draws it:
                 the page sits on the window's Mica beside the rail, without the
                 content layer NavigationView paints by default. Without a
                 HighContrast dictionary of its own, HighContrast fell back to
                 Default and lost its ground too; the HighContrast dictionary
                 below repeats the control's own values (WinUI generic.xaml),
                 so a contrast theme keeps SystemColorWindowColor. -->
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <!-- Items are built from the session (MailWindow.Rail.cs): the
                 mailboxes come and go with Settings. -->
            <Frame x:Name="PageFrame" />
        </NavigationView>

        <!-- Where the search field stands once its button is clicked in a
             narrow window: the code reparents the same AutoSuggestBox in here.
             A surface that appears briefly, so the flyout's ground and stroke;
             declared after the NavigationView to draw above the page. -->
        <Border x:Name="SearchOverlay"
                Grid.Row="1"
                MaxWidth="376"
                Margin="12,4"
                Padding="8,6"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="Collapsed" />
    </Grid>
</Window>
