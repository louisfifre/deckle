<Page
    x:Class="Deckle.Mail.Hub.AddMailboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Mail.Hub"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:catalog="using:Deckle.Catalog"
    NavigationCacheMode="Disabled">

    <!-- Add mailbox, a page of its own (Settings holds no fold to add one):
         the address and the name side by side on one line of a compact card,
         then the connection (spec, Settings; frame 1.2). Disabled cache: the
         form starts empty each time, and a typed password never outlives the
         page. -->
    <ScrollViewer>
        <Grid>
            <!-- The column of the page, at most 1000 wide inside its 32 px margins and
                 held at the left as the frames hold it. A capped Grid column, not
                 MaxWidth on a stretched panel: WinUI centres such a panel from its
                 desired width, which drifted a narrow page to the middle. -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1064" /></Grid.ColumnDefinitions>
            <StackPanel
                    HorizontalAlignment="Stretch"
                    Margin="32,32,32,24"
                    Spacing="{StaticResource SettingsCardSpacing}">
            <local:MailPageHeader x:Name="Header" Margin="0,0,0,-20" />

            <catalog:SettingsSection x:Uid="AddMailboxSection">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <controls:SettingsCard x:Uid="AddMailboxAddressCard" ContentAlignment="Vertical">
                        <StackPanel Spacing="6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="AddressBox"
                                         x:Uid="AddMailboxAddress"
                                         Width="320"
                                         InputScope="EmailSmtpAddress"
                                         TextChanged="OnFormChanged" />
                                <!-- A name left empty makes the mailbox show
                                     its address. -->
                                <TextBox x:Name="NameBox"
                                         x:Uid="AddMailboxName"
                                         Width="240" />
                            </StackPanel>
                            <TextBlock x:Name="ProviderText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="AddMailboxPasswordCard" ContentAlignment="Vertical">
                        <PasswordBox x:Name="PasswordField"
                                     x:Uid="AddMailboxPasswordField"
                                     Width="320"
                                     HorizontalAlignment="Left"
                                     PasswordChanged="OnPasswordChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsExpander x:Name="ServerExpander" x:Uid="AddMailboxServerExpander">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="MailboxServerHost">
                                <TextBox x:Name="HostBox" Width="240" TextChanged="OnFormChanged" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="MailboxServerPort">
                                <NumberBox x:Name="PortBox" Width="120" Minimum="1" Maximum="65535" Value="993" SpinButtonPlacementMode="Hidden" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
            </catalog:SettingsSection>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                <Button x:Name="AddButton"
                        x:Uid="AddMailboxAddButton"
                        IsEnabled="False"
                        Click="OnAddClick" />
                <Button x:Uid="AddMailboxCancelButton" Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
