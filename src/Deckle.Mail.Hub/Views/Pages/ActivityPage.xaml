<Page
    x:Class="Deckle.Mail.Hub.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Mail.Hub"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="MailRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- The card a day's lines stand in, as Triage's rows do. -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Margin="32,32,32,24">
            <local:MailPageHeader x:Name="Header" />
            <!-- Two parts, one shown at a time: what the person did, and
                 what the sorting did alone (spec, Activity; Open 12 for the
                 words). The SelectorBar is Windows' own control for two views
                 of one page. -->
            <SelectorBar x:Name="Parts" Margin="-12,-12,0,0" SelectionChanged="OnPartChanged">
                <SelectorBarItem x:Name="ByYouItem" x:Uid="ActivityByYou" />
                <SelectorBarItem x:Name="ByDeckleItem" x:Uid="ActivityByDeckle" />
            </SelectorBar>
            <StackPanel x:Name="DaysPanel" />
            <TextBlock x:Name="NoneText"
                       Margin="1,24,0,0"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
