<UserControl
    x:Class="Deckle.Mail.Hub.DialogBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The body of a ContentDialog of the window: what the action does, then
         what it is about, in grey (frames 1.9 and 7.6). -->
    <StackPanel Spacing="12">
        <TextBlock x:Name="MainText" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
