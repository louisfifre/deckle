<UserControl
    x:Class="Deckle.Mail.Hub.FileTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left">

    <!-- A file attached to a mail: a tile with its name, kind and size, which
         opens the file in the app Windows uses for its kind. A standard
         button, so it has the hover, press and focus of every button. -->
    <Button x:Name="TileButton" Padding="12,8,16,8">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="{StaticResource Icon.Mail.File}" FontSize="20" />
            <StackPanel>
                <TextBlock x:Name="NameText" />
                <TextBlock x:Name="MetaText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Button>
</UserControl>
