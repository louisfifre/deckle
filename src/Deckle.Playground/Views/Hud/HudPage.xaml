<!-- HUD playground page. The tuning panel is built in code-behind from
     HudViewModel.ActiveTuningSections, so only the knobs that affect the
     current preview show. -->
<Page
    x:Class="Deckle.Playground.HudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrono="using:Deckle.Hud">

    <Page.Resources>
        <Style x:Key="HudTuningHelpTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- MinWidth 320 keeps the preview visible at the window's
                 1280 minimum width. -->
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── Col 0 — preview ────────────────────────────────────── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="24,24,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                <DropDownButton x:Name="TargetDropDownButton"
                                MinWidth="200"
                                HorizontalContentAlignment="Left"
                                ToolTipService.ToolTip="Pick the HUD state or primitive to preview">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Target:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentTargetLabel, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DropDownButton.Content>

                    <!-- Flat, so every target is one click away. Separators
                         mark the groups (HUD states, sweep primitives, then
                         the clone and the countdown views): MenuFlyout has no
                         native section header. Labels name what each target
                         shows, not the HudTarget member; the Tag carries the
                         member. -->
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Charging"
                                            Tag="Charging" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Recording"
                                            Tag="Recording" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Transcribing"
                                            Tag="Transcribing" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Rewriting"
                                            Tag="Rewriting" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutSeparator Margin="0,6,0,6" />
                            <MenuFlyoutItem Text="Cone"
                                            Tag="Conic" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Sweep mask"
                                            Tag="ArcMask" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Masked cone"
                                            Tag="Combined" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutSeparator Margin="0,6,0,6" />
                            <MenuFlyoutItem Text="Cone clone"
                                            Tag="ConicClone" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Utterance countdown"
                                            Tag="UtteranceCountdown" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Countdown material"
                                            Tag="CountdownMaterial" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Countdown masks"
                                            Tag="CountdownMasks" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                            <MenuFlyoutItem Text="Masked countdown"
                                            Tag="MaskedCountdown" MinHeight="36"
                                            Click="OnTargetMenuItemClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                    <!-- Grading for the geometry-only previews, which carry
                         no HUD state; ApplyTarget shows it per
                         HudViewModel.IsVariantToggleVisible. -->
                    <StackPanel x:Name="VariantToggle"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <RadioButton Content="Transcribing"
                                     GroupName="PreviewVariant"
                                     Tag="Transcribing"
                                     Checked="OnVariantRadioChecked" />
                        <RadioButton Content="Rewriting"
                                     GroupName="PreviewVariant"
                                     Tag="Rewriting"
                                     IsChecked="True"
                                     Checked="OnVariantRadioChecked" />
                    </StackPanel>
                </StackPanel>

                <!-- Both buttons always show; the inactive one greys out
                     instead of hiding. -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Button x:Name="PlayButton"
                            IsEnabled="{x:Bind ViewModel.IsPlayEnabled, Mode=OneWay}"
                            Click="OnPlayClick"
                            ToolTipService.ToolTip="Start"
                            AutomationProperties.Name="Start">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Transport.Play}" FontSize="14" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton"
                            IsEnabled="{x:Bind ViewModel.IsStopEnabled, Mode=OneWay}"
                            Click="OnStopClick"
                            ToolTipService.ToolTip="Stop"
                            AutomationProperties.Name="Stop">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Transport.Stop}" FontSize="14" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ApplyTarget collapses both previews on Stop, leaving the
                 substrate empty. -->
            <Border Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Margin="24,0,12,24">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <chrono:HudChrono x:Name="ChronoPreview"
                                      Width="272"
                                      Height="78" />
                    <Grid x:Name="NakedPreviewHost"
                          Width="300"
                          Height="300"
                          Visibility="Collapsed">
                        <Border Width="272" Height="78"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Col 1 — tuning Expanders (built programmatically) ───── -->
        <Grid Grid.Column="1"
              MinWidth="480"
              MaxWidth="600">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,24,24,24">
            <StackPanel>
            <StackPanel x:Name="TuningStack" Spacing="6">

                <!-- Reset all returns every knob to the compiled defaults;
                     the floating bar below saves what the knobs show.
                     BuildTuningPanel relies on this header staying child 0
                     of TuningStack. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Uid="PlaygroundHudTunablesHeader"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Row="0" Grid.Column="1"
                            x:Name="ResetAllButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Reset everything on this page to its defaults"
                            Click="OnResetAllClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="14" />
                            <TextBlock Text="Reset all" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               x:Uid="PlaygroundHudTunablesDescription"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               MaxWidth="400"
                               Margin="0,4,0,0" />
                </Grid>
            </StackPanel>

            <!-- Footer breathing room, present only while the floating save
                 bar is up, so the last row can scroll clear of it. Kept as
                 tall as the bar in code-behind. -->
            <Border x:Name="UnsavedSpacer" Height="56" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Floating save bar, the Segmentation tab's: shown while a knob
             differs from the stored HUD settings. Revert puts the stored
             values back, Save writes the knobs to the HUD settings store;
             both clear the difference, so the bar dismisses itself. Margins
             overhang the column's padding by 12 on each side, as the
             Segmentation bar does. -->
        <Border x:Name="UnsavedBar"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                Margin="0,0,12,12"
                Padding="16,14"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Unsaved changes"
                           VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="RevertButton" Click="OnRevertClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                            <TextBlock Text="Revert" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnSaveClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource Icon.Save}" FontSize="14" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
