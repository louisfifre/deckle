<!-- Landing page. Routing goes through PlaygroundShell.NavigateTo so the
     page holds no reference to the window's NavigationView. -->
<Page
    x:Class="Deckle.Playground.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Top"
              MaxWidth="720"
              Margin="32,32,32,32">
            <StackPanel Spacing="32">

                <!-- TitleTextBlockStyle, not TitleLarge: every Playground page
                     header uses it, so no surface reads oversized. -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PlaygroundHomeHeader"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="PlaygroundHomeSubheader"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Each card's glyph matches its NavigationView item icon in
                     PlaygroundWindow. -->
                <StackPanel Spacing="8">
                    <controls:SettingsCard x:Name="HomeHudCard"
                                           x:Uid="PlaygroundHomeHudCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Speaker}}"
                                           IsClickEnabled="True"
                                           Click="OnHudCardClick" />
                    <controls:SettingsCard x:Name="HomeAmbientCard"
                                           x:Uid="PlaygroundHomeAmbientCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Lightbulb}}"
                                           IsClickEnabled="True"
                                           Click="OnAmbientCardClick" />
                    <controls:SettingsCard x:Name="HomeSegmentationCard"
                                           x:Uid="PlaygroundHomeSegmentationCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Speech}}"
                                           IsClickEnabled="True"
                                           Click="OnSegmentationCardClick" />
                    <controls:SettingsCard x:Name="HomeCorrectionCard"
                                           x:Uid="PlaygroundHomeCorrectionCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Autocorrect}}"
                                           IsClickEnabled="True"
                                           Click="OnCorrectionCardClick" />
                </StackPanel>

                <!-- Manual probe for the toast channel. -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PlaygroundHomeNotificationsHeader"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Button x:Name="SendTestPromptButton"
                            x:Uid="PlaygroundHomeSendTestPrompt"
                            Click="OnSendTestPromptClick" />
                    <TextBlock x:Name="NotificationOutcomeText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
