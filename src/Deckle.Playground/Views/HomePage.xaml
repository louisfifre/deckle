<!-- Landing page : three SettingsCards routing to the HUD, Ambient and
     Segmentation pages. Pattern mirrors Dev Home / Settings hub : a centred,
     readable column with an H1 and a stack of cards. Routing goes
     through PlaygroundShell.NavigateTo so the page doesn't hold a
     reference to the parent Window's NavigationView. -->
<Page
    x:Class="Deckle.Playground.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Top"
              MaxWidth="720"
              Margin="32,32,32,32">
            <StackPanel Spacing="32">

                <!-- Header block : H1 + one-line description. TitleTextBlockStyle
                     (not TitleLarge) is the shared Playground header convention —
                     the HUD page sets the reference, every page aligns to it so
                     no surface reads oversized. -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PlaygroundHomeHeader"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="PlaygroundHomeSubheader"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Routing cards. IsClickEnabled + Click handler
                     follows the SettingsCard "actionable row" pattern :
                     the whole card is a hit target, the chevron glyph
                     on the right is added automatically. Glyphs match
                     the NavigationView item icons in PlaygroundWindow
                     so the user reads "this card goes to the HUD nav
                     item" without further explanation. -->
                <StackPanel Spacing="8">
                    <controls:SettingsCard x:Name="HomeHudCard"
                                           x:Uid="PlaygroundHomeHudCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Speaker}}"
                                           IsClickEnabled="True"
                                           Click="OnHudCardClick" />
                    <controls:SettingsCard x:Name="HomeAmbientCard"
                                           x:Uid="PlaygroundHomeAmbientCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Lightbulb}}"
                                           IsClickEnabled="True"
                                           Click="OnAmbientCardClick" />
                    <controls:SettingsCard x:Name="HomeSegmentationCard"
                                           x:Uid="PlaygroundHomeSegmentationCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Speech}}"
                                           IsClickEnabled="True"
                                           Click="OnSegmentationCardClick" />
                </StackPanel>

                <!-- Notifications test surface. Manual probe for the toast
                     channel : fires the Playground TestPrompt descriptor
                     through the dispatcher and reports the answer. Section
                     header uses BodyStrongTextBlockStyle, the Win11 settings
                     section-title convention, so it reads as a distinct group
                     below the routing cards without competing with the H1. -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PlaygroundHomeNotificationsHeader"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Button x:Name="SendTestPromptButton"
                            x:Uid="PlaygroundHomeSendTestPrompt"
                            Click="OnSendTestPromptClick" />
                    <TextBlock x:Name="NotificationOutcomeText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
