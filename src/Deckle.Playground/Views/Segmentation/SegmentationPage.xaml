<!-- Streaming segmentation tuning page. Unlike the live-save AmbientPage,
     edits stay in SegmentationViewModel until Save writes them to the
     transcription settings store. -->
<Page
    x:Class="Deckle.Playground.SegmentationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deckle.Settings.Controls"
    xmlns:catalog="using:Deckle.Catalog">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── Col 0 — curve stage ─────────────────────────────────────── -->
        <!-- Inner edge at 12, not 24: with Col 1's 12 padding the central
             gutter reads as one 24 unit, not a doubled 48. -->
        <Grid Grid.Column="0" Margin="24,24,12,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="GraphToggle" Grid.Column="0"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="OnGraphToggleChanged"
                              Unchecked="OnGraphToggleChanged">
                    <TextBlock x:Name="GraphToggleText" Text="Hide graph" />
                </ToggleButton>

                <Grid x:Name="GraphLegend" Grid.Column="1" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Shaped curve"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Text="Linear reference"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Utterance length"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Grid>

