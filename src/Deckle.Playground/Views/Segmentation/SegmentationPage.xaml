        <!-- ── Col 1 — controls + floating save bar ─────────────────────── -->
        <Grid Grid.Column="1">

            <ScrollViewer MinWidth="380"
                          MaxWidth="480"
                          Padding="12,24,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   x:Uid="PlaygroundSegmentationHeader"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="0" Grid.Column="1"
                                x:Name="ResetDefaultsButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}"
                                ToolTipService.ToolTip="Reset everything on this page to its defaults"
                                Click="OnResetDefaultsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="14" />
                                <TextBlock Text="Reset all" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   x:Uid="PlaygroundSegmentationSubheader"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </Grid>

                    <controls:TuningCard Title="Hangover &amp; ramp"
                        Description="The decision delay starts at the maximum and, once an utterance grows past the ramp start, shrinks toward the minimum by the ramp end. In seconds."
                        ResetClick="OnResetHangoverRampClick">
                        <StackPanel Spacing="20">
                            <controls:TunableRow Label="Hangover (max)" Unit="s"
                                Minimum="0.5" Maximum="15.0" Step="0.5" Default="5.0"
                                Value="{x:Bind ViewModel.HangoverMaxSec, Mode=TwoWay}"
                                Description="Trailing silence to wait, at the start of an utterance, before declaring it ended." />

                            <controls:TunableRow Label="Hangover (min)" Unit="s"
                                Minimum="0.1" Maximum="2.0" Step="0.1" Default="0.5"
                                Value="{x:Bind ViewModel.HangoverMinSec, Mode=TwoWay}"
                                Description="Floor the delay decays to for long utterances — a shorter pause is treated as intra-word." />

                            <controls:TunableRow Label="Ramp start" Unit="s"
                                Minimum="0.0" Maximum="180.0" Step="5.0" Default="15.0"
                                Value="{x:Bind ViewModel.RampStartSec, Mode=TwoWay}"
                                Description="Utterance length where the delay starts shrinking from the max." />

                            <controls:TunableRow Label="Ramp end" Unit="s"
                                Minimum="30.0" Maximum="240.0" Step="5.0" Default="120.0"
                                Value="{x:Bind ViewModel.RampEndSec, Mode=TwoWay}"
                                Description="Utterance length where the delay reaches the minimum." />
                        </StackPanel>
                    </controls:TuningCard>

                    <controls:TuningCard Title="Detection"
                        Description="The voicing gate, the cut margin, and the noise-blip floor — the rest of the segmenter around the hangover curve."
                        ResetClick="OnResetDetectionClick">
                        <StackPanel Spacing="20">
                            <controls:TunableRow Label="Silence threshold" Unit="dBFS"
                                Minimum="-70.0" Maximum="-20.0" Step="1.0" Default="-45.0"
                                Value="{x:Bind ViewModel.ThresholdDbfs, Mode=TwoWay}"
                                Description="Raw level (dBFS) at or above which a frame counts as speech. Lower is more sensitive." />

                            <controls:TunableRow Label="Cut margin" Unit="ms"
                                Minimum="0.0" Maximum="1000.0" Step="50.0" Default="150.0"
                                Value="{x:Bind ViewModel.MarginMs, Mode=TwoWay}"
                                Description="Silence kept after the last word when cutting — the rest is dropped." />

                            <controls:TunableRow Label="Minimum utterance" Unit="ms"
                                Minimum="0.0" Maximum="1000.0" Step="50.0" Default="250.0"
                                Value="{x:Bind ViewModel.MinUtteranceMs, Mode=TwoWay}"
                                Description="Speech shorter than this is dropped as a noise blip rather than transcribed." />
                        </StackPanel>
                    </controls:TuningCard>

                    <!-- Shown with the floating save bar so the last caption can
                         scroll clear of it; code-behind keeps its height equal to
                         the bar's. -->
                    <Border x:Name="UnsavedSpacer" Height="56" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Shown only while there are unsaved edits. Left margin 0, not
                 12, so it overhangs the cards by 12 on the left as on the right
                 and bottom. -->
            <Border x:Name="UnsavedBar"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,12"
                    Padding="16,14"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Unsaved changes"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="RevertButton" Click="OnRevertClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                <TextBlock Text="Revert" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnSaveClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Save}" FontSize="14" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
