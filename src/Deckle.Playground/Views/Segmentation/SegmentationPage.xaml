<!-- Streaming segmentation tuning page. Two columns : the dynamic-hangover
     curve stage on the left (action header + live plot + the curve-shape editor
     under it), the segmenter knobs on the right in a scroll panel with a pinned
     Save / Revert / Reset bar. Every knob is a TunableRow (slider + editable
     NumberBox + per-parameter reset wheel) bound two-way to the view-model ;
     each card and the curve editor carry a per-section reset wheel. Edits are
     EPHEMERAL — held in SegmentationViewModel until Save writes them to the
     transcription settings store (the Playground Save / Revert / Reset
     contract), unlike the live-save AmbientPage. -->
<Page
    x:Class="Deckle.Playground.SegmentationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deckle.Playground.Controls"
    xmlns:transcription="using:Deckle.Transcription">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── Col 0 — curve stage ─────────────────────────────────────── -->
        <!-- Inner edge (right) at 12, not 24, so the central gutter between the
             two columns reads as one 24 unit (12 here + 12 on Col 1's padding),
             not a doubled 48. Outer edges stay 24. -->
        <Grid Grid.Column="0" Margin="24,24,12,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Action header — the graph show/hide toggle on the left (the action,
                 mirroring the Ambient / HUD toolbars), the legend and the
                 "Utterance length" axis title on the right. Legend collapses with
                 the graph ; the toggle stays. -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="GraphToggle" Grid.Column="0"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="OnGraphToggleChanged"
                              Unchecked="OnGraphToggleChanged">
                    <TextBlock x:Name="GraphToggleText" Text="Hide graph" />
                </ToggleButton>

                <Grid x:Name="GraphLegend" Grid.Column="1" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Shaped curve"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Text="Linear reference"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Utterance length"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Grid>

            <!-- The hangover curve. Height is capped (width stays elastic) so the
                 plot reads as a wide band ; the control captions its own axes. The
                 anchor properties feed it one-way ; the four Bézier control points
                 are bound two-way, so dragging a handle writes the view-model and
                 typing in the boxes below moves the handle. -->
            <transcription:HangoverCurveCanvas
                x:Name="HangoverCurve"
                Grid.Row="1"
                Height="280"
                HangoverMaxSec="{x:Bind ViewModel.HangoverMaxSec, Mode=OneWay}"
                HangoverMinSec="{x:Bind ViewModel.HangoverMinSec, Mode=OneWay}"
                RampStartSec="{x:Bind ViewModel.RampStartSec, Mode=OneWay}"
                RampEndSec="{x:Bind ViewModel.RampEndSec, Mode=OneWay}"
                X1="{x:Bind ViewModel.CurveX1, Mode=TwoWay}"
                Y1="{x:Bind ViewModel.CurveY1, Mode=TwoWay}"
                X2="{x:Bind ViewModel.CurveX2, Mode=TwoWay}"
                Y2="{x:Bind ViewModel.CurveY2, Mode=TwoWay}" />

            <!-- Below the plot : the plain-language readout and the curve-shape
                 editor (cubic-bezier readout + manual entry of the four control
                 points, with a section reset wheel). The handles on the plot and
                 these boxes edit the same view-model values. -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="16">
                <TextBlock x:Name="CurveReadoutText"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="CurveShapeSection" Spacing="8"
                            Background="Transparent"
                            PointerEntered="OnCurveSectionPointerEntered"
                            PointerExited="OnCurveSectionPointerExited">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Curve shape"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="CurveResetButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Opacity="0"
                                ToolTipService.ToolTip="Reset this section to its defaults"
                                Click="OnResetCurveClick"
                                GotFocus="OnCurveResetGotFocus"
                                LostFocus="OnCurveResetLostFocus">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="14" />
                                <TextBlock Text="Reset section" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="CurveBezierText"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="x1" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <NumberBox x:Name="CurveX1Box"
                                       Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind ViewModel.CurveX1, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="y1" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <NumberBox x:Name="CurveY1Box"
                                       Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind ViewModel.CurveY1, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="x2" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <NumberBox x:Name="CurveX2Box"
                                       Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind ViewModel.CurveX2, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="y2" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <NumberBox x:Name="CurveY2Box"
                                       Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind ViewModel.CurveY2, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Drag the two handles on the plot or type the four control points. Pull a handle into a corner for a right-angle hold-then-drop ; line them up on the diagonal for a straight decline."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               MaxWidth="640" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Col 1 — controls + floating save bar ─────────────────────── -->
        <Grid Grid.Column="1">

            <ScrollViewer MinWidth="380"
                          MaxWidth="480"
                          Padding="12,24,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">

                    <!-- Page title block — TitleTextBlockStyle header + Body
                         description, with Reset to defaults inline on the right
                         (always there — snaps every knob to the shipping
                         defaults). Save / Revert live in the floating bar below. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   x:Uid="PlaygroundSegmentationHeader"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="0" Grid.Column="1"
                                x:Name="ResetDefaultsButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}"
                                ToolTipService.ToolTip="Reset everything on this page to its defaults"
                                Click="OnResetDefaultsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Refresh}" FontSize="14" />
                                <TextBlock Text="Reset all" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   x:Uid="PlaygroundSegmentationSubheader"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </Grid>

                    <!-- Hangover & ramp card. -->
                    <controls:TuningCard Title="Hangover &amp; ramp"
                        Description="The decision delay starts at the maximum and, once an utterance grows past the ramp start, shrinks toward the minimum by the ramp end. In seconds."
                        ResetClick="OnResetHangoverRampClick">
                        <StackPanel Spacing="20">
                            <controls:TunableRow Label="Hangover (max)" Unit="s"
                                Minimum="0.5" Maximum="15.0" Step="0.5" Default="5.0"
                                Value="{x:Bind ViewModel.HangoverMaxSec, Mode=TwoWay}"
                                Description="Trailing silence to wait, at the start of an utterance, before declaring it ended." />

                            <controls:TunableRow Label="Hangover (min)" Unit="s"
                                Minimum="0.1" Maximum="2.0" Step="0.1" Default="0.5"
                                Value="{x:Bind ViewModel.HangoverMinSec, Mode=TwoWay}"
                                Description="Floor the delay decays to for long utterances — a shorter pause is treated as intra-word." />

                            <controls:TunableRow Label="Ramp start" Unit="s"
                                Minimum="0.0" Maximum="180.0" Step="5.0" Default="60.0"
                                Value="{x:Bind ViewModel.RampStartSec, Mode=TwoWay}"
                                Description="Utterance length where the delay starts shrinking from the max." />

                            <controls:TunableRow Label="Ramp end" Unit="s"
                                Minimum="30.0" Maximum="240.0" Step="5.0" Default="180.0"
                                Value="{x:Bind ViewModel.RampEndSec, Mode=TwoWay}"
                                Description="Utterance length where the delay reaches the minimum." />
                        </StackPanel>
                    </controls:TuningCard>

                    <!-- Detection card. -->
                    <controls:TuningCard Title="Detection"
                        Description="The voicing gate, the cut margin, and the noise-blip floor — the rest of the segmenter around the hangover curve."
                        ResetClick="OnResetDetectionClick">
                        <StackPanel Spacing="20">
                            <controls:TunableRow Label="Silence threshold" Unit="dBFS"
                                Minimum="-70.0" Maximum="-20.0" Step="1.0" Default="-45.0"
                                Value="{x:Bind ViewModel.ThresholdDbfs, Mode=TwoWay}"
                                Description="Raw level (dBFS) at or above which a frame counts as speech. Lower is more sensitive." />

                            <controls:TunableRow Label="Cut margin" Unit="ms"
                                Minimum="0.0" Maximum="1000.0" Step="50.0" Default="150.0"
                                Value="{x:Bind ViewModel.MarginMs, Mode=TwoWay}"
                                Description="Silence kept after the last word when cutting — the rest is dropped." />

                            <controls:TunableRow Label="Minimum utterance" Unit="ms"
                                Minimum="0.0" Maximum="1000.0" Step="50.0" Default="250.0"
                                Value="{x:Bind ViewModel.MinUtteranceMs, Mode=TwoWay}"
                                Description="Speech shorter than this is dropped as a noise blip rather than transcribed." />
                        </StackPanel>
                    </controls:TuningCard>

                    <!-- Footer breathing room — only present while the floating
                         save bar is up, so the last card's caption can scroll
                         clear of it instead of sitting under it. Its height is
                         kept in step with the bar's actual height in code-behind;
                         toggled with the bar on IsDirty. -->
                    <Border x:Name="UnsavedSpacer" Height="56" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Floating save bar — overlays the bottom of the scroll, shown only
                 while there are unsaved edits (toggled on IsDirty in code-behind).
                 Revert discards back to the saved values, Save writes them to the
                 segmenter store ; both clear the dirty state, so the bar dismisses
                 itself. Rounded + inset + elevated so it reads as a floating card.
                 The left margin is 0 (not 12) so it overhangs the cards by the
                 same 12 on the left as it does on the right and bottom. -->
            <Border x:Name="UnsavedBar"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,12"
                    Padding="16,14"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Unsaved changes"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="RevertButton" Click="OnRevertClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Reset}" FontSize="14" />
                                <TextBlock Text="Revert" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnSaveClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource Icon.Save}" FontSize="14" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
