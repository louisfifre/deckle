<!-- Wheel-capture surface (Palier 0 of the wheel→touchpad work). One
     diagnostic toggle driving MouseWheelSettings.RecordEvents, plus a
     shortcut to the telemetry folder where wheel-events-*.jsonl lands.
     Same centred-column + SettingsCard layout as HomePage so the
     Playground surfaces stay visually consistent. -->
<Page
    x:Class="Deckle.Playground.MouseWheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Top"
              MaxWidth="720"
              Margin="32,32,32,32">
            <StackPanel Spacing="32">

                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PlaygroundMouseWheelHeader"
                               Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock x:Uid="PlaygroundMouseWheelSubheader"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <controls:SettingsCard x:Uid="PlaygroundMouseWheelRecordCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Mouse}}">
                        <ToggleSwitch x:Name="RecordToggle"
                                      Toggled="OnRecordToggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="PlaygroundMouseWheelOpenFolderCard"
                                           HeaderIcon="{ui:FontIcon Glyph={StaticResource Icon.Folder}}"
                                           IsClickEnabled="True"
                                           Click="OnOpenFolderClick" />

                    <TextBlock x:Name="FolderPathText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
