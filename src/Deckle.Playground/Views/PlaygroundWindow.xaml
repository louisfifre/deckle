<Window
    x:Class="Deckle.Playground.PlaygroundWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Deckle Playground">

    <!-- Hit-testable and focusable so a tap on empty space can take focus
         from a NumberBox: a focused WinUI 3 input keeps it on a background
         click unless something else takes it. -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  x:Name="AppTitleBar"
                  x:Uid="PlaygroundTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <!-- Same lateral commands as SettingsWindow and LogWindow: each
                     of the three windows carries the two others here. -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SettingsButton"
                            x:Uid="PlaygroundSettingsButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnSettingsButtonClick">
                        <FontIcon Glyph="{StaticResource Icon.Settings}" FontSize="16" />
                    </Button>
                    <Button x:Name="LogsButton"
                            x:Uid="PlaygroundLogsButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            MinWidth="36"
                            Padding="8,4"
                            Click="OnLogsButtonClick">
                        <FontIcon Glyph="{StaticResource Icon.Logs}" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Each Tag is the fully-qualified Page type name, resolved by
             Type.GetType in OnNavSelectionChanged; PlaygroundWindow.NavigateTo
             maps the short tags onto these. -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        ExpandedModeThresholdWidth="1440"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="PlaygroundNavHome"
                                    Tag="Deckle.Playground.HomePage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Home}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="PlaygroundNavHud"
                                    Tag="Deckle.Playground.HudPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Speaker}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="PlaygroundNavAmbient"
                                    Tag="Deckle.Playground.AmbientPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Lightbulb}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="PlaygroundNavCorrection"
                                    Tag="Deckle.Playground.CorrectionApplicationPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource Icon.Autocorrect}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="PageFrame" />
        </NavigationView>
    </Grid>
</Window>
