  <!-- Playground TestPrompt descriptor strings, resolved by the notification
       channel via Loc (C# direct-lookup convention, Surface_Purpose). The keys
       are referenced from PlaygroundNotifications.cs, not from XAML — so they
       are MIRRORED in Deckle.App's Resources.resw: Loc resolves the root
       resource map only, and a library's .resw lands in its own subtree,
       reachable by x:Uid but not by Loc.Get. This copy is the source of truth
       for wording. -->
  <data name="PlaygroundNotifications_TestPrompt_Title" xml:space="preserve">
    <value>Deckle test notification</value>
  </data>
  <data name="PlaygroundNotifications_TestPrompt_Body" xml:space="preserve">
