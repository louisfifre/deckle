  <data name="PlaygroundHomeHeader.Text" xml:space="preserve">
    <value>Deckle Playground</value>
  </data>
  <data name="PlaygroundHomeSubheader.Text" xml:space="preserve">
    <value>Tuning surface for the running pipelines. Pick a section below to start adjusting — values apply live, no restart needed.</value>
  </data>
  <data name="PlaygroundHomeHudCard.Header" xml:space="preserve">
    <value>HUD stroke</value>
  </data>
  <data name="PlaygroundHomeHudCard.Description" xml:space="preserve">
    <value>Tune the conic gradient stroke that wraps the chrono. Colour, easing, arc fade, per-state variants.</value>
  </data>
  <data name="PlaygroundHomeAmbientCard.Header" xml:space="preserve">
    <value>Ambient lighting</value>
  </data>
  <data name="PlaygroundHomeAmbientCard.Description" xml:space="preserve">
    <value>Screen capture, zone sampling, colour processing, Hue REST output. Live preview + per-light swatches.</value>
  </data>
  <data name="PlaygroundHomeSegmentationCard.Header" xml:space="preserve">
    <value>Utterance segmentation</value>
  </data>
  <data name="PlaygroundHomeSegmentationCard.Description" xml:space="preserve">
    <value>Shape the dynamic-hangover curve that decides where the streaming transcriber cuts one utterance from the next. Live plot + Save / Revert / Reset.</value>
  </data>

  <data name="PlaygroundHudTunablesHeader.Text" xml:space="preserve">
    <value>HUD elements</value>
  </data>
  <data name="PlaygroundHudTunablesDescription.Text" xml:space="preserve">
    <value>Tweak values live for the current session — nothing is saved. Reset all to start over; the next launch is fresh anyway.</value>
  </data>

  <data name="PlaygroundAmbientHeader.Text" xml:space="preserve">
    <value>Ambient lighting</value>
  </data>
  <data name="PlaygroundAmbientSubheader.Text" xml:space="preserve">
    <value>Screen capture, Hue bridge, and the analysis pipeline that pushes the averaged screen colour to your lights.</value>
  </data>

  <data name="PlaygroundSegmentationHeader.Text" xml:space="preserve">
    <value>Utterance segmentation</value>
  </data>
  <data name="PlaygroundSegmentationSubheader.Text" xml:space="preserve">
    <value>Shape the dynamic-hangover curve that decides where the streaming transcriber cuts one utterance from the next. Edits stay local until you save.</value>
  </data>

