  <data name="PlaygroundHomeHeader.Text" xml:space="preserve">
    <value>Deckle Playground</value>
  </data>
  <data name="PlaygroundHomeSubheader.Text" xml:space="preserve">
    <value>Tuning surface for the running pipelines. Pick a section below to start adjusting — values apply live, no restart needed.</value>
  </data>
  <data name="PlaygroundHomeHudCard.Header" xml:space="preserve">
    <value>HUD stroke</value>
  </data>
  <data name="PlaygroundHomeHudCard.Description" xml:space="preserve">
    <value>Tune the conic gradient stroke that wraps the chrono. Colour, easing, arc fade, per-state variants.</value>
  </data>
  <data name="PlaygroundHomeAmbientCard.Header" xml:space="preserve">
    <value>Ambient lighting</value>
  </data>
  <data name="PlaygroundHomeAmbientCard.Description" xml:space="preserve">
    <value>Screen capture, zone sampling, colour processing, Hue REST output. Live preview + per-light swatches.</value>
  </data>
  <data name="PlaygroundHomeSegmentationCard.Header" xml:space="preserve">
    <value>Utterance segmentation</value>
  </data>
  <data name="PlaygroundHomeSegmentationCard.Description" xml:space="preserve">
    <value>Shape the dynamic-hangover curve that decides where the streaming transcriber cuts one utterance from the next. Live plot + Save / Revert / Reset.</value>
  </data>
  <data name="PlaygroundHomeCorrectionCard.Header" xml:space="preserve">
    <value>Delayed correction</value>
  </data>
  <data name="PlaygroundHomeCorrectionCard.Description" xml:space="preserve">
    <value>Measure whether an earlier sentence can be corrected while typing continues, without moving the active caret.</value>
  </data>

  <!-- ACX-0021 phase-A physical-typing lab. Synthetic text only; results stay
       in memory and cannot establish external-editor or production safety. -->
  <data name="PlaygroundCorrectionHeader.Text" xml:space="preserve">
    <value>Delayed correction</value>
  </data>
  <data name="PlaygroundCorrectionSubheader.Text" xml:space="preserve">
    <value>Type a new sentence while the lab corrects a fixed token in the previous one through an owned document range.</value>
  </data>
  <data name="PlaygroundCorrectionBoundary.Title" xml:space="preserve">
    <value>Research boundary</value>
  </data>
  <data name="PlaygroundCorrectionBoundary.Message" xml:space="preserve">
    <value>This synthetic WinUI test does not exercise production autocorrect, another app, UI Automation, simulated input, or end-to-end application.</value>
  </data>
  <data name="PlaygroundCorrectionScenarioCard.Header" xml:space="preserve">
    <value>Owned editor scenario</value>
  </data>
  <data name="PlaygroundCorrectionScenarioCard.Description" xml:space="preserve">
    <value>The fixed edit is “la” → “là” in the first sentence. Continue typing only at the end after arming.</value>
  </data>
  <data name="PlaygroundCorrectionEditor.AutomationProperties.Name" xml:space="preserve">
    <value>Synthetic delayed-correction editor</value>
  </data>
  <data name="PlaygroundCorrectionEditor.PlaceholderText" xml:space="preserve">
