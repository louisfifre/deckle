  </data>
  <data name="PlaygroundCorrectionFaultLabel.Text" xml:space="preserve">
    <value>Controlled fault</value>
  </data>
  <data name="PlaygroundCorrectionFault.PlaceholderText" xml:space="preserve">
    <value>Choose a fault</value>
  </data>
  <data name="PlaygroundCorrectionLoadScenario.Content" xml:space="preserve">
    <value>Load scenario</value>
  </data>
  <data name="PlaygroundCorrectionArm.Content" xml:space="preserve">
