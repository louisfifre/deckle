<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Inference.Onnx</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DirectML build although sessions here run on the CPU: ONNX Runtime
         is one native DLL per process, and the GenAI sentence judge needs that
         build. Never the .Gpu package. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
  </ItemGroup>
</Project>
