<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Deckle.Shell</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.UI.Windowing (AppWindow icon) + Microsoft.UI.Dispatching
         (DispatcherQueue) consumed by IconAssets and DispatcherQueueExtensions.
         No XAML, no UseWinUI=true — pure WinAppSDK API surface. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output. Convention
         documented in ../Deckle.Diagnostics/CLAUDE.md. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
