<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Shell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the WinAppSDK API surface (AppWindow, DispatcherQueue).
         Deckle.Shell stays XAML-free, no UseWinUI: code that needs the XAML
         visual tree lives in a sibling module such as Deckle.Shell.TrayMenu. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deckle.Core\Deckle.Core.csproj" />
    <ProjectReference Include="..\Deckle.Catalog\Deckle.Catalog.csproj" />
    <ProjectReference Include="..\Deckle.Diagnostics\Deckle.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ResizeGesture (the Win32-free state machine behind ResizeCoalescer) is
         internal; its unit tests reach it through this grant. -->
    <InternalsVisibleTo Include="Deckle.Shell.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EventSource [Event] parameters use snake_case so the ETW
         payload keys land directly in the JSONL output and must
         match the ETW manifest. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>
</Project>
