<Window
    x:Class="Deckle.Atelier.Views.AtelierWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Atelier.Views"
    Title="Deckle Atelier">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- The three numbered lines of the empty state (12.11). -->
            <Style x:Key="EmptyStepCard" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="EmptyStepNumber" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Key="D" Modifiers="Menu" Invoked="OnAddressAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The top row is the title bar itself (spec, Window: one row, no
             band above it, no tabs). The TitleBar control lays out, left to
             right, its pane toggle, the icon, the title, then Content, then
             Windows' caption buttons; its own back button is hidden because
             Back sits after the name here, with Forward, Up and Refresh, in
             Content. The window asks for the tall caption buttons, which take
             the row's full height. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="Deckle Atelier"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Resources>
                <!-- Content takes the width left between the title and the
                     caption buttons, so the address bar can stretch. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource x:Name="AppTitleBarIcon" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid Margin="4,0,0,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BackButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnBackClick">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <Button x:Name="ForwardButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnForwardClick">
                            <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        </Button>
                        <Button x:Name="UpButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnUpClick">
                            <FontIcon Glyph="&#xE74A;" FontSize="16" />
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnRefreshClick">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <local:AddressBar x:Name="Address" Grid.Column="1" Margin="2,0" />

                    <!-- One button per tool; the active one is pressed and
                         shows its name (spec, Window). Built from the tool
                         catalog in code. -->
                    <StackPanel x:Name="ToolButtons" Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="2,0">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                        </StackPanel.Resources>
                    </StackPanel>

                    <Button x:Name="SearchButton" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,4,0">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- The pane of added folders (12.1, 12.2): reduced to their icons in
             a rail, opened over the content by the first button of the top
             row. NavigationView's LeftCompact mode is that rail and that
             overlay; its own toggle is hidden because the title bar's opens
             it. Its content area brings the layer fill and the rounded top
             left corner the boards draw. -->
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        OpenPaneLength="280"
                        SelectionFollowsFocus="Disabled"
                        ItemInvoked="OnNavItemInvoked">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AddFolderItem" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="CentreHost" />

                <!-- Before any folder is added (12.11). -->
                <ScrollViewer x:Name="EmptyState" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Spacing="24" MaxWidth="584">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="EmptyTitle"
                                       Style="{StaticResource BodyLargeTextBlockStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="EmptyBody"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="DropZone"
                              Height="120"
                              AllowDrop="True"
                              Background="Transparent"
                              DragOver="OnDropZoneDragOver"
                              Drop="OnDropZoneDrop">
                            <Rectangle Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       StrokeThickness="1"
                                       StrokeDashArray="4,3"
                                       RadiusX="8"
                                       RadiusY="8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Button x:Name="EmptyAddButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Click="OnAddFolderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                                        <TextBlock x:Name="EmptyAddLabel" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Uid="EmptyDrop"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid Style="{StaticResource EmptyStepCard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EmptyStepNumber}"><TextBlock Text="1" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="EmptyStep1Title" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="EmptyStep1Body" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource EmptyStepCard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EmptyStepNumber}"><TextBlock Text="2" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="EmptyStep2Title" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="EmptyStep2Body" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource EmptyStepCard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EmptyStepNumber}"><TextBlock Text="3" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="EmptyStep3Title" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="EmptyStep3Body" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The details panel, on the right of the centre (12.1). The
                     window owns its frame; the active tool fills it. -->
                <Border x:Name="DetailsPanel"
                        Grid.Column="1"
                        Width="320"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <ScrollViewer>
                        <ContentPresenter x:Name="DetailsHost" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
