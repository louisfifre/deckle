<UserControl
    x:Class="Deckle.Atelier.Views.MapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Atelier.Views">

    <!-- The map's inventory as a details list, flat, as board 12.8b draws it:
         the filter boxes, a header row, then one row per item. The header,
         the rows and the total share their column widths and sit 12 px in
         from the item's rounded fill, as in the file tool, so each label
         stands over its column and the last value ends the row. -->
    <UserControl.Resources>
        <GridLength x:Key="MapKindColumnWidth">128</GridLength>
        <GridLength x:Key="MapLinksColumnWidth">40</GridLength>
        <GridLength x:Key="MapLinesColumnWidth">52</GridLength>
        <GridLength x:Key="MapTokensColumnWidth">96</GridLength>
        <GridLength x:Key="MapModifiedColumnWidth">80</GridLength>
        <!-- Explorer's compact rows, not ListView's touch-sized default. -->
        <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
        <Style x:Key="MapHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="MapFigureTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MapHeaderTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="12,8,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- "Toujours lu par un LLM" first, then one box per kind present in
             the folder, all ticked (12.8b, 12.8c). -->
        <StackPanel x:Name="Filters"
                    Margin="16,0,16,4"
                    Orientation="Horizontal"
                    Spacing="24">
            <CheckBox x:Name="AlwaysReadBox" x:Uid="MapAlwaysRead" MinWidth="0" Click="OnFilterClick" />
            <Rectangle Width="1"
                       Height="16"
                       VerticalAlignment="Center"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel x:Name="KindBoxes" Orientation="Horizontal" Spacing="24" />
        </StackPanel>

        <!-- The walk stopped at its bound on a huge folder: the list is partial. -->
        <InfoBar x:Name="Truncated"
                 Grid.Row="1"
                 Margin="4,0,4,8"
                 Severity="Informational"
                 IsClosable="False"
                 IsOpen="False" />

        <Grid x:Name="Header"
              Grid.Row="2"
              Height="32"
              Margin="4,0"
              Padding="12,0"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource MapKindColumnWidth}" />
                <ColumnDefinition Width="{StaticResource MapLinksColumnWidth}" />
                <ColumnDefinition Width="{StaticResource MapLinesColumnWidth}" />
                <ColumnDefinition Width="{StaticResource MapTokensColumnWidth}" />
                <ColumnDefinition Width="{StaticResource MapModifiedColumnWidth}" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="MapHeaderName" Style="{StaticResource MapHeaderTextStyle}" />
            <TextBlock x:Uid="MapHeaderKind" Grid.Column="1" Style="{StaticResource MapHeaderTextStyle}" />
            <TextBlock x:Uid="MapHeaderLinks" Grid.Column="2" Style="{StaticResource MapFigureTextStyle}" />
            <TextBlock x:Uid="MapHeaderLines" Grid.Column="3" Style="{StaticResource MapFigureTextStyle}" />
            <TextBlock x:Name="TokensHeader" x:Uid="MapHeaderTokens" Grid.Column="4" Style="{StaticResource MapFigureTextStyle}" />
            <TextBlock x:Uid="MapHeaderModified" Grid.Column="5" Style="{StaticResource MapFigureTextStyle}" />
        </Grid>

        <ProgressBar x:Name="Progress"
                     Grid.Row="3"
                     Margin="4,0"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="Collapsed" />

        <ListView x:Name="Rows"
                  Grid.Row="3"
                  Margin="0,4,0,0"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MapRow">
                    <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Place}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource MapKindColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource MapLinksColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource MapLinesColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource MapTokensColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource MapModifiedColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Folder}"
                                       Visibility="{x:Bind FolderVisibility}"
                                       Style="{StaticResource MapHeaderTextStyle}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource MapHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Links}" Style="{StaticResource MapFigureTextStyle}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Lines}" Style="{StaticResource MapFigureTextStyle}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Tokens}" Style="{StaticResource MapFigureTextStyle}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Modified}" Style="{StaticResource MapFigureTextStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <!-- With "Toujours lu par un LLM" ticked, a last row gives the
                 total of the tokens shown (12.8c). It scrolls with the rows,
                 right under the last one. -->
            <ListView.Footer>
                <Grid x:Name="Total"
                      Height="32"
                      Margin="4,0"
                      Padding="12,0"
                      ColumnSpacing="12"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource MapKindColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource MapLinksColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource MapLinesColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource MapTokensColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource MapModifiedColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TotalLabel"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TotalTokens"
                               Grid.Column="4"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </ListView.Footer>
        </ListView>

        <!-- A filter that leaves no row, or a folder gone or unreadable (spec,
             Open 33: Windows' conventions, the sentence in the middle of the
             list as File Explorer writes it). -->
        <TextBlock x:Name="Message"
                   Grid.Row="3"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />

        <!-- A folder with nothing of the kind: it says so, then what was
             looked for (12.14). No header and no boxes: nothing to filter. -->
        <StackPanel x:Name="EmptyState"
                    Grid.RowSpan="4"
                    MaxWidth="480"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <FontIcon x:Name="EmptyGlyph"
                      FontSize="32"
                      Margin="0,0,0,8"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyTitle"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyBody"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
