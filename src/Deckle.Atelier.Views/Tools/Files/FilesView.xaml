<UserControl
    x:Class="Deckle.Atelier.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Atelier.Views">

    <!-- The details list of board 12.1: a header row, then one row per item,
         name, date modified and size. The header and the rows share their
         column widths, and both sit 12 px in from the item's rounded fill,
         so each label stands over its column. -->
    <UserControl.Resources>
        <GridLength x:Key="ModifiedColumnWidth">104</GridLength>
        <GridLength x:Key="SizeColumnWidth">88</GridLength>
        <!-- Explorer's compact rows, not ListView's touch-sized default. -->
        <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
    </UserControl.Resources>

    <Grid Padding="12,8,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header"
              Height="32"
              Margin="4,0"
              Padding="12,0"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ModifiedColumnWidth}" />
                <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="FilesHeaderName"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Uid="FilesHeaderModified"
                       Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Uid="FilesHeaderSize"
                       Grid.Column="2"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <ListView x:Name="Rows"
                  Grid.Row="1"
                  Margin="0,4,0,0"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnRowsDoubleTapped"
                  KeyDown="OnRowsKeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileRow">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ModifiedColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <IconSourceElement IconSource="{x:Bind Icon}"
                                               Width="16"
                                               Height="16"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Modified}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Size}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- An empty folder, or one that is gone or unreadable (spec, Open 33:
             Windows' conventions; Explorer says the folder is empty in the
             middle of the list). -->
        <TextBlock x:Name="Message"
                   Grid.Row="1"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />

        <!-- Where the display is chosen (12.18, bottom right). The list is the
             one built; large rows and the gallery come later and are shown
             disabled so the place is there. -->
        <StackPanel x:Name="DisplayChoice"
                    Grid.Row="2"
                    Height="40"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="2">
            <StackPanel.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
            </StackPanel.Resources>
            <ToggleButton x:Name="DisplayListButton" Width="36" Height="32" Padding="0" IsChecked="True" Click="OnDisplayClick">
                <FontIcon Glyph="&#xE8FD;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="DisplayLargeRowsButton" Width="36" Height="32" Padding="0" IsEnabled="False">
                <FontIcon Glyph="&#xE8BF;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="DisplayGalleryButton" Width="36" Height="32" Padding="0" IsEnabled="False">
                <FontIcon Glyph="&#xF0E2;" FontSize="16" />
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
