<UserControl
    x:Class="Deckle.Atelier.Views.FileRowActions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opacity="0">

    <!-- The two actions of a row (spec, File list; 12.1): "Show in
         File Explorer" and "Move to Recycle Bin". The control always takes
         its width, shown or not, so no column moves when they appear, and a
         folder whose rows held other actions would line up the same. Subtle
         icon buttons, as Windows draws the commands of a list row; over a
         picture, in the gallery, they sit on an in-app acrylic frame so they
         read on any photo. -->
    <Border x:Name="Frame" CornerRadius="{ThemeResource ControlCornerRadius}">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="ShowInFolderButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    Width="32"
                    Height="28"
                    Padding="0"
                    Click="OnShowInFolderClick">
                <FontIcon x:Name="ShowInFolderIcon" FontSize="14" />
            </Button>
            <Button x:Name="RecycleButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    Width="32"
                    Height="28"
                    Padding="0"
                    Click="OnRecycleClick">
                <FontIcon x:Name="RecycleIcon" FontSize="14" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
