<UserControl
    x:Class="Deckle.Atelier.Views.PhotosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Atelier.Views">

    <!-- The photo tool of board 12.4: one row with the counters on the left and
         the commands on the right, then the gallery. A photo seen large (12.5)
         takes the gallery's place, with the panel kept beside it. -->
    <UserControl.Resources>
        <!-- 3:2, the shape most cameras shoot; four across at the window's
             default width with the panel open, as 12.4 draws them. -->
        <x:Double x:Key="PhotoTileWidth">184</x:Double>
        <x:Double x:Key="PhotoTileHeight">123</x:Double>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="12,8,12,0" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Counters and commands (12.4). -->
        <Grid Height="40" Margin="4,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Counters"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
                <Run x:Name="UnmarkedRun" FontWeight="SemiBold" />
                <Run x:Name="KeepRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run x:Name="DeleteRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>

            <!-- While the marks are applied, in the counters' place. -->
            <StackPanel x:Name="Applying"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressBar x:Name="ApplyingBar" Width="160" VerticalAlignment="Center" />
                <TextBlock x:Name="ApplyingText" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="Commands" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ApplyButton" Click="OnApplyClick" IsEnabled="False" />
                <Button x:Name="DarktableButton" Click="OnDarktableClick" />
            </StackPanel>
        </Grid>

        <!-- What applying the marks could not do, file by file. -->
        <InfoBar x:Name="ApplyResult"
                 Grid.Row="1"
                 Margin="4,4,4,8"
                 IsOpen="False" />

        <GridView x:Name="Gallery"
                  Grid.Row="2"
                  Margin="0,4,0,0"
                  Padding="4,0,0,12"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnGalleryDoubleTapped"
                  ContainerContentChanging="OnContainerContentChanging">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoTile">
                    <Grid Width="{StaticResource PhotoTileWidth}"
                          Height="{StaticResource PhotoTileHeight}"
                          CornerRadius="{ThemeResource ControlCornerRadius}"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          ToolTipService.ToolTip="{x:Bind Name}"
                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                        <FontIcon Glyph="&#xE91B;"
                                  FontSize="24"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        <Border Width="24"
                                Height="24"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                CornerRadius="12"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind MarkVisibility, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind MarkGlyph, Mode=OneWay}" FontSize="12" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- An empty folder, a folder with no photo, or one that is gone or
             unreadable (Open 33: Windows' conventions, said in the middle). -->
        <TextBlock x:Name="Message"
                   Grid.Row="2"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />

        <!-- A photo seen large (12.5): the picture fitted to the centre, the
             neighbours on each side, the way back at the top right. -->
        <Grid x:Name="Large"
              Grid.Row="2"
              Margin="0,4,0,12"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="LeaveLargeButton"
                    Grid.Column="2"
                    Width="36"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnLeaveLargeClick">
                <FontIcon Glyph="&#xE73F;" FontSize="16" />
            </Button>

            <Button x:Name="PreviousButton"
                    Grid.Row="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnPreviousClick">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>

            <Grid x:Name="LargeFrame"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="12,8"
                  SizeChanged="OnLargeFrameSizeChanged">
                <Border x:Name="LargePlaceholder"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE91B;"
                              FontSize="48"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
                <Image x:Name="LargeImage" Stretch="Uniform" />
            </Grid>

            <Button x:Name="NextButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnNextClick">
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
            </Button>
        </Grid>

        <!-- darktable missing, or the folder gone (Open 33): said at the
             button, with the way out. -->
        <TeachingTip x:Name="DarktableTip"
                     Target="{x:Bind DarktableButton}"
                     PreferredPlacement="BottomLeft"
                     ActionButtonClick="OnDarktableTipAction" />
    </Grid>
</UserControl>
