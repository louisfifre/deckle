<UserControl
    x:Class="Deckle.Atelier.Views.SizesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deckle.Atelier.Views">

    <!-- The sizes list of board 12.7: one line on what the bars measure, a
         header row, then the place's own files and one row per sub-folder,
         each with its name, a bar whose length is its share and its size.
         The header and the rows share their column widths and sit 12 px in
         from the item's rounded fill, as in the file tool. -->
    <UserControl.Resources>
        <GridLength x:Key="BarColumnWidth">2*</GridLength>
        <GridLength x:Key="SizeColumnWidth">88</GridLength>
        <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
    </UserControl.Resources>

    <Grid Padding="12,8,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What the bars measure, and where the analysis stands (12.21,
             12.23). While it runs: how many sub-folders are measured, a
             progress bar and a way to stop it. -->
        <Grid x:Name="StatusLine" Margin="16,0,4,0" MinHeight="32" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ShareLine"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="StateLine"
                       Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="StopButton"
                    Grid.Column="2"
                    Click="OnStopClick"
                    Visibility="Collapsed" />
        </Grid>
        <ProgressBar x:Name="Progress"
                     Grid.Row="1"
                     Margin="16,4,16,4"
                     Maximum="1"
                     Visibility="Collapsed" />

        <!-- Folders that could not be read are said, not hidden. -->
        <InfoBar x:Name="UnreadableNotice"
                 Grid.Row="2"
                 Margin="4,4,4,4"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="False" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Header"
                  Height="32"
                  Margin="4,0"
                  Padding="12,0"
                  ColumnSpacing="12"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="{StaticResource BarColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderName"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderSize"
                           Grid.Column="2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <ListView x:Name="Rows"
                      Grid.Row="1"
                      Margin="0,4,0,0"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      SelectionChanged="OnSelectionChanged"
                      DoubleTapped="OnRowsDoubleTapped"
                      KeyDown="OnRowsKeyDown">
                <!-- A row's bar is read for its length, so its track is as
                     thick as its fill, the way Settings > System > Storage
                     draws a category's share; ProgressBar's own 1 px track is
                     made to show progress, and reads here as a rule. The
                     track takes a faint control fill: Deckle's accent is a
                     grey, close to ProgressBar's own track colour, and the
                     length would not read against it. -->
                <ListView.Resources>
                    <x:Double x:Key="ProgressBarMinHeight">4</x:Double>
                    <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                    <CornerRadius x:Key="ProgressBarTrackCornerRadius">2</CornerRadius>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SizeRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="{StaticResource BarColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="{x:Bind Indent}">
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Where, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind WhereVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <!-- The bar is Windows' own determinate ProgressBar,
                                 as Settings > Storage draws a category's share:
                                 it follows the theme, the accent and contrast. -->
                            <ProgressBar Grid.Column="1"
                                         Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                         Maximum="1"
                                         Value="{x:Bind Share, Mode=OneWay}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          ToolTipService.ToolTip="{x:Bind Warning, Mode=OneWay}"
                                          Visibility="{x:Bind WarningVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Size, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- An empty folder, one that is gone or unreadable, an analysis
                 that failed (spec, Open 33: Windows' conventions, said in the
                 middle of the list as Explorer says a folder is empty). -->
            <TextBlock x:Name="Message"
                       Grid.Row="1"
                       Margin="0,24,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
