<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Deckle.Diagnostics</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <!--
      EventSource conventions adopt snake_case parameter names so the
      ETW payload keys land directly in the JSONL output. Suppress the
      naming-style warning that flags non-PascalCase parameters; the
      convention is explicit and documented in CLAUDE.md.
    -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Tests" />
  </ItemGroup>
</Project>
