<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Deckle.Diagnostics</RootNamespace>
    <!--
      EventSource parameters are snake_case so the ETW payload keys land
      directly in the JSONL output; IDE1006 would flag them.
    -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Diagnostics.Tests" />
  </ItemGroup>
</Project>
